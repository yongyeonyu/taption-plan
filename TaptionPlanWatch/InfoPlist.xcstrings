            "state" : "translated",
            "value" : "BOKKI Plan"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BOKKI Plan"
          }
        }
      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TaptionPlanWatch"
          }
        },
        "ko" : {
