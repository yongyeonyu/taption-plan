    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads heart rate and distance to show a live workout record."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동 중 심박수와 거리 정보를 읽어 실시간 운동 기록을 표시합니다."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves walking, running, and cycling workouts measured on Apple Watch to Health."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch에서 측정한 걷기·달리기·자전거 운동을 건강 앱에 저장합니다."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access records walking and running routes on Apple Maps."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걷기와 달리기 경로를 Apple 지도에 기록하려면 위치 접근이 필요합니다."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion access adds acceleration, rotation, altitude, and step data to activity records and can collect wrist motion in the background."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동 중 3축 가속도·회전·고도·걸음 센서를 활동 기록에 반영하고, 백그라운드에서 손목 움직임을 기록해 활동을 추정합니다."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
