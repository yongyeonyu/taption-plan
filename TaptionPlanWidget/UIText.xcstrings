      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → 画面上部の自分の名前 → iCloudでサインインし、iCloud Driveをオンにしてから、この行をタップしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”→ 顶部你的姓名 → iCloud 中登录，开启 iCloud 云盘，然后点按此行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前往「設定」→ 最上方你的名字 → iCloud，登入並開啟 iCloud 雲碟，然後點一下此列。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich unter Einstellungen → dein Name oben → iCloud an, schalte iCloud Drive ein und tippe dann auf diese Zeile."
          }
        },
