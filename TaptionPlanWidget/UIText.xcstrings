    "|The device storage could not be opened, so changes will not be saved." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスのストレージを開けないため、変更は保存されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开设备存储，因此更改不会被保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟裝置儲存空間，因此變更不會被儲存。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gerätespeicher konnte nicht geöffnet werden, daher werden Änderungen nicht gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'ouvrir le stockage de l'appareil ; les modifications ne seront pas enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire l'archivio del dispositivo, quindi le modifiche non verranno salvate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir el almacenamiento del dispositivo, así que los cambios no se guardarán."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir o armazenamento do dispositivo, então as alterações não serão salvas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể mở bộ nhớ thiết bị nên các thay đổi sẽ không được lưu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan perangkat tidak dapat dibuka, sehingga perubahan tidak akan tersimpan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดที่เก็บข้อมูลของอุปกรณ์ไม่ได้ จึงจะไม่บันทึกการเปลี่ยนแปลง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिवाइस स्टोरेज नहीं खुल सका, इसलिए बदलाव सहेजे नहीं जाएँगे।"
          }
        }
      }
    },
    "|The iCloud container's TaptionSnapshot schema has not been deployed to Production. Until it is deployed, records are stored safely on this device; after deployment, tap this row to try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudコンテナのTaptionSnapshotスキーマが本番環境にデプロイされていません。デプロイされるまでは、記録はこのデバイスに安全に保存されます。デプロイ後に、この行をタップして再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 容器的 TaptionSnapshot 架构尚未部署到生产环境。部署之前，记录会安全地保存在此设备上；部署后，点按此行重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 容器的 TaptionSnapshot 結構尚未部署到正式環境。部署之前，記錄會安全地儲存在這部裝置上；部署之後，點一下此列即可重試。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das TaptionSnapshot-Schema des iCloud-Containers wurde noch nicht in Production bereitgestellt. Bis dahin werden Einträge sicher auf diesem Gerät gespeichert; tippe nach der Bereitstellung auf diese Zeile, um es erneut zu versuchen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le schéma TaptionSnapshot du conteneur iCloud n'a pas été déployé en Production. D'ici là, les enregistrements sont conservés en sécurité sur cet appareil ; après le déploiement, touchez cette ligne pour réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo schema TaptionSnapshot del container iCloud non è stato ancora distribuito in Production. Fino ad allora i dati restano al sicuro su questo dispositivo; dopo la distribuzione, tocca questa riga per riprovare."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El esquema TaptionSnapshot del contenedor de iCloud no se ha desplegado en Producción. Hasta entonces, los registros se guardan de forma segura en este dispositivo; tras el despliegue, toca esta fila para reintentar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O esquema TaptionSnapshot do contêiner do iCloud ainda não foi implantado em Produção. Até lá, os registros ficam guardados com segurança neste dispositivo; depois da implantação, toque nesta linha para tentar de novo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lược đồ TaptionSnapshot của vùng chứa iCloud chưa được triển khai lên Production. Trong lúc chờ, các bản ghi được lưu an toàn trên thiết bị này; sau khi triển khai, hãy nhấn vào hàng này để thử lại."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skema TaptionSnapshot pada kontainer iCloud belum diterapkan ke Production. Sampai diterapkan, catatan tersimpan aman di perangkat ini; setelah itu, ketuk baris ini untuk mencoba lagi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สคีมา TaptionSnapshot ของคอนเทนเนอร์ iCloud ยังไม่ได้ปรับใช้กับ Production ระหว่างนี้ระบบจะเก็บบันทึกไว้ในเครื่องนี้อย่างปลอดภัย เมื่อปรับใช้แล้วให้แตะแถวนี้เพื่อลองอีกครั้ง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud कंटेनर का TaptionSnapshot स्कीमा अभी Production में डिप्लॉय नहीं हुआ है। डिप्लॉय होने तक रिकॉर्ड इस डिवाइस पर सुरक्षित रहते हैं; उसके बाद दोबारा कोशिश के लिए यह पंक्ति दबाएँ।"
          }
        }
      }
    },
