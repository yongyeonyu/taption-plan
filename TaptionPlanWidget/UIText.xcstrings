    "|Screen Time or a device management policy is blocking iCloud. Remove the restriction and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンタイムまたはデバイス管理ポリシーによってiCloudがブロックされています。制限を解除して、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“屏幕使用时间”或设备管理策略正在阻止 iCloud。请移除限制后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「螢幕使用時間」或裝置管理政策正在封鎖 iCloud。請移除限制後再試一次。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmzeit oder eine Geräteverwaltungsrichtlinie blockiert iCloud. Entferne die Einschränkung und versuch es noch einmal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temps d'écran ou une politique de gestion d'appareil bloque iCloud. Retirez la restriction et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo di utilizzo o un criterio di gestione del dispositivo sta bloccando iCloud. Rimuovi la restrizione e riprova."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo de uso o una política de gestión del dispositivo está bloqueando iCloud. Quita la restricción e inténtalo de nuevo."
