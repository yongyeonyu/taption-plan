    "기기 저장소를 열 수 없어 변경 내용을 저장하지 않습니다.|The device storage could not be opened, so changes will not be saved." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスのストレージを開けないため、変更は保存されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开设备存储，因此更改不会被保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟裝置儲存空間，因此變更不會被儲存。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gerätespeicher konnte nicht geöffnet werden, daher werden Änderungen nicht gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'ouvrir le stockage de l'appareil ; les modifications ne seront pas enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire l'archivio del dispositivo, quindi le modifiche non verranno salvate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir el almacenamiento del dispositivo, así que los cambios no se guardarán."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir o armazenamento do dispositivo, então as alterações não serão salvas."
