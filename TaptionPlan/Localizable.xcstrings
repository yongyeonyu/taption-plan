    "GPS 오차와 건물 규모에 맞춰 위치로 인식할 범위를 정합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the area recognized as a location based on GPS accuracy and building size."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPSの精度と建物の大きさに基づいて、位置として認識するエリアを設定します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据 GPS 精度和建筑大小，设置被识别为一个地点的范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依 GPS 準確度和建築物大小，設定被辨識為某個位置的範圍。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege den Bereich fest, der je nach GPS-Genauigkeit und Gebäudegröße als Standort erkannt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez la zone reconnue comme un lieu selon la précision du GPS et la taille du bâtiment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta l'area riconosciuta come luogo in base alla precisione del GPS e alle dimensioni dell'edificio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define la zona que se reconoce como un lugar según la precisión del GPS y el tamaño del edificio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina a área reconhecida como um lugar com base na precisão do GPS e no tamanho do prédio."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt vùng được nhận là một vị trí dựa trên độ chính xác GPS và kích thước tòa nhà."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur area yang dikenali sebagai lokasi berdasarkan akurasi GPS dan ukuran gedung."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งพื้นที่ที่จะรู้จำเป็นสถานที่ตามความแม่นยำของ GPS และขนาดอาคาร"
