        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากตัวแผนภูมิแกนต์เพื่อย้าย และถ่างสองนิ้วเพื่อซูมได้ละเอียดถึงหนึ่งนาที"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मूव करने के लिए गैंट बॉडी को खींचें, और एक मिनट की सटीकता तक ज़ूम करने के लिए दो उँगलियों से पिंच करें"
