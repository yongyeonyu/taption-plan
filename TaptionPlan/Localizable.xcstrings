    "iPhone GPS·모션·기압이 기본 · Apple Watch 운동·경로·활동 데이터는 권한을 받은 경우에만 보조" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone GPS, motion, and barometer are primary · Apple Watch workouts, routes, and activity data supplement them only when authorized"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneのGPS、モーション、気圧計が主で、Apple Watchのワークアウト、ルート、アクティビティデータは、許可した場合のみ補完します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 iPhone 的 GPS、运动和气压计为主 · Apple Watch 的体能训练、路线和活动数据仅在获得授权时作为补充"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 iPhone 的 GPS、動作感測器和氣壓計為主 · 僅在獲授權時，才以 Apple Watch 的體能訓練、路線和活動資料作為補充"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-GPS, Bewegung und Barometer sind primär · Workouts, Routen und Aktivitätsdaten der Apple Watch ergänzen sie nur, wenn erlaubt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le GPS, les mouvements et le baromètre de l'iPhone sont prioritaires · les entraînements, itinéraires et données d'activité de l'Apple Watch les complètent uniquement si autorisé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS, movimento e barometro dell'iPhone sono primari · allenamenti, percorsi e dati attività di Apple Watch li integrano solo se autorizzati"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El GPS, el movimiento y el barómetro del iPhone son la fuente principal · Los entrenamientos, rutas y datos de actividad del Apple Watch los complementan solo si están autorizados"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS, movimento e barômetro do iPhone são a fonte principal · treinos, rotas e dados de atividade do Apple Watch só os complementam quando autorizados"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS, chuyển động và phong vũ biểu của iPhone là chính · bài tập, lộ trình và dữ liệu hoạt động từ Apple Watch chỉ bổ sung khi được cho phép"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS, gerakan, dan barometer iPhone adalah yang utama · olahraga, rute, dan data aktivitas Apple Watch hanya melengkapi bila diizinkan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS การเคลื่อนไหว และเครื่องวัดความกดอากาศของ iPhone เป็นหลัก · การออกกำลังกาย เส้นทาง และข้อมูลกิจกรรมของ Apple Watch ใช้เสริมเมื่อได้รับอนุญาตเท่านั้น"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone का GPS, मोशन और बैरोमीटर मुख्य हैं · Apple Watch के वर्कआउट, रूट और गतिविधि डेटा अनुमति मिलने पर ही पूरक बनते हैं"
          }
        }
      }
    },
    "iPhone 설정 자동 반영 · 건강·활동·가속도" : {
      "localizations" : {
