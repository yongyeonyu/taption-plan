    "계획, 실제 기록, 메모, 자동 이동 기록이 삭제됩니다. 구매 내역과 체험 사용 여부는 유지되며, 이 작업은 되돌릴 수 없습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plans, actual records, notes, and automatic travel records will be deleted. Purchase history and trial usage will be kept. This action cannot be undone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラン、実績記録、メモ、自動の移動記録が削除されます。購入履歴とトライアルの利用状況は保持されます。この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计划、实际记录、备忘和自动出行记录将被删除。购买记录和试用使用情况将保留。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計畫、實際記錄、備忘和自動行程記錄將被刪除。購買記錄和試用使用情形會保留。此操作無法復原。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pläne, tatsächliche Einträge, Memos und automatische Reiseeinträge werden gelöscht. Kaufverlauf und Testnutzung bleiben erhalten. Das kann nicht rückgängig gemacht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plans, enregistrements réels, mémos et trajets automatiques seront supprimés. L'historique d'achat et l'utilisation de l'essai seront conservés. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piani, registrazioni effettive, memo e registrazioni automatiche dei tragitti verranno eliminati. Cronologia degli acquisti e uso della prova verranno mantenuti. L'operazione non si può annullare."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán los planes, los registros reales, las notas y los registros automáticos de viaje. Se conservarán el historial de compras y el uso de la prueba. Esta acción no se puede deshacer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planos, registros reais, notas e registros automáticos de viagem serão excluídos. O histórico de compras e o uso do teste serão mantidos. Esta ação não pode ser desfeita."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kế hoạch, bản ghi thực tế, ghi chú và bản ghi di chuyển tự động sẽ bị xóa. Lịch sử mua và việc dùng thử sẽ được giữ lại. Không thể hoàn tác thao tác này."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rencana, catatan aktual, memo, dan catatan perjalanan otomatis akan dihapus. Riwayat pembelian dan pemakaian uji coba akan dipertahankan. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะลบแผน บันทึกจริง โน้ต และบันทึกการเดินทางอัตโนมัติ ประวัติการซื้อและการใช้งานช่วงทดลองจะยังอยู่ ไม่สามารถย้อนกลับการดำเนินการนี้ได้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लान, असली रिकॉर्ड, मेमो और स्वचालित यात्रा रिकॉर्ड हटा दिए जाएँगे। खरीदारी का इतिहास और ट्रायल उपयोग बना रहेगा। इसे पूर्ववत नहीं किया जा सकता।"
          }
        }
      }
    },
    "계획, 실제 기록, 메모, 자동 이동 기록이 삭제됩니다. 이 작업은 되돌릴 수 없습니다." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plans, actual records, notes, and automatic travel records will be deleted. This action cannot be undone."
          }
        }
      }
    },
    "계획명은 중분류 이름으로 추가되고, 입력한 내용은 액션 메모에 연결됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The plan name is added as a subcategory and the entered content is linked to the action note."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランの名前が中分類として追加され、入力した内容がアクションのメモにリンクされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计划名称会作为中类添加，输入的内容会关联到行动备忘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計畫名稱會新增為中分類，輸入的內容會連結到行動備忘。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Planname wird als Unterkategorie hinzugefügt und der eingegebene Inhalt mit dem Aufgaben-Memo verknüpft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom du plan est ajouté comme sous-catégorie et le contenu saisi est lié au mémo de l'action."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome del piano viene aggiunto come sottocategoria e il contenuto inserito viene collegato al memo dell'azione."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre del plan se añade como subcategoría y el contenido introducido se vincula a la nota de acción."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome do plano é adicionado como subcategoria e o conteúdo digitado é vinculado à nota de ação."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tên kế hoạch được thêm làm danh mục phụ và nội dung đã nhập được liên kết với ghi chú hành động."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama rencana ditambahkan sebagai subkategori dan isi yang dimasukkan dihubungkan ke catatan aksi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชื่อแผนจะถูกเพิ่มเป็นหมวดย่อย และเนื้อหาที่ป้อนจะเชื่อมโยงกับโน้ตการปฏิบัติ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लान का नाम उप-श्रेणी के रूप में जुड़ता है और दर्ज सामग्री एक्शन मेमो से लिंक हो जाती है।"
          }
        }
      }
