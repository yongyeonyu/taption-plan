        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri a sinistra o a destra per vedere la foto successiva o precedente"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a izquierda o derecha para ver la foto siguiente o anterior"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a esquerda ou para a direita para ver a foto seguinte ou anterior"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt trái hoặc phải để xem ảnh kế tiếp hoặc trước đó"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser ke kiri atau kanan untuk melihat foto berikutnya atau sebelumnya"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปัดซ้ายหรือขวาเพื่อดูรูปภาพถัดไปหรือก่อนหน้า"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगली या पिछली फ़ोटो देखने के लिए बाएँ या दाएँ स्वाइप करें"
          }
        }
      }
    },
    "좌표 정밀도가 낮아 선분을 그릴 수 없어서 위치 마커만 표시 중입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Showing location markers only because coordinate precision is too low to draw route segments."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "座標の精度が低く、ルート区間を描画できないため、位置のマーカーのみを表示しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于坐标精度太低，无法绘制路线段，因此只显示位置标记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於座標精確度太低，無法繪製路線區段，因此只顯示位置標記。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur Standortmarkierungen angezeigt, weil die Koordinatengenauigkeit zu gering ist, um Routenabschnitte zu zeichnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les repères de position sont affichés car la précision des coordonnées est trop faible pour tracer les segments d'itinéraire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono mostrati solo i segnaposto di posizione perché la precisione delle coordinate è troppo bassa per disegnare i segmenti del percorso."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se muestran marcadores de ubicación porque la precisión de las coordenadas es demasiado baja para dibujar tramos de ruta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando só marcadores de localização porque a precisão das coordenadas é baixa demais para desenhar trechos de rota."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ hiện điểm đánh dấu vị trí vì độ chính xác tọa độ quá thấp để vẽ các đoạn lộ trình."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya menampilkan penanda lokasi karena presisi koordinat terlalu rendah untuk menggambar segmen rute."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงเฉพาะเครื่องหมายตำแหน่ง เพราะความละเอียดของพิกัดต่ำเกินไปที่จะวาดช่วงเส้นทาง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्देशांक की सटीकता रूट खंड बनाने के लिए बहुत कम है, इसलिए सिर्फ़ स्थान मार्कर दिखाए गए हैं।"
          }
        }
      }
    },
