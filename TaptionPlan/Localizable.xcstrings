    "수면·활동 기록은 시간을 포함하는 루틴에만 연결할 수 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep and activity records can only be connected to routines that include a time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠とアクティビティの記録は、時間を含むルーティンにのみ接続できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠和活动记录只能关联到包含时间的流程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠和活動記錄只能連接到包含時間的例行事項。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf- und Aktivitätseinträge lassen sich nur mit Routinen verknüpfen, die eine Zeit enthalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements de sommeil et d'activité ne peuvent être liés qu'à des routines comportant une heure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le registrazioni di sonno e attività possono essere collegate solo a routine che includono un orario."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros de sueño y actividad solo se pueden conectar a rutinas que incluyan una hora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registros de sono e atividade só podem ser vinculados a rotinas que incluam um horário."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi giấc ngủ và hoạt động chỉ có thể liên kết với các thói quen có thời gian."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan tidur dan aktivitas hanya dapat dihubungkan ke rutinitas yang memiliki waktu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกการนอนหลับและกิจกรรมเชื่อมโยงได้เฉพาะกับกิจวัตรที่มีเวลา"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नींद और गतिविधि रिकॉर्ड सिर्फ़ समय वाले रूटीन से जोड़े जा सकते हैं।"
          }
        }
      }
    },
    "수면·활동 실적은 자동 기록 카드에서 루틴으로 연결합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect sleep and activity results to a routine from the automatic record card."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動記録カードから、睡眠とアクティビティの結果をルーティンに接続します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在自动记录卡片中，将睡眠和活动结果关联到流程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從自動記錄卡片將睡眠與活動結果連接到例行事項。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verknüpfe Schlaf- und Aktivitätsergebnisse über die Karte des automatischen Eintrags mit einer Routine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liez les résultats de sommeil et d'activité à une routine depuis la carte d'enregistrement automatique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega i risultati di sonno e attività a una routine dalla scheda della registrazione automatica."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta los resultados de sueño y actividad a una rutina desde la tarjeta de registro automático."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincule resultados de sono e atividade a uma rotina pelo cartão de registro automático."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liên kết kết quả giấc ngủ và hoạt động với một thói quen từ thẻ bản ghi tự động."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan hasil tidur dan aktivitas ke rutinitas dari kartu catatan otomatis."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมโยงผลการนอนหลับและกิจกรรมกับกิจวัตรจากการ์ดบันทึกอัตโนมัติ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वचालित रिकॉर्ड कार्ड से नींद और गतिविधि के नतीजे रूटीन से जोड़ें।"
          }
        }
