    "예: 주중 23:00 취침 → 다음날 06:30 기상, 주말 01:00 → 10:00" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Example: Weekday sleep 23:00 → wake 06:30 next day, weekend 01:00 → 10:00"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例: 平日の睡眠 23:00 → 翌日6:30に起床、週末は1:00 → 10:00"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
