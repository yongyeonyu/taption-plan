    "끄면 이 장소는 자동 분석에서 제외되고 수동 지정만 유지됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, this place is excluded from automatic analysis and only manual assignments remain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、この場所は自動分析から除外され、手動の割り当てのみ残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，此地点将不参与自动分析，只保留手动指定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉時，此地點會排除在自動分析之外，只保留手動指定。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aus, wird dieser Ort von der automatischen Analyse ausgenommen und nur manuelle Zuordnungen bleiben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, ce lieu est exclu de l'analyse automatique et seules les attributions manuelles restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivato, questo luogo viene escluso dall'analisi automatica e restano solo le assegnazioni manuali."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, este lugar se excluye del análisis automático y solo quedan las asignaciones manuales."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado, este lugar fica fora da análise automática e só restam as atribuições manuais."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tắt, địa điểm này bị loại khỏi phân tích tự động và chỉ còn các gán thủ công."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat nonaktif, tempat ini dikecualikan dari analisis otomatis dan hanya penetapan manual yang tersisa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อปิด สถานที่นี้จะถูกยกเว้นจากการวิเคราะห์อัตโนมัติ และเหลือเฉพาะการกำหนดด้วยมือ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद होने पर यह जगह स्वचालित विश्लेषण से बाहर रहती है और सिर्फ़ मैनुअल असाइनमेंट बचते हैं।"
          }
        }
      }
    },
