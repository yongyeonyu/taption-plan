          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beispiel: Schlaf unter der Woche 23:00 → aufstehen 06:30 am nächsten Tag, am Wochenende 01:00 → 10:00"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exemple : Sommeil en semaine 23:00 → réveil 06:30 le lendemain, week-end 01:00 → 10:00"
