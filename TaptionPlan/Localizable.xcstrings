    "센서 수집 · iPhone 전송" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collect sensors · Send to iPhone"
          }
        }
      }
    },
    "센서 정보 수집중" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collecting sensor data"
          }
        }
      }
    },
    "센서·HealthKit 원본은 보존되며, 수면·운동처럼 자동 기록 전용인 항목은 직접 변경할 수 없습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensor and HealthKit originals are preserved; automatic-only records such as sleep and workouts cannot be edited directly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センサーとHealthKitの元データは保持されます。睡眠やワークアウトなどの自動のみの記録は、直接編集できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "传感器和 HealthKit 原始数据均会保留；睡眠和体能训练等仅自动生成的记录无法直接编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感測器與 HealthKit 的原始資料會保留；睡眠和體能訓練等僅限自動的記錄無法直接編輯。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensor- und HealthKit-Originale bleiben erhalten; rein automatische Einträge wie Schlaf und Workouts lassen sich nicht direkt bearbeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les originaux des capteurs et de HealthKit sont conservés ; les enregistrements uniquement automatiques, comme le sommeil et les entraînements, ne peuvent pas être modifiés directement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli originali di sensori e HealthKit vengono conservati; le registrazioni solo automatiche come sonno e allenamenti non si possono modificare direttamente."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los originales de los sensores y de HealthKit se conservan; los registros solo automáticos, como el sueño y los entrenamientos, no se pueden editar directamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os originais dos sensores e do HealthKit são preservados; registros somente automáticos, como sono e treinos, não podem ser editados diretamente."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu gốc từ cảm biến và HealthKit được giữ nguyên; các bản ghi chỉ tự động như giấc ngủ và bài tập không thể sửa trực tiếp."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data asli sensor dan HealthKit dipertahankan; catatan khusus otomatis seperti tidur dan olahraga tidak dapat diedit langsung."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บข้อมูลต้นฉบับของเซนเซอร์และ HealthKit ไว้ บันทึกอัตโนมัติอย่างเดียว เช่น การนอนหลับและการออกกำลังกาย แก้ไขโดยตรงไม่ได้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेंसर और HealthKit के मूल रिकॉर्ड सुरक्षित रहते हैं; नींद और वर्कआउट जैसे केवल-स्वचालित रिकॉर्ड सीधे संपादित नहीं हो सकते।"
          }
        }
      }
    },
    "센서·건강 원본은 보존되고 표시 활동만 변경됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensor and health originals are preserved; only the displayed activity can be changed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センサーとヘルスケアの元データは保持されます。変更できるのは表示するアクティビティだけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "传感器和健康原始数据均会保留；只能更改显示的活动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感測器與健康原始資料會保留；只能更改顯示的活動。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensor- und Health-Originale bleiben erhalten; nur die angezeigte Aktivität lässt sich ändern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les originaux des capteurs et de Santé sont conservés ; seule l'activité affichée peut être modifiée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli originali di sensori e salute vengono conservati; si può cambiare solo l'attività mostrata."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los originales de los sensores y de Salud se conservan; solo se puede cambiar la actividad mostrada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os originais dos sensores e da saúde são preservados; só a atividade exibida pode ser alterada."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu gốc từ cảm biến và sức khỏe được giữ nguyên; chỉ có thể đổi hoạt động hiển thị."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data asli sensor dan kesehatan dipertahankan; hanya aktivitas yang ditampilkan yang dapat diubah."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บข้อมูลต้นฉบับของเซนเซอร์และสุขภาพไว้ เปลี่ยนได้เฉพาะกิจกรรมที่แสดง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेंसर और स्वास्थ्य के मूल रिकॉर्ड सुरक्षित रहते हैं; सिर्फ़ दिखाई जाने वाली गतिविधि बदली जा सकती है।"
          }
        }
      }
    },
    "센서에서 복원한 이동 기록" : {
      "localizations" : {
        "en" : {
