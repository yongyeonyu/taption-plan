    },
    "두 번 탭하면 섹션 편집을 엽니다" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap to edit the section"
          }
        }
      }
    },
    "두 번 탭하면 확대하고, 길게 누른 뒤 드래그하면 이동하며 양 끝점을 끌면 길이를 조절합니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap to zoom, long-press and drag to move, or drag either endpoint to adjust the length"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルタップでズーム、長押ししてドラッグで移動、どちらかの端をドラッグして長さを調整します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双击缩放，长按并拖动移动，或拖动任一端点调整长度"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連點兩下可縮放，長按並拖曳可移動，或拖曳任一端點以調整長度"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen zum Zoomen, lang drücken und ziehen zum Verschieben, oder einen der Endpunkte ziehen, um die Länge anzupassen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois pour zoomer, appuyez longuement et faites glisser pour déplacer, ou faites glisser une extrémité pour ajuster la durée"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte per zoomare, tieni premuto e trascina per spostare, o trascina un'estremità per regolare la durata"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces para hacer zoom, mantén pulsado y arrastra para mover, o arrastra cualquiera de los extremos para ajustar la duración"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes para dar zoom, mantenha pressionado e arraste para mover, ou arraste qualquer extremidade para ajustar a duração"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn đúp để thu phóng, nhấn giữ và kéo để di chuyển, hoặc kéo một trong hai đầu để chỉnh độ dài"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk dua kali untuk zoom, tekan lama dan seret untuk memindahkan, atau seret salah satu ujung untuk menyesuaikan durasi"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะสองครั้งเพื่อซูม กดค้างแล้วลากเพื่อย้าย หรือลากปลายด้านใดด้านหนึ่งเพื่อปรับความยาว"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़ूम के लिए डबल-टैप करें, हिलाने के लिए देर तक दबाकर खींचें, या लंबाई बदलने के लिए कोई भी सिरा खींचें"
          }
        }
      }
    },
    "드래그하면 시간을 이동하고 두 번 탭하면 섹션 편집을 엽니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to move through time and double-tap to edit the section"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして時間を移動し、ダブルタップで区間を編集します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以在时间中移动，双击以编辑该时段"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖曳即可在時間中移動，連點兩下可編輯該區段"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, um in der Zeit zu navigieren, und doppeltippen, um den Abschnitt zu bearbeiten"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour avancer dans le temps et touchez deux fois pour modifier la section"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per spostarti nel tempo e tocca due volte per modificare la sezione"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para moverte por el tiempo y toca dos veces para editar el tramo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para se mover no tempo e toque duas vezes para editar o trecho"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo để di chuyển theo thời gian và nhấn đúp để sửa khoảng đó"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret untuk berpindah dalam waktu dan ketuk dua kali untuk mengedit bagian"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากเพื่อเลื่อนไปตามเวลา และแตะสองครั้งเพื่อแก้ไขช่วงนั้น"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समय में आगे-पीछे जाने के लिए खींचें और खंड संपादित करने के लिए डबल-टैप करें"
          }
        }
      }
    },
