    },
    "권한은 필요한 기능을 처음 켤 때만 요청하며, 설정에서 언제든 연결을 끊을 수 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permissions are requested only when a feature first needs them, and you can disconnect them anytime in Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可は、機能が初めて必要としたときにのみリクエストされ、設定からいつでも接続を解除できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在某项功能首次需要时才会请求权限，你可以随时在“设置”中断开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在功能第一次需要時才會要求權限，你隨時可在「設定」中中斷連接。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechtigungen werden erst angefragt, wenn eine Funktion sie zum ersten Mal braucht. Du kannst sie jederzeit in den Einstellungen widerrufen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autorisations ne sont demandées que lorsqu'une fonction en a besoin pour la première fois, et vous pouvez les retirer à tout moment dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I permessi vengono richiesti solo quando una funzione ne ha bisogno per la prima volta e puoi scollegarli quando vuoi in Impostazioni."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los permisos se piden solo cuando una función los necesita por primera vez, y puedes desconectarlos cuando quieras en Ajustes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As permissões só são solicitadas quando um recurso precisa delas pela primeira vez, e você pode desconectá-las quando quiser em Ajustes."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền chỉ được yêu cầu khi một tính năng lần đầu cần đến, và bạn có thể ngắt kết nối bất cứ lúc nào trong Cài đặt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin hanya diminta saat fitur pertama kali membutuhkannya, dan Anda dapat memutuskannya kapan saja di Pengaturan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะขอสิทธิ์เมื่อฟีเจอร์ต้องใช้เป็นครั้งแรกเท่านั้น และคุณยกเลิกการเชื่อมต่อได้ทุกเมื่อใน การตั้งค่า"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमतियाँ तभी माँगी जाती हैं जब किसी सुविधा को पहली बार उनकी ज़रूरत हो, और आप उन्हें कभी भी सेटिंग्ज़ में बंद कर सकते हैं।"
          }
        }
      }
    },
