      }
    },
    "설정에서 언제든 바꿀 수 있습니다. ‘동작 줄이기’가 켜지면 선택한 고양이가 정지 자세로 표시됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change this anytime in Settings. When Reduce Motion is on, the selected cat appears in a still pose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定からいつでも変更できます。「視差効果を減らす」がオンのときは、選択したネコが静止ポーズで表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时在“设置”中更改。开启“减弱动态效果”后，所选的猫会以静止姿势显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你隨時可在「設定」中更改。開啟「減少動態效果」後，所選的貓咪會以靜止姿勢顯示。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das jederzeit in den Einstellungen ändern. Wenn „Bewegung reduzieren“ an ist, erscheint die gewählte Katze in einer ruhigen Pose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez le changer à tout moment dans Réglages. Quand Réduire les animations est activé, le chat sélectionné apparaît dans une pose fixe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi cambiarlo quando vuoi in Impostazioni. Con Riduci movimento attivo, il gatto selezionato appare in posa ferma."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiarlo cuando quieras en Ajustes. Con Reducir movimiento activado, el gato seleccionado aparece en una pose estática."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode mudar isto quando quiser em Ajustes. Com Reduzir Movimento ativado, o gato selecionado aparece em uma pose parada."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể đổi bất cứ lúc nào trong Cài đặt. Khi bật Giảm chuyển động, chú mèo đã chọn xuất hiện ở tư thế tĩnh."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat mengubahnya kapan saja di Pengaturan. Saat Kurangi Gerakan aktif, kucing yang dipilih tampil dalam pose diam."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนได้ทุกเมื่อใน การตั้งค่า เมื่อเปิดลดการเคลื่อนไหว แมวที่เลือกจะแสดงในท่านิ่ง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप इसे कभी भी सेटिंग्ज़ में बदल सकते हैं। मोशन कम करें चालू होने पर चुनी हुई बिल्ली स्थिर मुद्रा में दिखती है।"
          }
        }
      }
    },
    "센서 결과는 신뢰도와 함께 기기 안에서 정리" : {
      "localizations" : {
        "en" : {
