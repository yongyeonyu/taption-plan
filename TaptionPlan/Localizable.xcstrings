          }
        }
      }
    },
    "Apple 건강·Watch 수면 기록은 반복 시간과 겹치면 자동 근거로 반영됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health and Watch sleep records are used as automatic evidence when they overlap a repeating schedule."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアとWatchの睡眠記録は、繰り返しの予定と重なるときに自動の根拠として使われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 Apple 健康和 Watch 的睡眠记录与重复日程重叠时，会被用作自动依据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當 Apple 健康與 Watch 的睡眠記錄與重複行程重疊時，會作為自動依據。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlafeinträge von Health und der Watch werden als automatischer Nachweis verwendet, wenn sie sich mit einem wiederkehrenden Termin überschneiden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements de sommeil de Santé et de la Watch servent de preuve automatique lorsqu'ils chevauchent un planning répété."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno di Salute e Watch viene usato come prova automatica quando si sovrappone a un programma ripetuto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros de sueño de Salud de Apple y del Watch se usan como evidencia automática cuando coinciden con una agenda repetida."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registros de sono do Saúde e do Watch são usados como evidência automática quando se sobrepõem a uma agenda recorrente."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi giấc ngủ từ Sức khỏe của Apple và Watch được dùng làm căn cứ tự động khi trùng với lịch lặp."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan tidur Kesehatan Apple dan Watch dipakai sebagai bukti otomatis saat tumpang tindih dengan jadwal berulang."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกการนอนหลับจากสุขภาพและ Watch จะใช้เป็นหลักฐานอัตโนมัติเมื่อทับซ้อนกับตารางที่ทำซ้ำ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple स्वास्थ्य और Watch के नींद रिकॉर्ड, दोहराए जाने वाले शेड्यूल से मेल खाने पर स्वचालित आधार के रूप में इस्तेमाल होते हैं।"
          }
        }
      }
    },
