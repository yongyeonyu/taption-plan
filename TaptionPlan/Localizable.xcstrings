        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esempio: sonno nei giorni feriali 23:00 → sveglia 06:30 del giorno dopo, weekend 01:00 → 10:00"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejemplo: sueño entre semana 23:00 → despertar 06:30 del día siguiente, fin de semana 01:00 → 10:00"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exemplo: sono em dia útil 23:00 → acordar 06:30 do dia seguinte, fim de semana 01:00 → 10:00"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ví dụ: Giấc ngủ ngày thường 23:00 → thức dậy 06:30 hôm sau, cuối tuần 01:00 → 10:00"
          }
        },
        "id" : {
          "stringUnit" : {
