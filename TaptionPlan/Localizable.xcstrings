    "간트 본문을 드래그해 이동하고 두 손가락으로 최대 1분 단위까지 확대합니다" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag the Gantt body to move it, and pinch with two fingers to zoom to one-minute precision"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ガントの本体をドラッグして移動し、2本指のピンチで1分単位までズームします"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动甘特图主体可移动，双指捏合可缩放到1分钟精度"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖曳甘特圖主體即可移動，用兩指縮放可精確到一分鐘"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe den Gantt-Bereich zum Verschieben und zoome mit zwei Fingern bis auf eine Minute genau"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le corps du Gantt pour le déplacer et pincez à deux doigts pour zoomer jusqu'à la minute"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il corpo del Gantt per spostarlo e pizzica con due dita per zoomare fino alla precisione di un minuto"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra el cuerpo del Gantt para moverlo y pellizca con dos dedos para hacer zoom hasta la precisión de un minuto"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste o corpo do Gantt para mover e use pinça com dois dedos para dar zoom até a precisão de um minuto"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo phần thân biểu đồ Gantt để di chuyển và chụm hai ngón để thu phóng đến độ chính xác một phút"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
