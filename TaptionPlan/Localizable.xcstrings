    "위치·동작 센서가 이동이나 층 변화를 감지하면 여기에 나타납니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movement and motion sensors appear here when they detect travel or floor changes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動や階の変化を検出すると、移動とモーションのセンサーがここに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到出行或楼层变化时，移动和动作传感器会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當偵測到行程或樓層變化時，移動與動作感測器會顯示在這裡。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegungs- und Beschleunigungssensoren erscheinen hier, wenn sie Reisen oder Etagenwechsel erkennen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les capteurs de déplacement et de mouvement apparaissent ici quand ils détectent un trajet ou un changement d'étage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sensori di movimento e spostamento compaiono qui quando rilevano un tragitto o un cambio di piano."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sensores de desplazamiento y movimiento aparecen aquí cuando detectan viajes o cambios de planta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os sensores de movimento aparecem aqui quando detectam viagem ou mudança de andar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảm biến di chuyển và chuyển động hiện ở đây khi phát hiện di chuyển hoặc thay đổi tầng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensor perpindahan dan gerakan muncul di sini saat mendeteksi perjalanan atau perubahan lantai."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซนเซอร์การเคลื่อนที่และการเคลื่อนไหวจะปรากฏที่นี่เมื่อตรวจพบการเดินทางหรือการเปลี่ยนชั้น"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यात्रा या मंज़िल बदलने का पता चलने पर गति और मोशन सेंसर यहाँ दिखते हैं।"
          }
        }
      }
    },
    "위치는 이미 채워져 있습니다. 이름과 감지 범위는 다음 화면에서 고칠 수 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The location is already filled in. You can edit its name and detection range on the next screen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置はすでに入力されています。次の画面で、名前と検出範囲を編集できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置已填好。你可以在下一屏编辑其名称和检测范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置已填入。你可以在下一個畫面編輯其名稱和偵測範圍。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standort ist bereits ausgefüllt. Name und Erkennungsbereich kannst du im nächsten Bildschirm bearbeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lieu est déjà renseigné. Vous pourrez modifier son nom et sa portée de détection sur l'écran suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione è già compilata. Nella schermata successiva puoi modificarne il nome e il raggio di rilevamento."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación ya está rellenada. Puedes editar su nombre y su rango de detección en la siguiente pantalla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização já está preenchida. Você pode editar o nome e o alcance de detecção na próxima tela."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vị trí đã được điền sẵn. Bạn có thể sửa tên và phạm vi nhận diện ở màn hình tiếp theo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi sudah terisi. Anda dapat mengedit nama dan jangkauan deteksinya di layar berikutnya."
          }
        },
        "th" : {
