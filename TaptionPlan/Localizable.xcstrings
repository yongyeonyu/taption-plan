    "이동은 아래 10종류만 사용합니다. 센서가 직접 구분하지 못하는 수단은 여러 신호를 합쳐 신뢰도와 함께 표시합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel uses the 10 modes below. Modes sensors cannot identify directly are shown using combined signals and a confidence score."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動は、下の10種類の手段で扱います。センサーで直接判別できない手段は、複数の信号と信頼度スコアを組み合わせて表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出行使用下面10种方式。传感器无法直接识别的方式，会结合多种信号和置信度来显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行程使用以下 10 種方式。感測器無法直接辨識的方式，會以綜合訊號和可信度分數顯示。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Reisen gelten die 10 Verkehrsmittel unten. Verkehrsmittel, die Sensoren nicht direkt erkennen, werden aus kombinierten Signalen mit einem Sicherheitswert angezeigt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les déplacements utilisent les 10 modes ci-dessous. Les modes que les capteurs ne peuvent pas identifier directement sont affichés à partir de signaux combinés et d'un score de confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tragitti usano i 10 mezzi qui sotto. I mezzi che i sensori non riconoscono direttamente vengono mostrati con segnali combinati e un punteggio di affidabilità."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los viajes usan los 10 medios de abajo. Los medios que los sensores no pueden identificar directamente se muestran con señales combinadas y una puntuación de confianza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As viagens usam os 10 meios abaixo. Os meios que os sensores não identificam diretamente aparecem com base em sinais combinados e um índice de confiança."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di chuyển dùng 10 chế độ bên dưới. Các chế độ mà cảm biến không nhận diện trực tiếp được hiển thị bằng tín hiệu kết hợp và điểm tin cậy."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perjalanan memakai 10 moda di bawah. Moda yang tidak dapat dikenali langsung oleh sensor ditampilkan dengan sinyal gabungan dan skor keyakinan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเดินทางใช้ 10 รูปแบบด้านล่าง รูปแบบที่เซนเซอร์ระบุโดยตรงไม่ได้จะแสดงโดยใช้สัญญาณรวมและคะแนนความมั่นใจ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यात्रा नीचे दिए 10 तरीकों का उपयोग करती है। जिन तरीकों को सेंसर सीधे नहीं पहचान सकते, वे मिले-जुले संकेतों और भरोसा स्कोर से दिखाए जाते हैं।"
          }
        }
      }
    },
