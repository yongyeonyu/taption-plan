    "루틴과 연결된 하위 계획이 함께 삭제됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linked child plans will also be deleted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクされた子プランも削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关联的下级计划也将被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已連結的子計畫也會一併刪除。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verknüpfte Unterpläne werden ebenfalls gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-plans liés seront aussi supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno eliminati anche i piani secondari collegati."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los planes secundarios vinculados también se eliminarán."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os planos secundários vinculados também serão excluídos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các kế hoạch con được liên kết cũng sẽ bị xóa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rencana anak yang terhubung juga akan dihapus."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แผนย่อยที่เชื่อมโยงจะถูกลบด้วย"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिंक किए गए चाइल्ड प्लान भी हटा दिए जाएँगे।"
          }
        }
      }
    },
    "루틴을 월·주·일 계획으로 내려보내면 실제 기록이 다시 이 루틴으로 합쳐집니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you convert a routine into monthly, weekly, or daily plans, actual records are merged back into this routine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルーティンを月・週・日のプランに変換すると、実績記録がこのルーティンに統合されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将流程转换为月、周或日计划时，实际记录会合并回此流程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將例行事項轉換為每月、每週或每日計畫時，實際記錄會合併回這個例行事項。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du eine Routine in Monats-, Wochen- oder Tagespläne umwandelst, werden tatsächliche Einträge wieder in diese Routine zusammengeführt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous convertissez une routine en plans mensuels, hebdomadaires ou quotidiens, les enregistrements réels sont refusionnés dans cette routine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando converti una routine in piani mensili, settimanali o giornalieri, le registrazioni effettive vengono riunite in questa routine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al convertir una rutina en planes mensuales, semanales o diarios, los registros reales se fusionan de nuevo en esta rutina."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao converter uma rotina em planos mensais, semanais ou diários, os registros reais são mesclados de volta nesta rotina."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn chuyển một thói quen thành kế hoạch theo tháng, tuần hoặc ngày, các bản ghi thực tế sẽ được gộp lại vào thói quen này."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Anda mengubah rutinitas menjadi rencana bulanan, mingguan, atau harian, catatan aktual digabungkan kembali ke rutinitas ini."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อแปลงกิจวัตรเป็นแผนรายเดือน รายสัปดาห์ หรือรายวัน บันทึกจริงจะถูกรวมกลับเข้ากับกิจวัตรนี้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रूटीन को मासिक, साप्ताहिक या दैनिक प्लान में बदलने पर असली रिकॉर्ड वापस इसी रूटीन में मिल जाते हैं।"
          }
        }
      }
    },
