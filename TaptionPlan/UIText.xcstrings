    "근무 중 1시간 안에 시급이 기준의 90% 아래로 내려가면 알려요.|When another hour of work would push the rate below 90% of base." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さらに1時間働くと、時給が基本額の90%を下回るタイミングです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再多工作一小时会使时薪降到基准的 90% 以下时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當再多工作一小時會使費率低於基本費率的 90% 時。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine weitere Arbeitsstunde den Satz unter 90 % des Grundwerts drücken würde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une heure de travail de plus ferait passer le taux sous 90 % de la base."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando un'altra ora di lavoro farebbe scendere la tariffa sotto il 90% della base."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando otra hora de trabajo bajaría la tarifa por debajo del 90 % de la base."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando mais uma hora de trabalho levaria a taxa abaixo de 90% da base."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi thêm một giờ làm nữa sẽ kéo mức trả xuống dưới 90% mức cơ bản."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat satu jam kerja tambahan akan menurunkan tarif di bawah 90% dari dasar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อการทำงานเพิ่มอีกหนึ่งชั่วโมงจะทำให้อัตราต่ำกว่า 90% ของฐาน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब एक घंटा और काम करने से दर बेस के 90% से नीचे चली जाए।"
          }
        }
      }
    },
    "근무·수면과 상관없이 24시간 내내 쌓여요. 카운터에는 그날 0시부터 번 돈이 보여요.|Grows around the clock. The counter shows what you earned since midnight." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24時間増え続けます。カウンターには、午前0時からの稼ぎが表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全天候增长。计数器显示你从午夜起赚到的金额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全天候成長。計數器顯示自午夜起你賺到的金額。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wächst rund um die Uhr. Der Zähler zeigt, was du seit Mitternacht verdient hast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progresse en continu. Le compteur affiche ce que vous avez gagné depuis minuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cresce giorno e notte. Il contatore mostra quanto hai guadagnato da mezzanotte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crece las 24 horas. El contador muestra lo que has ganado desde medianoche."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cresce o dia todo. O contador mostra o que você ganhou desde a meia-noite."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tăng suốt ngày đêm. Bộ đếm hiển thị số tiền bạn kiếm được từ nửa đêm."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bertambah sepanjang hari. Penghitung menampilkan penghasilan Anda sejak tengah malam."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เติบโตตลอด 24 ชั่วโมง ตัวนับแสดงรายได้ของคุณตั้งแต่เที่ยงคืน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चौबीसों घंटे बढ़ता है। काउंटर आधी रात से अब तक की आपकी कमाई दिखाता है।"
          }
        }
      }
    },
