    "지도를 움직이거나 검색해 핀을 맞춰 주세요. 지금 위치를 보내려면 위치 단추를 누르세요.|Move the map or search to place the pin. To send where you are, tap the location button." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図を動かすか検索してピンを合わせてください。今いる場所を送るには位置ボタンを押してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请移动地图或搜索来放置图钉。要发送当前所在位置，请点按定位按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請移動地圖或搜尋來放置圖釘。要傳送目前所在位置，請點一下定位按鈕。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebe die Karte oder suche, um die Stecknadel zu setzen. Um deinen aktuellen Ort zu senden, tippe auf die Standorttaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez la carte ou recherchez pour placer l’épingle. Pour envoyer votre position actuelle, touchez le bouton de localisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta la mappa o cerca per posizionare lo spillo. Per inviare dove ti trovi, tocca il pulsante della posizione."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve el mapa o busca para colocar el pin. Para enviar dónde estás, toca el botón de ubicación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mova o mapa ou pesquise para posicionar o alfinete. Para enviar onde você está, toque no botão de localização."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di chuyển bản đồ hoặc tìm kiếm để đặt ghim. Để gửi vị trí hiện tại, hãy nhấn nút vị trí."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser peta atau cari untuk menaruh pin. Untuk mengirim lokasi Anda sekarang, ketuk tombol lokasi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลื่อนแผนที่หรือค้นหาเพื่อวางหมุด หากต้องการส่งตำแหน่งปัจจุบัน ให้แตะปุ่มตำแหน่ง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिन लगाने के लिए मैप खिसकाएँ या खोजें। अभी की जगह भेजने के लिए लोकेशन बटन दबाएँ।"
          }
        }
      }
    },
