    "|Astana is the capital of Kazakhstan, on the northern steppe. Its distinctive modern architecture and the Baiterek tower shape the skyline." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アスタナはカザフスタンの首都で、北部の草原にあります。独特な現代建築とバイテレク塔がスカイラインをつくります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阿斯塔纳是哈萨克斯坦的首都，位于北部草原。独特的现代建筑和巴伊杰列克塔塑造了城市天际线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阿斯塔納是哈薩克的首都,位於北部草原。獨特的現代建築與巴伊杰列克塔構成城市天際線。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astana ist die Hauptstadt Kasachstans in der nördlichen Steppe. Ihre markante moderne Architektur und der Baiterek-Turm prägen die Skyline."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astana est la capitale du Kazakhstan, sur la steppe du nord. Son architecture moderne singulière et la tour Baiterek façonnent l'horizon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astana è la capitale del Kazakistan, nella steppa settentrionale. La sua caratteristica architettura moderna e la torre Baiterek definiscono lo skyline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astaná es la capital de Kazajistán, en la estepa del norte. Su arquitectura moderna singular y la torre Baiterek dan forma al perfil de la ciudad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astana é a capital do Cazaquistão, na estepe do norte. Sua arquitetura moderna distinta e a torre Baiterek moldam o horizonte."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astana là thủ đô của Kazakhstan, nằm trên thảo nguyên phía bắc. Kiến trúc hiện đại độc đáo và tháp Baiterek tạo nên đường chân trời của thành phố."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astana adalah ibu kota Kazakhstan, di stepa utara. Arsitektur modernnya yang khas dan menara Baiterek membentuk garis cakrawala."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัสตานาเป็นเมืองหลวงของคาซัคสถาน ตั้งอยู่บนทุ่งหญ้าสเตปป์ทางเหนือ สถาปัตยกรรมสมัยใหม่อันโดดเด่นและหอ Baiterek กำหนดเส้นขอบฟ้าของเมือง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अस्ताना कज़ाख़स्तान की राजधानी है, जो उत्तरी स्तेपी में है। इसकी विशिष्ट आधुनिक वास्तुकला और बाइतेरेक टॉवर क्षितिज की रेखा तय करते हैं।"
          }
        }
      }
    },
    "|Athens" : {
      "extractionState" : "manual",
      "localizations" : {
