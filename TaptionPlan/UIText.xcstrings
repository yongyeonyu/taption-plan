    "|Changes could not be verified against storage again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更内容をストレージと再照合できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法再次对照存储验证更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法再次對照儲存內容驗證變更。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Änderungen konnten nicht erneut mit dem Speicher abgeglichen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de revérifier les modifications par rapport au stockage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile verificare di nuovo le modifiche rispetto all'archivio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron volver a verificar los cambios con el almacenamiento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar as alterações no armazenamento novamente."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác minh lại các thay đổi với bộ nhớ lưu trữ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan tidak dapat diverifikasi ulang terhadap penyimpanan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบการเปลี่ยนแปลงกับที่เก็บข้อมูลอีกครั้งไม่ได้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदलावों को स्टोरेज से दोबारा सत्यापित नहीं किया जा सका।"
          }
        }
      }
    },
