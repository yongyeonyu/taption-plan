    "|New York is the largest city in the United States, at the mouth of the Hudson River. The Statue of Liberty, Central Park, Times Square and Broadway are famous." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ニューヨークはアメリカ最大の都市で、ハドソン川の河口にあります。自由の女神、セントラルパーク、タイムズスクエア、ブロードウェイが有名です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "纽约是美国最大的城市，位于哈德逊河河口。自由女神像、中央公园、时代广场和百老汇闻名遐迩。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紐約是美國最大的城市,位於哈德遜河口。自由女神像、中央公園、時代廣場與百老匯十分著名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New York ist die größte Stadt der Vereinigten Staaten an der Mündung des Hudson. Die Freiheitsstatue, der Central Park, der Times Square und der Broadway sind berühmt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New York est la plus grande ville des États-Unis, à l'embouchure de l'Hudson. La statue de la Liberté, Central Park, Times Square et Broadway sont célèbres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New York è la città più grande degli Stati Uniti, alla foce del fiume Hudson. La Statua della Libertà, Central Park, Times Square e Broadway sono famosi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueva York es la mayor ciudad de Estados Unidos, en la desembocadura del río Hudson. La Estatua de la Libertad, Central Park, Times Square y Broadway son famosos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova York é a maior cidade dos Estados Unidos, na foz do rio Hudson. A Estátua da Liberdade, o Central Park, a Times Square e a Broadway são famosos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New York là thành phố lớn nhất Hoa Kỳ, ở cửa sông Hudson. Tượng Nữ thần Tự do, Central Park, Quảng trường Thời đại và Broadway rất nổi tiếng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New York adalah kota terbesar di Amerika Serikat, di muara Sungai Hudson. Patung Liberty, Central Park, Times Square, dan Broadway sangat terkenal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นิวยอร์กเป็นเมืองใหญ่ที่สุดในสหรัฐอเมริกา ตั้งอยู่ที่ปากแม่น้ำฮัดสัน เทพีเสรีภาพ เซ็นทรัลปาร์ก ไทมส์สแควร์ และบรอดเวย์เป็นที่รู้จักไปทั่ว"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "न्यूयॉर्क हडसन नदी के मुहाने पर संयुक्त राज्य का सबसे बड़ा शहर है। स्टैच्यू ऑफ़ लिबर्टी, सेंट्रल पार्क, टाइम्स स्क्वायर और ब्रॉडवे प्रसिद्ध हैं।"
          }
        }
      }
    },
