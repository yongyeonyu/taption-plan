        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città portuale all’estremità settentrionale di Honshu, in Giappone. È nota per il festival Nebuta, le mele e il pesce fresco."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad portuaria en el extremo norte de Honshu, Japón. Es conocida por el festival Nebuta, las manzanas y los mariscos frescos."
