    "|Oslo is the capital of Norway, at the head of the Oslo Fjord. The Viking Ship Museum, the Opera House and Vigeland Sculpture Park are main attractions." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オスロはノルウェーの首都で、オスロ・フィヨルドの奥にあります。ヴァイキング船博物館、オペラハウス、ヴィーゲラン彫刻公園が主な見どころです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "奥斯陆是挪威的首都，位于奥斯陆峡湾的最深处。维京船博物馆、歌剧院和维格兰雕塑公园是主要景点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "奧斯陸是挪威的首都,位於奧斯陸峽灣盡頭。維京船博物館、歌劇院與維格蘭雕塑公園是主要景點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oslo ist die Hauptstadt Norwegens am Ende des Oslofjords. Das Wikingerschiffsmuseum, das Opernhaus und der Vigeland-Skulpturenpark sind Hauptattraktionen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oslo est la capitale de la Norvège, au fond du fjord d'Oslo. Le Musée des navires vikings, l'Opéra et le parc de sculptures Vigeland en sont les principales attractions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oslo è la capitale della Norvegia, all'estremità del fiordo di Oslo. Il Museo delle Navi Vichinghe, il Teatro dell'Opera e il Parco delle Sculture di Vigeland sono le attrazioni principali."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oslo es la capital de Noruega, en la cabecera del fiordo de Oslo. El Museo de los Barcos Vikingos, la Ópera y el Parque de Esculturas de Vigeland son sus principales atractivos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oslo é a capital da Noruega, no extremo do fiorde de Oslo. O Museu dos Navios Vikings, a Ópera e o Parque de Esculturas Vigeland são as principais atrações."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oslo là thủ đô của Na Uy, ở đầu vịnh hẹp Oslo. Bảo tàng Tàu Viking, Nhà hát Opera và Công viên Điêu khắc Vigeland là các điểm thu hút chính."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oslo adalah ibu kota Norwegia, di ujung Fjord Oslo. Museum Kapal Viking, Gedung Opera, dan Taman Patung Vigeland adalah daya tarik utama."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออสโลเป็นเมืองหลวงของนอร์เวย์ ตั้งอยู่ที่หัวฟยอร์ดออสโล พิพิธภัณฑ์เรือไวกิ้ง โรงอุปรากร และสวนประติมากรรม Vigeland เป็นแหล่งท่องเที่ยวหลัก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ओस्लो नॉर्वे की राजधानी है, जो ओस्लो फ़्योर्ड के सिरे पर है। वाइकिंग शिप संग्रहालय, ओपेरा हाउस और विगेलैंड मूर्तिकला पार्क मुख्य आकर्षण हैं।"
          }
        }
      }
    },
