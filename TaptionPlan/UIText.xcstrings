        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ícone de localização pode continuar visível enquanto o app monitora deslocamentos com baixo consumo para o registro automático."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biểu tượng vị trí có thể vẫn hiển thị khi ứng dụng theo dõi di chuyển ở mức tiết kiệm pin để tự động ghi lại."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikon lokasi dapat tetap terlihat saat aplikasi memantau pergerakan dengan daya rendah untuk pencatatan otomatis."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไอคอนตำแหน่งอาจแสดงค้างไว้ขณะที่แอปเฝ้าดูการเคลื่อนที่แบบประหยัดพลังงานเพื่อบันทึกอัตโนมัติ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वचालित रिकॉर्ड के लिए ऐप कम बैटरी में गतिविधि पर नज़र रखते समय लोकेशन आइकन दिखता रह सकता है।"
          }
        }
      }
    },
    "자동 기록이 틀렸으면 영상 편집처럼 고칩니다.|Fix automatic records the way you edit a video." : {
      "extractionState" : "manual",
      "localizations" : {
