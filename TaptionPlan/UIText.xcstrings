    "|Vienna is the capital of Austria, on the Danube. It is known for Schönbrunn Palace, St. Stephen’s Cathedral and a deep tradition of opera and classical music." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィーンはオーストリアの首都で、ドナウ川沿いにあります。シェーンブルン宮殿、シュテファン大聖堂、オペラとクラシック音楽の深い伝統で知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "维也纳是奥地利的首都，位于多瑙河畔。以美泉宫、圣斯蒂芬大教堂以及深厚的歌剧和古典音乐传统闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "維也納是奧地利的首都,位於多瑙河畔。以美泉宮、聖史蒂芬大教堂與深厚的歌劇與古典音樂傳統聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wien ist die Hauptstadt Österreichs an der Donau. Es ist für Schloss Schönbrunn, den Stephansdom und eine tiefe Tradition von Oper und klassischer Musik bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vienne est la capitale de l'Autriche, sur le Danube. Elle est connue pour le château de Schönbrunn, la cathédrale Saint-Étienne et une profonde tradition d'opéra et de musique classique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vienna è la capitale dell'Austria, sul Danubio. È nota per il Palazzo di Schönbrunn, la Cattedrale di Santo Stefano e una profonda tradizione di opera e musica classica."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viena es la capital de Austria, a orillas del Danubio. Es conocida por el Palacio de Schönbrunn, la catedral de San Esteban y una profunda tradición de ópera y música clásica."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viena é a capital da Áustria, no Danúbio. É conhecida pelo Palácio de Schönbrunn, pela Catedral de Santo Estêvão e por uma profunda tradição de ópera e música clássica."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vienna là thủ đô của Áo, bên sông Danube. Nổi tiếng với Cung điện Schönbrunn, Nhà thờ St. Stephen và truyền thống opera và nhạc cổ điển sâu đậm."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wina adalah ibu kota Austria, di Sungai Danube. Dikenal dengan Istana Schönbrunn, Katedral Santo Stefanus, dan tradisi opera serta musik klasik yang mendalam."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวียนนาเป็นเมืองหลวงของออสเตรีย ตั้งอยู่ริมแม่น้ำดานูบ มีชื่อเสียงเรื่องพระราชวัง Schönbrunn มหาวิหารเซนต์สตีเฟน และประเพณีโอเปร่าและดนตรีคลาสสิกอันลึกซึ้ง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वियना ऑस्ट्रिया की राजधानी है, जो डेन्यूब पर है। यह शॉनब्रुन पैलेस, सेंट स्टीफ़न कैथेड्रल और ओपेरा तथा शास्त्रीय संगीत की गहरी परंपरा के लिए जाना जाता है।"
          }
        }
      }
    },
