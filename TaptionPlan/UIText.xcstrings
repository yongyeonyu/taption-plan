        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể hoàn tất xác thực sinh trắc học."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentikasi biometrik tidak dapat diselesaikan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การยืนยันตัวตนด้วยไบโอเมตริกไม่สำเร็จ"
