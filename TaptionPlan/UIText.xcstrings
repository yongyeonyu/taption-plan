    "|Boston is the capital of Massachusetts, with deep roots in the American Revolution. The Freedom Trail, nearby Harvard University and Fenway Park are well known." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボストンはマサチューセッツ州の州都で、アメリカ独立革命ゆかりの深い街です。フリーダム・トレイル、近くのハーバード大学、フェンウェイ・パークがよく知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "波士顿是马萨诸塞州的首府，与美国独立战争渊源深厚。自由之路、附近的哈佛大学和芬威球场广为人知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "波士頓是麻薩諸塞州的首府,與美國獨立戰爭淵源深厚。自由之路、鄰近的哈佛大學與芬威球場廣為人知。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boston ist die Hauptstadt von Massachusetts mit tiefen Wurzeln in der Amerikanischen Revolution. Der Freedom Trail, die nahe Harvard University und der Fenway Park sind bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boston est la capitale du Massachusetts, aux profondes racines dans la Révolution américaine. Le Freedom Trail, l'université Harvard voisine et Fenway Park sont bien connus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boston è la capitale del Massachusetts, con profonde radici nella Rivoluzione americana. Il Freedom Trail, la vicina Università di Harvard e il Fenway Park sono ben noti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boston es la capital de Massachusetts, con profundas raíces en la Revolución Americana. Son muy conocidos el Freedom Trail, la cercana Universidad de Harvard y Fenway Park."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boston é a capital de Massachusetts, com profundas raízes na Revolução Americana. O Freedom Trail, a vizinha Universidade Harvard e o Fenway Park são bem conhecidos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boston là thủ phủ của bang Massachusetts, gắn sâu với Cách mạng Mỹ. Freedom Trail, Đại học Harvard gần đó và sân Fenway Park rất nổi tiếng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boston adalah ibu kota Massachusetts, dengan akar yang dalam dalam Revolusi Amerika. Freedom Trail, Universitas Harvard di dekatnya, dan Fenway Park sangat terkenal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอสตันเป็นเมืองหลวงของรัฐแมสซาชูเซตส์ มีรากฐานลึกซึ้งในการปฏิวัติอเมริกา Freedom Trail มหาวิทยาลัยฮาร์วาร์ดที่อยู่ใกล้ และสนาม Fenway Park เป็นที่รู้จักดี"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोस्टन मैसाचुसेट्स की राजधानी है, जिसकी अमेरिकी क्रांति में गहरी जड़ें हैं। फ्रीडम ट्रेल, पास का हार्वर्ड विश्वविद्यालय और फ़ेनवे पार्क प्रसिद्ध हैं।"
          }
        }
      }
    },
