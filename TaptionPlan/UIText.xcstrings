    "고른 하나만 카운터에 쓰여요. 적은 금액은 나머지 칸에 환산해 보여 줘요.|Only the selected one runs the counter. Other tabs show the converted amount." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ1つだけカウンターに使います。他のタブには換算額を表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有所选项用于计数器，其他标签显示换算金额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有所選項目會用於計數器，其他分頁顯示換算金額。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Auswahl zählt für den Zähler. Die anderen Tabs zeigen den umgerechneten Betrag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le choix sélectionné alimente le compteur. Les autres onglets affichent le montant converti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo la voce scelta aziona il contatore. Le altre schede mostrano l’importo convertito."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo la opción elegida usa el contador. Las otras pestañas muestran el importe convertido."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só a opção escolhida usa o contador. As outras abas mostram o valor convertido."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ mục đã chọn dùng cho bộ đếm. Các tab khác hiện số tiền quy đổi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya pilihan ini yang menjalankan penghitung. Tab lain menampilkan jumlah hasil konversi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวนับใช้เฉพาะรายการที่เลือก แท็บอื่นแสดงจำนวนที่แปลงแล้ว"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काउंटर में केवल चुना हुआ विकल्प चलता है। अन्य टैब बदली हुई राशि दिखाते हैं।"
          }
        }
      }
    },
    "고속도로 통행료를 자동으로 넣을 때 할인을 계산해요. 경차는 50%, 전기·수소차는 올해 30%, 평일 출퇴근 시간에는 20~50%예요. 하이브리드는 일반이에요.|Used for highway toll discounts when tolls are added automatically: compact cars 50%, EVs 30% this year, weekday commute hours 20–50%. Hybrids count as standard." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高速道路の通行料を自動で入れるときに割引を計算します。軽自動車は50%、EV・水素車は今年30%、平日の通勤時間帯は20〜50%です。ハイブリッド車は一般です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动添加高速通行费时按此计算折扣：微型车 50%，电动·氢能车今年 30%，工作日通勤时段 20%～50%。混合动力车按普通计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動加入高速公路通行費時依此計算折扣：輕型車 50%，電動·氫能車今年 30%，平日通勤時段 20%～50%。油電混合車視為一般。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird für Mautrabatte verwendet, wenn Mautgebühren automatisch hinzugefügt werden: Kleinstwagen 50 %, E-Autos dieses Jahr 30 %, werktags zu Pendlerzeiten 20–50 %. Hybride zählen als Standard."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à calculer les réductions de péage lors de l'ajout automatique : mini-voitures 50 %, VE 30 % cette année, heures de pointe en semaine 20–50 %. Les hybrides comptent comme standard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve per gli sconti sui pedaggi aggiunti automaticamente: utilitarie 50%, EV 30% quest'anno, orari dei pendolari nei giorni feriali 20–50%. Le ibride contano come standard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para los descuentos de peaje al añadirlos automáticamente: coches compactos 50 %, VE 30 % este año, horas punta entre semana 20–50 %. Los híbridos cuentan como estándar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para descontos de pedágio ao adicioná-los automaticamente: carros compactos 50%, VEs 30% este ano, horários de pico em dias úteis 20–50%. Híbridos contam como padrão."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng để tính giảm giá phí đường cao tốc khi tự động thêm: xe cỡ nhỏ 50%, xe điện 30% trong năm nay, giờ đi làm ngày thường 20–50%. Xe hybrid tính là thông thường."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipakai untuk menghitung diskon tol saat ditambahkan otomatis: mobil kecil 50%, EV 30% tahun ini, jam komuter hari kerja 20–50%. Hibrida dihitung sebagai standar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้คำนวณส่วนลดค่าทางด่วนเมื่อเพิ่มอัตโนมัติ: รถขนาดเล็ก 50% รถ EV 30% ในปีนี้ ช่วงเดินทางไปทำงานวันธรรมดา 20–50% รถไฮบริดนับเป็นทั่วไป"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टोल अपने आप जोड़ते समय छूट की गणना के लिए: छोटी कार 50%, EV इस साल 30%, कार्यदिवस के आवागमन समय 20–50%. हाइब्रिड सामान्य गिनी जाती है।"
          }
        }
      }
    },
