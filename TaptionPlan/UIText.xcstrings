        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hauptstadt von Guizhou, China, mit kühlen Sommern. Kulturen der Minderheiten, nahe Wasserfälle und Berglandschaften sind ihre Anziehungspunkte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capitale du Guizhou, en Chine, aux étés frais. Cultures des minorités, cascades voisines et paysages de montagne en sont les attraits."
