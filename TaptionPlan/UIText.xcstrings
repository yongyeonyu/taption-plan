    "|Honolulu is the capital of Hawaii, on the south shore of Oahu. Waikiki Beach, Diamond Head and the Pearl Harbor memorials are its main sights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホノルルはハワイ州の州都で、オアフ島の南岸にあります。ワイキキビーチ、ダイヤモンドヘッド、真珠湾の慰霊施設が主な名所です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檀香山是夏威夷的首府，位于瓦胡岛南岸。威基基海滩、钻石头山和珍珠港纪念设施是其主要景点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檀香山是夏威夷的首府,位於歐胡島南岸。威基基海灘、鑽石頭山與珍珠港紀念館是主要景點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honolulu ist die Hauptstadt von Hawaii an der Südküste von Oahu. Der Waikiki Beach, Diamond Head und die Gedenkstätten von Pearl Harbor sind die wichtigsten Sehenswürdigkeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honolulu est la capitale d'Hawaï, sur la côte sud d'Oahu. La plage de Waikiki, Diamond Head et les mémoriaux de Pearl Harbor en sont les principaux sites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honolulu è la capitale delle Hawaii, sulla costa meridionale di Oahu. Waikiki Beach, Diamond Head e i memoriali di Pearl Harbor sono le sue attrazioni principali."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honolulu es la capital de Hawái, en la costa sur de Oahu. La playa de Waikiki, Diamond Head y los memoriales de Pearl Harbor son sus principales atractivos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honolulu é a capital do Havaí, na costa sul de Oahu. A praia de Waikiki, Diamond Head e os memoriais de Pearl Harbor são suas principais atrações."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honolulu là thủ phủ của Hawaii, ở bờ nam đảo Oahu. Bãi biển Waikiki, Diamond Head và các đài tưởng niệm Trân Châu Cảng là những điểm chính."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honolulu adalah ibu kota Hawaii, di pesisir selatan Oahu. Pantai Waikiki, Diamond Head, dan memorial Pearl Harbor adalah tempat utamanya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โฮโนลูลูเป็นเมืองหลวงของฮาวาย ตั้งอยู่ชายฝั่งใต้ของเกาะโออาฮู หาดไวกีกี Diamond Head และอนุสรณ์สถานเพิร์ลฮาร์เบอร์เป็นสถานที่หลัก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होनोलूलू हवाई की राजधानी है, जो ओआहू के दक्षिणी तट पर है। वाइकीकी बीच, डायमंड हेड और पर्ल हार्बर के स्मारक इसके मुख्य दर्शनीय स्थल हैं।"
          }
        }
      }
    },
