    "|Yancheng is a city on the Yellow Sea coast of eastern Jiangsu. Its wide tidal flats and wetlands are known as a stopover for migratory birds." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "塩城は江蘇省東部の黄海沿岸の都市です。広い干潟と湿地が、渡り鳥の中継地として知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "盐城是江苏东部黄海沿岸的城市。宽阔的滩涂和湿地以候鸟的中转停留地闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鹽城是江蘇東部黃海沿岸的城市。廣闊的潮間帶與濕地以候鳥中途停棲地聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yancheng ist eine Stadt an der Küste des Gelben Meeres im Osten von Jiangsu. Seine weiten Wattflächen und Feuchtgebiete sind als Rastplatz für Zugvögel bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yancheng est une ville sur la côte de la mer Jaune, dans l'est du Jiangsu. Ses vastes estrans et zones humides sont connus comme halte pour les oiseaux migrateurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yancheng è una città sulla costa del Mar Giallo, nel Jiangsu orientale. Le sue ampie distese tidali e zone umide sono note come luogo di sosta per gli uccelli migratori."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yancheng es una ciudad en la costa del Mar Amarillo, en el este de Jiangsu. Sus amplias marismas y humedales son conocidos como lugar de paso de aves migratorias."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yancheng é uma cidade na costa do Mar Amarelo, no leste de Jiangsu. Suas amplas planícies de maré e áreas úmidas são conhecidas como ponto de parada de aves migratórias."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diêm Thành là thành phố ở bờ Hoàng Hải phía đông Giang Tô. Những bãi triều và đầm lầy rộng được biết đến là nơi dừng chân của chim di cư."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yancheng adalah kota di pesisir Laut Kuning di Jiangsu timur. Dataran lumpur dan lahan basahnya yang luas dikenal sebagai tempat singgah burung migran."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหยียนเฉิงเป็นเมืองบนชายฝั่งทะเลเหลืองทางตะวันออกของมณฑลเจียงซู ที่ราบน้ำขึ้นน้ำลงกว้างและพื้นที่ชุ่มน้ำเป็นที่รู้จักในฐานะจุดแวะพักของนกอพยพ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "येनचेंग पूर्वी जियांगसू के पीले सागर तट पर शहर है। इसके चौड़े ज्वारीय समतल और आर्द्रभूमियाँ प्रवासी पक्षियों के पड़ाव के रूप में जानी जाती हैं।"
          }
        }
      }
    },
