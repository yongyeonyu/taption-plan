    "|Shown as connected when sensor or Health data arrives within the last 15 minutes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去15分以内にセンサーまたはヘルスケアのデータが届くと、接続済みと表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近15分钟内收到传感器或健康数据时，显示为已连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近 15 分鐘內收到感測器或健康資料時，會顯示為已連接。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird als verbunden angezeigt, wenn in den letzten 15 Minuten Sensor- oder Health-Daten eingetroffen sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché comme connecté lorsque des données de capteurs ou de Santé arrivent dans les 15 dernières minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appare come connesso quando i dati dei sensori o di Salute arrivano negli ultimi 15 minuti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra como conectado cuando llegan datos de sensores o de Salud en los últimos 15 minutos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece como conectado quando chegam dados de sensor ou do Saúde nos últimos 15 minutos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị là đã kết nối khi có dữ liệu cảm biến hoặc Sức khỏe trong 15 phút gần nhất."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditampilkan sebagai terhubung bila data sensor atau Kesehatan masuk dalam 15 menit terakhir."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงว่าเชื่อมต่อแล้วเมื่อมีข้อมูลเซนเซอร์หรือข้อมูลสุขภาพเข้ามาใน 15 นาทีที่ผ่านมา"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछले 15 मिनट में सेंसर या स्वास्थ्य डेटा आने पर जुड़ा हुआ दिखता है।"
          }
        }
      }
    },
