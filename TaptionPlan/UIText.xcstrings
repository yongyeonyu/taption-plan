        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không dùng được Face ID hoặc Touch ID. Hãy kiểm tra mật mã thiết bị và cài đặt sinh trắc học."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID atau Touch ID tidak tersedia. Periksa kode sandi perangkat dan pengaturan biometrik Anda."
          }
