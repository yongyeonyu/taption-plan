    "|Chicago is a major Midwestern city on Lake Michigan. It is known for its skyscraper architecture, Millennium Park and the Art Institute of Chicago." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シカゴはミシガン湖畔にある中西部の大都市です。高層建築、ミレニアム・パーク、シカゴ美術館で知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "芝加哥是密歇根湖畔的中西部大城市。以摩天大楼建筑、千禧公园和芝加哥艺术博物馆闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "芝加哥是中西部臨密西根湖的大城市。以摩天大樓建築、千禧公園與芝加哥藝術博物館聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chicago ist eine große Stadt des Mittleren Westens am Michigansee. Sie ist für ihre Wolkenkratzer-Architektur, den Millennium Park und das Art Institute of Chicago bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chicago est une grande ville du Midwest, sur le lac Michigan. Elle est connue pour son architecture de gratte-ciel, le Millennium Park et l'Art Institute of Chicago."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chicago è una grande città del Midwest sul lago Michigan. È nota per l'architettura dei grattacieli, il Millennium Park e l'Art Institute of Chicago."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chicago es una gran ciudad del Medio Oeste a orillas del lago Míchigan. Es conocida por su arquitectura de rascacielos, el Millennium Park y el Instituto de Arte de Chicago."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chicago é uma grande cidade do Meio-Oeste, no lago Michigan. É conhecida pela arquitetura de arranha-céus, pelo Millennium Park e pelo Art Institute of Chicago."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chicago là thành phố lớn ở vùng Trung Tây bên hồ Michigan. Nổi tiếng với kiến trúc nhà chọc trời, Millennium Park và Viện Nghệ thuật Chicago."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chicago adalah kota besar di Midwest di tepi Danau Michigan. Dikenal dengan arsitektur pencakar langit, Millennium Park, dan Art Institute of Chicago."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชิคาโกเป็นเมืองใหญ่ในภาคมิดเวสต์ริมทะเลสาบมิชิแกน มีชื่อเสียงเรื่องสถาปัตยกรรมตึกระฟ้า Millennium Park และสถาบันศิลปะแห่งชิคาโก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शिकागो मिशिगन झील पर मध्य-पश्चिम का बड़ा शहर है। यह अपनी गगनचुंबी इमारतों की वास्तुकला, मिलेनियम पार्क और आर्ट इंस्टीट्यूट ऑफ़ शिकागो के लिए जाना जाता है।"
          }
        }
      }
    },
