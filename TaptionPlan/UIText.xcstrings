    "|Sleep and activity records can only be linked to routines." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠とアクティビティの記録は、ルーティンにのみリンクできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠和活动记录只能关联到流程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠和活動記錄只能連結到例行事項。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf- und Aktivitätseinträge können nur mit Routinen verknüpft werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements de sommeil et d'activité ne peuvent être liés qu'à des routines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le registrazioni di sonno e attività possono essere collegate solo alle routine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros de sueño y actividad solo se pueden vincular a rutinas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registros de sono e atividade só podem ser vinculados a rotinas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi giấc ngủ và hoạt động chỉ có thể liên kết với thói quen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan tidur dan aktivitas hanya dapat dihubungkan ke rutinitas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกการนอนหลับและกิจกรรมเชื่อมโยงได้เฉพาะกับกิจวัตร"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नींद और गतिविधि रिकॉर्ड सिर्फ़ रूटीन से लिंक हो सकते हैं।"
          }
        }
      }
    },
