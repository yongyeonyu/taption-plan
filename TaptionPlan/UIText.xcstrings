    "|Undo failed because it conflicts with synced changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期された変更と競合するため、取り消しに失敗しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撤销失败，因为与已同步的更改冲突。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復原失敗，因為與已同步的變更衝突。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rückgängig machen fehlgeschlagen, da es mit synchronisierten Änderungen kollidiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'annulation a échoué car elle entre en conflit avec des modifications synchronisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annullamento non riuscito perché in conflitto con le modifiche sincronizzate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo deshacer porque entra en conflicto con cambios sincronizados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível desfazer porque há conflito com alterações sincronizadas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoàn tác không thành công do xung đột với các thay đổi đã đồng bộ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urungkan gagal karena bertentangan dengan perubahan yang disinkronkan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลิกทำไม่สำเร็จเพราะขัดแย้งกับการเปลี่ยนแปลงที่ซิงค์"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूर्ववत करना विफल रहा क्योंकि यह सिंक हुए बदलावों से टकराता है।"
          }
        }
      }
    },
