    "|Update to iOS 26.4 or later in Settings > General > Software Update." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 > 一般 > ソフトウェアアップデートで、iOS 26.4以降にアップデートしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”>“通用”>“软件更新”中更新到 iOS 26.4 或更高版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請前往「設定」>「一般」>「軟體更新」更新到 iOS 26.4 或以上版本。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere in Einstellungen > Allgemein > Softwareupdate auf iOS 26.4 oder neuer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez à iOS 26.4 ou version ultérieure dans Réglages > Général > Mise à jour logicielle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna a iOS 26.4 o versioni successive in Impostazioni > Generali > Aggiornamento software."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza a iOS 26.4 o posterior en Ajustes > General > Actualización de software."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize para o iOS 26.4 ou posterior em Ajustes > Geral > Atualização de Software."
