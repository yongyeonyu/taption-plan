    "|Las Vegas is an entertainment city in the Nevada desert. It is famous for the big hotels and casinos along the Strip, live shows and bright night views." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ラスベガスはネバダ州の砂漠にあるエンターテインメントの街です。ストリップ沿いの大型ホテルとカジノ、ライブショー、きらびやかな夜景で有名です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉斯维加斯是内华达沙漠中的娱乐之城。以大道沿线的大型酒店和赌场、现场表演和璀璨夜景闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拉斯維加斯是內華達沙漠中的娛樂城市。以大道沿線的大型飯店與賭場、現場表演和絢爛夜景聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Vegas ist eine Unterhaltungsstadt in der Wüste von Nevada. Sie ist für die großen Hotels und Casinos am Strip, Live-Shows und helle Nachtansichten berühmt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Vegas est une ville de divertissement dans le désert du Nevada. Elle est célèbre pour ses grands hôtels et casinos le long du Strip, ses spectacles et ses vues nocturnes éclatantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Vegas è una città dell'intrattenimento nel deserto del Nevada. È famosa per i grandi hotel e casinò lungo la Strip, gli spettacoli dal vivo e le luminose vedute notturne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Vegas es una ciudad de entretenimiento en el desierto de Nevada. Es famosa por los grandes hoteles y casinos del Strip, los espectáculos en vivo y las brillantes vistas nocturnas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Vegas é uma cidade de entretenimento no deserto de Nevada. É famosa pelos grandes hotéis e cassinos ao longo da Strip, pelos shows ao vivo e pelas vistas noturnas luminosas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Vegas là thành phố giải trí giữa sa mạc Nevada. Nổi tiếng với các khách sạn và sòng bạc lớn dọc Strip, các buổi biểu diễn trực tiếp và cảnh đêm rực rỡ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Vegas adalah kota hiburan di gurun Nevada. Terkenal dengan hotel besar dan kasino di sepanjang Strip, pertunjukan langsung, dan pemandangan malam yang gemerlap."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลาสเวกัสเป็นเมืองบันเทิงกลางทะเลทรายเนวาดา มีชื่อเสียงเรื่องโรงแรมใหญ่และคาสิโนริมถนน Strip การแสดงสด และทัศนียภาพยามค่ำคืนอันสว่างไสว"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लास वेगास नेवादा के रेगिस्तान में मनोरंजन शहर है। यह स्ट्रिप के साथ बड़े होटलों और कैसीनो, लाइव शो और चमकीले रात के दृश्यों के लिए प्रसिद्ध है।"
          }
        }
      }
    },
