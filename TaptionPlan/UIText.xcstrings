    "|Bohol is an island in the Visayas of the Philippines. It is known for the cone-shaped Chocolate Hills and the tiny tarsier." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボホールはフィリピン・ビサヤ諸島の島です。円錐形のチョコレートヒルズと小さなメガネザルで知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄荷岛是菲律宾米沙鄢地区的一座岛。以锥形的巧克力山和小小的眼镜猴闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保和島是菲律賓維薩亞斯群島中的島嶼。以錐形的巧克力山和小巧的眼鏡猴聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bohol ist eine Insel in den Visayas der Philippinen. Sie ist für die kegelförmigen Chocolate Hills und den winzigen Koboldmaki bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bohol est une île des Visayas, aux Philippines. Elle est connue pour les Chocolate Hills en forme de cône et le minuscule tarsier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bohol è un'isola delle Visayas, nelle Filippine. È nota per le Chocolate Hills a forma di cono e per il minuscolo tarsio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bohol es una isla de las Visayas, en Filipinas. Es conocida por las Colinas de Chocolate de forma cónica y el diminuto tarsero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bohol é uma ilha nas Visayas, nas Filipinas. É conhecida pelas Colinas de Chocolate em forma de cone e pelo minúsculo társio."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bohol là một hòn đảo ở vùng Visayas của Philippines. Nổi tiếng với Chocolate Hills hình nón và loài khỉ tarsier nhỏ xíu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bohol adalah pulau di Visayas, Filipina. Dikenal dengan Chocolate Hills berbentuk kerucut dan tarsius yang mungil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โบโฮลเป็นเกาะในภูมิภาควิซายัสของฟิลิปปินส์ มีชื่อเสียงเรื่องเนินช็อกโกแลตรูปกรวยและตัวทาร์เซียร์ตัวเล็ก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोहोल फ़िलीपींस के विसायास का द्वीप है। यह शंकु आकार की चॉकलेट हिल्स और नन्हे टार्सियर के लिए जाना जाता है।"
          }
        }
      }
    },
