    "|London is the capital of the United Kingdom, on the River Thames. The Palace of Westminster with Big Ben, Tower Bridge and the British Museum are major sights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロンドンはイギリスの首都で、テムズ川沿いにあります。ビッグ・ベンのあるウェストミンスター宮殿、タワーブリッジ、大英博物館が主な名所です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伦敦是英国的首都，位于泰晤士河畔。带有大本钟的威斯敏斯特宫、塔桥和大英博物馆是主要景点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "倫敦是英國的首都,位於泰晤士河畔。附大笨鐘的西敏宮、倫敦塔橋與大英博物館是主要景點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "London ist die Hauptstadt des Vereinigten Königreichs an der Themse. Der Palace of Westminster mit Big Ben, die Tower Bridge und das British Museum sind wichtige Sehenswürdigkeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Londres est la capitale du Royaume-Uni, sur la Tamise. Le palais de Westminster avec Big Ben, Tower Bridge et le British Museum en sont les principaux sites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Londra è la capitale del Regno Unito, sul Tamigi. Il Palazzo di Westminster con il Big Ben, il Tower Bridge e il British Museum sono le attrazioni principali."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Londres es la capital del Reino Unido, a orillas del río Támesis. El Palacio de Westminster con el Big Ben, el Tower Bridge y el Museo Británico son sus principales atractivos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Londres é a capital do Reino Unido, às margens do rio Tâmisa. O Palácio de Westminster com o Big Ben, a Tower Bridge e o Museu Britânico são grandes atrações."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "London là thủ đô của Vương quốc Anh, bên sông Thames. Cung điện Westminster với Big Ben, cầu Tower Bridge và Bảo tàng Anh là những điểm tham quan chính."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "London adalah ibu kota Britania Raya, di Sungai Thames. Istana Westminster dengan Big Ben, Tower Bridge, dan British Museum adalah tempat utama."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลอนดอนเป็นเมืองหลวงของสหราชอาณาจักร ตั้งอยู่ริมแม่น้ำเทมส์ พระราชวังเวสต์มินสเตอร์พร้อมหอนาฬิกา Big Ben สะพานทาวเวอร์ และพิพิธภัณฑ์บริติชเป็นสถานที่สำคัญ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लंदन यूनाइटेड किंगडम की राजधानी है, जो टेम्स नदी पर है। बिग बेन के साथ पैलेस ऑफ़ वेस्टमिंस्टर, टावर ब्रिज और ब्रिटिश म्यूज़ियम प्रमुख दर्शनीय स्थल हैं।"
          }
        }
      }
    },
