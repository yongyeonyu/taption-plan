        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem trong ngày trên thanh thời gian bên phải và các ngày trước trong lịch."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat hari ini di bilah waktu kanan dan hari lalu di kalender."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูวันนั้นได้ที่แถบเวลาด้านขวา และดูวันที่ผ่านมาในปฏิทิน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिन को दाईं ओर के टाइम बार में और बीते दिनों को कैलेंडर में देखें।"
          }
        }
      }
    },
    "오른쪽 위 날짜 아래 화살표로 펼치고, 막대 맨 위 화살표로 접습니다.|Use the arrow under the date to show it and the arrow on top to hide it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付の下の矢印で開き、バー上部の矢印で閉じます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用日期下方的箭头展开，用时间条顶部的箭头收起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用日期下方的箭頭展開，用時間軸頂部的箭頭收合。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeige sie mit dem Pfeil unter dem Datum an und blende sie mit dem Pfeil oben aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez la flèche sous la date pour l’afficher et celle du haut pour la masquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la freccia sotto la data per mostrarla e quella in alto per nasconderla."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la flecha bajo la fecha para mostrarla y la de arriba para ocultarla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a seta abaixo da data para mostrar e a seta no topo para ocultar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng mũi tên dưới ngày để hiện và mũi tên ở trên cùng để ẩn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan panah di bawah tanggal untuk menampilkan dan panah di atas untuk menyembunyikan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ลูกศรใต้วันที่เพื่อแสดง และลูกศรด้านบนเพื่อซ่อน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिखाने के लिए तारीख़ के नीचे के तीर का और छिपाने के लिए ऊपर के तीर का उपयोग करें।"
          }
        }
      }
    },
    "오른쪽 위 날짜를 누르면 날짜 줄이 펼쳐집니다. 밀어서 날을 옮깁니다.|Tap the date at the top right to open the date strip, then swipe." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上の日付をタップすると日付バーが開きます。スワイプで日を移動します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
