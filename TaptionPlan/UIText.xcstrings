          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Karte gedrückt und wähle „Standort-Memo hinzufügen“, um es dort anzuheften."
          }
        },
        "fr" : {
          "stringUnit" : {
