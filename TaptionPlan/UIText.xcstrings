    "|Wuhan is a large central Chinese city where the Yangtze and Han rivers meet. Yellow Crane Tower and East Lake are among its well-known sights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "武漢は長江と漢水が合流する中国中部の大都市です。黄鶴楼と東湖が有名な名所です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "武汉是长江与汉水交汇处的中国中部大城市。黄鹤楼和东湖是其著名景点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "武漢是長江與漢水交會處的中國中部大城市。黃鶴樓與東湖是其知名景點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuhan ist eine große zentralchinesische Stadt, in der sich Jangtse und Han treffen. Der Gelbe Kranichturm und der Ostsee gehören zu ihren bekannten Sehenswürdigkeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuhan est une grande ville du centre de la Chine où se rejoignent le Yangtsé et la rivière Han. La tour de la Grue jaune et le lac de l'Est comptent parmi ses sites bien connus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuhan è una grande città della Cina centrale dove si incontrano i fiumi Yangtze e Han. La Torre della Gru Gialla e il Lago Orientale sono tra le sue attrazioni più note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuhan es una gran ciudad del centro de China donde se encuentran los ríos Yangtsé y Han. La Torre de la Grulla Amarilla y el Lago del Este están entre sus lugares conocidos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuhan é uma grande cidade do centro da China onde se encontram os rios Yangtzé e Han. A Torre da Garça Amarela e o Lago Leste estão entre suas atrações conhecidas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vũ Hán là thành phố lớn ở miền trung Trung Quốc, nơi sông Trường Giang và sông Hán gặp nhau. Hoàng Hạc Lâu và Đông Hồ nằm trong số những điểm tham quan nổi tiếng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuhan adalah kota besar di Tiongkok tengah tempat Sungai Yangtze dan Han bertemu. Menara Burung Bangau Kuning dan Danau Timur termasuk tempat yang terkenal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อู่ฮั่นเป็นเมืองใหญ่ทางภาคกลางของจีนที่แม่น้ำแยงซีและแม่น้ำฮั่นมาบรรจบกัน หอกระเรียนเหลืองและทะเลสาบตะวันออกเป็นสถานที่ที่รู้จักดี"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वुहान मध्य चीन का बड़ा शहर है, जहाँ यांगत्ज़ी और हान नदियाँ मिलती हैं। येलो क्रेन टॉवर और ईस्ट लेक इसके प्रसिद्ध दर्शनीय स्थलों में हैं।"
          }
        }
      }
    },
