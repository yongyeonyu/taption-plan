        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o arquivo de backup existente, então ele não foi sobrescrito."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc tệp sao lưu hiện có nên không ghi đè."
