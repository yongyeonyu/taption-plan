    "|Fine-grained actions told apart by wrist movement, such as stairs, elevators, brushing teeth and typing. The iPhone alone distinguishes still, walking, running, cycling and driving." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "階段、エレベーター、歯みがき、タイピングなど、手首の動きで見分ける細かなアクション。iPhoneだけでは、静止、歩行、ランニング、サイクリング、運転を判別します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过手腕动作区分的精细动作，例如上下楼梯、乘电梯、刷牙和打字。仅凭 iPhone 只能区分静止、步行、跑步、骑行和驾车。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依手腕動作區分的細部動作，例如爬樓梯、搭電梯、刷牙和打字。單靠 iPhone 只能區分靜止、步行、跑步、騎自行車和開車。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feine Aktionen, die an der Handgelenksbewegung erkannt werden, etwa Treppensteigen, Aufzug, Zähneputzen und Tippen. Das iPhone allein unterscheidet Stillstehen, Gehen, Laufen, Radfahren und Autofahren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actions fines distinguées par le mouvement du poignet, comme les escaliers, l'ascenseur, le brossage des dents et la frappe. L'iPhone seul distingue immobile, marche, course, vélo et conduite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azioni specifiche riconosciute dal movimento del polso, come scale, ascensori, lavarsi i denti e digitare. Il solo iPhone distingue fermo, camminata, corsa, ciclismo e guida."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acciones detalladas distinguidas por el movimiento de la muñeca, como escaleras, ascensor, cepillarse los dientes y escribir. El iPhone por sí solo distingue quieto, caminar, correr, ir en bici y conducir."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ações detalhadas distinguidas pelo movimento do pulso, como escadas, elevadores, escovar os dentes e digitar. O iPhone sozinho distingue parado, caminhando, correndo, pedalando e dirigindo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các hành động chi tiết được phân biệt qua chuyển động cổ tay, như leo cầu thang, đi thang máy, đánh răng và gõ phím. Riêng iPhone chỉ phân biệt được đứng yên, đi bộ, chạy, đạp xe và lái xe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksi terperinci yang dibedakan lewat gerakan pergelangan tangan, seperti tangga, lift, sikat gigi, dan mengetik. iPhone saja membedakan diam, jalan, lari, bersepeda, dan mengemudi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกระทำย่อยที่แยกได้จากการเคลื่อนไหวของข้อมือ เช่น ขึ้นลงบันได ลิฟต์ แปรงฟัน และพิมพ์ดีด ส่วน iPhone เพียงเครื่องเดียวแยกได้เพียงอยู่นิ่ง เดิน วิ่ง ปั่นจักรยาน และขับรถ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कलाई की गति से पहचानी गई बारीक गतिविधियाँ, जैसे सीढ़ियाँ, लिफ़्ट, दाँत ब्रश करना और टाइपिंग। अकेला iPhone सिर्फ़ ठहरना, चलना, दौड़ना, साइकिल चलाना और ड्राइविंग अलग पहचानता है।"
          }
        }
      }
    },
    "|Fixed calendar events cannot be moved here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定のカレンダーイベントはここでは移動できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在此处移动固定的日历事件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法在這裡移動固定的行事曆事件。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feste Kalendertermine können hier nicht verschoben werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements fixes du calendrier ne peuvent pas être déplacés ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli eventi fissi del calendario non possono essere spostati qui."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos fijos del calendario no se pueden mover aquí."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventos fixos do calendário não podem ser movidos aqui."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể di chuyển các sự kiện lịch cố định tại đây."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acara kalender tetap tidak dapat dipindahkan di sini."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้ายกิจกรรมปฏิทินที่กำหนดไว้ที่นี่ไม่ได้"
