          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu deiner eingestellten Zeit (standardmäßig 8:00) kannst du die Karte von gestern öffnen, um sie zu speichern oder zu teilen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À l'heure choisie (8 h par défaut), ouvrez la carte d'hier pour l'enregistrer ou la partager."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
