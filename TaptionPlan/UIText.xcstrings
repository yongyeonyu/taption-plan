    "|Repeating segments and events cannot be used as link targets." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繰り返しのセグメントやイベントは、リンク先として使用できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重复的时段和事件不能用作关联目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重複的區段和事件不能用作連結目標。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederkehrende Abschnitte und Termine können nicht als Verknüpfungsziel dienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les segments et événements répétés ne peuvent pas servir de cibles de lien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I segmenti e gli eventi ripetuti non possono essere usati come destinazioni di collegamento."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los segmentos y eventos repetidos no se pueden usar como destinos de vínculo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segmentos repetidos e eventos não podem ser usados como destino de vínculo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đoạn lặp và sự kiện không thể dùng làm mục tiêu liên kết."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segmen dan acara berulang tidak dapat dipakai sebagai target tautan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ช่วงเวลาและกิจกรรมที่ซ้ำเป็นเป้าหมายการเชื่อมโยงไม่ได้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोहराए जाने वाले खंड और इवेंट लिंक लक्ष्य नहीं बन सकते।"
          }
        }
      }
    },
    "|Repeating segments and routines cannot be linked as action items." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繰り返しのセグメントやルーティンは、アクション項目としてリンクできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重复的时段和流程不能作为行动项关联。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重複的區段和例行事項不能連結為行動項目。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederkehrende Abschnitte und Routinen können nicht als Aufgaben verknüpft werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les segments et routines répétés ne peuvent pas être liés comme actions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I segmenti e le routine ripetuti non possono essere collegati come azioni."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los segmentos y rutinas repetidos no se pueden vincular como tareas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segmentos repetidos e rotinas não podem ser vinculados como itens de ação."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đoạn lặp và thói quen không thể liên kết làm mục hành động."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segmen dan rutinitas berulang tidak dapat dihubungkan sebagai item aksi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมโยงช่วงเวลาและกิจวัตรที่ซ้ำเป็นรายการปฏิบัติไม่ได้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोहराए जाने वाले खंड और रूटीन एक्शन आइटम के रूप में लिंक नहीं हो सकते।"
          }
        }
      }
    },
