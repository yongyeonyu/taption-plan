          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini CLI: nhấn Kết nối để sao chép cấu hình cho settings.json. Dán vào ~/.gemini/settings.json rồi khởi động lại gemini."
          }
        },
