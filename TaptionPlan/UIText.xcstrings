    "|Vancouver is a port city in British Columbia on Canada’s west coast. Mountains and sea lie close together, and Stanley Park and Gastown are popular spots." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バンクーバーはカナダ西海岸、ブリティッシュコロンビア州の港湾都市です。山と海が近く、スタンレーパークとギャスタウンが人気です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温哥华是加拿大西岸不列颠哥伦比亚省的港口城市。山与海近在咫尺，斯坦利公园和煤气镇是热门去处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "溫哥華是加拿大西岸不列顛哥倫比亞省的港口城市。山與海相距很近,史丹利公園與煤氣鎮是熱門地點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vancouver ist eine Hafenstadt in British Columbia an Kanadas Westküste. Berge und Meer liegen nah beieinander, und der Stanley Park und Gastown sind beliebte Orte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vancouver est une ville portuaire de Colombie-Britannique, sur la côte ouest du Canada. Montagnes et mer sont proches l'une de l'autre, et Stanley Park et Gastown sont des lieux prisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vancouver è una città portuale della Columbia Britannica, sulla costa occidentale del Canada. Montagne e mare sono vicini e Stanley Park e Gastown sono luoghi popolari."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vancouver es una ciudad portuaria de Columbia Británica, en la costa oeste de Canadá. Las montañas y el mar están muy próximos, y Stanley Park y Gastown son lugares populares."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vancouver é uma cidade portuária na Colúmbia Britânica, na costa oeste do Canadá. Montanhas e mar ficam próximos, e o Stanley Park e Gastown são lugares populares."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vancouver là thành phố cảng ở British Columbia, bờ tây Canada. Núi và biển nằm gần nhau, và Stanley Park cùng Gastown là những nơi được ưa chuộng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vancouver adalah kota pelabuhan di British Columbia di pesisir barat Kanada. Gunung dan laut berdekatan, dan Stanley Park serta Gastown adalah tempat populer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แวนคูเวอร์เป็นเมืองท่าในบริติชโคลัมเบียบนชายฝั่งตะวันตกของแคนาดา ภูเขาและทะเลอยู่ใกล้กัน และ Stanley Park กับ Gastown เป็นจุดยอดนิยม"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वैंकूवर कनाडा के पश्चिमी तट पर ब्रिटिश कोलंबिया का बंदरगाह शहर है। पहाड़ और समुद्र पास-पास हैं, और स्टैनली पार्क तथा गैस्टाउन लोकप्रिय जगहें हैं।"
          }
        }
      }
    },
