      }
    },
    "기존 백업({0}행)보다 이 기기의 행({1})이 적어 기존 백업을 지켰습니다.|This device has fewer rows ({0}) than the existing backup ({1}), so the backup was kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの行数({0})が既存のバックアップ({1})より少ないため、バックアップをそのまま残しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备的行数（{0}）少于已有备份（{1}），因此保留了备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這部裝置的列數（{0}）少於現有備份（{1}），因此保留了該備份。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat weniger Zeilen ({0}) als das vorhandene Backup ({1}), daher blieb das Backup erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil a moins de lignes ({0}) que la sauvegarde existante ({1}) ; la sauvegarde a donc été conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo ha meno righe ({0}) del backup esistente ({1}), quindi il backup è stato mantenuto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tiene menos filas ({0}) que la copia existente ({1}), así que se conservó la copia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tem menos linhas ({0}) que o backup existente ({1}), então o backup foi mantido."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị này có ít hàng hơn ({0}) so với bản sao lưu hiện có ({1}) nên bản sao lưu được giữ nguyên."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini memiliki lebih sedikit baris ({0}) daripada cadangan yang ada ({1}), jadi cadangan dipertahankan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อุปกรณ์นี้มีจำนวนแถว ({0}) น้อยกว่าข้อมูลสำรองที่มีอยู่ ({1}) จึงเก็บข้อมูลสำรองไว้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर मौजूदा बैकअप ({1}) से कम पंक्तियाँ ({0}) हैं, इसलिए बैकअप बना रहने दिया गया।"
          }
        }
      }
    },
    "기존 백업을 만들 때 쓴 비밀번호와 달라 올리지 않았습니다. 비밀번호를 다시 확인해 주세요.|This password differs from the one used for the existing backup, so nothing was uploaded. Check your password." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパスワードは既存のバックアップに使われたものと異なるため、何もアップロードされませんでした。パスワードを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此密码与已有备份使用的密码不同，因此未上传任何内容。请检查你的密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此密碼與現有備份使用的密碼不同，因此未上傳任何內容。請檢查你的密碼。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Passwort weicht von dem des vorhandenen Backups ab, daher wurde nichts hochgeladen. Prüfe dein Passwort."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mot de passe diffère de celui de la sauvegarde existante ; rien n'a été envoyé. Vérifiez votre mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa password è diversa da quella usata per il backup esistente, quindi non è stato caricato nulla. Controlla la password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
