    "걷기·이동·운동·수면을 더 정확히 구분합니다.|Tells walking, travel, workouts, and sleep apart more accurately." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩行・移動・ワークアウト・睡眠をより正確に区別します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更准确地区分步行、移动、体能训练和睡眠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更準確地區分步行、移動、體能訓練和睡眠。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterscheidet Gehen, Fortbewegung, Workouts und Schlaf genauer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue plus précisément la marche, les déplacements, les séances et le sommeil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue con più precisione camminata, spostamenti, allenamenti e sonno."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue con más precisión caminar, desplazarte, entrenar y dormir."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue com mais precisão caminhada, deslocamento, treino e sono."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phân biệt chính xác hơn việc đi bộ, di chuyển, tập luyện và ngủ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
