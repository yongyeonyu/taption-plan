          }
        }
      }
    },
    "|Phu Quoc is Vietnam’s largest island, in the Gulf of Thailand off the southwest coast. It is known for white-sand beaches, resorts, pepper farms and fish sauce." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フーコック島はベトナム最大の島で、南西海岸沖のタイ湾にあります。白砂のビーチ、リゾート、胡椒農園、魚醤で知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "富国岛是越南最大的岛屿，位于西南海岸外的泰国湾。以白沙滩、度假村、胡椒园和鱼露闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "富國島是越南最大的島嶼,位於西南海岸外的泰國灣。以白沙灘、度假村、胡椒園與魚露聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phu Quoc ist Vietnams größte Insel im Golf von Thailand vor der Südwestküste. Sie ist für Strände mit weißem Sand, Resorts, Pfefferfarmen und Fischsauce bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phú Quốc est la plus grande île du Vietnam, dans le golfe de Thaïlande, au large de la côte sud-ouest. Elle est connue pour ses plages de sable blanc, ses complexes hôteliers, ses plantations de poivre et son nuoc-mâm."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phu Quoc è la più grande isola del Vietnam, nel Golfo di Thailandia al largo della costa sud-occidentale. È nota per le spiagge di sabbia bianca, i resort, le piantagioni di pepe e la salsa di pesce."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phu Quoc es la mayor isla de Vietnam, en el golfo de Tailandia, frente a la costa suroeste. Es conocida por sus playas de arena blanca, complejos turísticos, plantaciones de pimienta y salsa de pescado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phu Quoc é a maior ilha do Vietnã, no Golfo da Tailândia, ao largo da costa sudoeste. É conhecida por praias de areia branca, resorts, plantações de pimenta e molho de peixe."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phú Quốc là hòn đảo lớn nhất Việt Nam, ở vịnh Thái Lan ngoài khơi bờ biển tây nam. Nổi tiếng với bãi biển cát trắng, khu nghỉ dưỡng, vườn tiêu và nước mắm."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phu Quoc adalah pulau terbesar Vietnam, di Teluk Thailand di lepas pantai barat daya. Dikenal dengan pantai pasir putih, resor, kebun lada, dan kecap ikan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟู้โกว๊กเป็นเกาะที่ใหญ่ที่สุดของเวียดนาม ในอ่าวไทยนอกชายฝั่งตะวันตกเฉียงใต้ มีชื่อเสียงเรื่องหาดทรายขาว รีสอร์ต ไร่พริกไทย และน้ำปลา"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फू क्वोक वियतनाम का सबसे बड़ा द्वीप है, जो दक्षिण-पश्चिमी तट के पास थाईलैंड की खाड़ी में है। यह सफ़ेद रेत के समुद्र तटों, रिसॉर्ट, काली मिर्च के खेतों और फ़िश सॉस के लिए जाना जाता है।"
          }
        }
      }
    },
    "|Phuket" : {
      "extractionState" : "manual",
      "localizations" : {
