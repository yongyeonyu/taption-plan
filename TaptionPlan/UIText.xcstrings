    "|Montreal is the largest city in Quebec, Canada, with a French-speaking culture. Old Montreal’s stone buildings and Notre-Dame Basilica are highlights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モントリオールはカナダ・ケベック州最大の都市で、フランス語圏の文化があります。旧市街の石造りの建物とノートルダム大聖堂が見どころです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蒙特利尔是加拿大魁北克省最大的城市，具有法语文化。老蒙特利尔的石砌建筑和圣母大教堂是其亮点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蒙特婁是加拿大魁北克最大的城市,具有說法語的文化。舊蒙特婁的石造建築與聖母大教堂是其亮點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montreal ist die größte Stadt in Québec, Kanada, mit französischsprachiger Kultur. Die Steingebäude der Altstadt und die Basilika Notre-Dame sind Höhepunkte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montréal est la plus grande ville du Québec, au Canada, de culture francophone. Les bâtiments de pierre du Vieux-Montréal et la basilique Notre-Dame en sont les points forts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montréal è la città più grande del Québec, in Canada, con una cultura di lingua francese. Gli edifici in pietra della Vecchia Montréal e la Basilica di Notre-Dame sono i punti forti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montreal es la mayor ciudad de Quebec, Canadá, con una cultura de habla francesa. Los edificios de piedra del Viejo Montreal y la Basílica de Notre-Dame son lo más destacado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montreal é a maior cidade de Quebec, no Canadá, com cultura de língua francesa. Os edifícios de pedra do Velho Montreal e a Basílica de Notre-Dame são os destaques."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montreal là thành phố lớn nhất ở Quebec, Canada, với nền văn hóa nói tiếng Pháp. Những tòa nhà đá của Old Montreal và Vương cung thánh đường Notre-Dame là điểm nổi bật."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montreal adalah kota terbesar di Quebec, Kanada, dengan budaya berbahasa Prancis. Bangunan batu Old Montreal dan Basilika Notre-Dame adalah sorotan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มอนทรีออลเป็นเมืองใหญ่ที่สุดในควิเบก ประเทศแคนาดา มีวัฒนธรรมพูดภาษาฝรั่งเศส อาคารหินของมอนทรีออลเก่าและมหาวิหาร Notre-Dame เป็นไฮไลต์"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मॉन्ट्रियल कनाडा के क्यूबेक का सबसे बड़ा शहर है, जहाँ फ़्रांसीसी-भाषी संस्कृति है। ओल्ड मॉन्ट्रियल की पत्थर की इमारतें और नोट्रे-डेम बेसिलिका मुख्य आकर्षण हैं।"
          }
        }
      }
    },
