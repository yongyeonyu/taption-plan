      }
    },
    "메뉴의 앱 비밀번호와 같아요. AI 서버에는 비밀번호 대신 따로 만든 값만 보내요.|Same as your app password in the menu. The AI server only gets a separate value, never the password." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューのアプリのパスワードと同じです。AIサーバーにはパスワードではなく別に作った値だけを送ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与菜单中的 App 密码相同。AI 服务器只会收到另外生成的值，不会收到密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與選單中的 App 密碼相同。AI 伺服器只會收到另外產生的值，不會收到密碼。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleich wie dein App-Passwort im Menü. Der KI-Server bekommt nur einen separaten Wert, nie das Passwort."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identique au mot de passe d’app du menu. Le serveur IA ne reçoit qu’une valeur distincte, jamais le mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uguale alla password dell’app nel menu. Il server IA riceve solo un valore separato, mai la password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es la misma que la contraseña de la app del menú. El servidor de IA solo recibe un valor aparte, nunca la contraseña."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É a mesma senha do app no menu. O servidor de IA recebe só um valor separado, nunca a senha."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giống mật khẩu ứng dụng trong menu. Máy chủ AI chỉ nhận một giá trị riêng, không bao giờ nhận mật khẩu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sama dengan kata sandi aplikasi di menu. Server AI hanya menerima nilai terpisah, bukan kata sandinya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหมือนรหัสผ่านแอปในเมนู เซิร์ฟเวอร์ AI จะได้รับเพียงค่าที่สร้างแยกไว้ ไม่ใช่รหัสผ่าน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह मेन्यू के ऐप पासवर्ड जैसा ही है। AI सर्वर को पासवर्ड नहीं, सिर्फ़ अलग से बना मान भेजा जाता है।"
          }
        }
      }
    },
