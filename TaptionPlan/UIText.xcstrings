    "|Nha Trang is a resort city on Vietnam’s south-central coast. Its long beach, island boat tours and mud baths attract visitors." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ニャチャンはベトナム中南部海岸のリゾート都市です。長いビーチ、島巡りのボートツアー、泥風呂が人気です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "芽庄是越南中南部海岸的度假城市。长长的海滩、出海岛屿游船和泥浆浴吸引游客。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "芽莊是越南中南部沿海的度假城市。長長的海灘、島嶼遊船與泥漿浴吸引遊客。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nha Trang ist eine Urlaubsstadt an der Küste Süd-Zentralvietnams. Der lange Strand, Inselbootstouren und Schlammbäder ziehen Besucher an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nha Trang est une station balnéaire sur la côte centre-sud du Vietnam. Sa longue plage, ses excursions en bateau vers les îles et ses bains de boue attirent les visiteurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nha Trang è una città di villeggiatura sulla costa centro-meridionale del Vietnam. La lunga spiaggia, i giri in barca alle isole e i bagni di fango attirano i visitatori."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nha Trang es una ciudad turística en la costa centro-sur de Vietnam. Su larga playa, las excursiones en barco a las islas y los baños de barro atraen a los visitantes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nha Trang é uma cidade de resorts na costa centro-sul do Vietnã. Sua longa praia, passeios de barco pelas ilhas e banhos de lama atraem visitantes."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nha Trang là thành phố nghỉ dưỡng ở bờ biển Nam Trung Bộ Việt Nam. Bãi biển dài, các tour đảo bằng thuyền và tắm bùn thu hút du khách."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nha Trang adalah kota resor di pesisir selatan-tengah Vietnam. Pantai panjang, tur perahu ke pulau, dan pemandian lumpur menarik pengunjung."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นาตรังเป็นเมืองรีสอร์ตบนชายฝั่งภาคกลางตอนใต้ของเวียดนาม ชายหาดยาว ทัวร์เรือไปเกาะ และอาบโคลนดึงดูดผู้มาเยือน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "न्हा ट्रांग वियतनाम के दक्षिण-मध्य तट पर रिसॉर्ट शहर है। इसका लंबा समुद्र तट, द्वीपों के नौका भ्रमण और मड बाथ आगंतुकों को आकर्षित करते हैं।"
          }
        }
      }
    },
