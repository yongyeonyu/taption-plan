        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hauptstadt Chinas, eine Stadt mit langer Geschichte. Die Verbotene Stadt, der Tiananmen-Platz und die Große Mauer sind die Hauptsehenswürdigkeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capitale de la Chine, une ville à la longue histoire. La Cité interdite, la place Tiananmen et la Grande Muraille en sont les principaux sites."
