          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thủ phủ của Nội Mông, Trung Quốc. Nổi tiếng với văn hóa thảo nguyên, ẩm thực Mông Cổ và các ngôi chùa Phật giáo Tây Tạng."
