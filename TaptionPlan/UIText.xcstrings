    "|Delhi is India’s capital region, split into Old Delhi and New Delhi. Sights include the Red Fort, Humayun’s Tomb and India Gate." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デリーはインドの首都圏で、オールドデリーとニューデリーに分かれています。レッド・フォート、フマーユーン廟、インド門が名所です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "德里是印度的首都地区，分为旧德里和新德里。景点包括红堡、胡马雍陵和印度门。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "德里是印度的首都地區,分為舊德里與新德里。景點包括紅堡、胡馬雍陵與印度門。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delhi ist Indiens Hauptstadtregion, aufgeteilt in Alt-Delhi und Neu-Delhi. Zu den Sehenswürdigkeiten zählen das Rote Fort, Humayuns Grabmal und das India Gate."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delhi est la région capitale de l'Inde, divisée en Vieux Delhi et New Delhi. On y visite le Fort Rouge, le tombeau d'Humayun et India Gate."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delhi è la regione capitale dell'India, divisa in Vecchia Delhi e Nuova Delhi. Tra le attrazioni ci sono il Forte Rosso, la Tomba di Humayun e India Gate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delhi es la región capital de la India, dividida en Vieja Delhi y Nueva Delhi. Entre sus atractivos están el Fuerte Rojo, la Tumba de Humayun y la Puerta de la India."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délhi é a região da capital da Índia, dividida entre a Velha Délhi e Nova Délhi. Entre as atrações estão o Forte Vermelho, o Túmulo de Humayun e o Portão da Índia."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delhi là vùng thủ đô của Ấn Độ, chia thành Old Delhi và New Delhi. Các điểm tham quan gồm Pháo đài Đỏ, Lăng Humayun và Cổng Ấn Độ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delhi adalah wilayah ibu kota India, terbagi menjadi Delhi Lama dan New Delhi. Tempat menarik termasuk Red Fort, Makam Humayun, dan India Gate."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เดลีเป็นเขตเมืองหลวงของอินเดีย แบ่งเป็นเดลีเก่าและนิวเดลี สถานที่น่าชมได้แก่ป้อมแดง สุสาน Humayun และ India Gate"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिल्ली भारत का राजधानी क्षेत्र है, जो पुरानी दिल्ली और नई दिल्ली में बँटा है। दर्शनीय स्थलों में लाल किला, हुमायूँ का मकबरा और इंडिया गेट शामिल हैं।"
          }
        }
      }
    },
