    "글이 길어 다듬지 못했어요. 1,500자 이하로 줄여 주세요.|This is too long to polish. Keep it under 1,500 characters." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長すぎて整えられません。1,500文字以内にしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内容过长，无法润色。请控制在1,500个字符以内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內容太長，無法潤飾。請控制在 1,500 個字元以內。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist zu lang zum Verfeinern. Bleib unter 1.500 Zeichen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce texte est trop long pour être amélioré. Gardez-le sous 1 500 caractères."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo è troppo lungo per essere rifinito. Mantienilo sotto i 1.500 caratteri."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es demasiado largo para pulirlo. Mantenlo por debajo de 1500 caracteres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto longo demais para aprimorar. Use no máximo 1.500 caracteres."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Văn bản quá dài để chỉnh câu. Hãy giữ dưới 1.500 ký tự."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu panjang untuk dipoles. Buat di bawah 1.500 karakter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความยาวเกินกว่าจะปรับได้ โปรดให้ไม่เกิน 1,500 ตัวอักษร"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सुधारने के लिए बहुत लंबा है। इसे 1,500 अक्षरों से कम रखें।"
          }
        }
      }
    },
    "글이 바뀌어 다듬기를 멈췄어요.|The text changed, so polishing stopped." : {
