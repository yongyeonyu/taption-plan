    "일정을 읽어 지도와 활동 판정에 씁니다. 일정은 기기에만 저장합니다.|Events are read for the map and activity detection and stay on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントは地図とアクティビティ検出のために読み取られ、このデバイスにとどまります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取事件仅用于地图和活动检测，并保留在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事件會用於地圖和活動偵測，並保留在這部裝置上。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine werden für Karte und Aktivitätserkennung gelesen und bleiben auf diesem Gerät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements sont lus pour la carte et la détection d'activité et restent sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli eventi vengono letti per la mappa e il rilevamento delle attività e restano su questo dispositivo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos se leen para el mapa y la detección de actividad, y se quedan en este dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os eventos são lidos para o mapa e a detecção de atividades e ficam neste dispositivo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự kiện được đọc cho bản đồ và nhận diện hoạt động, và chỉ nằm trên thiết bị này."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acara dibaca untuk peta dan deteksi aktivitas dan tetap berada di perangkat ini."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กิจกรรมถูกอ่านเพื่อใช้กับแผนที่และการตรวจจับกิจกรรม และอยู่ในเครื่องนี้เท่านั้น"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इवेंट नक्शे और गतिविधि पहचान के लिए पढ़े जाते हैं और इसी डिवाइस पर रहते हैं।"
          }
        }
      }
    },
    "일정을 하루 기록과 함께 봅니다. 읽기만 합니다.|See events with your day. Read only." : {
