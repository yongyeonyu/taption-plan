    "|One of Korea’s largest inland wetlands, in Changnyeong, South Gyeongsang, and a Ramsar site. It has water plants, migratory birds and birdwatching trails." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慶南昌寧にある、韓国最大級の内陸湿地でラムサール条約登録地です。水生植物、渡り鳥、バードウォッチングの道があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于庆南昌宁的韩国最大内陆湿地之一，也是拉姆萨尔湿地。有水生植物、候鸟和观鸟步道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於慶南昌寧、韓國最大的內陸濕地之一,也是拉姆薩爾濕地。有水生植物、候鳥與賞鳥步道。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eines der größten Binnenfeuchtgebiete Koreas in Changnyeong, Süd-Gyeongsang, und ein Ramsar-Gebiet. Es hat Wasserpflanzen, Zugvögel und Vogelbeobachtungswege."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'une des plus grandes zones humides intérieures de Corée, à Changnyeong, dans le Gyeongsang du Sud, classée site Ramsar. On y trouve des plantes aquatiques, des oiseaux migrateurs et des sentiers d'observation des oiseaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una delle più grandi zone umide interne della Corea, a Changnyeong, nel Gyeongsang del Sud, e sito Ramsar. Ha piante acquatiche, uccelli migratori e sentieri per l'osservazione degli uccelli."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno de los mayores humedales interiores de Corea, en Changnyeong, Gyeongsang del Sur, y sitio Ramsar. Tiene plantas acuáticas, aves migratorias y senderos para observar aves."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma das maiores áreas úmidas do interior da Coreia, em Changnyeong, Gyeongsang do Sul, e sítio Ramsar. Tem plantas aquáticas, aves migratórias e trilhas para observação de aves."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một trong những vùng đất ngập nước nội địa lớn nhất Hàn Quốc, ở Changnyeong, Nam Gyeongsang, và là khu Ramsar. Có thực vật thủy sinh, chim di cư và các lối đi ngắm chim."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salah satu lahan basah pedalaman terbesar di Korea, di Changnyeong, Gyeongsang Selatan, dan situs Ramsar. Memiliki tumbuhan air, burung migran, dan jalur pengamatan burung."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หนึ่งในพื้นที่ชุ่มน้ำในแผ่นดินที่ใหญ่ที่สุดของเกาหลี ใน Changnyeong คยองซังใต้ และเป็นแหล่งแรมซาร์ มีพืชน้ำ นกอพยพ และเส้นทางดูนก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दक्षिणी ग्योंगसांग के छांगन्योंग में कोरिया के सबसे बड़े अंतर्देशीय आर्द्रभूमियों में से एक और रामसर स्थल। यहाँ जलीय पौधे, प्रवासी पक्षी और पक्षी-दर्शन के रास्ते हैं।"
          }
        }
      }
    },
    "|One of Seoul’s old traditional markets, near Sungnyemun Gate. Clothing, goods and food shops fill its narrow lanes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "崇礼門の近くにあるソウルの古い伝統市場の一つ。細い路地に衣料品、雑貨、食べ物の店が並びます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首尔古老的传统市场之一，靠近崇礼门。狭窄的小巷里挤满了服装、杂货和美食店铺。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首爾古老的傳統市場之一,靠近崇禮門。服飾、雜貨與食品店舖布滿狹窄巷弄。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einer der alten traditionellen Märkte Seouls, nahe dem Sungnyemun-Tor. Kleidung, Waren und Essensläden füllen seine schmalen Gassen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'un des anciens marchés traditionnels de Séoul, près de la porte Sungnyemun. Boutiques de vêtements, d'articles divers et de nourriture emplissent ses ruelles étroites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno dei vecchi mercati tradizionali di Seul, vicino alla porta Sungnyemun. Negozi di abbigliamento, articoli vari e cibo riempiono i suoi stretti vicoli."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno de los antiguos mercados tradicionales de Seúl, cerca de la puerta Sungnyemun. Tiendas de ropa, artículos y comida llenan sus estrechos callejones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dos antigos mercados tradicionais de Seul, perto do Portão Sungnyemun. Lojas de roupas, utilidades e comida enchem suas vielas estreitas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một trong những khu chợ truyền thống cổ của Seoul, gần cổng Sungnyemun. Cửa hàng quần áo, đồ dùng và đồ ăn lấp đầy những con hẻm hẹp."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salah satu pasar tradisional tua Seoul, dekat Gerbang Sungnyemun. Toko pakaian, barang, dan makanan memenuhi gang-gangnya yang sempit."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หนึ่งในตลาดดั้งเดิมเก่าแก่ของโซล ใกล้ประตู Sungnyemun สินค้าเสื้อผ้า ของใช้ และร้านอาหารเต็มตรอกแคบ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सियोल के पुराने पारंपरिक बाज़ारों में से एक, जो सुंगनेमुन गेट के पास है। इसकी संकरी गलियों में कपड़ों, सामान और खाने की दुकानें भरी हैं।"
          }
        }
      }
    },
    "|One of the northernmost islands of the west sea in Ongjin County, Incheon, close to North Korea. Its sand dunes and Nongyeo Beach are known sights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仁川甕津郡の西海最北端の島の一つで、北朝鮮に近い場所です。砂丘とノンニョ海水浴場が名所として知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仁川瓮津郡西海最北端的岛屿之一，靠近朝鲜。沙丘和农女海滩是知名景点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仁川甕津郡西海最北端的島嶼之一,靠近北韓。沙丘與農女海灘是著名景點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine der nördlichsten Inseln des Westmeers im Landkreis Ongjin, Incheon, nahe Nordkorea. Ihre Sanddünen und der Strand Nongyeo sind bekannte Sehenswürdigkeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'une des îles les plus septentrionales de la mer de l'Ouest, dans le comté d'Ongjin, à Incheon, près de la Corée du Nord. Ses dunes de sable et la plage de Nongyeo en sont des sites connus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una delle isole più settentrionali del Mar Occidentale nella contea di Ongjin, a Incheon, vicino alla Corea del Nord. Le dune di sabbia e la spiaggia di Nongyeo sono luoghi noti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una de las islas más septentrionales del mar occidental, en el condado de Ongjin, Incheon, cerca de Corea del Norte. Sus dunas de arena y la playa de Nongyeo son atractivos conocidos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma das ilhas mais ao norte do mar do oeste, no condado de Ongjin, Incheon, perto da Coreia do Norte. Suas dunas de areia e a praia de Nongyeo são atrações conhecidas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một trong những hòn đảo cực bắc của biển phía tây ở huyện Ongjin, Incheon, gần Triều Tiên. Các đụn cát và bãi biển Nongyeo là những điểm nổi tiếng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salah satu pulau paling utara di laut barat di Ongjin County, Incheon, dekat dengan Korea Utara. Bukit pasir dan Pantai Nongyeo adalah tempat yang dikenal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หนึ่งในเกาะเหนือสุดของทะเลตะวันตกในอำเภอ Ongjin เมืองอินชอน ใกล้เกาหลีเหนือ เนินทรายและหาด Nongyeo เป็นที่รู้จัก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंचियोन की ओंगजिन काउंटी में पश्चिमी सागर के सबसे उत्तरी द्वीपों में से एक, जो उत्तर कोरिया के नज़दीक है। इसके रेत के टीले और नोंगयेओ समुद्र तट जाने-माने दर्शनीय स्थल हैं।"
          }
        }
      }
    },
    "|Onyang Hot Springs" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
