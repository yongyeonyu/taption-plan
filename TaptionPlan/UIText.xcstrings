          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะคลิปหรือลากขึ้นลงเพื่อเลือกหลายรายการพร้อมกัน เลือกหมวดหมู่เพื่อเปลี่ยนและรวมเป็นหนึ่งเดียว"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्लिप पर टैप करें या ऊपर-नीचे खींचकर एक साथ कई चुनें। श्रेणी चुनने पर सब बदलकर एक में जुड़ जाएँगी।"
          }
        }
      }
