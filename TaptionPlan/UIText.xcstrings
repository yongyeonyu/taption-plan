          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande parque temático em Yongin, Gyeonggi. Oferece brinquedos, um zoológico e festivais sazonais."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một công viên giải trí lớn ở Yongin, Gyeonggi. Nơi đây có trò chơi cảm giác, sở thú và các lễ hội theo mùa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taman hiburan besar di Yongin, Gyeonggi. Menawarkan wahana, kebun binatang, dan festival musiman."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวนสนุกขนาดใหญ่ในยงอิน จังหวัดคยองกี มีเครื่องเล่น สวนสัตว์ และเทศกาลตามฤดูกาล"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्योंगगी के योंगइन में बड़ा थीम पार्क। यहाँ झूले, एक चिड़ियाघर और मौसमी उत्सव हैं।"
          }
        }
      }
    },
    "|A large traditional market in Jegi-dong, Dongdaemun-gu, Seoul. Many stalls sell herbal medicine ingredients, dried seafood, vegetables and fruit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソウル・東大門区の祭基洞にある大きな伝統市場です。多くの店が薬材、干した海産物、野菜、果物を売っています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于首尔东大门区祭基洞的大型传统市场。众多摊位出售药材、干海产、蔬菜和水果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於首爾東大門區祭基洞的大型傳統市場。眾多攤位販售藥材、乾貨海產、蔬菜與水果。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein großer traditioneller Markt in Jegi-dong, Dongdaemun-gu, Seoul. Viele Stände verkaufen Zutaten für Kräutermedizin, getrocknete Meeresfrüchte, Gemüse und Obst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grand marché traditionnel à Jegi-dong, dans le Dongdaemun-gu de Séoul. De nombreux étals vendent des ingrédients de médecine à base de plantes, des fruits de mer séchés, des légumes et des fruits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande mercato tradizionale a Jegi-dong, Dongdaemun-gu, Seoul. Molte bancarelle vendono ingredienti per la medicina erboristica, pesce essiccato, verdura e frutta."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gran mercado tradicional en Jegi-dong, Dongdaemun-gu, Seúl. Muchos puestos venden ingredientes de medicina herbal, mariscos secos, verduras y frutas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande mercado tradicional em Jegi-dong, Dongdaemun-gu, Seul. Muitas barracas vendem ingredientes de medicina fitoterápica, frutos do mar secos, verduras e frutas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một khu chợ truyền thống lớn ở Jegi-dong, quận Dongdaemun, Seoul. Nhiều quầy bán nguyên liệu thuốc đông y, hải sản khô, rau và trái cây."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasar tradisional besar di Jegi-dong, Dongdaemun-gu, Seoul. Banyak kios menjual bahan obat herbal, seafood kering, sayuran, dan buah."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตลาดดั้งเดิมขนาดใหญ่ในเจกีดง เขตทงแดมุนกู กรุงโซล แผงจำนวนมากขายวัตถุดิบยาสมุนไพร อาหารทะเลแห้ง ผัก และผลไม้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सियोल के डोंगदेमुन-गु के जेगी-दोंग में बड़ा पारंपरिक बाज़ार। कई दुकानें जड़ी-बूटी की दवाओं की सामग्री, सूखी समुद्री खाद्य सामग्री, सब्ज़ियाँ और फल बेचती हैं।"
          }
        }
      }
    },
    "|A large traditional market in Jung-gu, Daegu. It has many fabric, clothing and food stalls, and a night market is held there." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大邱・中区にある大きな伝統市場です。布地、衣料、食べ物の店が多く、夜市も開かれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于大邱中区的大型传统市场。有许多布料、服装和美食摊位，还设有夜市。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於大邱中區的大型傳統市場。有許多布料、服飾與美食攤位，並設有夜市。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein großer traditioneller Markt in Jung-gu, Daegu. Er hat viele Stände für Stoffe, Kleidung und Essen, und es findet dort ein Nachtmarkt statt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grand marché traditionnel dans le Jung-gu de Daegu. Il compte de nombreux étals de tissus, de vêtements et de nourriture, et un marché de nuit s'y tient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande mercato tradizionale a Jung-gu, Daegu. Ha molte bancarelle di tessuti, abbigliamento e cibo e vi si tiene un mercato notturno."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gran mercado tradicional en Jung-gu, Daegu. Tiene muchos puestos de telas, ropa y comida, y allí se celebra un mercado nocturno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande mercado tradicional em Jung-gu, Daegu. Tem muitas barracas de tecidos, roupas e comida, e um mercado noturno é realizado ali."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một khu chợ truyền thống lớn ở quận Jung-gu, Daegu. Chợ có nhiều quầy vải, quần áo và đồ ăn, và có chợ đêm."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasar tradisional besar di Jung-gu, Daegu. Memiliki banyak kios kain, pakaian, dan makanan, dan pasar malam diadakan di sana."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตลาดดั้งเดิมขนาดใหญ่ในจุงกู แทกู มีแผงผ้า เสื้อผ้า และอาหารมากมาย และมีตลาดกลางคืน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दाएगू के जुंग-गु में बड़ा पारंपरिक बाज़ार। यहाँ कपड़े, वस्त्र और खाने की अनेक दुकानें हैं, और रात का बाज़ार भी लगता है।"
          }
        }
      }
    },
    "|A large urban park beside Seongsu-dong in Seongdong-gu. It has wide lawns, ponds and a deer enclosure, and lies close to the Han River." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城東区の聖水洞の隣にある大きな都市公園です。広い芝生、池、鹿の飼育場があり、漢江に近い場所にあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于城东区圣水洞旁的大型城市公园。有宽阔的草坪、池塘和鹿园，靠近汉江。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於城東區聖水洞旁的大型都市公園。有寬廣的草坪、池塘與鹿園，緊鄰漢江。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein großer Stadtpark neben Seongsu-dong in Seongdong-gu. Er hat weite Rasenflächen, Teiche und ein Hirschgehege und liegt nahe am Han-Fluss."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grand parc urbain à côté de Seongsu-dong, dans le Seongdong-gu. Il a de vastes pelouses, des étangs et un enclos à cerfs, et se trouve près du fleuve Han."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande parco urbano accanto a Seongsu-dong a Seongdong-gu. Ha ampi prati, stagni e un recinto di cervi e si trova vicino al fiume Han."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gran parque urbano junto a Seongsu-dong, en Seongdong-gu. Tiene amplios céspedes, estanques y un recinto de ciervos, y queda cerca del río Han."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande parque urbano ao lado de Seongsu-dong, em Seongdong-gu. Tem amplos gramados, lagoas e um recinto de veados, e fica perto do rio Han."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một công viên đô thị lớn cạnh Seongsu-dong ở quận Seongdong. Công viên có bãi cỏ rộng, ao và chuồng nuôi hươu, gần sông Hàn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taman kota besar di samping Seongsu-dong di Seongdong-gu. Memiliki padang rumput luas, kolam, dan kandang rusa, dan dekat dengan Sungai Han."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวนสาธารณะในเมืองขนาดใหญ่ข้างซองซูดงในเขตซองดงกู มีสนามหญ้ากว้าง สระน้ำ และคอกกวาง และอยู่ใกล้แม่น้ำฮัน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सोंगडोंग-गु में सोंगसू-दोंग के बगल में बड़ा शहरी पार्क। इसमें चौड़े लॉन, तालाब और हिरण बाड़ा है, और यह हान नदी के निकट है।"
          }
        }
      }
    },
    "|A large urban park in Busanjin-gu, Busan. It was converted from a former US military camp site and has lawns, trails and a pond." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "釜山・釜山鎮区にある大きな都市公園です。旧米軍キャンプ跡地を転用したもので、芝生、遊歩道、池があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于釜山釜山镇区的大型城市公园。由旧美军营地改建而成，有草坪、步道和池塘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於釜山釜山鎮區的大型都市公園。由舊美軍營區改建而成，有草坪、步道與池塘。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein großer Stadtpark in Busanjin-gu, Busan. Er wurde aus dem Gelände eines ehemaligen US-Militärlagers umgewandelt und hat Rasenflächen, Wege und einen Teich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grand parc urbain dans le Busanjin-gu de Busan. Il a été aménagé sur un ancien camp militaire américain et compte des pelouses, des sentiers et un étang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande parco urbano a Busanjin-gu, Busan. È stato ricavato da un ex sito di un campo militare statunitense e ha prati, sentieri e uno stagno."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gran parque urbano en Busanjin-gu, Busan. Fue convertido a partir de un antiguo campamento militar estadounidense y tiene céspedes, senderos y un estanque."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande parque urbano em Busanjin-gu, Busan. Foi convertido de um antigo campo militar dos EUA e tem gramados, trilhas e uma lagoa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một công viên đô thị lớn ở quận Busanjin, Busan. Công viên được chuyển đổi từ khu trại quân đội Mỹ cũ, có bãi cỏ, lối đi bộ và ao."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taman kota besar di Busanjin-gu, Busan. Diubah dari bekas lokasi kamp militer AS dan memiliki padang rumput, jalur, dan kolam."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวนสาธารณะในเมืองขนาดใหญ่ในเขตบูซันจินกู ปูซาน ดัดแปลงจากที่ตั้งค่ายทหารสหรัฐฯ เดิม มีสนามหญ้า เส้นทางเดิน และสระน้ำ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बुसान के बुसानजिन-गु में बड़ा शहरी पार्क। इसे अमेरिकी सेना के पूर्व शिविर स्थल से बदला गया है, और इसमें लॉन, पथ और तालाब हैं।"
          }
        }
      }
    },
    "|A lava tube in Gujwa, Jeju, part of a UNESCO World Heritage Site. It is known as a large lava cave, and only a section is open to visitors." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "済州・旧左にある溶岩洞窟で、ユネスコ世界遺産の一部です。大きな溶岩洞として知られ、一部だけが見学者に公開されています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于济州旧左的熔岩洞，属于联合国教科文组织世界遗产。以大型熔岩洞闻名，仅部分区段向游客开放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於濟州舊左的熔岩洞窟，是聯合國教科文組織世界遺產的一部分。以大型熔岩洞聞名，僅部分區段開放參觀。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Lavaröhre in Gujwa, Jeju, Teil einer UNESCO-Welterbestätte. Sie ist als große Lavahöhle bekannt, und nur ein Abschnitt ist für Besucher geöffnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tube de lave à Gujwa, Jeju, faisant partie d'un site du patrimoine mondial de l'UNESCO. Il est connu comme une grande grotte de lave, et seule une section est ouverte aux visiteurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnel di lava a Gujwa, Jeju, parte di un sito patrimonio mondiale dell’UNESCO. È noto come una grande grotta lavica e solo una parte è aperta ai visitatori."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tubo de lava en Gujwa, Jeju, parte de un sitio Patrimonio de la Humanidad de la UNESCO. Es conocido como una gran cueva de lava, y solo una sección está abierta a los visitantes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tubo de lava em Gujwa, Jeju, parte de um Patrimônio Mundial da UNESCO. É conhecido como uma grande caverna de lava, e apenas um trecho é aberto aos visitantes."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một hang dung nham ở Gujwa, Jeju, thuộc Di sản Thế giới UNESCO. Đây được biết đến là hang dung nham lớn, và chỉ một đoạn được mở cho du khách."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabung lava di Gujwa, Jeju, bagian dari Situs Warisan Dunia UNESCO. Dikenal sebagai gua lava besar, dan hanya sebagian yang dibuka untuk pengunjung."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ท่อลาวาในกูจวา เชจู เป็นส่วนหนึ่งของแหล่งมรดกโลกขององค์การยูเนสโก เป็นที่รู้จักว่าเป็นถ้ำลาวาขนาดใหญ่ และเปิดให้เข้าชมเพียงบางส่วน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जेजू के गुजवा में लावा ट्यूब, जो यूनेस्को विश्व धरोहर स्थल का हिस्सा है। यह बड़ी लावा गुफा के रूप में जानी जाती है, और केवल एक हिस्सा पर्यटकों के लिए खुला है।"
          }
        }
      }
    },
    "|A leading performing arts venue near Gwanghwamun Square in Seoul. Its grand theater stages concerts, dance and plays." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソウルの光化門広場の近くにある代表的な舞台芸術の会場です。大劇場でコンサート、舞踊、演劇が上演されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首尔光化门广场附近的主要表演艺术场馆。大剧场上演音乐会、舞蹈和戏剧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於首爾光化門廣場附近的主要表演藝術場館。大劇場上演音樂會、舞蹈與戲劇。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine führende Spielstätte der darstellenden Künste nahe dem Gwanghwamun-Platz in Seoul. Ihr großes Theater zeigt Konzerte, Tanz und Schauspiel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haut lieu des arts de la scène près de la place Gwanghwamun à Séoul. Son grand théâtre accueille concerts, danse et pièces de théâtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importante sede di arti dello spettacolo vicino a piazza Gwanghwamun a Seoul. Il suo grande teatro ospita concerti, danza e prosa."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importante recinto de artes escénicas cerca de la plaza Gwanghwamun en Seúl. Su gran teatro presenta conciertos, danza y obras de teatro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importante casa de artes cênicas perto da Praça Gwanghwamun, em Seul. Seu grande teatro apresenta concertos, dança e peças."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một địa điểm biểu diễn nghệ thuật hàng đầu gần Quảng trường Gwanghwamun ở Seoul. Nhà hát lớn của nơi đây dàn dựng hòa nhạc, múa và kịch."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempat seni pertunjukan terkemuka dekat Alun-alun Gwanghwamun di Seoul. Teater besarnya menggelar konser, tari, dan drama."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สถานที่แสดงศิลปะการแสดงชั้นนำใกล้จัตุรัสควังฮวามุนในกรุงโซล โรงละครใหญ่จัดคอนเสิร์ต การเต้นรำ และละคร"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सियोल के ग्वांगह्वामुन चौक के पास प्रमुख प्रदर्शन कला स्थल। इसका भव्य थिएटर संगीत कार्यक्रम, नृत्य और नाटक प्रस्तुत करता है।"
          }
        }
      }
    },
    "|A limestone cave in Danyang, North Chungcheong, designated a natural monument. It has well-developed stalactites and stalagmites along a maintained walkway." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忠清北道・丹陽にある石灰洞窟で、天然記念物に指定されています。鍾乳石と石筍がよく発達し、整備された通路があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于忠清北道丹阳的石灰岩洞穴，被指定为天然纪念物。钟乳石和石笋发育良好，有维护完善的步道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於忠清北道丹陽的石灰岩洞窟，被指定為天然紀念物。沿著整建的步道可見發達的鐘乳石與石筍。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kalksteinhöhle in Danyang, Nord-Chungcheong, als Naturdenkmal ausgewiesen. Sie hat gut ausgebildete Stalaktiten und Stalagmiten entlang eines gepflegten Wegs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grotte calcaire à Danyang (Chungcheong du Nord), classée monument naturel. Elle possède des stalactites et des stalagmites bien développées le long d'une passerelle aménagée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grotta calcarea a Danyang, nel Chungcheong settentrionale, designata monumento naturale. Ha stalattiti e stalagmiti ben sviluppate lungo un percorso attrezzato."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueva de piedra caliza en Danyang, Chungcheong del Norte, designada monumento natural. Tiene estalactitas y estalagmitas bien desarrolladas a lo largo de un paseo acondicionado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caverna calcária em Danyang, Chungcheong do Norte, designada monumento natural. Tem estalactites e estalagmites bem desenvolvidas ao longo de uma passarela conservada."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một hang đá vôi ở Danyang, Bắc Chungcheong, được công nhận là thiên nhiên di tích. Hang có nhũ đá và măng đá phát triển tốt dọc lối đi được duy trì."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gua batu kapur di Danyang, Chungcheong Utara, yang ditetapkan sebagai monumen alam. Stalaktit dan stalagmitnya berkembang baik di sepanjang jalur yang terawat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้ำหินปูนในทันยัง จังหวัดชุงชองเหนือ ได้รับการกำหนดเป็นอนุสรณ์ธรรมชาติ มีหินย้อยและหินงอกที่พัฒนาดีตามทางเดินที่ดูแลไว้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उत्तर चुंगचोंग के दानयांग में चूना-पत्थर की गुफा, जिसे प्राकृतिक स्मारक घोषित किया गया है। रखरखाव वाले पथ के साथ इसमें विकसित स्टैलेक्टाइट और स्टैलेग्माइट हैं।"
          }
        }
      }
    },
    "|A limestone cave in the Daei-ri cave area of Samcheok, designated as a natural monument. Its large chambers hold stalactites and an underground waterfall." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三陟の大耳里洞窟地域にある石灰洞窟で、天然記念物に指定されています。大きな空間に鍾乳石と地下の滝があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于三陟大耳里洞窟地区的石灰岩洞穴，被指定为天然纪念物。宽大的洞厅中有钟乳石和地下瀑布。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於三陟大耳里洞窟區的石灰岩洞窟，被指定為天然紀念物。大型洞室內有鐘乳石與地下瀑布。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kalksteinhöhle im Höhlengebiet Daei-ri in Samcheok, als Naturdenkmal ausgewiesen. Ihre großen Kammern bergen Stalaktiten und einen unterirdischen Wasserfall."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grotte calcaire dans la zone des grottes de Daei-ri à Samcheok, classée monument naturel. Ses grandes salles abritent des stalactites et une cascade souterraine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grotta calcarea nell’area delle grotte di Daei-ri a Samcheok, designata monumento naturale. Le sue grandi sale contengono stalattiti e una cascata sotterranea."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueva de piedra caliza en la zona de cuevas de Daei-ri, en Samcheok, designada monumento natural. Sus grandes cámaras albergan estalactitas y una cascada subterránea."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caverna calcária na área de cavernas de Daei-ri, em Samcheok, designada monumento natural. Suas grandes câmaras abrigam estalactites e uma cachoeira subterrânea."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một hang đá vôi trong khu hang Daei-ri ở Samcheok, được công nhận là thiên nhiên di tích. Các hang lớn có nhũ đá và một thác nước ngầm."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gua batu kapur di kawasan gua Daei-ri di Samcheok, ditetapkan sebagai monumen alam. Ruang-ruang besarnya berisi stalaktit dan air terjun bawah tanah."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้ำหินปูนในพื้นที่ถ้ำแทอีรีของซัมช็อก ได้รับการกำหนดเป็นอนุสรณ์ธรรมชาติ ห้องโถงใหญ่มีหินย้อยและน้ำตกใต้ดิน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामचेओक के डेई-री गुफा क्षेत्र में चूना-पत्थर की गुफा, जिसे प्राकृतिक स्मारक घोषित किया गया है। इसके बड़े कक्षों में स्टैलेक्टाइट और एक भूमिगत झरना है।"
          }
        }
      }
    },
    "|A linear park on the former Gyeongui railway line through Mapo and Yongsan. Walkers can stroll between Yeonnam-dong and Gongdeok past cafes and restaurants." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧京義線の跡地を利用した麻浦と龍山を通る線状の公園です。連南洞から孔徳まで、カフェや飲食店の前を散策できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿旧京义线铁路修建的线性公园，穿过麻浦和龙山。步行者可在延南洞与孔德之间漫步，沿途经过咖啡馆和餐厅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於麻浦與龍山、利用舊京義線鐵道改建的線形公園。步行者可從延南洞漫步至孔德，沿途經過咖啡館與餐廳。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Linearpark auf der ehemaligen Gyeongui-Bahnlinie durch Mapo und Yongsan. Spaziergänger können zwischen Yeonnam-dong und Gongdeok an Cafés und Restaurants vorbeischlendern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parc linéaire sur l'ancienne ligne ferroviaire Gyeongui, à travers Mapo et Yongsan. Les promeneurs peuvent aller de Yeonnam-dong à Gongdeok en passant devant des cafés et des restaurants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parco lineare sull’ex linea ferroviaria Gyeongui tra Mapo e Yongsan. I pedoni possono passeggiare tra Yeonnam-dong e Gongdeok passando davanti a caffè e ristoranti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque lineal sobre la antigua línea ferroviaria Gyeongui, que atraviesa Mapo y Yongsan. Los caminantes pueden pasear entre Yeonnam-dong y Gongdeok junto a cafés y restaurantes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque linear na antiga linha ferroviária Gyeongui, atravessando Mapo e Yongsan. Os pedestres podem passear entre Yeonnam-dong e Gongdeok, passando por cafés e restaurantes."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một công viên tuyến tính trên tuyến đường sắt Gyeongui cũ chạy qua Mapo và Yongsan. Du khách có thể đi dạo từ Yeonnam-dong đến Gongdeok, qua các quán cà phê và nhà hàng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taman memanjang di bekas jalur kereta Gyeongui melalui Mapo dan Yongsan. Pejalan kaki dapat berjalan-jalan antara Yeonnam-dong dan Gongdeok melewati kafe dan restoran."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวนเชิงเส้นบนทางรถไฟสายคยองอุยเดิมผ่านมาโปและยงซัน ผู้เดินเล่นเดินระหว่างยอนนัมดงและกงด็อกผ่านคาเฟ่และร้านอาหารได้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मापो और योंगसान से गुज़रती पूर्व ग्योंगुई रेल लाइन पर रेखीय पार्क। पैदल यात्री योननाम-दोंग और गोंगदेओक के बीच कैफ़े और रेस्तरां के पास से टहल सकते हैं।"
          }
        }
      }
    },
    "|A lively district near Hongik University in Mapo-gu. Street performances, cafes, clubs and small shops give it a youthful feel." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麻浦区の弘益大学校の近くにあるにぎやかな街区です。路上パフォーマンス、カフェ、クラブ、小さな店が若々しい雰囲気をつくっています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于麻浦区弘益大学附近的热闹街区。街头表演、咖啡馆、夜店和小商店带来青春气息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於麻浦區弘益大學附近的熱鬧街區。街頭表演、咖啡館、夜店與小商店帶來年輕的氛圍。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein lebhaftes Viertel nahe der Hongik-Universität in Mapo-gu. Straßenauftritte, Cafés, Clubs und kleine Läden verleihen ihm ein jugendliches Flair."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quartier animé près de l'université Hongik dans le Mapo-gu. Spectacles de rue, cafés, clubs et petites boutiques lui donnent une ambiance jeune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quartiere vivace vicino all’Università Hongik a Mapo-gu. Spettacoli di strada, caffè, club e piccoli negozi gli danno un’atmosfera giovanile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animado distrito cerca de la Universidad Hongik en Mapo-gu. Espectáculos callejeros, cafés, clubes y pequeñas tiendas le dan un aire juvenil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animado distrito perto da Universidade Hongik, em Mapo-gu. Apresentações de rua, cafés, casas noturnas e pequenas lojas dão a ele um clima jovem."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một khu sôi động gần Đại học Hongik ở quận Mapo. Biểu diễn đường phố, quán cà phê, câu lạc bộ và cửa hàng nhỏ mang lại cảm giác trẻ trung."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distrik ramai di dekat Universitas Hongik di Mapo-gu. Pertunjukan jalanan, kafe, klub, dan toko kecil memberinya nuansa muda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย่านคึกคักใกล้มหาวิทยาลัยฮงอิกในเขตมาโปกู การแสดงริมถนน คาเฟ่ คลับ และร้านเล็ก ๆ ให้ความรู้สึกวัยรุ่น"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मापो-गु में होंगिक विश्वविद्यालय के पास जीवंत मोहल्ला। सड़क प्रस्तुतियाँ, कैफ़े, क्लब और छोटी दुकानें इसे युवा माहौल देती हैं।"
          }
        }
      }
    },
    "|A lone sea stack rising off the coast of Seogwipo. Volcanic cliffs and a coastal walking trail surround it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "西帰浦の沖にそびえる一本の海食柱です。火山性の断崖と海岸の遊歩道に囲まれています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从西归浦海岸外耸起的孤立海蚀柱。周围是火山悬崖和海岸步道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "矗立在西歸浦海邊的孤立海蝕柱。四周是火山懸崖與海岸步道。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein einzelner Meeresfelsen, der vor der Küste von Seogwipo aufragt. Vulkanische Klippen und ein Küstenwanderweg umgeben ihn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiguille marine isolée qui s'élève au large de Seogwipo. Des falaises volcaniques et un sentier côtier l'entourent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faraglione isolato che si innalza al largo della costa di Seogwipo. Scogliere vulcaniche e un sentiero costiero lo circondano."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farallón solitario que se alza frente a la costa de Seogwipo. Acantilados volcánicos y un sendero costero lo rodean."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rochedo isolado que se ergue no mar ao largo de Seogwipo. Penhascos vulcânicos e uma trilha costeira o cercam."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một tảng đá biển đơn độc nhô lên ngoài khơi Seogwipo. Vách đá núi lửa và lối đi bộ ven biển bao quanh nó."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumpukan batu laut tunggal yang menjulang di lepas pantai Seogwipo. Tebing vulkanik dan jalur jalan pesisir mengelilinginya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หินเสาโดดเดี่ยวที่โผล่ขึ้นนอกชายฝั่งซอกวิโพ หน้าผาภูเขาไฟและเส้นทางเดินริมชายฝั่งล้อมรอบ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेओग्वीपो के तट से दूर उभरा अकेला समुद्री स्तंभ। ज्वालामुखीय चट्टानें और तटीय पैदल पथ इसे घेरे हैं।"
          }
        }
      }
    },
    "|A long cable-stayed bridge on the West Coast Expressway between Pyeongtaek in Gyeonggi and Dangjin in South Chungcheong. It spans Asan Bay." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "京畿道・平沢と忠清南道・唐津を結ぶ西海岸高速道路にある長い斜張橋です。牙山湾をまたいでいます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "西海岸高速公路上的长斜拉桥，位于京畿道平泽与忠清南道唐津之间。横跨牙山湾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於京畿道平澤與忠清南道唐津之間西海岸高速公路上的長型斜拉橋。橫跨牙山灣。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine lange Schrägseilbrücke auf der Westküsten-Schnellstraße zwischen Pyeongtaek in Gyeonggi und Dangjin in Süd-Chungcheong. Sie überspannt die Asan-Bucht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long pont à haubans de l'autoroute de la côte ouest entre Pyeongtaek (Gyeonggi) et Dangjin (Chungcheong du Sud). Il enjambe la baie d'Asan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lungo ponte strallato sulla West Coast Expressway tra Pyeongtaek, nel Gyeonggi, e Dangjin, nel Chungcheong meridionale. Attraversa la baia di Asan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largo puente atirantado en la autopista de la Costa Oeste entre Pyeongtaek, en Gyeonggi, y Dangjin, en Chungcheong del Sur. Cruza la bahía de Asan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longa ponte estaiada na Rodovia da Costa Oeste entre Pyeongtaek, em Gyeonggi, e Dangjin, em Chungcheong do Sul. Atravessa a baía de Asan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một cây cầu dây văng dài trên Đường cao tốc Bờ Tây giữa Pyeongtaek ở Gyeonggi và Dangjin ở Nam Chungcheong. Cầu bắc qua vịnh Asan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jembatan kabel panjang di Jalan Tol Pantai Barat antara Pyeongtaek di Gyeonggi dan Dangjin di Chungcheong Selatan. Membentang di atas Teluk Asan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สะพานขึงสายเคเบิลยาวบนทางด่วนชายฝั่งตะวันตกระหว่างพย็องแทกในคยองกีกับทันจินในชุงชองใต้ ทอดข้ามอ่าวอาซัน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्योंगगी के प्योंगताक और दक्षिण चुंगचोंग के डांगजिन के बीच वेस्ट कोस्ट एक्सप्रेसवे पर लंबा केबल-स्टे पुल। यह आसान खाड़ी को पार करता है।"
          }
        }
      }
    },
    "|A long commercial complex between Jongno and Euljiro in Seoul, home to electronics and machinery shops. Stores selling parts and tools fill the building and nearby alleys." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソウルの鍾路と乙支路の間に延びる長い商業施設で、電子機器や機械の店が集まっています。部品や工具を扱う店が建物と周辺の路地を埋めています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首尔钟路与乙支路之间的长条形商业综合体，有电子和机械店铺。出售零件和工具的商店遍布大楼和附近小巷。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於首爾鍾路與乙支路之間的長條形商業綜合體，是電子與機械商店的聚集地。販售零件與工具的店鋪遍布大樓與附近巷弄。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein langer Geschäftskomplex zwischen Jongno und Euljiro in Seoul, Heimat von Elektronik- und Maschinenläden. Geschäfte für Teile und Werkzeuge füllen das Gebäude und die nahen Gassen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long complexe commercial entre Jongno et Euljiro à Séoul, qui regroupe des boutiques d'électronique et de machines. Des magasins de pièces et d'outils remplissent le bâtiment et les ruelles voisines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lungo complesso commerciale tra Jongno ed Euljiro a Seoul, sede di negozi di elettronica e macchinari. Negozi di ricambi e utensili riempiono l’edificio e i vicoli vicini."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largo complejo comercial entre Jongno y Euljiro en Seúl, sede de tiendas de electrónica y maquinaria. Tiendas de piezas y herramientas llenan el edificio y los callejones cercanos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longo complexo comercial entre Jongno e Euljiro, em Seul, sede de lojas de eletrônicos e maquinário. Lojas de peças e ferramentas ocupam o edifício e os becos próximos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một khu thương mại dài giữa Jongno và Euljiro ở Seoul, nơi có các cửa hàng điện tử và máy móc. Các cửa hàng bán linh kiện và dụng cụ chật kín tòa nhà và những ngõ gần đó."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompleks komersial panjang antara Jongno dan Euljiro di Seoul, pusat toko elektronik dan mesin. Toko yang menjual suku cadang dan perkakas memenuhi gedung dan gang-gang di dekatnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อาคารพาณิชย์ยาวระหว่างจงโนกับอึลจีโรในกรุงโซล เป็นที่ตั้งของร้านอิเล็กทรอนิกส์และเครื่องจักร ร้านขายชิ้นส่วนและเครื่องมือเต็มอาคารและตรอกใกล้เคียง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सियोल में जोंगनो और यूलजिरो के बीच लंबा वाणिज्यिक परिसर, जहाँ इलेक्ट्रॉनिक्स और मशीनरी की दुकानें हैं। पुर्ज़े और औज़ार बेचने वाली दुकानें इमारत और आसपास की गलियों में भरी हैं।"
          }
        }
      }
    },
    "|A long row of old trees along the Gwanbang Stream embankment in Damyang. The embankment is said to have been built in the Joseon era to control floods." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "潭陽の灌坊川の堤防に沿って続く古木の長い並木です。堤防は洪水を防ぐため朝鮮時代に築かれたと伝えられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于潭阳官防川堤岸上的一长排古树。据说堤岸建于朝鲜时代，用于防洪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於潭陽官防川堤岸旁的一長排老樹。相傳這條堤防建於朝鮮時代，用以防洪。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine lange Reihe alter Bäume am Damm des Gwanbang-Bachs in Damyang. Der Damm soll in der Joseon-Zeit zur Hochwasserkontrolle gebaut worden sein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longue rangée de vieux arbres le long de la digue du ruisseau Gwanbang à Damyang. On dit que la digue fut construite à l'époque Joseon pour maîtriser les crues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunga fila di alberi antichi lungo l’argine del torrente Gwanbang a Damyang. Si dice che l’argine sia stato costruito in epoca Joseon per controllare le piene."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larga hilera de árboles antiguos a lo largo del dique del arroyo Gwanbang en Damyang. Se dice que el dique fue construido en la época Joseon para controlar las inundaciones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longa fileira de árvores antigas ao longo do dique do riacho Gwanbang, em Damyang. Diz-se que o dique foi construído na era Joseon para controlar enchentes."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một hàng cây cổ thụ dài dọc đê suối Gwanbang ở Damyang. Người ta nói con đê được xây vào thời Joseon để chống lũ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deretan panjang pohon tua di sepanjang tanggul Sungai Gwanbang di Damyang. Tanggul ini konon dibangun pada era Joseon untuk mengendalikan banjir."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แถวต้นไม้เก่าแก่ยาวตามคันกั้นลำธารกวันบังในดัมยัง เล่ากันว่าคันกั้นนี้สร้างในสมัยโชซอนเพื่อควบคุมน้ำท่วม"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दामयांग में ग्वानबांग धारा के तटबंध के साथ पुराने वृक्षों की लंबी कतार। कहा जाता है कि तटबंध जोसोन काल में बाढ़ नियंत्रण के लिए बनाया गया था।"
          }
        }
      }
    },
    "|A long wooden footbridge across the Nakdong River in Andong. A famous love letter story inspired it, and at night it is lit up with a fountain." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安東の洛東江に架かる長い木造の歩道橋です。有名なラブレターの逸話にちなんで造られ、夜は噴水とともにライトアップされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "横跨安东洛东江的长木制人行桥。灵感来自一个著名的情书故事，夜晚伴有喷泉灯光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "橫跨安東洛東江的長木造人行橋。受到一則有名的情書故事啟發，夜晚亮燈並有噴泉。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine lange hölzerne Fußgängerbrücke über den Nakdong-Fluss in Andong. Eine berühmte Liebesbrief-Geschichte inspirierte sie, und nachts ist sie mit einem Brunnen beleuchtet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longue passerelle piétonne en bois sur le fleuve Nakdong à Andong. Une célèbre histoire de lettre d'amour l'a inspirée, et la nuit elle est illuminée avec une fontaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunga passerella di legno sul fiume Nakdong ad Andong. È stata ispirata da una celebre storia di una lettera d’amore e di notte è illuminata con una fontana."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largo puente peatonal de madera sobre el río Nakdong en Andong. Lo inspiró una famosa historia de una carta de amor, y de noche se ilumina con una fuente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longa passarela de madeira sobre o rio Nakdong, em Andong. Uma famosa história de carta de amor a inspirou, e à noite é iluminada, com uma fonte."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một cây cầu đi bộ bằng gỗ dài bắc qua sông Nakdong ở Andong. Câu chuyện thư tình nổi tiếng đã truyền cảm hứng cho cầu, và ban đêm cầu được thắp sáng cùng đài phun nước."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jembatan pejalan kaki kayu panjang di atas Sungai Nakdong di Andong. Terinspirasi kisah surat cinta yang terkenal, dan pada malam hari diterangi lampu dengan air mancur."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สะพานเท้าไม้ยาวข้ามแม่น้ำนักดงในอันดง ได้แรงบันดาลใจจากเรื่องจดหมายรักที่มีชื่อเสียง และยามค่ำคืนประดับไฟพร้อมน้ำพุ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आंदोंग में नाकदोंग नदी पर लंबा लकड़ी का पैदल पुल। एक प्रसिद्ध प्रेम-पत्र की कथा ने इसे प्रेरित किया, और रात में यह फ़ाउंटेन के साथ रोशन होता है।"
          }
        }
      }
    },
    "|A loop trail around Ansan in Seodaemun-gu, Seoul. Wooden decks and forest paths offer views of the city and Bukhansan." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソウル・西大門区の鞍山を巡る周回コースです。木のデッキと森の道から街と北漢山の眺めが楽しめます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首尔西大门区鞍山的环形步道。木栈道和森林小径可眺望城市和北汉山。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "環繞首爾西大門區鞍山的環形步道。木棧道與森林小徑可眺望市區與北漢山。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rundweg um den Ansan in Seodaemun-gu, Seoul. Holzstege und Waldwege bieten Ausblicke auf die Stadt und den Bukhansan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentier en boucle autour de l'Ansan, dans le Seodaemun-gu de Séoul. Des platelages en bois et des chemins forestiers offrent des vues sur la ville et le Bukhansan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentiero ad anello intorno all’Ansan a Seodaemun-gu, Seoul. Passerelle di legno e sentieri nel bosco offrono viste sulla città e sul Bukhansan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendero circular alrededor de Ansan en Seodaemun-gu, Seúl. Pasarelas de madera y senderos de bosque ofrecen vistas de la ciudad y de Bukhansan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trilha circular em torno de Ansan, em Seodaemun-gu, Seul. Decks de madeira e caminhos na floresta oferecem vistas da cidade e de Bukhansan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một lối đi vòng quanh núi Ansan ở quận Seodaemun, Seoul. Sàn gỗ và đường rừng cho tầm nhìn ra thành phố và núi Bukhansan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalur lingkar mengelilingi Ansan di Seodaemun-gu, Seoul. Dek kayu dan jalur hutan menawarkan pemandangan kota dan Bukhansan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เส้นทางวงรอบอันซานในเขตซอแดมุนกู กรุงโซล ทางเดินไม้และทางป่าให้ทิวทัศน์เมืองและพุกฮันซาน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सियोल के सेओदेमुन-गु में आनसान के चारों ओर गोल पथ। लकड़ी के डेक और वन पथ शहर और बुकहानसान के दृश्य देते हैं।"
          }
        }
      }
    },
    "|A low mountain beside the Han River in Gwangjin-gu. It holds the remains of Goguryeo fortresses and views of the river and eastern Seoul." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広津区の漢江沿いにある低い山です。高句麗の城跡が残り、川とソウル東部が見渡せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于广津区汉江畔的低矮山丘。保留着高句丽山城遗迹，可眺望汉江和首尔东部。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於廣津區漢江旁的低矮山丘。保留著高句麗城郭遺跡，可眺望河川與首爾東部。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein niedriger Berg am Han-Fluss in Gwangjin-gu. Er birgt Überreste von Goguryeo-Festungen und Ausblicke auf den Fluss und das östliche Seoul."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basse montagne au bord du fleuve Han, dans le Gwangjin-gu. Elle conserve des vestiges de forteresses de Goguryeo et offre des vues sur le fleuve et l'est de Séoul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bassa montagna accanto al fiume Han a Gwangjin-gu. Conserva i resti di fortezze Goguryeo e viste sul fiume e su Seoul orientale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montaña baja junto al río Han en Gwangjin-gu. Conserva restos de fortalezas de Goguryeo y vistas del río y del este de Seúl."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montanha baixa à beira do rio Han, em Gwangjin-gu. Guarda vestígios de fortalezas Goguryeo e vistas do rio e do leste de Seul."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một ngọn núi thấp bên sông Hàn ở quận Gwangjin. Núi còn di tích các pháo đài Goguryeo và tầm nhìn ra sông cùng đông Seoul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunung rendah di samping Sungai Han di Gwangjin-gu. Menyimpan sisa benteng Goguryeo dan pemandangan sungai serta Seoul timur."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภูเขาเตี้ยข้างแม่น้ำฮันในเขตควังจินกู มีซากป้อมปราการโกคูรยอและทิวทัศน์แม่น้ำและโซลตะวันออก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्वांगजिन-गु में हान नदी के किनारे नीला पर्वत। यहाँ गोगुर्यो के किलों के अवशेष हैं और नदी तथा पूर्वी सियोल के दृश्य दिखते हैं।"
          }
        }
      }
    },
    "|A low mountain in Seocho-gu, Seoul. Trails and a spring make it a light hike for locals, and the Seoul Arts Center lies nearby." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソウル・瑞草区にある低い山です。遊歩道と湧き水があり、地元の人の軽いハイキングに向き、近くに芸術の殿堂があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于首尔瑞草区的低矮山丘。步道和泉水让当地人轻松徒步，首尔艺术殿堂就在附近。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於首爾瑞草區的低矮山丘。步道與泉水使當地居民可輕鬆健行，首爾藝術殿堂就在附近。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein niedriger Berg in Seocho-gu, Seoul. Wege und eine Quelle machen ihn zu einer leichten Wanderung für Einheimische, und das Seoul Arts Center liegt in der Nähe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basse montagne dans le Seocho-gu de Séoul. Des sentiers et une source en font une randonnée facile pour les habitants, et le Centre des arts de Séoul est tout proche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bassa montagna a Seocho-gu, Seoul. Sentieri e una sorgente ne fanno una facile escursione per gli abitanti del posto e il Seoul Arts Center è vicino."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montaña baja en Seocho-gu, Seúl. Senderos y un manantial la hacen una excursión ligera para los vecinos, y el Seoul Arts Center queda cerca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montanha baixa em Seocho-gu, Seul. Trilhas e uma fonte fazem dela uma caminhada leve para os moradores, e o Seoul Arts Center fica por perto."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một ngọn núi thấp ở quận Seocho, Seoul. Các lối đi bộ và một con suối khiến đây là chuyến leo nhẹ nhàng cho người dân địa phương, và Trung tâm Nghệ thuật Seoul ở gần."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunung rendah di Seocho-gu, Seoul. Jalur dan mata air menjadikannya pendakian ringan bagi warga, dan Seoul Arts Center berada di dekatnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภูเขาเตี้ยในเขตซอโชกู กรุงโซล เส้นทางเดินและน้ำพุทำให้เป็นการเดินป่าเบา ๆ สำหรับชาวบ้าน และศูนย์ศิลปะโซลอยู่ใกล้ ๆ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सियोल के सेओचो-गु में नीला पर्वत। पथ और एक झरना इसे स्थानीय लोगों के लिए हल्की पदयात्रा बनाते हैं, और सियोल आर्ट्स सेंटर पास है।"
          }
        }
      }
    },
    "|A low mountain rising near the Geum River in Sejong. The summit gives views of the river and the surrounding city." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世宗の錦江のそばにそびえる低い山です。山頂から川と周囲の街が眺められます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于世宗锦江附近的低矮山丘。山顶可眺望江景和周围的城市。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於世宗錦江附近的低矮山丘。山頂可眺望河川與周邊城市。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein niedriger Berg nahe dem Geum-Fluss in Sejong. Vom Gipfel hat man Ausblicke auf den Fluss und die umliegende Stadt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basse montagne qui s'élève près du fleuve Geum à Sejong. Le sommet offre des vues sur le fleuve et la ville alentour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bassa montagna che si innalza vicino al fiume Geum a Sejong. Dalla cima si vedono il fiume e la città circostante."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montaña baja que se alza cerca del río Geum en Sejong. La cumbre ofrece vistas del río y de la ciudad circundante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montanha baixa que se ergue perto do rio Geum, em Sejong. O cume oferece vistas do rio e da cidade ao redor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một ngọn núi thấp nhô lên gần sông Geum ở Sejong. Đỉnh núi cho tầm nhìn ra sông và thành phố xung quanh."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunung rendah yang menjulang dekat Sungai Geum di Sejong. Dari puncak terlihat pemandangan sungai dan kota di sekitarnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภูเขาเตี้ยที่โผล่ขึ้นใกล้แม่น้ำคึมในเซจง ยอดเขาให้ทิวทัศน์แม่น้ำและตัวเมืองโดยรอบ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेजोंग में गेउम नदी के पास उठा नीला पर्वत। शिखर से नदी और आसपास के शहर के दृश्य दिखते हैं।"
          }
        }
      }
    },
    "|A low volcanic cone on Jeju's southwest shore with a loop trail. Views reach Gapado, Marado and the offshore islets." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "済州島南西岸にある低い火山丘で、周回コースがあります。加波島、馬羅島、沖の小島まで見渡せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于济州西南海岸的低矮火山锥，有环形步道。可远眺加波岛、马罗岛和近海岩礁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於濟州西南海岸、設有環形步道的低矮火山錐。視野可達加波島、馬羅島與外海的岩礁。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein niedriger Vulkankegel an der Südwestküste von Jeju mit einem Rundweg. Die Aussicht reicht bis Gapado, Marado und die vorgelagerten Inselchen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petit cône volcanique sur le littoral sud-ouest de Jeju, avec un sentier en boucle. Les vues portent jusqu'à Gapado, Marado et les îlots au large."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basso cono vulcanico sulla costa sudoccidentale di Jeju con un sentiero ad anello. Le viste arrivano a Gapado, Marado e agli isolotti al largo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cono volcánico bajo en la costa suroeste de Jeju con un sendero circular. Las vistas llegan hasta Gapado, Marado y los islotes frente a la costa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cone vulcânico baixo na costa sudoeste de Jeju, com uma trilha circular. As vistas alcançam Gapado, Marado e os ilhéus ao largo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một nón núi lửa thấp trên bờ tây nam Jeju với lối đi vòng. Tầm nhìn đến Gapado, Marado và các đảo đá ngoài khơi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerucut vulkanik rendah di pesisir barat daya Jeju dengan jalur lingkar. Pemandangan mencapai Gapado, Marado, dan pulau karang lepas pantai."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กรวยภูเขาไฟเตี้ยบนชายฝั่งตะวันตกเฉียงใต้ของเชจู มีทางเดินวน ทิวทัศน์ไปถึงกาพาโด มาราโด และเกาะนอกชายฝั่ง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जेजू के दक्षिण-पश्चिमी तट पर गोल पथ वाला नीचा ज्वालामुखीय शंकु। यहाँ से गापादो, मारादो और तट से दूर के टापुओं के दृश्य दिखते हैं।"
          }
        }
      }
    },
    "|A low, flat island off Moseulpo in Jeju. In spring green barley fields cover it, and the whole island can be circled on foot." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "済州・摹瑟浦の沖にある低く平らな島です。春には青麦畑が一面に広がり、島全体を歩いて一周できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于济州摹瑟浦海外的低平岛屿。春天被青麦田覆盖，可徒步环岛一周。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於濟州摹瑟浦外海的低平島嶼。春天綠色大麥田覆蓋全島，可步行環島一周。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine niedrige, flache Insel vor Moseulpo auf Jeju. Im Frühling bedecken grüne Gerstenfelder sie, und man kann die ganze Insel zu Fuß umrunden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Île basse et plate au large de Moseulpo, à Jeju. Au printemps, des champs d'orge verte la couvrent, et l'on peut en faire le tour à pied."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isola bassa e piatta al largo di Moseulpo a Jeju. In primavera i campi di orzo verde la ricoprono e si può percorrere tutta a piedi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isla baja y plana frente a Moseulpo, en Jeju. En primavera, campos de cebada verde la cubren, y se puede rodear toda la isla a pie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilha baixa e plana ao largo de Moseulpo, em Jeju. Na primavera, campos de cevada verde a cobrem, e é possível contornar toda a ilha a pé."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một hòn đảo thấp, bằng phẳng ngoài khơi Moseulpo ở Jeju. Vào mùa xuân, những cánh đồng lúa mạch xanh phủ khắp đảo, và có thể đi bộ vòng quanh cả đảo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulau rendah dan datar di lepas Moseulpo di Jeju. Pada musim semi ladang jelai hijau menutupinya, dan seluruh pulau dapat dikelilingi dengan berjalan kaki."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกาะเตี้ยราบนอกชายฝั่งโมซึลโพในเชจู ในฤดูใบไม้ผลิทุ่งข้าวบาร์เลย์สีเขียวปกคลุมเกาะ และเดินรอบเกาะได้ทั้งเกาะ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जेजू के मोसेउलपो के तट से दूर एक नीचा, समतल द्वीप। वसंत में हरे जौ के खेत इसे ढक लेते हैं, और पूरे द्वीप का चक्कर पैदल लगाया जा सकता है।"
          }
        }
      }
    },
    "|A main peak of the Yeongnam Alps on the border of Ulsan and Yangsan. It is widely known for its silver grass plains in autumn." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蔚山と梁山の境にある嶺南アルプスの主峰です。秋のススキ原で広く知られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于蔚山与梁山交界处的岭南阿尔卑斯主峰之一。以秋天的芒草原野广为人知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於蔚山與梁山交界的嶺南阿爾卑斯主峰。以秋季的芒草平原而廣為人知。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Hauptgipfel der Yeongnam-Alpen an der Grenze von Ulsan und Yangsan. Er ist weithin für seine Silbergras-Ebenen im Herbst bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommet principal des Alpes du Yeongnam, à la limite d'Ulsan et de Yangsan. Il est largement connu pour ses plaines de roseaux argentés en automne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una delle cime principali delle Alpi di Yeongnam, al confine tra Ulsan e Yangsan. È molto nota per le pianure di miscanto in autunno."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pico principal de los Alpes de Yeongnam en el límite entre Ulsan y Yangsan. Es muy conocido por sus llanuras de hierba plateada en otoño."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dos principais picos dos Alpes de Yeongnam, na divisa entre Ulsan e Yangsan. É amplamente conhecido por suas planícies de capim-prateado no outono."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một đỉnh chính của dãy Yeongnam Alps trên ranh giới Ulsan và Yangsan. Núi nổi tiếng rộng rãi với những đồng lau bạc vào mùa thu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salah satu puncak utama Alpen Yeongnam di perbatasan Ulsan dan Yangsan. Dikenal luas dengan dataran rumput peraknya di musim gugur."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยอดเขาหลักของเทือกเขายองนัมแอลป์บนชายแดนอุลซานและยางซัน เป็นที่รู้จักกว้างขวางด้านที่ราบหญ้าเงินในฤดูใบไม้ร่วง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उल्सान और यांगसान की सीमा पर योंगनाम आल्प्स की एक मुख्य चोटी। यह शरद ऋतु में अपने चाँदी जैसे घास के मैदानों के लिए व्यापक रूप से जानी जाती है।"
          }
        }
      }
    },
    "|A major beach and resort district on the east side of Busan. It has a long sandy shore backed by high-rise buildings and is busy in summer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "釜山東部にある大規模なビーチとリゾート地区です。長い砂浜の背後に高層ビルが並び、夏はにぎわいます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于釜山东侧的大型海滩与度假区。长长的沙滩背后是高楼大厦，夏季十分热闹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於釜山東側的主要海灘與度假區。有長長的沙灘，背後是高樓大廈，夏季十分熱鬧。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein großes Strand- und Resortviertel im Osten von Busan. Es hat einen langen Sandstrand mit Hochhäusern dahinter und ist im Sommer stark besucht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grande plage et quartier de villégiature à l'est de Busan. Elle possède un long rivage de sable adossé à des tours et est très animée en été."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importante spiaggia e distretto turistico sul lato orientale di Busan. Ha una lunga riva sabbiosa con alti edifici alle spalle ed è affollata in estate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importante playa y zona turística en el este de Busan. Tiene una larga orilla arenosa respaldada por rascacielos y está muy concurrida en verano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importante distrito de praia e resort no lado leste de Busan. Tem uma longa orla arenosa com arranha-céus ao fundo e fica movimentado no verão."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một bãi biển lớn và khu nghỉ dưỡng ở phía đông Busan. Bãi có dải cát dài với các tòa nhà cao tầng phía sau và rất đông vào mùa hè."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kawasan pantai dan resor utama di sisi timur Busan. Memiliki tepi pantai berpasir panjang dengan gedung pencakar langit di belakangnya, dan ramai di musim panas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชายหาดและย่านรีสอร์ตสำคัญทางฝั่งตะวันออกของปูซาน มีชายหาดทรายยาวมีตึกสูงอยู่ด้านหลัง และคึกคักในฤดูร้อน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बुसान के पूर्वी हिस्से में प्रमुख समुद्र तट और रिसॉर्ट क्षेत्र। यहाँ ऊँची इमारतों से घिरा लंबा रेतीला किनारा है, और गर्मियों में यह व्यस्त रहता है।"
          }
        }
      }
    },
