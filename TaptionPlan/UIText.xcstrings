        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองในจังหวัดทตโตริบนชายฝั่งทะเลญี่ปุ่นของประเทศญี่ปุ่น มีสนามบิน และภูเขาไดเซ็นกับพื้นที่น้ำพุร้อนอยู่ใกล้ ๆ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जापान के जापान सागर तट पर तोत्तोरी का एक शहर। यहाँ हवाई अड्डा है, और माउंट दाइसेन तथा गर्म झरनों के क्षेत्र पास हैं।"
          }
        }
      }
    },
    "|A city in Yunnan, China, whose old town is a UNESCO World Heritage site. Its canals and stone lanes and Jade Dragon Snow Mountain are the main sights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中国・雲南にある都市で、旧市街はユネスコ世界遺産です。運河と石畳の路地、玉龍雪山が主な見どころです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中国云南的城市，古城被列入联合国教科文组织世界遗产。水渠、石板小巷和玉龙雪山是主要景观。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於中國雲南的城市，古城是聯合國教科文組織世界遺產。水渠與石板巷弄以及玉龍雪山是主要景點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stadt in Yunnan, China, deren Altstadt zum UNESCO-Welterbe gehört. Ihre Kanäle, Steingassen und der Jadedrachen-Schneeberg sind die Hauptsehenswürdigkeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville du Yunnan, en Chine, dont la vieille ville est inscrite au patrimoine mondial de l'UNESCO. Ses canaux, ses ruelles de pierre et la montagne enneigée du Dragon de Jade en sont les principaux sites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città dello Yunnan, in Cina, la cui città vecchia è sito patrimonio mondiale dell’UNESCO. I canali, i vicoli di pietra e la Montagna innevata del Drago di Giada sono le attrazioni principali."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad en Yunnan, China, cuyo casco antiguo es Patrimonio de la Humanidad de la UNESCO. Sus canales, callejones de piedra y la Montaña Nevada del Dragón de Jade son los principales atractivos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade em Yunnan, China, cuja cidade antiga é Patrimônio Mundial da UNESCO. Seus canais, vielas de pedra e a Montanha de Neve do Dragão de Jade são as principais atrações."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố ở Vân Nam, Trung Quốc, có khu phố cổ là Di sản Thế giới UNESCO. Các kênh đào, ngõ lát đá và núi tuyết Ngọc Long là những thắng cảnh chính."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota di Yunnan, Tiongkok, yang kota tuanya merupakan situs Warisan Dunia UNESCO. Kanal dan gang batunya serta Gunung Salju Naga Giok adalah pemandangan utamanya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองในยูนนาน ประเทศจีน ซึ่งเมืองเก่าเป็นแหล่งมรดกโลกขององค์การยูเนสโก คูคลอง ตรอกปูหิน และภูเขาหิมะมังกรหยกเป็นสถานที่เด่น"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चीन के युन्नान का एक शहर, जिसका पुराना नगर यूनेस्को विश्व धरोहर स्थल है। इसकी नहरें, पत्थर की गलियाँ और जेड ड्रैगन स्नो माउंटेन मुख्य दर्शनीय स्थल हैं।"
          }
        }
      }
    },
    "|A city in central Honshu, Japan, close to Mount Fuji. It is known for green tea fields and seafood from Suruga Bay." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本の本州中部にある、富士山に近い都市です。茶畑と駿河湾の海の幸で知られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于日本本州中部、靠近富士山的城市。以茶园和骏河湾海鲜闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於日本本州中部、靠近富士山的城市。以綠茶園與駿河灣海產聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stadt in Zentral-Honshu, Japan, nahe dem Fuji. Sie ist für Grünteefelder und Meeresfrüchte aus der Suruga-Bucht bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville du centre de Honshu, au Japon, proche du mont Fuji. Elle est connue pour ses champs de thé vert et ses fruits de mer de la baie de Suruga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città nel Giappone centrale, a Honshu, vicina al monte Fuji. È nota per le piantagioni di tè verde e per i frutti di mare della baia di Suruga."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad en el centro de Honshu, Japón, cerca del monte Fuji. Es conocida por sus campos de té verde y los mariscos de la bahía de Suruga."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade no centro de Honshu, Japão, perto do monte Fuji. É conhecida por campos de chá verde e frutos do mar da baía de Suruga."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố ở miền trung đảo Honshu, Nhật Bản, gần núi Phú Sĩ. Nơi đây nổi tiếng với các đồi trà xanh và hải sản từ vịnh Suruga."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota di Honshu tengah, Jepang, dekat Gunung Fuji. Dikenal dengan kebun teh hijau dan hasil laut dari Teluk Suruga."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองในตอนกลางของเกาะฮอนชู ประเทศญี่ปุ่น ใกล้ภูเขาไฟฟูจิ เป็นที่รู้จักด้านไร่ชาเขียวและอาหารทะเลจากอ่าวซูรูกะ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जापान के मध्य होन्शू का एक शहर, जो माउंट फ़ूजी के निकट है। यह हरी चाय के खेतों और सुरुगा खाड़ी के समुद्री भोजन के लिए जाना जाता है।"
          }
        }
      }
    },
    "|A city in central Kyushu, Japan, centered on Kumamoto Castle. Mount Aso and hot springs are nearby, and the mascot Kumamon is famous." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本の九州中部にある、熊本城を中心とした都市です。阿蘇山と温泉が近く、マスコットのくまモンが有名です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于日本九州中部、以熊本城为中心的城市。附近有阿苏山和温泉，吉祥物熊本熊很有名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於日本九州中部、以熊本城為中心的城市。附近有阿蘇山與溫泉，吉祥物熊本熊十分有名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stadt in Zentral-Kyushu, Japan, mit der Burg Kumamoto im Mittelpunkt. Der Berg Aso und Thermalquellen sind in der Nähe, und das Maskottchen Kumamon ist berühmt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville du centre de Kyushu, au Japon, centrée sur le château de Kumamoto. Le mont Aso et des sources chaudes sont proches, et la mascotte Kumamon est célèbre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città nel Kyushu centrale, in Giappone, incentrata sul castello di Kumamoto. Il monte Aso e le terme sono vicini ed è famosa la mascotte Kumamon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad en el centro de Kyushu, Japón, centrada en el castillo de Kumamoto. El monte Aso y las aguas termales están cerca, y la mascota Kumamon es famosa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade no centro de Kyushu, Japão, com o Castelo de Kumamoto como centro. O monte Aso e águas termais ficam perto, e o mascote Kumamon é famoso."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố ở miền trung đảo Kyushu, Nhật Bản, tập trung quanh lâu đài Kumamoto. Núi Aso và suối nước nóng ở gần đó, và linh vật Kumamon rất nổi tiếng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota di Kyushu tengah, Jepang, yang berpusat pada Kastil Kumamoto. Gunung Aso dan pemandian air panas berada di dekatnya, dan maskot Kumamon terkenal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองในตอนกลางของเกาะคีวชู ประเทศญี่ปุ่น มีปราสาทคุมาโมโตะเป็นศูนย์กลาง ภูเขาอะโสะและน้ำพุร้อนอยู่ใกล้ ๆ และมาสคอตคุมะมงก็มีชื่อเสียง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जापान के मध्य क्यूशू का एक शहर, जिसके केंद्र में कुमामोतो महल है। माउंट आसो और गर्म झरने पास हैं, और शुभंकर कुमामोन प्रसिद्ध है।"
          }
        }
      }
    },
    "|A city in eastern Shikoku, Japan, famous for the Awa Odori dance festival. The whirlpools of nearby Naruto Strait are another draw." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本の四国東部にある、阿波踊りで有名な都市です。近くの鳴門海峡の渦潮も見どころです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于日本四国东部的城市，以阿波舞节闻名。附近鸣门海峡的漩涡也是看点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於日本四國東部的城市，以阿波舞祭典聞名。附近鳴門海峽的漩渦也是一大看點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stadt im Osten von Shikoku, Japan, berühmt für das Tanzfest Awa Odori. Auch die Strudel der nahen Meerenge von Naruto sind ein Anziehungspunkt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville de l'est de Shikoku, au Japon, célèbre pour le festival de danse Awa Odori. Les tourbillons du détroit de Naruto, tout proche, sont un autre attrait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città nello Shikoku orientale, in Giappone, famosa per il festival di danza Awa Odori. I vortici del vicino stretto di Naruto sono un’altra attrattiva."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad en el este de Shikoku, Japón, famosa por el festival de danza Awa Odori. Los remolinos del cercano estrecho de Naruto son otro atractivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade no leste de Shikoku, Japão, famosa pelo festival de dança Awa Odori. Os redemoinhos do vizinho estreito de Naruto são outra atração."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố ở phía đông đảo Shikoku, Nhật Bản, nổi tiếng với lễ hội múa Awa Odori. Các xoáy nước ở eo biển Naruto gần đó là một điểm thu hút khác."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota di Shikoku timur, Jepang, terkenal dengan festival tari Awa Odori. Pusaran air di Selat Naruto yang dekat juga menjadi daya tarik."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองในตอนตะวันออกของเกาะชิโกกุ ประเทศญี่ปุ่น มีชื่อเสียงจากเทศกาลเต้นรำอาวะโอโดริ น้ำวนของช่องแคบนารุโตะที่อยู่ใกล้ ๆ ก็เป็นอีกจุดดึงดูด"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जापान के पूर्वी शिकोकू का एक शहर, जो आवा ओदोरी नृत्य उत्सव के लिए प्रसिद्ध है। पास की नारुतो जलडमरूमध्य के भँवर एक और आकर्षण हैं।"
          }
        }
      }
    },
    "|A city in northeastern Kyushu, Japan, near the hot spring areas of Beppu and Yufuin. The region is known for its abundant hot springs." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本の九州北東部にある、別府や由布院の温泉地に近い都市です。豊富な温泉で知られる地域です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于日本九州东北部的城市，靠近别府和由布院温泉区。该地区以丰富的温泉闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於日本九州東北部的城市，靠近別府與由布院溫泉區。該地區以豐富的溫泉聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stadt im Nordosten von Kyushu, Japan, nahe den Thermalgebieten von Beppu und Yufuin. Die Region ist für ihre Fülle an heißen Quellen bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville du nord-est de Kyushu, au Japon, près des zones d'eaux thermales de Beppu et Yufuin. La région est réputée pour l'abondance de ses sources chaudes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città nel Kyushu nordorientale, in Giappone, vicina alle zone termali di Beppu e Yufuin. La regione è nota per l’abbondanza di sorgenti termali."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad en el noreste de Kyushu, Japón, cerca de las zonas de aguas termales de Beppu y Yufuin. La región es conocida por sus abundantes aguas termales."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade no nordeste de Kyushu, Japão, perto das áreas de águas termais de Beppu e Yufuin. A região é conhecida por suas abundantes águas termais."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố ở đông bắc đảo Kyushu, Nhật Bản, gần các khu suối nước nóng Beppu và Yufuin. Vùng này nổi tiếng với nguồn suối nước nóng dồi dào."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota di timur laut Kyushu, Jepang, dekat kawasan pemandian air panas Beppu dan Yufuin. Wilayah ini terkenal dengan pemandian air panasnya yang melimpah."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองในตอนตะวันออกเฉียงเหนือของเกาะคีวชู ประเทศญี่ปุ่น ใกล้พื้นที่น้ำพุร้อนของเบ็ปปุและยูฟูอิน ภูมิภาคนี้เป็นที่รู้จักด้านน้ำพุร้อนอันอุดมสมบูรณ์"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जापान के उत्तर-पूर्वी क्यूशू का एक शहर, जो बेप्पू और युफ़ुइन के गर्म झरनों वाले क्षेत्रों के निकट है। यह क्षेत्र प्रचुर गर्म झरनों के लिए जाना जाता है।"
          }
        }
      }
    },
    "|A city in northern Kyushu, Japan, close to Korea. It is known for open-air food stalls, Hakata ramen and Dazaifu Shrine." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本の九州北部にある、韓国に近い都市です。屋台、博多ラーメン、太宰府天満宮で知られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于日本九州北部、靠近韩国的城市。以露天小吃摊、博多拉面和太宰府天满宫闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於日本九州北部、靠近韓國的城市。以露天攤販、博多拉麵與太宰府天滿宮聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stadt im Norden von Kyushu, Japan, nahe Korea. Sie ist bekannt für Imbissstände unter freiem Himmel, Hakata-Ramen und den Dazaifu-Schrein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville du nord de Kyushu, au Japon, proche de la Corée. Elle est connue pour ses stands de nourriture en plein air, ses ramen de Hakata et le sanctuaire de Dazaifu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città nel Kyushu settentrionale, in Giappone, vicina alla Corea. È nota per le bancarelle di cibo all’aperto, il ramen di Hakata e il santuario di Dazaifu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad en el norte de Kyushu, Japón, cercana a Corea. Es conocida por sus puestos de comida al aire libre, el ramen de Hakata y el santuario Dazaifu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade no norte de Kyushu, Japão, perto da Coreia. É conhecida por barracas de comida ao ar livre, pelo ramen de Hakata e pelo Santuário Dazaifu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố ở bắc đảo Kyushu, Nhật Bản, gần Hàn Quốc. Nơi đây nổi tiếng với các quầy ăn ngoài trời, mì ramen Hakata và đền Dazaifu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota di Kyushu utara, Jepang, dekat dengan Korea. Dikenal dengan kedai makanan terbuka, ramen Hakata, dan Kuil Dazaifu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองในตอนเหนือของเกาะคีวชู ประเทศญี่ปุ่น ใกล้เกาหลี เป็นที่รู้จักด้านแผงอาหารริมถนนกลางแจ้ง ราเมงฮากาตะ และศาลเจ้าดาไซฟุ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जापान के उत्तरी क्यूशू का एक शहर, जो कोरिया के निकट है। यह खुले में लगे खाने के ठेलों, हाकाता रामेन और दाज़ाइफ़ू तीर्थ के लिए जाना जाता है।"
          }
        }
      }
    },
    "|A city in southern Kyushu, Japan, facing the active volcano Sakurajima across the bay. It is also known for hot springs and black pork dishes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本の九州南部にある、湾越しに活火山の桜島を望む都市です。温泉や黒豚料理でも知られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于日本九州南部的城市，隔海湾与活火山樱岛相望。也以温泉和黑猪肉料理闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於日本九州南部的城市，隔海灣與活火山櫻島相望。也以溫泉與黑豚料理聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stadt im Süden von Kyushu, Japan, die über die Bucht hinweg dem aktiven Vulkan Sakurajima gegenüberliegt. Sie ist auch für heiße Quellen und Gerichte mit Schwarzem Schwein bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville du sud de Kyushu, au Japon, qui fait face au volcan actif Sakurajima de l'autre côté de la baie. Elle est aussi connue pour ses sources chaudes et ses plats de porc noir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città nel Kyushu meridionale, in Giappone, che si affaccia attraverso la baia sul vulcano attivo Sakurajima. È nota anche per le terme e i piatti di maiale nero."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad en el sur de Kyushu, Japón, frente al volcán activo Sakurajima al otro lado de la bahía. También es conocida por sus aguas termales y sus platos de cerdo negro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade no sul de Kyushu, Japão, de frente para o vulcão ativo Sakurajima do outro lado da baía. Também é conhecida por águas termais e pratos de porco preto."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố ở nam đảo Kyushu, Nhật Bản, đối diện núi lửa đang hoạt động Sakurajima qua vịnh. Nơi đây cũng nổi tiếng với suối nước nóng và các món thịt lợn đen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota di Kyushu selatan, Jepang, menghadap gunung berapi aktif Sakurajima di seberang teluk. Juga dikenal dengan pemandian air panas dan hidangan daging babi hitam."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองในตอนใต้ของเกาะคีวชู ประเทศญี่ปุ่น หันหน้าข้ามอ่าวไปยังภูเขาไฟที่ยังคุกรุ่นอย่างซากุราจิมะ เป็นที่รู้จักด้านน้ำพุร้อนและอาหารหมูดำ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जापान के दक्षिणी क्यूशू का एक शहर, जो खाड़ी के पार सक्रिय ज्वालामुखी साकुराजिमा के सामने स्थित है। यह गर्म झरनों और काले सूअर के व्यंजनों के लिए भी जाना जाता है।"
          }
        }
      }
    },
    "|A city in southwest Inner Mongolia, China, near deserts and grasslands. The Genghis Khan Mausoleum and the Kubuqi Desert are known sights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中国・内モンゴル南西部にある、砂漠と草原に近い都市です。チンギス・ハン陵や庫布其砂漠が有名な見どころです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于中国内蒙古西南部的城市，靠近沙漠和草原。成吉思汗陵和库布其沙漠是知名景点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於中國內蒙古西南部的城市，靠近沙漠與草原。成吉思汗陵與庫布其沙漠是知名景點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stadt im Südwesten der Inneren Mongolei, China, nahe Wüsten und Grasland. Das Mausoleum von Dschingis Khan und die Kubuqi-Wüste sind bekannte Sehenswürdigkeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville du sud-ouest de la Mongolie-Intérieure, en Chine, près de déserts et de prairies. Le mausolée de Gengis Khan et le désert de Kubuqi sont des sites réputés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città nel sudovest della Mongolia Interna, in Cina, vicina a deserti e praterie. Il Mausoleo di Gengis Khan e il deserto di Kubuqi sono luoghi noti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad en el suroeste de Mongolia Interior, China, cerca de desiertos y praderas. El Mausoleo de Genghis Khan y el desierto de Kubuqi son atractivos conocidos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade no sudoeste da Mongólia Interior, China, perto de desertos e pradarias. O Mausoléu de Gengis Khan e o deserto de Kubuqi são atrações conhecidas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố ở tây nam Nội Mông, Trung Quốc, gần các sa mạc và thảo nguyên. Lăng Thành Cát Tư Hãn và sa mạc Khố Bố Tề là những thắng cảnh nổi tiếng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota di barat daya Mongolia Dalam, Tiongkok, dekat gurun dan padang rumput. Mausoleum Genghis Khan dan Gurun Kubuqi adalah tempat yang terkenal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองในตอนตะวันตกเฉียงใต้ของมองโกเลียใน ประเทศจีน ใกล้ทะเลทรายและทุ่งหญ้า สุสานเจงกิสข่านและทะเลทรายคูบูฉีเป็นสถานที่ที่รู้จักกัน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चीन के भीतरी मंगोलिया के दक्षिण-पश्चिम का एक शहर, जो रेगिस्तानों और घास के मैदानों के निकट है। चंगेज़ ख़ान का मकबरा और कुबुकी रेगिस्तान जाने-माने स्थल हैं।"
          }
        }
      }
    },
    "|A city in the Tokachi plain of Hokkaido, Japan. It is known for broad farmland and dairy, and for local dishes such as pork rice bowls." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本・北海道の十勝平野にある都市です。広い農地と酪農、豚丼などの郷土料理で知られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于日本北海道十胜平原的城市。以广阔的农田和乳制品闻名，也有猪肉盖饭等当地美食。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於日本北海道十勝平原的城市。以遼闊的農田與乳製品聞名，並有豬肉蓋飯等當地美食。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stadt in der Tokachi-Ebene auf Hokkaido, Japan. Sie ist für weites Ackerland und Milchwirtschaft sowie für lokale Gerichte wie Schweinefleisch-Reisschalen bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville de la plaine de Tokachi, à Hokkaido, au Japon. Elle est connue pour ses vastes terres agricoles et ses produits laitiers, ainsi que pour des plats locaux comme les bols de riz au porc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città nella pianura del Tokachi, a Hokkaido, in Giappone. È nota per i vasti campi e per l’industria casearia e per piatti locali come le ciotole di riso con maiale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad en la llanura de Tokachi, en Hokkaido, Japón. Es conocida por sus amplias tierras de cultivo y su producción lechera, y por platos locales como los tazones de arroz con cerdo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade na planície de Tokachi, em Hokkaido, Japão. É conhecida por vastas terras agrícolas e laticínios, e por pratos locais como tigelas de arroz com porco."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố trên đồng bằng Tokachi ở Hokkaido, Nhật Bản. Nơi đây nổi tiếng với đất canh tác rộng lớn và ngành sữa, cùng các món địa phương như cơm thịt lợn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota di dataran Tokachi, Hokkaido, Jepang. Dikenal dengan lahan pertanian luas dan produk susu, serta hidangan lokal seperti mangkuk nasi daging babi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองในที่ราบโทกาจิของฮอกไกโด ประเทศญี่ปุ่น เป็นที่รู้จักด้านพื้นที่เกษตรกว้างใหญ่และผลิตภัณฑ์นม รวมถึงอาหารท้องถิ่นเช่นข้าวหน้าหมู"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जापान के होक्काइदो के तोकाची मैदान का एक शहर। यह विस्तृत खेतों और डेयरी के लिए, और सूअर के मांस के चावल कटोरे जैसे स्थानीय व्यंजनों के लिए जाना जाता है।"
          }
        }
      }
    },
    "|A city in western Honshu, Japan, with the black-walled Okayama Castle and Korakuen Garden. The historic Kurashiki district is nearby." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本の本州西部にある、黒い城壁の岡山城と後楽園がある都市です。歴史ある倉敷の街並みが近くにあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于日本本州西部的城市，有黑色城墙的冈山城和后乐园。附近是历史悠久的仓敷美观地区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於日本本州西部的城市，有黑牆的岡山城與後樂園。歷史悠久的倉敷美觀地區就在附近。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stadt im Westen von Honshu, Japan, mit der schwarz ummauerten Burg Okayama und dem Garten Korakuen. Das historische Viertel Kurashiki ist in der Nähe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville de l'ouest de Honshu, au Japon, avec le château d'Okayama aux murs noirs et le jardin Korakuen. Le quartier historique de Kurashiki est proche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città nel Giappone occidentale, a Honshu, con il castello nero di Okayama e il giardino Korakuen. Il quartiere storico di Kurashiki è vicino."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad en el oeste de Honshu, Japón, con el castillo de Okayama, de muros negros, y el jardín Korakuen. El histórico distrito de Kurashiki está cerca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade no oeste de Honshu, Japão, com o Castelo de Okayama de paredes negras e o Jardim Korakuen. O histórico distrito de Kurashiki fica perto."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố ở miền tây đảo Honshu, Nhật Bản, có lâu đài Okayama tường đen và vườn Korakuen. Khu phố lịch sử Kurashiki ở gần đó."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota di Honshu barat, Jepang, dengan Kastil Okayama yang berdinding hitam dan Taman Korakuen. Kawasan bersejarah Kurashiki berada di dekatnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองในตะวันตกของเกาะฮอนชู ประเทศญี่ปุ่น มีปราสาทโอกายามะกำแพงสีดำและสวนโคราคุเอ็น ย่านประวัติศาสตร์คุราชิกิอยู่ใกล้ ๆ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जापान के पश्चिमी होन्शू का एक शहर, जहाँ काली दीवारों वाला ओकायामा महल और कोराकुएन उद्यान है। ऐतिहासिक कुराशिकी मोहल्ला पास है।"
          }
        }
      }
    },
    "|A city in western Japan home to the Peace Memorial Park and the Atomic Bomb Dome. Itsukushima Shrine on nearby Miyajima is also well known." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平和記念公園と原爆ドームがある日本西部の都市です。近くの宮島にある厳島神社も有名です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于日本西部的城市，有和平纪念公园和原爆圆顶馆。附近宫岛的严岛神社也很有名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於日本西部的城市，有和平紀念公園與原爆圓頂館。附近宮島的嚴島神社同樣聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stadt im Westen Japans mit dem Friedensgedenkpark und dem Atombombendom. Der Itsukushima-Schrein auf der nahen Insel Miyajima ist ebenfalls bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville de l'ouest du Japon qui abrite le parc du Mémorial de la paix et le Dôme de la bombe atomique. Le sanctuaire d'Itsukushima, sur la proche île de Miyajima, est lui aussi très connu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città nel Giappone occidentale che ospita il Parco Commemorativo della Pace e la Cupola della Bomba Atomica. È ben noto anche il santuario di Itsukushima sulla vicina Miyajima."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad del oeste de Japón que alberga el Parque Memorial de la Paz y la Cúpula de la Bomba Atómica. El santuario Itsukushima, en la cercana Miyajima, también es muy conocido."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade no oeste do Japão que abriga o Parque Memorial da Paz e a Cúpula da Bomba Atômica. O Santuário de Itsukushima, na vizinha Miyajima, também é bem conhecido."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố ở miền tây Nhật Bản có Công viên Tưởng niệm Hòa bình và Mái vòm Bom nguyên tử. Đền Itsukushima trên đảo Miyajima gần đó cũng rất nổi tiếng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota di Jepang barat yang menjadi rumah bagi Taman Peringatan Perdamaian dan Kubah Bom Atom. Kuil Itsukushima di Miyajima yang dekat juga terkenal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองในญี่ปุ่นตะวันตกที่เป็นที่ตั้งของสวนอนุสรณ์สันติภาพและโดมระเบิดปรมาณู ศาลเจ้าอิสึคุชิมะบนเกาะมิยาจิมะที่อยู่ใกล้ ๆ ก็มีชื่อเสียง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पश्चिमी जापान का एक शहर, जहाँ पीस मेमोरियल पार्क और परमाणु बम गुंबद है। पास के मियाजिमा पर इत्सुकुशिमा तीर्थ भी प्रसिद्ध है।"
          }
        }
      }
    },
    "|A city on Kyushu’s southeast coast, Japan, known for its warm climate and shoreline. It has shrines tied to myth and surf beaches." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本の九州南東海岸にある都市で、温暖な気候と海岸線で知られます。神話ゆかりの神社とサーフビーチがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于日本九州东南海岸的城市，以温暖的气候和海岸线闻名。这里有与神话相关的神社和冲浪海滩。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於日本九州東南海岸的城市，以溫暖的氣候與海岸線聞名。有與神話相關的神社與衝浪海灘。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stadt an der Südostküste von Kyushu, Japan, bekannt für ihr warmes Klima und ihre Küste. Sie hat Schreine, die mit Mythen verbunden sind, und Surfstrände."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville de la côte sud-est de Kyushu, au Japon, connue pour son climat doux et son littoral. Elle possède des sanctuaires liés à la mythologie et des plages de surf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città sulla costa sudorientale del Kyushu, in Giappone, nota per il clima mite e il litorale. Ha santuari legati al mito e spiagge per il surf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad en la costa sureste de Kyushu, Japón, conocida por su clima cálido y su litoral. Tiene santuarios ligados a mitos y playas para surfear."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade na costa sudeste de Kyushu, Japão, conhecida por seu clima quente e pelo litoral. Tem santuários ligados à mitologia e praias para surfe."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố trên bờ đông nam đảo Kyushu, Nhật Bản, nổi tiếng với khí hậu ấm áp và bờ biển. Nơi đây có các đền thờ gắn với thần thoại và những bãi biển lướt sóng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota di pesisir tenggara Kyushu, Jepang, dikenal dengan iklimnya yang hangat dan garis pantainya. Memiliki kuil yang terkait mitos dan pantai selancar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองบนชายฝั่งตะวันออกเฉียงใต้ของเกาะคีวชู ประเทศญี่ปุ่น เป็นที่รู้จักด้านอากาศอบอุ่นและแนวชายฝั่ง มีศาลเจ้าที่เกี่ยวข้องกับตำนานและชายหาดเล่นเซิร์ฟ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जापान के क्यूशू के दक्षिण-पूर्वी तट का एक शहर, जो अपने गर्म मौसम और तटरेखा के लिए जाना जाता है। यहाँ पौराणिक कथाओं से जुड़े तीर्थ और सर्फ़ समुद्र तट हैं।"
          }
        }
      }
    },
    "|A city on the Songhua River in northeastern Heilongjiang, China. It has cold winters and lies near wetlands and the Russian border." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中国・黒竜江省北東部の松花江沿いにある都市です。冬は寒く、湿地やロシアとの国境の近くにあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于中国黑龙江东北部松花江畔的城市。冬季寒冷，靠近湿地和俄罗斯边境。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於中國黑龍江東北部松花江畔的城市。冬季寒冷，靠近濕地與俄羅斯邊境。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stadt am Songhua-Fluss im Nordosten von Heilongjiang, China. Sie hat kalte Winter und liegt nahe Feuchtgebieten und der russischen Grenze."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville sur la rivière Songhua, dans le nord-est du Heilongjiang, en Chine. Elle a des hivers froids et se trouve près de zones humides et de la frontière russe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città sul fiume Songhua, nel Heilongjiang nordorientale, in Cina. Ha inverni freddi e si trova vicino a zone umide e al confine con la Russia."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad a orillas del río Songhua, en el noreste de Heilongjiang, China. Tiene inviernos fríos y se encuentra cerca de humedales y de la frontera con Rusia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade às margens do rio Songhua, no nordeste de Heilongjiang, China. Tem invernos frios e fica perto de pântanos e da fronteira com a Rússia."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố bên sông Tùng Hoa ở đông bắc Hắc Long Giang, Trung Quốc. Nơi đây có mùa đông lạnh và nằm gần vùng đất ngập nước cùng biên giới Nga."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota di tepi Sungai Songhua di timur laut Heilongjiang, Tiongkok. Musim dinginnya dingin dan letaknya dekat lahan basah dan perbatasan Rusia."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองริมแม่น้ำซงหัวทางตะวันออกเฉียงเหนือของเฮย์หลงเจียง ประเทศจีน มีฤดูหนาวที่หนาวเย็น และอยู่ใกล้พื้นที่ชุ่มน้ำและชายแดนรัสเซีย"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चीन के उत्तर-पूर्वी हेइलोंगजियांग में सुंगहुआ नदी पर एक शहर। यहाँ सर्दियाँ ठंडी होती हैं, और यह आर्द्रभूमियों व रूसी सीमा के निकट है।"
          }
        }
      }
    },
    "|A coastal city in Shandong, China, with buildings from its German colonial era. It is known for Tsingtao beer, beaches and Zhanqiao Pier." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中国・山東省にある海沿いの都市で、ドイツ統治時代の建物が残ります。青島ビール、ビーチ、桟橋で知られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中国山东的滨海城市，保留着德国殖民时期的建筑。以青岛啤酒、海滩和栈桥闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於中國山東的海濱城市，留有德國殖民時期的建築。以青島啤酒、海灘與棧橋聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Küstenstadt in Shandong, China, mit Gebäuden aus der deutschen Kolonialzeit. Sie ist für Tsingtao-Bier, Strände und den Zhanqiao-Pier bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ville côtière du Shandong, en Chine, avec des bâtiments de l'époque coloniale allemande. Elle est connue pour la bière Tsingtao, ses plages et la jetée de Zhanqiao."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città costiera nello Shandong, in Cina, con edifici del periodo coloniale tedesco. È nota per la birra Tsingtao, le spiagge e il molo Zhanqiao."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciudad costera en Shandong, China, con edificios de su época colonial alemana. Es conocida por la cerveza Tsingtao, las playas y el muelle Zhanqiao."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidade costeira em Shandong, China, com edifícios da época colonial alemã. É conhecida pela cerveja Tsingtao, pelas praias e pelo cais Zhanqiao."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thành phố ven biển ở Sơn Đông, Trung Quốc, có các tòa nhà từ thời thuộc địa Đức. Nơi đây nổi tiếng với bia Tsingtao, các bãi biển và cầu tàu Trạm Kiều."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota pesisir di Shandong, Tiongkok, dengan bangunan dari era kolonial Jerman. Dikenal dengan bir Tsingtao, pantai, dan Dermaga Zhanqiao."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองชายฝั่งในซานตง ประเทศจีน มีอาคารจากยุคอาณานิคมเยอรมัน เป็นที่รู้จักด้านเบียร์ชิงเต่า ชายหาด และท่าเทียบเรือจ้านเฉียว"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चीन के शानदोंग का एक तटीय शहर, जहाँ जर्मन औपनिवेशिक काल की इमारतें हैं। यह त्सिंगताओ बीयर, समुद्र तटों और झानचिआओ घाट के लिए जाना जाता है।"
          }
        }
      }
    },
    "|A coastal cliff below Sanbangsan named for its resemblance to a dragon’s head reaching into the sea. Layers of sedimentary rock are carved into wave-like patterns." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山房山の下にある海岸の断崖で、海へ伸びる竜の頭に似ていることから名づけられました。堆積岩の層が波のような模様に削られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山房山下的海岸悬崖，因形似伸入大海的龙头而得名。层层沉积岩被雕琢成波浪般的纹路。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於三房山下的海岸懸崖，因形似伸入海中的龍頭而得名。層層沉積岩被雕琢成波浪般的紋理。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Küstenklippe unterhalb des Sanbangsan, benannt nach ihrer Ähnlichkeit mit einem ins Meer reichenden Drachenkopf. Schichten von Sedimentgestein sind zu wellenartigen Mustern geformt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falaise côtière sous le Sanbangsan, nommée pour sa ressemblance avec une tête de dragon plongeant dans la mer. Des couches de roche sédimentaire y sont sculptées en motifs ondulés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scogliera costiera sotto il Sanbangsan, chiamata così perché somiglia a una testa di drago che si tuffa nel mare. Strati di roccia sedimentaria sono scolpiti in motivi simili a onde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acantilado costero bajo Sanbangsan, llamado así por su parecido con una cabeza de dragón que se adentra en el mar. Capas de roca sedimentaria están talladas en formas onduladas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penhasco costeiro abaixo de Sanbangsan, nomeado pela semelhança com uma cabeça de dragão que se estende para o mar. Camadas de rocha sedimentar são esculpidas em padrões semelhantes a ondas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một vách đá ven biển dưới núi Sanbangsan, được đặt tên vì giống đầu rồng đang vươn ra biển. Các lớp đá trầm tích được khắc thành hoa văn như sóng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tebing pesisir di bawah Sanbangsan yang dinamai karena kemiripannya dengan kepala naga yang menjulur ke laut. Lapisan batuan sedimen terukir membentuk pola menyerupai ombak."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าผาริมชายฝั่งใต้เขาซันบังซัน ตั้งชื่อตามความคล้ายหัวมังกรที่ยื่นลงทะเล ชั้นหินตะกอนถูกกัดเซาะเป็นลวดลายคล้ายคลื่น"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सान्बांगसान के नीचे एक तटीय चट्टान, जिसका नाम समुद्र में पहुँचते अजगर के सिर से मिलते-जुलते आकार पर पड़ा। तलछटी चट्टान की परतें लहरों जैसे पैटर्न में तराशी गई हैं।"
          }
        }
      }
    },
    "|A coastal cliff in Jungmun, Seogwipo, formed of columnar basalt that cooled from lava. Waves crash against the rock columns below the viewing paths." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "西帰浦・中文にある海岸の断崖で、溶岩が冷えて固まった柱状節理の玄武岩でできています。遊歩道の下で波が岩の柱に打ち寄せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于西归浦中文的海岸悬崖，由熔岩冷却形成的柱状玄武岩构成。海浪拍打着观景步道下方的岩柱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於西歸浦中文的海岸懸崖，由熔岩冷卻形成的柱狀玄武岩構成。海浪拍擊著觀景步道下方的岩柱。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Küstenklippe in Jungmun, Seogwipo, aus säulenförmigem Basalt, der aus Lava erkaltet ist. Unterhalb der Aussichtswege schlagen Wellen gegen die Felssäulen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falaise côtière à Jungmun, Seogwipo, formée de basalte en colonnes refroidi après la lave. Les vagues s'écrasent contre les colonnes de roche sous les sentiers d'observation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scogliera costiera a Jungmun, Seogwipo, formata da basalto colonnare raffreddatosi dalla lava. Le onde si infrangono sulle colonne di roccia sotto i sentieri panoramici."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acantilado costero en Jungmun, Seogwipo, formado por basalto columnar enfriado a partir de lava. Las olas rompen contra las columnas de roca bajo los senderos de observación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penhasco costeiro em Jungmun, Seogwipo, formado por basalto colunar que esfriou a partir da lava. As ondas se chocam contra as colunas de rocha abaixo dos caminhos de observação."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một vách đá ven biển ở Jungmun, Seogwipo, hình thành từ bazan dạng cột nguội đi từ dung nham. Sóng đập vào các cột đá bên dưới lối ngắm cảnh."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tebing pesisir di Jungmun, Seogwipo, yang terbentuk dari basal berkolom yang mendingin dari lava. Ombak menghantam kolom-kolom batu di bawah jalur pandang."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าผาริมชายฝั่งในจุงมุน ซอกวิโพ เกิดจากหินบะซอลต์เป็นเสาที่เย็นตัวจากลาวา คลื่นซัดเข้ากระทบเสาหินด้านล่างทางเดินชมวิว"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेओग्वीपो के जुंगमुन में तटीय चट्टान, जो लावा के ठंडे होने से बने स्तंभाकार बेसाल्ट से बनी है। देखने के रास्तों के नीचे लहरें चट्टान के स्तंभों से टकराती हैं।"
          }
        }
      }
    },
    "|A coastal park in Dong District, Ulsan, with odd rock formations and a dense pine forest. A suspension bridge and a lighthouse stand by the rocky islet." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蔚山・東区にある海岸公園で、奇岩と密生した松林があります。岩の小島のそばに吊り橋と灯台が立っています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于蔚山东区的海岸公园，有奇特的岩石和茂密的松林。吊桥和灯塔矗立在岩石小岛旁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於蔚山東區的海岸公園，有奇特的岩石地形與茂密的松林。岩礁旁有吊橋與燈塔。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Küstenpark im Bezirk Dong, Ulsan, mit eigentümlichen Felsformationen und einem dichten Kiefernwald. Eine Hängebrücke und ein Leuchtturm stehen am felsigen Inselchen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parc côtier du district de Dong, à Ulsan, avec d'étranges formations rocheuses et une pinède dense. Un pont suspendu et un phare se dressent près de l'îlot rocheux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parco costiero nel distretto di Dong, a Ulsan, con strane formazioni rocciose e una fitta pineta. Un ponte sospeso e un faro sorgono presso l’isolotto roccioso."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque costero en el distrito Dong, Ulsan, con extrañas formaciones rocosas y un denso pinar. Un puente colgante y un faro se alzan junto al islote rocoso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque costeiro em Dong-gu, Ulsan, com formações rochosas curiosas e uma densa floresta de pinheiros. Uma ponte suspensa e um farol ficam junto ao ilhéu rochoso."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một công viên ven biển ở quận Dong, Ulsan, với những khối đá kỳ lạ và rừng thông rậm. Một cầu treo và một ngọn hải đăng đứng cạnh đảo đá nhỏ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taman pesisir di Distrik Dong, Ulsan, dengan formasi batuan unik dan hutan pinus yang lebat. Jembatan gantung dan mercusuar berdiri di dekat pulau karang kecil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวนชายฝั่งในเขตทงกู เมืองอุลซาน มีหินรูปร่างแปลกตาและป่าสนหนาแน่น สะพานแขวนและประภาคารตั้งอยู่ข้างเกาะหินเล็ก ๆ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उल्सान के डोंग ज़िले में तटीय उद्यान, जहाँ अनोखी चट्टानी आकृतियाँ और घना चीड़ वन है। चट्टानी टापू के पास एक झूला पुल और एक प्रकाशस्तंभ है।"
          }
        }
      }
    },
    "|A coastal road along Haegeumgang on southern Geoje, South Gyeongsang. It is known for sea-stack scenery and views over the southern sea." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慶尚南道・巨済の南部にある海金剛沿いの海岸道路です。海に立つ奇岩の景色と南の海の眺めで知られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于庆尚南道巨济南部海金刚的海岸公路。以海蚀柱景观和南海海景闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於慶尚南道巨濟南部海金剛的海岸道路。以海蝕柱景觀與南海遼闊的景色聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Küstenstraße entlang des Haegeumgang im Süden von Geoje, Süd-Gyeongsang. Sie ist für ihre Felsnadel-Landschaft und Ausblicke über das Südmeer bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Route côtière le long de Haegeumgang, au sud de Geoje (Gyeongsang du Sud). Elle est connue pour ses paysages d'aiguilles marines et ses vues sur la mer du Sud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strada costiera lungo Haegeumgang, nel sud di Geoje, nel Gyeongsang meridionale. È nota per il paesaggio di faraglioni e per le viste sul mare meridionale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carretera costera a lo largo de Haegeumgang, en el sur de Geoje, Gyeongsang del Sur. Es conocida por sus paisajes de farallones y sus vistas del mar del sur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrada costeira ao longo de Haegeumgang, no sul de Geoje, Gyeongsang do Sul. É conhecida por paisagens de rochedos no mar e vistas do mar do sul."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một con đường ven biển dọc Haegeumgang ở nam Geoje, Nam Gyeongsang. Nơi đây nổi tiếng với cảnh đá dựng ngoài biển và tầm nhìn ra vùng biển phía nam."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan pesisir di sepanjang Haegeumgang di Geoje selatan, Gyeongsang Selatan. Dikenal dengan pemandangan tumpukan batu laut dan pemandangan laut selatan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถนนชายฝั่งริมแฮกึมกังทางใต้ของเกาะคอเจ จังหวัดคยองซังใต้ เป็นที่รู้จักด้านทิวทัศน์เสาหินกลางทะเลและวิวทะเลใต้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दक्षिण ग्योंगसांग के दक्षिणी गेओजे में हेगेउमगांग के किनारे तटीय सड़क। यह समुद्री स्तंभ चट्टानों के दृश्य और दक्षिणी सागर के विस्तार के लिए जानी जाती है।"
          }
        }
      }
    },
    "|A coastal road along Taean’s Yellow Sea shore in South Chungcheong. It passes beaches, tidal flats and pine groves and is known for sunsets." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忠清南道・泰安の黄海沿いを走る海岸道路です。ビーチ、干潟、松林を通り、夕日で知られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿忠清南道泰安黄海海岸的公路。途经海滩、滩涂和松林，以日落闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿著忠清南道泰安黃海海岸的濱海道路。經過海灘、灘塗與松林，以日落聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Küstenstraße entlang der Gelbmeer-Küste von Taean in Süd-Chungcheong. Sie führt an Stränden, Wattflächen und Kiefernhainen vorbei und ist für Sonnenuntergänge bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Route côtière le long du rivage de la mer Jaune à Taean (Chungcheong du Sud). Elle passe par des plages, des estrans et des pinèdes et est connue pour ses couchers de soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strada costiera lungo la riva del Mar Giallo a Taean, nel Chungcheong meridionale. Passa per spiagge, distese di fango e pinete ed è nota per i tramonti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carretera costera a lo largo de la orilla del Mar Amarillo de Taean, en Chungcheong del Sur. Pasa por playas, llanuras de marea y pinares, y es conocida por los atardeceres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrada costeira ao longo da orla do Mar Amarelo em Taean, Chungcheong do Sul. Passa por praias, planícies de maré e pinhais e é conhecida pelos pores do sol."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một con đường ven biển dọc bờ Hoàng Hải của Taean ở Nam Chungcheong. Đường đi qua các bãi biển, bãi bồi và rừng thông, nổi tiếng với hoàng hôn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan pesisir di sepanjang pantai Laut Kuning Taean di Chungcheong Selatan. Melewati pantai, dataran lumpur, dan hutan pinus, dan dikenal dengan matahari terbenamnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถนนชายฝั่งริมทะเลเหลืองของแทอันในจังหวัดชุงชองใต้ ผ่านชายหาด หาดโคลน และป่าสน เป็นที่รู้จักด้านพระอาทิตย์ตก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दक्षिण चुंगचोंग में ताएआन के पीला सागर तट के किनारे तटीय सड़क। यह समुद्र तटों, ज्वारीय दलदलों और चीड़ के वनों से गुज़रती है और सूर्यास्त के लिए जानी जाती है।"
          }
        }
      }
    },
    "|A coastal road along the east coast of Gangwon. Drivers run beside the sea and can enjoy sunrises and shoreline scenery." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "江原道の東海岸に沿う海岸道路です。海沿いをドライブしながら日の出と海岸の景色を楽しめます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿江原道东海岸的公路。驾车沿海而行，可欣赏日出和海岸风光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿著江原道東海岸的濱海道路。駕車沿海而行，可欣賞日出與海岸風光。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Küstenstraße entlang der Ostküste von Gangwon. Man fährt am Meer entlang und kann Sonnenaufgänge und Küstenlandschaft genießen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Route côtière le long de la côte est du Gangwon. On roule au bord de la mer et l'on profite des levers de soleil et des paysages du littoral."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strada costiera lungo la costa orientale del Gangwon. Si guida accanto al mare godendo di albe e paesaggi del litorale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carretera costera a lo largo de la costa este de Gangwon. Los conductores corren junto al mar y pueden disfrutar de amaneceres y paisajes del litoral."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrada costeira ao longo da costa leste de Gangwon. Os motoristas seguem ao lado do mar e podem apreciar nasceres do sol e paisagens do litoral."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một con đường ven biển dọc bờ đông Gangwon. Người lái xe chạy bên bờ biển và có thể ngắm bình minh cùng cảnh bờ biển."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan pesisir di sepanjang pantai timur Gangwon. Pengemudi melaju di samping laut dan dapat menikmati matahari terbit serta pemandangan garis pantai."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถนนชายฝั่งริมชายฝั่งตะวันออกของคังวอน ผู้ขับรถวิ่งเลียบทะเลและเพลิดเพลินกับพระอาทิตย์ขึ้นและทิวทัศน์ชายฝั่ง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गांगवोन के पूर्वी तट के साथ तटीय सड़क। चालक समुद्र के किनारे चलते हुए सूर्योदय और तटरेखा के दृश्यों का आनंद ले सकते हैं।"
          }
        }
      }
    },
    "|A coastal road along the eastern sea of Namhae, South Gyeongsang. It links Mulgeon village and Mijo, passing the sea, fishing villages and a coastal forest." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慶尚南道・南海の東の海沿いにある海岸道路です。物件村と味造をつなぎ、海、漁村、海岸林を通ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿庆尚南道南海东海的海岸公路。连接勿巾村和美助，途经大海、渔村和海岸森林。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿著慶尚南道南海東側海域的濱海道路。連接勿巾村與美助，沿途經過大海、漁村與海岸林。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Küstenstraße entlang des Ostmeeres von Namhae, Süd-Gyeongsang. Sie verbindet das Dorf Mulgeon und Mijo und führt am Meer, an Fischerdörfern und einem Küstenwald vorbei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Route côtière le long de la mer orientale de Namhae (Gyeongsang du Sud). Elle relie le village de Mulgeon à Mijo, en passant par la mer, des villages de pêcheurs et une forêt côtière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strada costiera lungo il mare orientale di Namhae, nel Gyeongsang meridionale. Collega il villaggio di Mulgeon e Mijo, passando per il mare, villaggi di pescatori e una foresta costiera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carretera costera a lo largo del mar oriental de Namhae, Gyeongsang del Sur. Une la aldea de Mulgeon y Mijo, pasando por el mar, aldeas de pescadores y un bosque costero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrada costeira ao longo do mar oriental de Namhae, Gyeongsang do Sul. Liga a vila de Mulgeon a Mijo, passando pelo mar, por vilas de pescadores e por uma floresta costeira."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một con đường ven biển dọc bờ biển phía đông Namhae, Nam Gyeongsang. Đường nối làng Mulgeon và Mijo, đi qua biển, các làng chài và một khu rừng ven biển."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan pesisir di sepanjang laut timur Namhae, Gyeongsang Selatan. Menghubungkan desa Mulgeon dan Mijo, melewati laut, desa nelayan, dan hutan pesisir."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถนนชายฝั่งริมทะเลตะวันออกของนัมแฮ จังหวัดคยองซังใต้ เชื่อมหมู่บ้านมูลกอนกับมีโจ ผ่านทะเล หมู่บ้านชาวประมง และป่าชายฝั่ง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दक्षिण ग्योंगसांग के नामहे के पूर्वी सागर के किनारे तटीय सड़क। यह मुलगेओन गाँव और मिजो को जोड़ती है, और समुद्र, मछुआरों के गाँवों और तटीय वन से गुज़रती है।"
          }
        }
      }
    },
    "|A coastal road along the sea in Gangneung, Gangwon, with cliffs on one side and the East Sea on the other. Its name comes from a Silla-era hyangga poem." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "江原道・江陵の海沿いにある海岸道路で、片側は断崖、もう片側は東海です。名前は新羅時代の郷歌に由来します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于江原道江陵沿海的公路，一侧是悬崖，另一侧是东海。其名称源自新罗时代的乡歌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於江原道江陵、沿海而行的道路，一側是懸崖，另一側是東海。路名取自新羅時代的鄉歌。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Küstenstraße am Meer in Gangneung, Gangwon, mit Klippen auf der einen und dem Ostmeer auf der anderen Seite. Ihr Name stammt von einem Hyangga-Gedicht aus der Silla-Zeit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Route côtière au bord de la mer à Gangneung (Gangwon), avec des falaises d'un côté et la mer de l'Est de l'autre. Son nom vient d'un poème hyangga de l'époque Silla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strada costiera lungo il mare a Gangneung, nel Gangwon, con scogliere da un lato e il Mare Orientale dall’altro. Il suo nome deriva da una poesia hyangga dell’epoca Silla."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carretera costera junto al mar en Gangneung, Gangwon, con acantilados a un lado y el Mar del Este al otro. Su nombre proviene de un poema hyangga de la época Silla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrada costeira ao longo do mar em Gangneung, Gangwon, com penhascos de um lado e o Mar do Leste do outro. Seu nome vem de um poema hyangga da era Silla."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một con đường ven biển ở Gangneung, Gangwon, một bên là vách đá và bên kia là Đông Hải. Tên đường bắt nguồn từ một bài thơ hyangga thời Silla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan pesisir di tepi laut di Gangneung, Gangwon, dengan tebing di satu sisi dan Laut Timur di sisi lain. Namanya berasal dari puisi hyangga era Silla."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถนนชายฝั่งริมทะเลในคังนึง คังวอน มีหน้าผาด้านหนึ่งและทะเลตะวันออกอีกด้านหนึ่ง ชื่อมาจากบทกวีฮยังกาในสมัยซิลลา"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गांगवोन के गांगनुंग में समुद्र के किनारे तटीय सड़क, जिसके एक ओर चट्टानें और दूसरी ओर पूर्वी सागर है। इसका नाम सिल्ला काल की एक ह्यांगगा कविता से आया है।"
          }
        }
      }
    },
    "|A coastal road along the sea in Jinhae, Changwon. It offers views of harbors and islands and is busy during the cherry blossom festival." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昌原・鎮海の海沿いにある海岸道路です。港や島を眺められ、桜まつりの時期はにぎわいます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于昌原镇海沿海的公路。可望见港口和岛屿，樱花节期间十分热闹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於昌原鎮海、沿海而行的道路。可眺望港口與島嶼，櫻花節期間十分熱鬧。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Küstenstraße am Meer in Jinhae, Changwon. Sie bietet Ausblicke auf Häfen und Inseln und ist während des Kirschblütenfestes stark befahren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Route côtière au bord de la mer à Jinhae, Changwon. Elle offre des vues sur les ports et les îles et est très fréquentée pendant le festival des cerisiers en fleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strada costiera lungo il mare a Jinhae, Changwon. Offre viste su porti e isole ed è affollata durante il festival dei ciliegi in fiore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carretera costera junto al mar en Jinhae, Changwon. Ofrece vistas de puertos e islas y está muy concurrida durante el festival de los cerezos en flor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrada costeira ao longo do mar em Jinhae, Changwon. Oferece vistas de portos e ilhas e fica movimentada durante o festival das cerejeiras em flor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một con đường ven biển ở Jinhae, Changwon. Đường cho tầm nhìn ra các bến cảng và đảo, và rất đông đúc trong lễ hội hoa anh đào."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan pesisir di tepi laut di Jinhae, Changwon. Menawarkan pemandangan pelabuhan dan pulau-pulau, dan ramai saat festival bunga sakura."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถนนชายฝั่งริมทะเลในชินแฮ ชางวอน ให้ทิวทัศน์ท่าเรือและเกาะ และคึกคักในช่วงเทศกาลซากุระ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चांगवोन के जिनहे में समुद्र के किनारे तटीय सड़क। यह बंदरगाहों और द्वीपों के दृश्य देती है और चेरी ब्लॉसम उत्सव के दौरान व्यस्त रहती है।"
          }
        }
      }
    },
    "|A coastal road along the west coast of Yeonggwang, South Jeolla. It is known for sunsets, with views over the sea and tidal flats." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全羅南道・霊光の西海岸にある海岸道路です。夕日で知られ、海と干潟の眺めが楽しめます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于全罗南道灵光西海岸的海岸公路。以日落闻名，可眺望大海和滩涂。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿著全羅南道靈光西海岸的濱海道路。以日落聞名，可眺望大海與灘塗。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Küstenstraße an der Westküste von Yeonggwang, Süd-Jeolla. Sie ist für Sonnenuntergänge bekannt, mit Blick über das Meer und die Wattflächen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Route côtière sur la côte ouest de Yeonggwang (Jeolla du Sud). Elle est connue pour ses couchers de soleil, avec des vues sur la mer et les estrans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strada costiera lungo la costa occidentale di Yeonggwang, nel Jeolla meridionale. È nota per i tramonti, con viste sul mare e sulle distese di fango."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carretera costera a lo largo de la costa oeste de Yeonggwang, Jeolla del Sur. Es conocida por los atardeceres, con vistas del mar y de las llanuras de marea."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrada costeira ao longo da costa oeste de Yeonggwang, Jeolla do Sul. É conhecida pelos pores do sol, com vistas do mar e das planícies de maré."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một con đường ven biển dọc bờ tây Yeonggwang, Nam Jeolla. Nơi đây nổi tiếng với hoàng hôn, với tầm nhìn ra biển và bãi bồi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan pesisir di sepanjang pantai barat Yeonggwang, Jeolla Selatan. Dikenal dengan matahari terbenam, dengan pemandangan laut dan dataran lumpur."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถนนชายฝั่งริมชายฝั่งตะวันตกของยองกวัง จังหวัดช็อลลาใต้ เป็นที่รู้จักด้านพระอาทิตย์ตก พร้อมทิวทัศน์ทะเลและหาดโคลน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दक्षिण जेओला के योंगग्वांग के पश्चिमी तट के किनारे तटीय सड़क। यह सूर्यास्त के लिए जानी जाती है, जहाँ समुद्र और ज्वारीय दलदलों के दृश्य मिलते हैं।"
          }
        }
      }
    },
    "|A coastal road at Sagye-ri in Seogwipo, Jeju. It offers a drive with Sanbangsan and Hyeongje Island across the sea." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "済州・西帰浦の沙渓里にある海岸道路です。海の向こうに山房山と兄弟島を望むドライブが楽しめます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于济州西归浦沙溪里的海岸公路。驾车时可隔海望见山房山和兄弟岛。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於濟州西歸浦沙溪里的濱海道路。駕車時可隔海眺望山房山與兄弟島。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Küstenstraße in Sagye-ri in Seogwipo, Jeju. Sie bietet eine Fahrt mit Blick über das Meer auf den Sanbangsan und die Insel Hyeongje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Route côtière à Sagye-ri, Seogwipo (Jeju). Elle offre une promenade en voiture avec le Sanbangsan et l'île de Hyeongje de l'autre côté de la mer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strada costiera a Sagye-ri, a Seogwipo, Jeju. Offre un percorso in auto con il Sanbangsan e l’isola Hyeongje di fronte, oltre il mare."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carretera costera en Sagye-ri, Seogwipo, Jeju. Ofrece un recorrido en coche con Sanbangsan y la isla Hyeongje al otro lado del mar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrada costeira em Sagye-ri, Seogwipo, Jeju. Oferece um passeio de carro com Sanbangsan e a ilha Hyeongje do outro lado do mar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một con đường ven biển ở Sagye-ri, Seogwipo, Jeju. Đây là cung đường lái xe với núi Sanbangsan và đảo Hyeongje bên kia biển."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan pesisir di Sagye-ri di Seogwipo, Jeju. Menawarkan berkendara dengan Sanbangsan dan Pulau Hyeongje di seberang laut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถนนชายฝั่งที่ซาเยรี ซอกวิโพ เชจู ให้การขับรถชมซันบังซันและเกาะฮยองเจที่อยู่ฝั่งตรงข้ามทะเล"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जेजू के सेओग्वीपो के सागये-री में तटीय सड़क। समुद्र के पार सान्बांगसान और ह्योंगजे द्वीप के साथ यह ड्राइव का आनंद देती है।"
          }
        }
      }
    },
    "|A coastal road circling Mireukdo Island in Tongyeong, South Gyeongsang. It runs beside the sea and islands, and is known for sunsets and the view from Darae Park." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慶尚南道・統営の弥勒島を一周する海岸道路です。海と島々の横を走り、夕日とタラ公園からの眺めで知られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "环绕庆尚南道统营弥勒岛的海岸公路。沿着大海和岛屿而行，以日落和从多来公园眺望的景色闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "環繞慶尚南道統營彌勒島的濱海道路。沿著大海與島嶼而行，以日落及從達牙公園看出去的景色聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Küstenstraße rund um die Insel Mireukdo in Tongyeong, Süd-Gyeongsang. Sie verläuft am Meer und an Inseln entlang und ist für Sonnenuntergänge und den Blick vom Darae-Park bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Route côtière qui fait le tour de l'île de Mireukdo à Tongyeong (Gyeongsang du Sud). Elle longe la mer et les îles et est connue pour ses couchers de soleil et la vue depuis le parc Darae."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strada costiera che circonda l’isola di Mireukdo a Tongyeong, nel Gyeongsang meridionale. Corre accanto al mare e alle isole ed è nota per i tramonti e per la vista dal parco Darae."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carretera costera que rodea la isla Mireukdo en Tongyeong, Gyeongsang del Sur. Corre junto al mar y las islas, y es conocida por los atardeceres y la vista desde el parque Darae."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrada costeira que contorna a ilha de Mireukdo, em Tongyeong, Gyeongsang do Sul. Corre ao lado do mar e das ilhas e é conhecida pelos pores do sol e pela vista do Parque Darae."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một con đường ven biển vòng quanh đảo Mireukdo ở Tongyeong, Nam Gyeongsang. Đường chạy bên biển và các đảo, nổi tiếng với hoàng hôn và tầm nhìn từ công viên Darae."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan pesisir yang mengelilingi Pulau Mireukdo di Tongyeong, Gyeongsang Selatan. Berjalan di samping laut dan pulau-pulau, dan dikenal dengan matahari terbenam serta pemandangan dari Taman Darae."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถนนชายฝั่งรอบเกาะมีรึกโดในทงยอง จังหวัดคยองซังใต้ วิ่งเลียบทะเลและเกาะ เป็นที่รู้จักด้านพระอาทิตย์ตกและวิวจากสวนดารา"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दक्षिण ग्योंगसांग के तोंगयोंग में मिरेउकदो द्वीप का चक्कर लगाती तटीय सड़क। यह समुद्र और द्वीपों के किनारे चलती है, और सूर्यास्त तथा दाराए पार्क से दिखने वाले दृश्य के लिए जानी जाती है।"
          }
        }
      }
    },
    "|A communication and observation tower on top of Namsan Mountain. It offers wide views over central Seoul and the Han River, and is known for its love lock fences." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "南山の頂上にある通信・展望タワーです。ソウル中心部と漢江を広く見渡せ、愛の南京錠のフェンスで知られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于南山山顶的通信与观景塔。可远眺首尔市中心和汉江，以爱情锁栅栏闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於南山山頂的通訊與觀景塔。可遠眺首爾市中心與漢江的寬闊景色，以愛情鎖欄杆聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kommunikations- und Aussichtsturm auf dem Gipfel des Namsan. Er bietet weite Ausblicke über das Zentrum von Seoul und den Han-Fluss und ist für seine Liebesschloss-Zäune bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tour de communication et d'observation au sommet du mont Namsan. Elle offre de larges vues sur le centre de Séoul et le fleuve Han, et est connue pour ses grillages de cadenas d'amour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torre di comunicazione e osservazione in cima al monte Namsan. Offre ampie viste sul centro di Seoul e sul fiume Han ed è nota per le recinzioni di lucchetti dell’amore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torre de comunicaciones y observación en lo alto de la montaña Namsan. Ofrece amplias vistas del centro de Seúl y del río Han, y es conocida por sus vallas de candados del amor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torre de comunicação e observação no topo da montanha Namsan. Oferece amplas vistas do centro de Seul e do rio Han e é conhecida por suas cercas de cadeados do amor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một tháp truyền thông và quan sát trên đỉnh núi Namsan. Tháp có tầm nhìn rộng ra trung tâm Seoul và sông Hàn, và nổi tiếng với hàng rào khóa tình yêu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menara komunikasi dan observasi di puncak Gunung Namsan. Menawarkan pemandangan luas atas pusat Kota Seoul dan Sungai Han, dan dikenal dengan pagar gembok cintanya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หอสื่อสารและหอชมวิวบนยอดเขานัมซาน ให้ทิวทัศน์กว้างไกลเหนือใจกลางโซลและแม่น้ำฮัน เป็นที่รู้จักด้านรั้วกุญแจรัก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नामसान पर्वत के शिखर पर संचार और अवलोकन मीनार। यहाँ से मध्य सियोल और हान नदी के विस्तृत दृश्य दिखते हैं, और यह प्रेम-ताला बाड़ों के लिए जानी जाती है।"
          }
        }
      }
    },
    "|A conference hall on Dongbaekseom in Busan. It hosted the 2005 Asia-Pacific Economic Cooperation summit and offers views over the sea." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "釜山の冬柏島にある会議場です。2005年にアジア太平洋経済協力首脳会議が開かれ、海の眺めが楽しめます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于釜山冬柏岛的会议馆。曾举办2005年亚太经合组织峰会，可眺望大海。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於釜山冬柏島的會議廳。曾舉辦2005年亞太經合會領袖峰會，可眺望海景。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Konferenzhalle auf Dongbaekseom in Busan. Hier fand 2005 der Gipfel der Asiatisch-Pazifischen Wirtschaftskooperation statt, und sie bietet Ausblicke aufs Meer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palais des congrès sur Dongbaekseom à Busan. Il a accueilli le sommet de la coopération économique Asie-Pacifique en 2005 et offre des vues sur la mer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centro congressi su Dongbaekseom a Busan. Ha ospitato il vertice della Cooperazione economica Asia-Pacifico del 2005 e offre viste sul mare."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sala de conferencias en Dongbaekseom, Busan. Acogió la cumbre de Cooperación Económica Asia-Pacífico de 2005 y ofrece vistas del mar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centro de conferências em Dongbaekseom, Busan. Sediou a cúpula da Cooperação Econômica Ásia-Pacífico de 2005 e oferece vistas do mar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một hội trường hội nghị trên Dongbaekseom ở Busan. Nơi đây từng đăng cai hội nghị thượng đỉnh Hợp tác Kinh tế châu Á - Thái Bình Dương năm 2005 và có tầm nhìn ra biển."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aula konferensi di Dongbaekseom di Busan. Menjadi tuan rumah KTT Kerja Sama Ekonomi Asia-Pasifik 2005 dan menawarkan pemandangan laut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ศูนย์ประชุมบนดงแบกซอมในปูซาน เคยจัดการประชุมสุดยอดความร่วมมือทางเศรษฐกิจเอเชีย-แปซิฟิกปี 2005 และให้ทิวทัศน์ทะเล"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बुसान के डोंगबेकसेओम पर एक सम्मेलन भवन। इसने 2005 के एशिया-प्रशांत आर्थिक सहयोग शिखर सम्मेलन की मेज़बानी की थी और यहाँ से समुद्र के दृश्य दिखते हैं।"
          }
        }
      }
    },
    "|A contemporary art exhibition hall in Buk-gu, Gwangju. It serves as the main venue for the city’s international art biennale held every two years." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光州・北区にある現代美術の展示館です。2年に一度開かれる市の国際美術ビエンナーレの主会場を務めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于光州北区的当代艺术展馆。是该市每两年举办一次的国际艺术双年展的主会场。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於光州北區的當代藝術展館。是該市每兩年舉辦一次的國際藝術雙年展的主要場地。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Ausstellungshalle für zeitgenössische Kunst in Buk-gu, Gwangju. Sie dient als Hauptveranstaltungsort der internationalen Kunstbiennale der Stadt, die alle zwei Jahre stattfindet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salle d'exposition d'art contemporain dans le Buk-gu de Gwangju. Elle sert de lieu principal à la biennale internationale d'art de la ville, qui a lieu tous les deux ans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sala espositiva di arte contemporanea a Buk-gu, Gwangju. È la sede principale della biennale d’arte internazionale della città, che si tiene ogni due anni."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sala de exposiciones de arte contemporáneo en Buk-gu, Gwangju. Es la sede principal de la bienal internacional de arte de la ciudad, que se celebra cada dos años."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salão de exposições de arte contemporânea em Buk-gu, Gwangju. É o principal local da bienal internacional de arte da cidade, realizada a cada dois anos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một hội trường triển lãm nghệ thuật đương đại ở quận Buk-gu, Gwangju. Nơi đây là địa điểm chính của hai năm một lần triển lãm nghệ thuật quốc tế của thành phố."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aula pameran seni kontemporer di Buk-gu, Gwangju. Menjadi tempat utama biennale seni internasional kota yang diadakan setiap dua tahun."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หอนิทรรศการศิลปะร่วมสมัยในเขตบุกกู เมืองควังจู เป็นสถานที่จัดงานหลักของงานเบียนนาเล่ศิลปะนานาชาติของเมืองที่จัดทุกสองปี"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्वांगजू के बुक-गु में समकालीन कला प्रदर्शनी भवन। यह हर दो साल में होने वाले शहर के अंतरराष्ट्रीय कला द्विवार्षिक का मुख्य स्थल है।"
          }
        }
      }
    },
    "|A cork oak in Sillim-dong, Gwanak District, Seoul. An old urban tree that has been protected for its age." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソウル・冠岳区の新林洞にあるコルクガシの木です。古い都市の樹木で、その樹齢のゆえに保護されています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于首尔冠岳区新林洞的栓皮栎。一棵因树龄而受到保护的都市古树。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於首爾冠岳區新林洞的栓皮櫟。這是一棵都市中的老樹，因樹齡而受到保護。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Korkeiche in Sillim-dong, Bezirk Gwanak, Seoul. Ein alter Stadtbaum, der wegen seines Alters geschützt ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chêne-liège à Sillim-dong, dans le district de Gwanak à Séoul. Vieil arbre urbain protégé en raison de son âge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una quercia da sughero a Sillim-dong, nel distretto di Gwanak, Seoul. Un vecchio albero urbano protetto per la sua età."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcornoque en Sillim-dong, distrito de Gwanak, Seúl. Un viejo árbol urbano protegido por su edad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobreiro em Sillim-dong, distrito de Gwanak, Seul. Uma antiga árvore urbana protegida por sua idade."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một cây sồi bần ở Sillim-dong, quận Gwanak, Seoul. Một cây đô thị lâu đời được bảo vệ vì tuổi đời của nó."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohon ek gabus di Sillim-dong, Distrik Gwanak, Seoul. Pohon kota tua yang dilindungi karena usianya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้นโอ๊กคอร์กในซิลลิมดง เขตควานัก กรุงโซล ต้นไม้เก่าแก่กลางเมืองที่ได้รับการคุ้มครองเพราะอายุของมัน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सियोल के ग्वानक ज़िले के सिल्लिम-दोंग में एक कॉर्क ओक। यह शहरी इलाके का पुराना पेड़ है, जिसे उसकी उम्र के कारण संरक्षित किया गया है।"
          }
        }
      }
    },
    "|A cultural complex built around the former provincial office site in Dong-gu, Gwangju. It offers exhibitions, performances and research spaces." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光州・東区の旧道庁跡地を中心に造られた文化複合施設です。展示、公演、研究の空間があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "围绕光州东区旧道厅旧址建成的文化综合体。提供展览、演出和研究空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以舊道廳舊址為中心興建的文化綜合設施，位於光州東區。提供展覽、表演與研究空間。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kulturkomplex rund um das Gelände des ehemaligen Provinzamts in Dong-gu, Gwangju. Er bietet Ausstellungen, Aufführungen und Forschungsräume."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complexe culturel construit autour de l'ancien site de la préfecture provinciale, dans le Dong-gu de Gwangju. Il propose des expositions, des spectacles et des espaces de recherche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complesso culturale costruito attorno al sito dell’ex sede della provincia a Dong-gu, Gwangju. Offre mostre, spettacoli e spazi di ricerca."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complejo cultural construido en torno al antiguo emplazamiento de la oficina provincial en Dong-gu, Gwangju. Ofrece exposiciones, espectáculos y espacios de investigación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complexo cultural construído em torno do antigo prédio do governo provincial em Dong-gu, Gwangju. Oferece exposições, espetáculos e espaços de pesquisa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một quần thể văn hóa xây quanh khu văn phòng tỉnh cũ ở quận Dong-gu, Gwangju. Nơi đây có triển lãm, biểu diễn và không gian nghiên cứu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompleks budaya yang dibangun di sekitar bekas lokasi kantor provinsi di Dong-gu, Gwangju. Menawarkan pameran, pertunjukan, dan ruang penelitian."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อาคารวัฒนธรรมที่สร้างรอบพื้นที่ที่ตั้งของที่ทำการจังหวัดเดิมในเขตทงกู เมืองควังจู มีนิทรรศการ การแสดง และพื้นที่วิจัย"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्वांगजू के डोंग-गु में पूर्व प्रांतीय कार्यालय स्थल के चारों ओर बना सांस्कृतिक परिसर। यहाँ प्रदर्शनियाँ, प्रस्तुतियाँ और शोध स्थल हैं।"
          }
        }
      }
    },
    "|A cultural complex in Seocho-gu with opera and concert halls, an art museum and a calligraphy museum." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瑞草区にある文化複合施設で、オペラ劇場とコンサートホール、美術館、書芸博物館があります。"
