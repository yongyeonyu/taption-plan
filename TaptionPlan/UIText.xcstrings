            "value" : "iPhoneのWatch App → マイウォッチ → 利用可能なApp → BOKKI Planの横の「インストール」をタップ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上的“Watch”App 中 → “我的手表” → “可用的 App” → 点按 BOKKI Plan 旁的“安装”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 的「Watch」App 中 →「我的手錶」→「可用的 App」→ 點一下 BOKKI Plan 旁的「安裝」"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Watch-App auf dem iPhone → Meine Watch → Verfügbare Apps → tippe bei BOKKI Plan auf „Installieren“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans l'app Watch de l'iPhone → Ma montre → Apps disponibles → touchez « Installer » à côté de BOKKI Plan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nell'app Watch su iPhone → Il mio Watch → App disponibili → tocca “Installa” accanto a BOKKI Plan"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la app Watch del iPhone → Mi reloj → Apps disponibles → toca “Instalar” junto a BOKKI Plan"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No app Watch do iPhone → Meu Watch → Apps Disponíveis → toque em “Instalar” ao lado de BOKKI Plan"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong ứng dụng Watch trên iPhone → Đồng hồ của tôi → Ứng dụng có sẵn → nhấn “Cài đặt” cạnh BOKKI Plan"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di app Watch pada iPhone → Jam Saya → App Tersedia → ketuk “Instal” di samping BOKKI Plan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในแอป Watch บน iPhone → Watch ของฉัน → แอปที่มี → แตะ “ติดตั้ง” ข้าง BOKKI Plan"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone के Watch ऐप में → मेरी वॉच → उपलब्ध ऐप्स → BOKKI Plan के आगे “इंस्टॉल करें” दबाएँ"
          }
        }
      }
