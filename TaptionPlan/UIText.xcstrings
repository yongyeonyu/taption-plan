    },
    "위치 점(위도·경도·고도·시각)만 담아요. 활동·건강·가계부·메모는 들어가지 않고, 다른 지도·운동 앱에서 열 수 있어요.|Contains location points only (latitude, longitude, altitude, time). No activities, health, ledger or memos. Opens in other map and fitness apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置の点（緯度・経度・高度・時刻）だけを入れます。アクティビティ・ヘルスケア・家計簿・メモは入らず、ほかの地図・運動アプリで開けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只包含位置点（纬度、经度、海拔、时间）。不含活动、健康、账本或备忘，可在其他地图和运动 App 中打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只包含位置點（緯度、經度、海拔、時間）。不含活動、健康、帳本或備忘，可在其他地圖和運動 App 中打開。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält nur Standortpunkte (Breite, Länge, Höhe, Zeit). Keine Aktivitäten, Health-Daten, Ausgaben oder Notizen. Lässt sich in anderen Karten- und Fitness-Apps öffnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contient uniquement des points de position (latitude, longitude, altitude, heure). Pas d’activités, de santé, de budget ni de notes. S’ouvre dans d’autres apps de cartes et de sport."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiene solo punti di posizione (latitudine, longitudine, altitudine, ora). Niente attività, salute, spese o note. Si apre in altre app di mappe e fitness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiene solo puntos de ubicación (latitud, longitud, altitud, hora). Sin actividades, salud, gastos ni notas. Se abre en otras apps de mapas y deporte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contém apenas pontos de localização (latitude, longitude, altitude, hora). Sem atividades, saúde, gastos ou notas. Abre em outros apps de mapas e exercícios."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ chứa các điểm vị trí (vĩ độ, kinh độ, độ cao, thời gian). Không có hoạt động, sức khỏe, chi tiêu hay ghi chú. Mở được trong ứng dụng bản đồ và thể thao khác."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya berisi titik lokasi (lintang, bujur, ketinggian, waktu). Tanpa aktivitas, kesehatan, buku kas, atau memo. Bisa dibuka di app peta dan kebugaran lain."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีเฉพาะจุดตำแหน่ง (ละติจูด ลองจิจูด ความสูง เวลา) ไม่มีกิจกรรม สุขภาพ บัญชีรายจ่าย หรือโน้ต เปิดได้ในแอปแผนที่และออกกำลังกายอื่น"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल स्थान बिंदु (अक्षांश, देशांतर, ऊँचाई, समय) होते हैं। गतिविधि, स्वास्थ्य, खर्च या मेमो नहीं। दूसरे मैप और फ़िटनेस ऐप में खुलता है।"
          }
        }
      }
    },
