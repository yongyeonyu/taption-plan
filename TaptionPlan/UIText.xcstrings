          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{0} backup di una versione precedente non possono essere aperti qui e non sono elencati. I file non sono stati toccati."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las {0} copias de una versión anterior no se pueden abrir aquí y no aparecen en la lista. Los archivos no se han tocado."
          }
