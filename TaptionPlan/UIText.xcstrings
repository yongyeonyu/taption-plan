    "모든 권한이 확인되면 GPS와 센서 기록이 5분 간격으로 자동 시작됩니다.|GPS and sensor recording starts automatically every 5 minutes after all permissions are verified." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての許可を確認すると、GPSとセンサーの記録が5分ごとに自動で始まります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证所有权限后，GPS 和传感器记录会每5分钟自动开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證所有權限後，GPS 與感測器記錄會每 5 分鐘自動開始。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die GPS- und Sensoraufzeichnung startet automatisch alle 5 Minuten, sobald alle Berechtigungen bestätigt sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement GPS et des capteurs démarre automatiquement toutes les 5 minutes une fois toutes les autorisations vérifiées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione di GPS e sensori parte automaticamente ogni 5 minuti dopo la verifica di tutti i permessi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de GPS y sensores empieza automáticamente cada 5 minutos una vez verificados todos los permisos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro de GPS e sensores começa automaticamente a cada 5 minutos depois que todas as permissões são verificadas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc ghi GPS và cảm biến tự động bắt đầu mỗi 5 phút sau khi xác minh mọi quyền."
          }
        },
        "id" : {
          "stringUnit" : {
