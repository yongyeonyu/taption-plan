          "stringUnit" : {
            "state" : "translated",
            "value" : "変更内容をストレージと再照合できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法再次对照存储验证更改。"
