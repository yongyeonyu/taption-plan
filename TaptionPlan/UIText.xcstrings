    "|Kaohsiung is a port city in southern Taiwan with a major harbor. The waterfront art districts and Lotus Pond are popular sights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高雄は台湾南部の港湾都市で、大きな港があります。ウォーターフロントのアート地区と蓮池潭が人気の名所です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高雄是台湾南部的港口城市，拥有大型港口。滨水艺术区和莲池潭是热门景点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高雄是台灣南部的港口城市,擁有大型港口。濱水的藝術特區與蓮池潭是熱門景點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaohsiung ist eine Hafenstadt im Süden Taiwans mit einem großen Hafen. Die Kunstviertel am Wasser und der Lotusteich sind beliebte Sehenswürdigkeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaohsiung est une ville portuaire du sud de Taïwan dotée d'un grand port. Les quartiers artistiques du front de mer et l'étang aux Lotus sont des sites prisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaohsiung è una città portuale del Taiwan meridionale con un grande porto. I distretti artistici sul lungomare e il Lotus Pond sono attrazioni molto frequentate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaohsiung es una ciudad portuaria del sur de Taiwán con un importante puerto. Los distritos artísticos frente al mar y el Estanque del Loto son atractivos populares."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaohsiung é uma cidade portuária no sul de Taiwan, com um grande porto. Os distritos de arte à beira-mar e o Lótus Pond são atrações populares."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cao Hùng là thành phố cảng ở miền nam Đài Loan với một bến cảng lớn. Các khu nghệ thuật ven bờ nước và Hồ Sen là những điểm tham quan được ưa chuộng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaohsiung adalah kota pelabuhan di Taiwan selatan dengan pelabuhan besar. Distrik seni tepi laut dan Lotus Pond adalah tempat wisata populer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกาสงเป็นเมืองท่าทางตอนใต้ของไต้หวันที่มีท่าเรือสำคัญ ย่านศิลปะริมน้ำและ Lotus Pond เป็นแหล่งท่องเที่ยวยอดนิยม"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काओशुंग दक्षिणी ताइवान का बंदरगाह शहर है, जहाँ बड़ा बंदरगाह है। जलतट के कला जिले और लोटस पॉन्ड लोकप्रिय दर्शनीय स्थल हैं।"
          }
        }
      }
    },
