        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distrito editorial en Paju formado por editoriales, imprentas, librerías y galerías. Es un lugar para disfrutar de libros junto a una arquitectura distintiva."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distrito editorial em Paju formado por editoras, gráficas, livrarias e galerias. É um lugar para apreciar livros junto a uma arquitetura distinta."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một khu xuất bản ở Paju gồm các nhà xuất bản, nhà in, hiệu sách và phòng tranh. Đây là nơi để thưởng thức sách cùng kiến trúc độc đáo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kawasan penerbitan di Paju yang terdiri dari penerbit, percetakan, toko buku, dan galeri. Tempat menikmati buku bersama arsitektur yang unik."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย่านสำนักพิมพ์ในพาจูที่ประกอบด้วยสำนักพิมพ์ โรงพิมพ์ ร้านหนังสือ และแกลเลอรี เป็นที่เพลิดเพลินกับหนังสือควบคู่ไปกับสถาปัตยกรรมที่โดดเด่น"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पाजू में प्रकाशकों, मुद्रकों, पुस्तक दुकानों और दीर्घाओं से बना प्रकाशन मोहल्ला। यह विशिष्ट वास्तुकला के साथ पुस्तकों का आनंद लेने की जगह है।"
          }
        }
      }
    },
    "|A rail bike ride along an old coastal railway in Samcheok. Riders pedal past sea and cliff scenery." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三陟の古い海岸線の線路を走るレールバイクです。海と断崖の景色の中をペダルをこいで進みます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿三陟旧海岸铁路的铁道自行车体验。骑行者蹬车经过海景和悬崖风光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿著三陟舊海岸鐵路而行的鐵道自行車。騎乘者踩著踏板，穿越海景與懸崖風光。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Schienenradfahrt auf einer alten Küstenbahnstrecke in Samcheok. Fahrer treten vorbei an Meer- und Klippenlandschaft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcours en vélorail le long d'une ancienne voie ferrée côtière à Samcheok. Les cyclistes pédalent devant des paysages de mer et de falaises."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giro in rail bike lungo un’antica ferrovia costiera a Samcheok. I partecipanti pedalano tra paesaggi di mare e scogliere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paseo en bicicleta sobre rieles por una antigua vía costera en Samcheok. Los ciclistas pedalean junto a paisajes de mar y acantilados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passeio de bicicleta sobre trilhos em uma antiga ferrovia costeira em Samcheok. Os ciclistas pedalam por paisagens de mar e penhascos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một chuyến xe đạp đường ray dọc tuyến đường sắt ven biển cũ ở Samcheok. Du khách đạp xe qua cảnh biển và vách đá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perjalanan sepeda rel di sepanjang jalur kereta pesisir lama di Samcheok. Pengendara mengayuh melewati pemandangan laut dan tebing."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การปั่นเรลไบค์ตามทางรถไฟชายฝั่งเก่าในซัมช็อก ผู้ปั่นถีบผ่านทิวทัศน์ทะเลและหน้าผา"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामचेओक में पुरानी तटीय रेलवे के साथ रेल बाइक की सवारी। सवार समुद्र और चट्टानों के दृश्यों के बीच पैडल चलाते हैं।"
          }
        }
      }
    },
    "|A railway station in Gwangsan-gu, Gwangju. It is a major gateway served by high-speed trains and is close to the airport." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光州・光山区にある鉄道駅です。高速列車が発着する主要な玄関口で、空港に近い場所にあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于光州光山区的火车站。是高速列车停靠的主要门户，靠近机场。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於光州光山區的火車站。這是高速列車停靠的主要門戶，靠近機場。"
