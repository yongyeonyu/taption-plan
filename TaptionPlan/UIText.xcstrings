    "평소에는 저전력으로 모으고, 운동을 측정할 때만 더 자주 확인합니다.|Collects in low-power mode, and checks more often only while measuring a workout." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普段は低電力で収集し、ワークアウトの測定中だけ頻繁に確認します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平时以低功耗收集，仅在测量体能训练时更频繁地检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平時以低耗電收集，僅在測量體能訓練時更頻繁地檢查。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammelt normalerweise stromsparend und prüft nur während einer Workout-Messung häufiger."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collecte en basse consommation et ne vérifie plus souvent que pendant la mesure d’une séance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di solito raccoglie a basso consumo e controlla più spesso solo durante la misurazione di un allenamento."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente recopila con bajo consumo y solo comprueba con más frecuencia al medir un entrenamiento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente coleta com baixo consumo e só verifica com mais frequência durante a medição de um treino."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thường thu thập ở chế độ tiết kiệm pin, chỉ kiểm tra thường xuyên hơn khi đo bài tập."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biasanya mengumpulkan dengan daya rendah, dan hanya lebih sering memeriksa saat mengukur olahraga."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปกติเก็บข้อมูลแบบประหยัดพลังงาน และตรวจบ่อยขึ้นเฉพาะตอนวัดการออกกำลังกาย"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आम तौर पर कम बिजली में डेटा जुटाता है, और सिर्फ़ वर्कआउट मापते समय ज़्यादा बार जाँचता है।"
          }
        }
      }
    },
    "평소처럼 지내면 하루가 쌓입니다. 저녁에 지도를 열고 재생해 보세요.|Go about your day and it builds up. Open the map tonight and tap Play." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普段どおり過ごせば、自然とたまっていきます。今夜、地図を開いて再生をタップしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "过你的一天，记录就会不断积累。今晚打开地图，点按“播放”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照常過你的一天，內容就會累積起來。今晚打開地圖，點一下「播放」。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leb deinen Tag, dann baut es sich auf. Öffne heute Abend die Karte und tippe auf Abspielen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vivez votre journée et elle se construit. Ce soir, ouvrez la carte et touchez Lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vivi la tua giornata e si accumula. Stasera apri la mappa e tocca Riproduci."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz tu día y se irá acumulando. Esta noche abre el mapa y toca Reproducir."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siga com o seu dia e isso vai se acumulando. Abra o mapa à noite e toque em Reproduzir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cứ sống ngày của bạn, bản ghi sẽ tự dày lên. Tối nay hãy mở bản đồ và nhấn Phát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalani hari Anda dan catatan akan terkumpul. Buka peta malam ini dan ketuk Putar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ชีวิตไปตามปกติแล้วบันทึกจะสะสมเอง คืนนี้เปิดแผนที่แล้วแตะเล่น"
          }
        },
        "hi" : {
