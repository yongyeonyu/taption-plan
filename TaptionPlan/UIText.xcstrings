        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現有的備份已損毀，且這部裝置並未保存完整內容，因此未覆寫。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
