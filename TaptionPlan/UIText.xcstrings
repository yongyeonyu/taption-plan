    "|Yantai is a port city on the northern coast of the Shandong Peninsula. It is known for its beaches and wine production, and is linked to Korea by sea routes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "煙台は山東半島の北岸にある港湾都市です。ビーチとワインの生産で知られ、韓国とは航路で結ばれています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烟台是山东半岛北岸的港口城市。以海滩和葡萄酒产业闻名，并有海上航线通往韩国。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "煙台是山東半島北岸的港口城市。以海灘與葡萄酒生產聞名,並有航線與韓國相連。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yantai ist eine Hafenstadt an der Nordküste der Shandong-Halbinsel. Sie ist für ihre Strände und Weinproduktion bekannt und über Seewege mit Korea verbunden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yantai est une ville portuaire sur la côte nord de la péninsule du Shandong. Elle est connue pour ses plages et sa production de vin, et est reliée à la Corée par des liaisons maritimes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yantai è una città portuale sulla costa settentrionale della penisola dello Shandong. È nota per le spiagge e la produzione di vino ed è collegata alla Corea da rotte marittime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yantai es una ciudad portuaria en la costa norte de la península de Shandong. Es conocida por sus playas y su producción de vino, y está unida a Corea por rutas marítimas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yantai é uma cidade portuária na costa norte da Península de Shandong. É conhecida pelas praias e pela produção de vinho e é ligada à Coreia por rotas marítimas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yên Đài là thành phố cảng ở bờ bắc bán đảo Sơn Đông. Nổi tiếng với bãi biển và sản xuất rượu vang, và nối với Hàn Quốc bằng các tuyến đường biển."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yantai adalah kota pelabuhan di pesisir utara Semenanjung Shandong. Dikenal dengan pantainya dan produksi anggur, dan terhubung dengan Korea melalui rute laut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เยียนไถเป็นเมืองท่าบนชายฝั่งเหนือของคาบสมุทรซานตง มีชื่อเสียงเรื่องชายหาดและการผลิตไวน์ และเชื่อมกับเกาหลีด้วยเส้นทางเดินเรือ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "येनताई शानदोंग प्रायद्वीप के उत्तरी तट पर बंदरगाह शहर है। यह अपने समुद्र तटों और वाइन उत्पादन के लिए जाना जाता है, और समुद्री मार्गों से कोरिया से जुड़ा है।"
          }
        }
      }
    },
