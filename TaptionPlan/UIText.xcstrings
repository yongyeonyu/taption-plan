        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere il messaggio di pagamento, inviato alla tua IA per il controllo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el mensaje de pago, así que se envió a tu IA para revisarlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler a mensagem de pagamento; ela foi enviada à sua IA para conferir."
