          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दक्षिणी जेओल्ला के बोसोंग में देवोनसा मंदिर की ओर जाने वाली सड़क। यह चाय उगाने वाले इलाके के पास शांत पर्वतीय जंगलों से होकर चलती है।"
          }
        }
      }
    },
    "|The road toward Hwangaksan in Gimcheon, North Gyeongsang. It passes forest and valley toward Jikjisa temple." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
