    "|Milan is the main city of Lombardy in northern Italy. It is known for its Gothic Duomo, La Scala opera house and its fashion and design industries." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミラノはイタリア北部ロンバルディア州の中心都市です。ゴシック様式のドゥオーモ、スカラ座、ファッションとデザイン産業で知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "米兰是意大利北部伦巴第大区的主要城市。以哥特式大教堂、斯卡拉歌剧院以及时装和设计产业闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "米蘭是義大利北部倫巴底的主要城市。以哥德式的大教堂、斯卡拉歌劇院,以及時尚與設計產業聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mailand ist die Hauptstadt der Lombardei in Norditalien. Sie ist für den gotischen Dom, die Mailänder Scala und ihre Mode- und Designindustrie bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milan est la principale ville de Lombardie, dans le nord de l'Italie. Elle est connue pour son Duomo gothique, l'opéra de la Scala et ses industries de la mode et du design."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milano è la città principale della Lombardia, nell'Italia settentrionale. È nota per il Duomo gotico, il Teatro alla Scala e le industrie della moda e del design."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milán es la ciudad principal de Lombardía, en el norte de Italia. Es conocida por su Duomo gótico, el teatro de ópera La Scala y sus industrias de la moda y el diseño."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milão é a principal cidade da Lombardia, no norte da Itália. É conhecida pelo Duomo gótico, pelo teatro La Scala e pelas indústrias de moda e design."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milan là thành phố chính của vùng Lombardy ở bắc Ý. Nổi tiếng với Duomo kiểu Gothic, nhà hát opera La Scala và các ngành thời trang và thiết kế."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milan adalah kota utama Lombardy di Italia utara. Dikenal dengan Duomo bergaya Gotik, gedung opera La Scala, serta industri mode dan desainnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มิลานเป็นเมืองหลักของแคว้นลอมบาร์เดียทางตอนเหนือของอิตาลี มีชื่อเสียงเรื่องมหาวิหาร Duomo แบบโกธิก โรงอุปรากร La Scala และอุตสาหกรรมแฟชั่นและดีไซน์"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिलान उत्तरी इटली के लोम्बार्डी का मुख्य शहर है। यह अपने गॉथिक दुओमो, ला स्काला ओपेरा हाउस और फ़ैशन तथा डिज़ाइन उद्योगों के लिए जाना जाता है।"
          }
        }
      }
    },
