    "색상을 선택하면 즉시 저장됩니다.|Colors save immediately." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色はすぐに保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜色会立即保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顏色會立即儲存。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farben werden sofort gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les couleurs sont enregistrées immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I colori si salvano subito."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los colores se guardan al instante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cores são salvas na hora."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu được lưu ngay lập tức."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna langsung tersimpan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกสีแล้วจะบันทึกทันที"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रंग तुरंत सहेजे जाते हैं।"
          }
        }
      }
    },
    "색은 업무·공부·이동처럼 그 시간에 한 일입니다.|Colors show what you did, like work, study, or travel." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色は、仕事・勉強・移動など、その時間にしたことを表します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜色表示那段时间做的事，如工作、学习或出行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顏色代表那段時間做的事，例如工作、學習或移動。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farben zeigen, was du getan hast, z. B. Arbeit, Lernen oder Unterwegs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les couleurs montrent ce que vous avez fait : travail, études, trajet, etc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I colori mostrano cosa hai fatto, come lavoro, studio o viaggio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los colores muestran lo que hiciste, como trabajo, estudio o viaje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cores mostram o que você fez, como trabalho, estudo ou deslocamento."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu sắc cho biết bạn đã làm gì, như công việc, học tập hay di chuyển."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna menunjukkan apa yang Anda lakukan, seperti kerja, belajar, atau perjalanan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีแสดงสิ่งที่คุณทำ เช่น งาน เรียน หรือการเดินทาง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रंग बताते हैं कि आपने क्या किया, जैसे काम, पढ़ाई या सफ़र।"
          }
        }
      }
    },
    "생각과 장소를 그 시각에 남깁니다.|Keep thoughts and places at the moment they happen." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "思いついたことや場所を、その瞬間に残しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在想法和地点出现的那一刻把它们留住。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在想法與地點出現的當下記錄下來。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte Gedanken und Orte im Moment fest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez vos pensées et vos lieux à l'instant où ils se produisent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva pensieri e luoghi nel momento in cui accadono."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda pensamientos y lugares en el momento en que ocurren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde pensamentos e lugares no momento em que acontecem."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ lại suy nghĩ và địa điểm ngay lúc chúng xảy ra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan pikiran dan tempat tepat saat terjadi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บความคิดและสถานที่ไว้ในขณะที่เกิดขึ้น"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विचार और जगहें उसी पल संजो लें जब वे घटें।"
          }
        }
      }
    },
    "생체 인증은 빠른 잠금 해제용이며, 생체 정보는 앱이나 백업에 저장되지 않습니다.|Biometrics are only a fast local unlock; biometric data is never stored." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生体認証は高速なローカルのロック解除にのみ使われ、生体データは保存されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生物识别只是快速的本地解锁方式；不会存储任何生物识别数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生物辨識只是快速的本機解鎖方式；生物辨識資料絕不會被儲存。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biometrie ist nur ein schnelles lokales Entsperren; biometrische Daten werden nie gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La biométrie n'est qu'un déverrouillage local rapide ; les données biométriques ne sont jamais stockées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La biometria è solo uno sblocco locale rapido; i dati biometrici non vengono mai memorizzati."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La biometría es solo un desbloqueo local rápido; los datos biométricos nunca se guardan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A biometria é só um desbloqueio local rápido; os dados biométricos nunca são armazenados."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinh trắc học chỉ là cách mở khóa cục bộ nhanh; dữ liệu sinh trắc học không bao giờ được lưu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biometrik hanya pembuka kunci lokal yang cepat; data biometrik tidak pernah disimpan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไบโอเมตริกเป็นเพียงการปลดล็อคเร็วในเครื่อง และจะไม่เก็บข้อมูลไบโอเมตริก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बायोमेट्रिक सिर्फ़ तेज़ स्थानीय अनलॉक है; बायोमेट्रिक डेटा कभी सहेजा नहीं जाता।"
          }
        }
      }
    },
    "생체 인증을 완료하지 못했습니다.|Biometric authentication could not be completed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
