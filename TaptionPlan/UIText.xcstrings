          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe in der unteren Leiste auf Zuhause oder auf das Haus auf der Karte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Accueil dans la barre du bas ou la maison sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Casa nella barra in basso o la casa sulla mappa."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Inicio en la barra inferior o la casa en el mapa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Início na barra inferior ou na casa no mapa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn Nhà ở thanh dưới hoặc ngôi nhà trên bản đồ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk Beranda di bilah bawah atau rumah di peta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ บ้าน ในแถบด้านล่างหรือรูปบ้านบนแผนที่"
          }
