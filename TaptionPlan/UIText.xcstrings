    "끈 일은 AI가 보내도 반영하지 않고 거절로 알려요.|Actions you turn off are not applied; the AI is told they were rejected." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにした操作はAIが送っても反映せず、拒否として伝えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭的操作即使 AI 发送也不会应用，并会告知 AI 已拒绝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉的操作即使 AI 傳送也不會套用，並會告知 AI 已拒絕。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivierte Aktionen werden nicht übernommen; die KI erfährt, dass sie abgelehnt wurden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les actions désactivées ne sont pas appliquées ; l’IA est informée de leur refus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le azioni disattivate non vengono applicate; all’IA viene comunicato il rifiuto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las acciones desactivadas no se aplican; se avisa a la IA de que fueron rechazadas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ações desativadas não são aplicadas; a IA é avisada de que foram recusadas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc đã tắt sẽ không được áp dụng dù AI gửi tới; AI sẽ được báo là bị từ chối."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan yang dimatikan tidak diterapkan meski dikirim AI; AI diberi tahu bahwa itu ditolak."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่ปิดไว้จะไม่ถูกใช้แม้ AI ส่งมา และจะแจ้ง AI ว่าถูกปฏิเสธ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद किए गए काम AI के भेजने पर भी लागू नहीं होते; AI को बताया जाता है कि वे अस्वीकार हुए।"
          }
        }
      }
    },
