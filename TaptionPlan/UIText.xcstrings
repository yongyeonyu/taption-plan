    "|Dongjin Bridge crosses the water in a quiet landscape. Open views of river and fields surround it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "東津橋は静かな景色の中で水をまたいでいます。川と野原の開けた眺めが周囲に広がります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "东津大桥横跨在宁静的景色之中。四周是开阔的江景与田野。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "東津橋橫跨在寧靜的風景中的水面上。四周是開闊的河流與田野景色。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dongjin-Brücke überquert das Wasser in einer ruhigen Landschaft. Weite Ausblicke auf Fluss und Felder umgeben sie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pont Dongjin traverse l'eau dans un paysage tranquille. Des vues dégagées sur la rivière et les champs l'entourent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ponte Dongjin attraversa l'acqua in un paesaggio tranquillo. Aperte vedute di fiume e campi lo circondano."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puente Dongjin cruza el agua en un paisaje tranquilo. Lo rodean amplias vistas del río y los campos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ponte Dongjin atravessa a água numa paisagem tranquila. Vistas abertas do rio e dos campos a cercam."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cầu Dongjin bắc qua mặt nước trong một khung cảnh yên bình. Tầm nhìn mở ra sông và cánh đồng bao quanh cầu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jembatan Dongjin melintasi air di lanskap yang tenang. Pemandangan sungai dan ladang yang terbuka mengelilinginya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สะพาน Dongjin ข้ามผืนน้ำท่ามกลางทิวทัศน์อันเงียบสงบ ทิวทัศน์โล่งกว้างของแม่น้ำและทุ่งนาล้อมรอบ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डोंगजिन पुल शांत परिदृश्य में पानी को पार करता है। नदी और खेतों के खुले दृश्य इसे घेरे हैं।"
          }
        }
      }
    },
