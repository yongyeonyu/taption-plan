        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một nhà ga đường sắt ở quận Gwangsan, Gwangju. Đây là cửa ngõ chính có tàu cao tốc phục vụ và gần sân bay."
