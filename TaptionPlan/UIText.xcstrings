    "|Minneapolis is a Minnesota city on the Mississippi River. It has many lakes and parks and forms a metro area with its twin city, St. Paul." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミネアポリスはミシシッピ川沿いにあるミネソタ州の都市です。湖や公園が多く、双子の都市セントポールとともに都市圏を形成しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明尼阿波利斯是明尼苏达州密西西比河畔的城市。拥有众多湖泊和公园，与双子城圣保罗组成都会区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明尼阿波利斯是密西西比河畔的明尼蘇達州城市。擁有許多湖泊與公園,並與雙子城聖保羅組成都會區。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minneapolis ist eine Stadt in Minnesota am Mississippi. Sie hat viele Seen und Parks und bildet mit ihrer Zwillingsstadt St. Paul eine Metropolregion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minneapolis est une ville du Minnesota, sur le Mississippi. Elle compte de nombreux lacs et parcs et forme une agglomération avec sa ville jumelle, Saint Paul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minneapolis è una città del Minnesota sul fiume Mississippi. Ha molti laghi e parchi e forma un'area metropolitana con la città gemella, St. Paul."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mineápolis es una ciudad de Minnesota a orillas del río Misisipi. Tiene muchos lagos y parques y forma un área metropolitana con su ciudad gemela, San Pablo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minneapolis é uma cidade de Minnesota no rio Mississippi. Tem muitos lagos e parques e forma uma região metropolitana com sua cidade gêmea, St. Paul."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minneapolis là thành phố của bang Minnesota bên sông Mississippi. Có nhiều hồ và công viên, và cùng thành phố song sinh St. Paul tạo thành một vùng đô thị."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minneapolis adalah kota di Minnesota di Sungai Mississippi. Memiliki banyak danau dan taman serta membentuk area metropolitan dengan kota kembarnya, St. Paul."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มินนีแอโพลิสเป็นเมืองในรัฐมินนิโซตาริมแม่น้ำมิสซิสซิปปี มีทะเลสาบและสวนสาธารณะมากมาย และเป็นเขตเมืองร่วมกับเมืองคู่แฝด เซนต์พอล"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिनियापोलिस मिसिसिपी नदी पर मिनेसोटा का शहर है। यहाँ कई झीलें और पार्क हैं, और यह अपने जुड़वाँ शहर सेंट पॉल के साथ महानगरीय क्षेत्र बनाता है।"
          }
        }
      }
    },
