    "|Sydney is Australia’s largest city, on the southeastern coast. The Opera House, Harbour Bridge and Bondi Beach are its signature sights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シドニーはオーストラリア最大の都市で、南東の海岸にあります。オペラハウス、ハーバーブリッジ、ボンダイビーチが象徴的な名所です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悉尼是澳大利亚最大的城市，位于东南海岸。歌剧院、海港大桥和邦迪海滩是其标志性景点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雪梨是澳洲最大的城市,位於東南海岸。歌劇院、海港大橋與邦迪海灘是其代表景點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sydney ist Australiens größte Stadt an der Südostküste. Das Opernhaus, die Harbour Bridge und der Bondi Beach sind ihre Wahrzeichen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sydney est la plus grande ville d'Australie, sur la côte sud-est. L'Opéra, le Harbour Bridge et la plage de Bondi en sont les sites emblématiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sydney è la città più grande dell'Australia, sulla costa sud-orientale. L'Opera House, l'Harbour Bridge e Bondi Beach sono le sue attrazioni simbolo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sídney es la mayor ciudad de Australia, en la costa sureste. La Ópera, el Harbour Bridge y la playa de Bondi son sus atractivos emblemáticos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sydney é a maior cidade da Austrália, na costa sudeste. A Ópera, a Harbour Bridge e a praia de Bondi são suas atrações mais características."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sydney là thành phố lớn nhất nước Úc, ở bờ biển đông nam. Nhà hát Opera, cầu Harbour Bridge và bãi biển Bondi là những điểm đặc trưng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sydney adalah kota terbesar Australia, di pesisir tenggara. Opera House, Harbour Bridge, dan Pantai Bondi adalah ikonnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซิดนีย์เป็นเมืองใหญ่ที่สุดของออสเตรเลีย ตั้งอยู่บนชายฝั่งตะวันออกเฉียงใต้ โรงอุปรากร สะพาน Harbour และหาด Bondi เป็นสถานที่ประจำเมือง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिडनी ऑस्ट्रेलिया का सबसे बड़ा शहर है, जो दक्षिण-पूर्वी तट पर है। ओपेरा हाउस, हार्बर ब्रिज और बोंडी बीच इसके प्रतीक दर्शनीय स्थल हैं।"
          }
        }
      }
    },
