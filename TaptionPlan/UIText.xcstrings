          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stazione ferroviaria a Gwangsan-gu, Gwangju. È un importante punto d’accesso servito da treni ad alta velocità ed è vicina all’aeroporto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estación de tren en Gwangsan-gu, Gwangju. Es una importante puerta de entrada servida por trenes de alta velocidad y está cerca del aeropuerto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estação ferroviária em Gwangsan-gu, Gwangju. É uma importante porta de entrada servida por trens de alta velocidade e fica perto do aeroporto."
