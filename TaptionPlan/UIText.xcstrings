    "|Prehistoric rock carvings on a cliff along the upper Taehwa River in Ulju County, Ulsan. The images include whales, animals and hunting scenes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蔚山蔚州郡の上流の泰和江沿いの崖にある先史時代の岩刻画。クジラ、動物、狩りの場面などが描かれています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蔚山蔚州郡大和江上游悬崖上的史前岩刻。图像包括鲸鱼、动物和狩猎场景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於蔚山蔚州郡太和江上游沿岸懸崖上的史前岩畫。圖像包括鯨魚、動物與狩獵場景。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prähistorische Felsritzungen an einer Klippe am oberen Taehwa-Fluss im Landkreis Ulju, Ulsan. Die Bilder zeigen Wale, Tiere und Jagdszenen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravures rupestres préhistoriques sur une falaise le long du cours supérieur de la rivière Taehwa, dans le comté d'Ulju, à Ulsan. Les images comprennent des baleines, des animaux et des scènes de chasse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incisioni rupestri preistoriche su una scogliera lungo il corso superiore del fiume Taehwa, nella contea di Ulju, a Ulsan. Le immagini comprendono balene, animali e scene di caccia."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabados rupestres prehistóricos en un acantilado a lo largo del curso alto del río Taehwa, en el condado de Ulju, Ulsan. Las imágenes incluyen ballenas, animales y escenas de caza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravuras rupestres pré-históricas num penhasco ao longo do alto rio Taehwa, no condado de Ulju, Ulsan. As imagens incluem baleias, animais e cenas de caça."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những hình khắc đá thời tiền sử trên vách đá dọc thượng nguồn sông Taehwa ở huyện Ulju, Ulsan. Các hình ảnh gồm cá voi, động vật và cảnh săn bắn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukiran batu prasejarah di tebing di sepanjang hulu Sungai Taehwa di Ulju County, Ulsan. Gambarnya mencakup paus, hewan, dan adegan berburu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาพสลักหินยุคก่อนประวัติศาสตร์บนหน้าผาริมแม่น้ำ Taehwa ตอนบนในอำเภอ Ulju เมืองอุลซาน ภาพประกอบด้วยปลาวาฬ สัตว์ และฉากล่าสัตว์"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उल्सान के उलजू काउंटी में ऊपरी तेह्वा नदी के किनारे चट्टान पर प्रागैतिहासिक शैल चित्र। इनमें व्हेल, जानवर और शिकार के दृश्य हैं।"
          }
        }
      }
    },
