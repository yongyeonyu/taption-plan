    "예산 이체와 정산은 지우고, 여행 중 기록은 일상 가계부로 옮겨요.|Budget transfers and settlement are removed; trip entries move to the daily ledger." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予算の振替と精算は削除し、旅行中の記録は日常の家計簿に移します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除预算转账和结算，旅行中的记录移到日常账本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除預算轉帳和結算，旅行中的紀錄移到日常帳本。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budgetüberträge und Abrechnung werden entfernt; Reiseeinträge wandern ins Alltags-Haushaltsbuch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les virements de budget et le solde sont supprimés ; les dépenses du voyage passent au budget quotidien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I trasferimenti di budget e il saldo vengono rimossi; le voci del viaggio passano alle spese quotidiane."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitan los traspasos de presupuesto y la liquidación; las entradas del viaje pasan a los gastos diarios."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As transferências de verba e o acerto são removidos; os lançamentos da viagem vão para o dia a dia."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa chuyển kinh phí và quyết toán; các mục chuyến đi chuyển về sổ hằng ngày."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfer anggaran dan penyelesaian dihapus; catatan perjalanan pindah ke catatan harian."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบการโอนงบและการเคลียร์ รายการระหว่างทริปย้ายไปบัญชีประจำวัน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बजट ट्रांसफ़र और हिसाब हटेंगे; यात्रा की प्रविष्टियाँ रोज़ के खाते में जाएँगी।"
          }
        }
      }
    },
