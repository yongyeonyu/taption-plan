    "|Urumqi is the main city of Xinjiang in northwestern China. Silk Road heritage, diverse ethnic cuisines and busy bazaars shape its character." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウルムチは中国北西部の新疆の中心都市です。シルクロードの遺産、多様な民族料理、にぎやかなバザールが街の個性です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "乌鲁木齐是中国西北新疆的主要城市。丝绸之路遗产、多样的民族美食和繁忙的巴扎塑造了它的特色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烏魯木齊是中國西北新疆的主要城市。絲路遺產、多元民族美食與熱鬧的巴扎構成其特色。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ürümqi ist die Hauptstadt von Xinjiang im Nordwesten Chinas. Das Erbe der Seidenstraße, vielfältige ethnische Küchen und belebte Basare prägen ihren Charakter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ürümqi est la principale ville du Xinjiang, dans le nord-ouest de la Chine. L'héritage de la route de la soie, des cuisines de diverses ethnies et des bazars animés façonnent son caractère."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urumqi è la città principale dello Xinjiang, nella Cina nord-occidentale. Il patrimonio della Via della Seta, le cucine di diverse etnie e i vivaci bazar ne definiscono il carattere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urumqi es la ciudad principal de Xinjiang, en el noroeste de China. El patrimonio de la Ruta de la Seda, las variadas cocinas étnicas y los bulliciosos bazares forman su carácter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urumqi é a principal cidade de Xinjiang, no noroeste da China. A herança da Rota da Seda, as variadas cozinhas étnicas e os movimentados bazares moldam seu caráter."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urumqi là thành phố chính của Tân Cương ở tây bắc Trung Quốc. Di sản Con đường Tơ lụa, ẩm thực đa dạng của các dân tộc và những khu chợ nhộn nhịp tạo nên nét đặc trưng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urumqi adalah kota utama Xinjiang di barat laut Tiongkok. Warisan Jalur Sutra, kuliner beragam etnis, dan bazar yang sibuk membentuk karakternya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อุรุมชีเป็นเมืองหลักของซินเจียงทางตะวันตกเฉียงเหนือของจีน มรดกเส้นทางสายไหม อาหารหลากหลายชาติพันธุ์ และตลาดบาซาร์ที่คึกคักหล่อหลอมลักษณะของเมือง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उरुमची उत्तर-पश्चिमी चीन के शिनजियांग का मुख्य शहर है। सिल्क रोड की विरासत, विविध जातीय व्यंजन और व्यस्त बाज़ार इसका चरित्र गढ़ते हैं।"
          }
        }
      }
    },
