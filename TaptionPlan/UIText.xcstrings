      }
    },
    "방문해서 '점령'한 장소에 꽂히는 깃발입니다. 새로운 곳을 방문할수록 더 많은 깃발이 모입니다.|A flag planted on a place you've visited and 'conquered'. Visit new places to collect more." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪れて「制覇」した場所に旗を立てます。新しい場所を訪れて、もっと集めましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插在你到访并“征服”过的地点上的旗帜。到访新地点可收集更多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插在你造訪並「征服」過的地點上的旗幟。造訪新地點即可收集更多。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Flagge auf einem besuchten und „eroberten“ Ort. Besuche neue Orte, um mehr zu sammeln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un drapeau planté sur un lieu que vous avez visité et « conquis ». Visitez de nouveaux lieux pour en collecter plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una bandierina piantata in un luogo che hai visitato e “conquistato”. Visita nuovi luoghi per raccoglierne altre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una bandera plantada en un lugar que has visitado y «conquistado». Visita lugares nuevos para conseguir más."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma bandeira fincada em um lugar que você visitou e ‘conquistou’. Visite novos lugares para coletar mais."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lá cờ cắm tại nơi bạn đã ghé và ‘chinh phục’. Hãy ghé thêm nơi mới để sưu tầm nhiều hơn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bendera yang ditancapkan di tempat yang pernah Anda kunjungi dan ‘taklukkan’. Kunjungi tempat baru untuk mengumpulkan lebih banyak."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ธงที่ปักบนสถานที่ที่คุณเคยไปและ ‘พิชิต’ แล้ว ไปสถานที่ใหม่ๆ เพื่อสะสมเพิ่ม"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके देखे और ‘जीते’ हुए स्थान पर गाड़ा गया झंडा। और इकट्ठा करने के लिए नई जगहें घूमें।"
          }
        }
      }
    },
