    "|Heart rate. The Watch is the only place the app can read heart rate." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍数。心拍数を読み取れるのはWatchだけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率。Watch 是 App 唯一能读取心率的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率。App 只能從 Watch 讀取心率。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herzfrequenz. Nur die Watch kann die Herzfrequenz für die App erfassen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fréquence cardiaque. La Watch est le seul endroit où l'app peut la lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battito cardiaco. Il Watch è l'unico posto da cui l'app può leggere il battito."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frecuencia cardiaca. El Watch es el único lugar donde la app puede leer la frecuencia cardiaca."
