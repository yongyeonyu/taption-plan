    "가게 이름 없음|No shop name" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "店名なし"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
