          }
        }
      }
    },
    "|Taichung is a large city in west-central Taiwan with a mild climate. It is known for its Rainbow Village, cultural venues and Fengjia night market." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台中は台湾中西部にある大都市で、気候は穏やかです。彩虹眷村、文化施設、逢甲夜市で知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台中是台湾中西部的大城市，气候温和。以彩虹眷村、文化场馆和逢甲夜市闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台中是台灣中西部的大城市,氣候溫和。以彩虹眷村、文化場館與逢甲夜市聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taichung ist eine große Stadt im west-zentralen Taiwan mit mildem Klima. Sie ist für ihr Rainbow Village, Kulturstätten und den Fengjia-Nachtmarkt bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taichung est une grande ville du centre-ouest de Taïwan au climat doux. Elle est connue pour son Rainbow Village, ses lieux culturels et le marché de nuit de Fengjia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taichung è una grande città nel Taiwan centro-occidentale con un clima mite. È nota per il Rainbow Village, i luoghi culturali e il mercato notturno di Fengjia."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taichung es una gran ciudad del centro-oeste de Taiwán con clima templado. Es conocida por su Pueblo Arcoíris, sus recintos culturales y el mercado nocturno de Fengjia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taichung é uma grande cidade no centro-oeste de Taiwan, de clima ameno. É conhecida pela Vila Arco-Íris, por espaços culturais e pelo mercado noturno de Fengjia."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đài Trung là thành phố lớn ở miền trung phía tây Đài Loan với khí hậu ôn hòa. Nổi tiếng với Làng Cầu Vồng, các địa điểm văn hóa và chợ đêm Phùng Giáp."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taichung adalah kota besar di Taiwan barat-tengah dengan iklim sejuk. Dikenal dengan Rainbow Village, tempat budaya, dan pasar malam Fengjia."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไถจงเป็นเมืองใหญ่ทางตะวันตกตอนกลางของไต้หวัน มีอากาศอบอุ่น มีชื่อเสียงเรื่องหมู่บ้านสายรุ้ง สถานที่ทางวัฒนธรรม และตลาดกลางคืน Fengjia"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ताइचुंग पश्चिम-मध्य ताइवान का बड़ा शहर है, जहाँ का मौसम सौम्य है। यह अपने रेनबो विलेज, सांस्कृतिक स्थलों और फ़ेंगजिया रात्रि बाज़ार के लिए जाना जाता है।"
          }
        }
      }
    },
