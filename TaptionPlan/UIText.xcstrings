        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीचे के बार में होम पर या मैप पर घर पर टैप करें।"
          }
        }
      }
    },
    "아래 막대의 현재 위치를 누르면 오늘, 지금 있는 곳으로 돌아옵니다.|Tap Location in the bottom bar to return to today and where you are." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下部バーの「現在地」をタップすると、今日と今いる場所に戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按底部栏的“位置”，即可回到今天和你所在的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下底部列的「位置」，即可回到今天和你所在的位置。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe in der unteren Leiste auf Standort, um zu heute und zu deinem Ort zurückzukehren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Position dans la barre du bas pour revenir à aujourd’hui et à votre position."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Posizione nella barra in basso per tornare a oggi e a dove sei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Ubicación en la barra inferior para volver a hoy y a donde estás."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Localização na barra inferior para voltar a hoje e ao local onde você está."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn Vị trí ở thanh dưới để quay về hôm nay và nơi bạn đang ở."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk Lokasi di bilah bawah untuk kembali ke hari ini dan tempat Anda berada."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ ตำแหน่ง ในแถบด้านล่างเพื่อกลับไปที่วันนี้และที่ที่คุณอยู่"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज और अपनी मौजूदा जगह पर लौटने के लिए नीचे के बार में वर्तमान स्थान पर टैप करें।"
          }
        }
      }
    },
    "아래 목록 위의 「자동화」를 누르고 「알림」을 고른 뒤, 은행·카드 앱을 골라요.|Tap Automation above the list, choose Notification, then pick your bank and card apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストの上の「オートメーション」をタップして「通知」を選び、銀行・カードのAppを選びます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点列表上方的“自动化”，选择“通知”，然后选择银行和信用卡 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下列表上方的「自動化」，選擇「通知」，然後選擇銀行與信用卡 App。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe über der Liste auf „Automation“, wähle „Mitteilung“ und dann deine Bank- und Karten-Apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez « Automatisation » au-dessus de la liste, choisissez « Notification », puis vos apps de banque et de carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca «Automazione» sopra l’elenco, scegli «Notifica», poi le app della banca e della carta."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca «Automatización» encima de la lista, elige «Notificación» y luego tus apps de banco y tarjeta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em “Automação” acima da lista, escolha “Notificação” e depois os apps do banco e do cartão."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm “Tự động hóa” phía trên danh sách, chọn “Thông báo”, rồi chọn ứng dụng ngân hàng và thẻ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk “Otomatisasi” di atas daftar, pilih “Pemberitahuan”, lalu pilih app bank dan kartu Anda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ “ระบบอัตโนมัติ” เหนือรายการ เลือก “การแจ้งเตือน” แล้วเลือกแอปธนาคารและบัตร"
          }
        },
        "hi" : {
