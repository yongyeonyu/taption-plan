    "|Warsaw is the capital of Poland, on the Vistula River. Its old town, rebuilt after the war, and sites linked to Chopin are well known." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワルシャワはポーランドの首都で、ヴィスワ川沿いにあります。戦後に再建された旧市街とショパンゆかりの場所がよく知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "华沙是波兰的首都，位于维斯瓦河畔。战后重建的老城以及与肖邦有关的遗迹广为人知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "華沙是波蘭的首都,位於維斯瓦河畔。戰後重建的舊城區與和蕭邦相關的景點廣為人知。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warschau ist die Hauptstadt Polens an der Weichsel. Seine nach dem Krieg wiederaufgebaute Altstadt und mit Chopin verbundene Stätten sind bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsovie est la capitale de la Pologne, sur la Vistule. Sa vieille ville, reconstruite après la guerre, et les sites liés à Chopin sont bien connus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsavia è la capitale della Polonia, sul fiume Vistola. La sua città vecchia, ricostruita dopo la guerra, e i luoghi legati a Chopin sono ben noti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsovia es la capital de Polonia, a orillas del río Vístula. Su casco antiguo, reconstruido tras la guerra, y los sitios ligados a Chopin son muy conocidos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsóvia é a capital da Polônia, no rio Vístula. Sua cidade antiga, reconstruída após a guerra, e os locais ligados a Chopin são bem conhecidos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warsaw là thủ đô của Ba Lan, bên sông Vistula. Khu phố cổ được xây lại sau chiến tranh và các địa điểm liên quan đến Chopin rất nổi tiếng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warsawa adalah ibu kota Polandia, di Sungai Vistula. Kota tuanya, yang dibangun kembali setelah perang, dan situs terkait Chopin sangat terkenal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วอร์ซอเป็นเมืองหลวงของโปแลนด์ ตั้งอยู่ริมแม่น้ำวิสทูลา เมืองเก่าที่สร้างใหม่หลังสงคราม และสถานที่ที่เกี่ยวข้องกับโชแปงเป็นที่รู้จักดี"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वारसा पोलैंड की राजधानी है, जो विस्तुला नदी पर है। युद्ध के बाद पुनर्निर्मित इसका पुराना शहर और शोपैन से जुड़े स्थल प्रसिद्ध हैं।"
          }
        }
      }
    },
