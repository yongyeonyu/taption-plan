        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thủ phủ của tỉnh Hải Nam ở bờ bắc hòn đảo, Trung Quốc. Có khí hậu nhiệt đới, cây cọ và những con phố có mái vòm cổ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibu kota Provinsi Hainan di pesisir utara pulau, Tiongkok. Memiliki iklim tropis, pohon palem, dan jalan arkade tua."
