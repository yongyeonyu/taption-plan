          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subelementos de una rutina no se pueden volver a vincular."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os subitens de uma rotina não podem ser vinculados de novo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể liên kết lại các mục con của thói quen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sub-item rutinitas tidak dapat dihubungkan ulang."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมโยงรายการย่อยของกิจวัตรใหม่ไม่ได้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रूटीन के सब-आइटम दोबारा लिंक नहीं किए जा सकते।"
          }
        }
      }
    },
    "|A sub-plan can only be moved within its parent routine's period." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブプランは、親ルーティンの期間内でのみ移動できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子计划只能在其上级流程的时间段内移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子計畫只能在上層例行事項的期間內移動。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Unterplan kann nur innerhalb des Zeitraums seiner übergeordneten Routine verschoben werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sous-plan ne peut être déplacé que dans la période de sa routine parente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sotto-piano può essere spostato solo nel periodo della routine principale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un subplan solo se puede mover dentro del periodo de su rutina principal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um subplano só pode ser movido dentro do período da rotina principal."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kế hoạch con chỉ có thể di chuyển trong khoảng thời gian của thói quen cha."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
