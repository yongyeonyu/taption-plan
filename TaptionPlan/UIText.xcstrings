    "|Weihai is a port city at the tip of the Shandong Peninsula, across the sea from Korea. It is known for its seaside promenades and tidy streets." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "威海は山東半島の先端にある港湾都市で、海を隔てて韓国の向かいにあります。海辺の遊歩道と整った街並みで知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "威海是山东半岛尖端的港口城市，与韩国隔海相望。以海滨步道和整洁的街道闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "威海是山東半島尖端的港口城市,與韓國隔海相望。以海濱步道與整潔的街道聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weihai ist eine Hafenstadt an der Spitze der Shandong-Halbinsel, jenseits des Meeres von Korea. Sie ist für ihre Uferpromenaden und gepflegten Straßen bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weihai est une ville portuaire à l'extrémité de la péninsule du Shandong, de l'autre côté de la mer par rapport à la Corée. Elle est connue pour ses promenades en bord de mer et ses rues soignées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weihai è una città portuale all'estremità della penisola dello Shandong, di fronte alla Corea dall'altra parte del mare. È nota per le passeggiate sul mare e le strade ordinate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weihai es una ciudad portuaria en la punta de la península de Shandong, al otro lado del mar desde Corea. Es conocida por sus paseos marítimos y sus calles ordenadas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weihai é uma cidade portuária na ponta da Península de Shandong, do outro lado do mar em relação à Coreia. É conhecida pelos calçadões à beira-mar e pelas ruas bem cuidadas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uy Hải là thành phố cảng ở mũi bán đảo Sơn Đông, bên kia biển đối diện Hàn Quốc. Nổi tiếng với những lối đi dạo ven biển và đường phố ngăn nắp."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weihai adalah kota pelabuhan di ujung Semenanjung Shandong, di seberang laut dari Korea. Dikenal dengan promenade tepi lautnya dan jalanan yang rapi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เว่ยไห่เป็นเมืองท่าที่ปลายคาบสมุทรซานตง ตรงข้ามทะเลกับเกาหลี มีชื่อเสียงเรื่องทางเดินริมทะเลและถนนที่เป็นระเบียบเรียบร้อย"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेइहाई शानदोंग प्रायद्वीप की नोक पर बंदरगाह शहर है, जो समुद्र के पार कोरिया के सामने है। यह समुद्र किनारे के पैदल मार्गों और साफ़-सुथरी सड़कों के लिए जाना जाता है।"
          }
        }
      }
    },
