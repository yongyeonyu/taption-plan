    "|It changed afterwards, so it couldn't be undone. Please edit it in the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その後に変更があったため取り消せませんでした。アプリで直接修正してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之后已有改动，无法撤销。请在 App 中直接修改。"
