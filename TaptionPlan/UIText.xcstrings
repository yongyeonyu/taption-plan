        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องมีสิทธิ์เหล่านี้สำหรับการบันทึกอัตโนมัติ ไทม์ไลน์จะถูกล็อคจนกว่าจะเปิดครบทั้งหมด"
