    "연결 주소 만들기|Make a connection link" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続アドレスを作成"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成连接地址"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "產生連線網址"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindungslink erstellen"
          }
        },
        "fr" : {
          "stringUnit" : {
