          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在底部列的「行事曆」中尋找並選擇過去的日期。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde und wähle vergangene Tage mit Kalender in der unteren Leiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrouvez et choisissez les jours passés avec Calendrier dans la barre du bas."
