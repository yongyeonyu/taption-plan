        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thủ phủ của tỉnh Hồ Nam, Trung Quốc. Nổi tiếng với các địa điểm thời niên thiếu của Mao Trạch Đông, công viên Quất Tử Châu và ẩm thực Hồ Nam cay."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibu kota Hunan, Tiongkok. Dikenal dengan situs masa muda Mao Zedong, Orange Isle Park, dan masakan Hunan yang pedas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองหลวงของมณฑลหูหนานในจีน มีชื่อเสียงเรื่องสถานที่ในวัยหนุ่มของเหมา เจ๋อตง สวน Orange Isle และอาหารหูหนานรสเผ็ด"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चीन के हुनान की राजधानी। यह माओ ज़ेदोंग की युवावस्था से जुड़े स्थलों, ऑरेंज आइल पार्क और तीखे हुनान भोजन के लिए जाना जाता है।"
          }
        }
      }
    },
    "|The capital of Inner Mongolia, China. It is known for grassland culture, Mongolian food and Tibetan Buddhist temples." : {
