    "|Amsterdam is the capital of the Netherlands, crisscrossed by canals. The Van Gogh Museum, the Anne Frank House and narrow canal houses are highlights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アムステルダムはオランダの首都で、運河が縦横に走ります。ゴッホ美術館、アンネ・フランクの家、細い運河沿いの家々が見どころです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阿姆斯特丹是荷兰的首都，运河纵横交错。梵高博物馆、安妮之家和狭窄的运河房屋是其亮点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阿姆斯特丹是荷蘭的首都,運河縱橫交錯。梵谷博物館、安妮之家與狹窄的運河屋是其亮點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amsterdam ist die Hauptstadt der Niederlande und von Grachten durchzogen. Das Van-Gogh-Museum, das Anne-Frank-Haus und schmale Grachtenhäuser sind Höhepunkte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amsterdam est la capitale des Pays-Bas, sillonnée de canaux. Le Musée Van Gogh, la Maison d'Anne Frank et les étroites maisons de canal en sont les points forts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amsterdam è la capitale dei Paesi Bassi, attraversata da canali. Il Museo Van Gogh, la Casa di Anna Frank e le strette case sui canali sono i punti forti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ámsterdam es la capital de los Países Bajos, surcada por canales. El Museo Van Gogh, la Casa de Ana Frank y las estrechas casas junto a los canales son lo más destacado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amsterdã é a capital dos Países Baixos, cortada por canais. O Museu Van Gogh, a Casa de Anne Frank e as casas estreitas à beira dos canais são os destaques."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amsterdam là thủ đô của Hà Lan, với hệ thống kênh đào chằng chịt. Bảo tàng Van Gogh, Nhà Anne Frank và những ngôi nhà hẹp bên kênh là các điểm nổi bật."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amsterdam adalah ibu kota Belanda, dengan kanal yang menyilang di seluruh kota. Museum Van Gogh, Rumah Anne Frank, dan rumah-rumah kanal yang sempit menjadi daya tarik utama."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัมสเตอร์ดัมเป็นเมืองหลวงของเนเธอร์แลนด์ มีคลองตัดผ่านไปทั่ว พิพิธภัณฑ์ Van Gogh บ้าน Anne Frank และบ้านริมคลองหลังแคบเป็นไฮไลต์"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एम्स्टर्डम नीदरलैंड की राजधानी है, जहाँ नहरों का जाल बिछा है। वान गॉग संग्रहालय, एना फ्रैंक हाउस और नहर किनारे के संकरे घर मुख्य आकर्षण हैं।"
          }
        }
      }
    },
