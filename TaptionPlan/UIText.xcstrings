    "동기화된 변경과 충돌해 다시실행하지 못했습니다.|Redo failed because it conflicts with synced changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期された変更と競合するため、やり直しに失敗しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重做失败，因为与已同步的更改冲突。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重做失敗，因為與已同步的變更衝突。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederholen fehlgeschlagen, da es mit synchronisierten Änderungen kollidiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rétablissement a échoué car il entre en conflit avec des modifications synchronisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripetizione non riuscita perché in conflitto con le modifiche sincronizzate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo rehacer porque entra en conflicto con cambios sincronizados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível refazer porque há conflito com alterações sincronizadas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm lại không thành công do xung đột với các thay đổi đã đồng bộ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulangi gagal karena bertentangan dengan perubahan yang disinkronkan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำซ้ำไม่สำเร็จเพราะขัดแย้งกับการเปลี่ยนแปลงที่ซิงค์"
          }
