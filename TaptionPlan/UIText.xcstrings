    "|Shijiazhuang is the capital of Hebei Province, southwest of Beijing. It is a railway hub, with old temples and historic sites in the surrounding area." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "石家荘は北京の南西にある河北省の省都です。鉄道の要衝で、周辺には古い寺院や史跡があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "石家庄是河北省的省会，位于北京西南。它是铁路枢纽，周边有古寺和历史遗迹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "石家莊是河北省的省會,位於北京西南。它是鐵路樞紐,周邊有古寺與歷史遺跡。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shijiazhuang ist die Hauptstadt der Provinz Hebei, südwestlich von Peking. Sie ist ein Eisenbahnknotenpunkt, mit alten Tempeln und historischen Stätten in der Umgebung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shijiazhuang est la capitale de la province du Hebei, au sud-ouest de Pékin. C'est un nœud ferroviaire, avec de vieux temples et des sites historiques dans les environs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shijiazhuang è la capitale della provincia dello Hebei, a sud-ovest di Pechino. È un nodo ferroviario, con antichi templi e siti storici nei dintorni."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shijiazhuang es la capital de la provincia de Hebei, al suroeste de Pekín. Es un nudo ferroviario, con templos antiguos y sitios históricos en los alrededores."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shijiazhuang é a capital da província de Hebei, a sudoeste de Pequim. É um entroncamento ferroviário, com templos antigos e sítios históricos nos arredores."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thạch Gia Trang là thủ phủ của tỉnh Hà Bắc, ở phía tây nam Bắc Kinh. Là đầu mối đường sắt, với các ngôi chùa cổ và di tích lịch sử ở vùng xung quanh."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shijiazhuang adalah ibu kota Provinsi Hebei, di barat daya Beijing. Merupakan simpul kereta api, dengan kuil tua dan situs bersejarah di sekitarnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shijiazhuang เป็นเมืองหลวงของมณฑลเหอเป่ย ทางตะวันตกเฉียงใต้ของปักกิ่ง เป็นชุมทางรถไฟ มีวัดเก่าและแหล่งประวัติศาสตร์ในพื้นที่โดยรอบ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शिजियाझुआंग बीजिंग के दक्षिण-पश्चिम में हेबेई प्रांत की राजधानी है। यह रेलवे का केंद्र है, और आसपास के क्षेत्र में पुराने मंदिर तथा ऐतिहासिक स्थल हैं।"
          }
        }
      }
    },
