    "|Hanoi is the capital of Vietnam, on the Red River in the north. Hoan Kiem Lake, the Old Quarter and French colonial buildings define its look." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハノイはベトナム北部の紅河沿いにある首都です。ホアンキエム湖、旧市街、フランス植民地時代の建物が街の姿をつくります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "河内是越南的首都，位于北部红河畔。还剑湖、老城区和法式殖民建筑构成了它的面貌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "河內是越南的首都,位於北部的紅河畔。還劍湖、舊城區與法國殖民建築構成其面貌。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanoi ist die Hauptstadt Vietnams am Roten Fluss im Norden. Der Hoan-Kiem-See, das Alte Viertel und französische Kolonialgebäude prägen ihr Bild."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanoï est la capitale du Vietnam, sur le fleuve Rouge, dans le nord. Le lac Hoàn Kiếm, le Vieux Quartier et les bâtiments coloniaux français définissent son aspect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanoi è la capitale del Vietnam, sul Fiume Rosso, al nord. Il lago Hoan Kiem, il Quartiere Vecchio e gli edifici coloniali francesi ne definiscono l'aspetto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanói es la capital de Vietnam, a orillas del río Rojo, en el norte. El lago Hoan Kiem, el Barrio Antiguo y los edificios coloniales franceses definen su aspecto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanói é a capital do Vietnã, no rio Vermelho, no norte. O lago Hoan Kiem, o Bairro Antigo e os edifícios coloniais franceses definem seu visual."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hà Nội là thủ đô của Việt Nam, bên sông Hồng ở miền Bắc. Hồ Hoàn Kiếm, Phố Cổ và các tòa nhà thuộc địa Pháp tạo nên diện mạo của thành phố."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanoi adalah ibu kota Vietnam, di Sungai Merah di utara. Danau Hoan Kiem, Kota Tua, dan bangunan kolonial Prancis membentuk tampilannya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฮานอยเป็นเมืองหลวงของเวียดนาม ตั้งอยู่ริมแม่น้ำแดงทางเหนือ ทะเลสาบหว่านเกี๋ยม ย่านเมืองเก่า และอาคารสมัยอาณานิคมฝรั่งเศสกำหนดโฉมหน้าเมือง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हनोई वियतनाम की राजधानी है, जो उत्तर में रेड रिवर पर है। होआन कीम झील, ओल्ड क्वार्टर और फ़्रांसीसी औपनिवेशिक इमारतें इसकी पहचान तय करती हैं।"
          }
        }
      }
    },
