    "|Taipei is the capital and largest city of Taiwan. Taipei 101, the National Palace Museum and its night markets are the main draws." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台北は台湾の首都で最大の都市です。台北101、国立故宮博物院、夜市が主な魅力です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台北是台湾的首府和最大城市。台北101、故宫博物院和夜市是主要吸引力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台北是台灣的首都與最大城市。台北101、國立故宮博物院與夜市是主要的吸引力。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taipeh ist die Hauptstadt und größte Stadt Taiwans. Taipei 101, das Nationale Palastmuseum und die Nachtmärkte sind die wichtigsten Anziehungspunkte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taipei est la capitale et la plus grande ville de Taïwan. Taipei 101, le Musée national du Palais et ses marchés de nuit en sont les principaux attraits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taipei è la capitale e la città più grande di Taiwan. Taipei 101, il Museo del Palazzo Nazionale e i mercati notturni sono i principali richiami."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taipéi es la capital y mayor ciudad de Taiwán. El Taipei 101, el Museo del Palacio Nacional y sus mercados nocturnos son los principales atractivos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taipé é a capital e maior cidade de Taiwan. O Taipei 101, o Museu do Palácio Nacional e seus mercados noturnos são os principais atrativos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đài Bắc là thủ phủ và thành phố lớn nhất của Đài Loan. Tòa nhà Taipei 101, Bảo tàng Cố cung Quốc gia và các chợ đêm là những điểm thu hút chính."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taipei adalah ibu kota dan kota terbesar Taiwan. Taipei 101, Museum Istana Nasional, dan pasar malamnya adalah daya tarik utama."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไทเปเป็นเมืองหลวงและเมืองใหญ่ที่สุดของไต้หวัน Taipei 101 พิพิธภัณฑ์พระราชวังแห่งชาติ และตลาดกลางคืนเป็นจุดดึงดูดหลัก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ताइपे ताइवान की राजधानी और सबसे बड़ा शहर है। ताइपे 101, राष्ट्रीय राजमहल संग्रहालय और इसके रात्रि बाज़ार मुख्य आकर्षण हैं।"
          }
        }
      }
    },
