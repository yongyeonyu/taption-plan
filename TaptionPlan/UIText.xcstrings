          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarankan {0} judul (masing-masing kurang dari {1} karakter) dan satu baris memo (kurang dari {2} karakter)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แนะนำชื่อ {0} ชื่อ (ไม่เกิน {1} ตัวอักษรต่อชื่อ) และโน้ตหนึ่งบรรทัด (ไม่เกิน {2} ตัวอักษร)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{0} शीर्षक सुझाएँ (हर एक {1} अक्षरों से कम) और एक पंक्ति का मेमो ({2} अक्षरों से कम)।"
          }
        }
      }
    },
