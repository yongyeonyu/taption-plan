          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi xóa, ghi chú này thành “chỉ ghi chú” và sẽ không quay lại sổ chi tiêu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
