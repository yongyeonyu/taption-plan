        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 iPhone 和 Apple Watch 的診斷資料，以及上一次未完成的工作階段，儲存到 iCloud 雲碟的 TaptionLogs。"
          }
        },
        "de" : {
