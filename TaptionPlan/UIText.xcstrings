    "|Boracay is a small island in the central Visayas of the Philippines. It is known for fine white sand at White Beach and its sunsets." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボラカイはフィリピン中部ビサヤ諸島の小さな島です。ホワイトビーチの細かい白砂と夕日で知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长滩岛是菲律宾米沙鄢中部的一座小岛。以白沙滩的细白沙和日落闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長灘島是菲律賓中部維薩亞斯的一座小島。以白沙灘的細白沙與日落聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boracay ist eine kleine Insel in den zentralen Visayas der Philippinen. Sie ist für den feinen weißen Sand am White Beach und ihre Sonnenuntergänge bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boracay est une petite île du centre des Visayas, aux Philippines. Elle est connue pour le sable blanc fin de White Beach et ses couchers de soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boracay è una piccola isola nelle Visayas centrali, nelle Filippine. È nota per la fine sabbia bianca di White Beach e per i tramonti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boracay es una pequeña isla de las Visayas centrales, en Filipinas. Es conocida por la fina arena blanca de White Beach y sus atardeceres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boracay é uma pequena ilha nas Visayas centrais, nas Filipinas. É conhecida pela areia branca e fina de White Beach e pelos pores do sol."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boracay là một hòn đảo nhỏ ở trung tâm Visayas của Philippines. Nổi tiếng với bãi cát trắng mịn ở White Beach và hoàng hôn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boracay adalah pulau kecil di Visayas tengah, Filipina. Dikenal dengan pasir putih halus di White Beach dan matahari terbenamnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โบราไกย์เป็นเกาะเล็ก ๆ ในวิซายัสตอนกลางของฟิลิปปินส์ มีชื่อเสียงเรื่องทรายขาวละเอียดที่ White Beach และพระอาทิตย์ตก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोराके फ़िलीपींस के मध्य विसायास का छोटा द्वीप है। यह व्हाइट बीच की महीन सफ़ेद रेत और अपने सूर्यास्त के लिए जाना जाता है।"
          }
        }
      }
    },
