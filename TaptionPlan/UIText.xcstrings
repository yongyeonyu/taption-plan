        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按底部栏的“家”或地图上的房子即可打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
