    "|Helsinki is the capital of Finland, on the Baltic Sea coast. Helsinki Cathedral, the Rock Church, the design district and the harbor market are highlights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルシンキはフィンランドの首都で、バルト海沿岸にあります。ヘルシンキ大聖堂、岩の教会、デザイン地区、港の市場が見どころです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赫尔辛基是芬兰的首都，位于波罗的海沿岸。赫尔辛基大教堂、岩石教堂、设计区和港口市场是其亮点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赫爾辛基是芬蘭的首都,位於波羅的海沿岸。赫爾辛基大教堂、岩石教堂、設計區與港口市場是其亮點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helsinki ist die Hauptstadt Finnlands an der Ostseeküste. Der Dom von Helsinki, die Felsenkirche, das Designviertel und der Hafenmarkt sind Höhepunkte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helsinki est la capitale de la Finlande, sur la côte de la mer Baltique. La cathédrale d'Helsinki, l'église du Rocher, le quartier du design et le marché du port en sont les points forts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helsinki è la capitale della Finlandia, sulla costa del Mar Baltico. La Cattedrale di Helsinki, la Chiesa nella Roccia, il quartiere del design e il mercato del porto sono i punti forti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helsinki es la capital de Finlandia, en la costa del mar Báltico. La Catedral de Helsinki, la Iglesia de la Roca, el distrito del diseño y el mercado del puerto son lo más destacado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helsinque é a capital da Finlândia, na costa do Mar Báltico. A Catedral de Helsinque, a Igreja na Rocha, o distrito de design e o mercado do porto são os destaques."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helsinki là thủ đô của Phần Lan, ven bờ biển Baltic. Nhà thờ Helsinki, Nhà thờ Đá, khu thiết kế và chợ bến cảng là các điểm nổi bật."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helsinki adalah ibu kota Finlandia, di pesisir Laut Baltik. Katedral Helsinki, Gereja Batu, distrik desain, dan pasar pelabuhan adalah sorotan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เฮลซิงกิเป็นเมืองหลวงของฟินแลนด์ ตั้งอยู่ริมชายฝั่งทะเลบอลติก มหาวิหารเฮลซิงกิ โบสถ์หิน ย่านดีไซน์ และตลาดริมท่าเรือเป็นไฮไลต์"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हेलसिंकी फ़िनलैंड की राजधानी है, जो बाल्टिक सागर तट पर है। हेलसिंकी कैथेड्रल, रॉक चर्च, डिज़ाइन जिला और बंदरगाह बाज़ार मुख्य आकर्षण हैं।"
          }
        }
      }
    },
