    "Watch 앱을 열지 못했습니다. iPhone에서 Watch 앱을 직접 열어 주세요.|Couldn't open the Watch app. Open it on your iPhone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Appを開けませんでした。iPhoneでWatch Appを直接開いてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开 Watch App。请在 iPhone 上直接打开 Watch App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法打開 Watch App。請在 iPhone 上直接打開 Watch App。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Watch-App konnte nicht geöffnet werden. Öffne die Watch-App direkt auf dem iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir l’app Watch. Ouvrez-la directement sur l’iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire l’app Watch. Aprila direttamente su iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir la app Watch. Ábrela directamente en el iPhone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir o app Watch. Abra-o diretamente no iPhone."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không mở được ứng dụng Watch. Hãy mở trực tiếp ứng dụng Watch trên iPhone."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat membuka app Watch. Buka app Watch langsung di iPhone."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดแอป Watch ไม่ได้ โปรดเปิดแอป Watch บน iPhone โดยตรง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch ऐप नहीं खुल सका। इसे iPhone पर सीधे खोलें।"
          }
        }
      }
    },
    "Watch의 움직임 기록을 받고, 건강 앱의 심박·걸음·운동·수면 기록을 함께 읽습니다.|Motion from your Watch, plus heart rate, steps, workouts, and sleep from the Health app." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watchの動きの記録を受け取り、ヘルスケアの心拍数・歩数・ワークアウト・睡眠の記録も一緒に読み取ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接收 Watch 的运动记录，并一同读取“健康”中的心率、步数、体能训练和睡眠记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接收 Watch 的動作記錄，並一併讀取「健康」中的心率、步數、體能訓練和睡眠記錄。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfängt Bewegungsdaten von der Watch und liest zusätzlich Herzfrequenz, Schritte, Workouts und Schlaf aus Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reçoit les mouvements de la Watch et lit aussi la fréquence cardiaque, les pas, les séances et le sommeil dans Santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riceve i movimenti dal Watch e legge anche battito, passi, allenamenti e sonno da Salute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe los movimientos del Watch y también lee la frecuencia cardiaca, los pasos, los entrenamientos y el sueño de Salud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recebe os movimentos do Watch e também lê batimentos, passos, treinos e sono do app Saúde."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận dữ liệu chuyển động từ Watch và đọc thêm nhịp tim, số bước, bài tập và giấc ngủ từ Sức khỏe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menerima catatan gerakan dari Watch, serta membaca detak jantung, langkah, olahraga, dan tidur dari Kesehatan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รับบันทึกการเคลื่อนไหวจาก Watch และอ่านอัตราการเต้นของหัวใจ จำนวนก้าว การออกกำลังกาย และการนอนหลับจากสุขภาพด้วย"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch से गति का रिकॉर्ड लेता है और स्वास्थ्य ऐप से हृदय गति, कदम, वर्कआउट व नींद भी पढ़ता है।"
          }
        }
      }
    },
    "claude.ai → 설정 → 커넥터 → 맞춤 커넥터 추가에 서버 주소를 넣고 연결을 누르세요. 열린 화면에 아래 연결 코드와 PIN을 넣으면 끝나요.|On claude.ai, open Settings → Connectors → Add custom connector, enter the server URL and connect. Enter the code below and your PIN on the page that opens." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "claude.aiで「設定 → コネクタ → カスタムコネクタを追加」を開き、サーバーURLを入力して接続します。開いた画面に下の接続コードとPINを入力すれば完了です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 claude.ai 打开“设置 → 连接器 → 添加自定义连接器”，输入服务器 URL 并连接。在打开的页面输入下方的连接码和 PIN 即可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 claude.ai 打開「設定 → 連接器 → 新增自訂連接器」，輸入伺服器 URL 並連接。在開啟的頁面輸入下方的連線碼和 PIN 即可。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne auf claude.ai Einstellungen → Konnektoren → Benutzerdefinierten Konnektor hinzufügen, gib die Server-URL ein und verbinde. Gib auf der geöffneten Seite den Code unten und deine PIN ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur claude.ai, ouvrez Paramètres → Connecteurs → Ajouter un connecteur personnalisé, saisissez l'URL du serveur et connectez. Saisissez le code ci-dessous et votre PIN sur la page qui s'ouvre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su claude.ai apri Impostazioni → Connettori → Aggiungi connettore personalizzato, inserisci l'URL del server e collega. Inserisci il codice qui sotto e il PIN nella pagina che si apre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En claude.ai, abra Configuración → Conectores → Añadir conector personalizado, introduzca la URL del servidor y conecte. Introduzca el código de abajo y su PIN en la página que se abre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No claude.ai, abra Configurações → Conectores → Adicionar conector personalizado, informe a URL do servidor e conecte. Digite o código abaixo e seu PIN na página que abrir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên claude.ai, mở Cài đặt → Trình kết nối → Thêm trình kết nối tùy chỉnh, nhập URL máy chủ rồi nhấn kết nối. Nhập mã kết nối bên dưới và PIN vào trang hiện ra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di claude.ai, buka Pengaturan → Konektor → Tambah konektor kustom, masukkan URL server, lalu hubungkan. Masukkan kode di bawah dan PIN Anda di halaman yang terbuka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใน claude.ai เปิด การตั้งค่า → ตัวเชื่อมต่อ → เพิ่มตัวเชื่อมต่อแบบกำหนดเอง ใส่ URL เซิร์ฟเวอร์แล้วกดเชื่อมต่อ จากนั้นใส่รหัสด้านล่างและ PIN ในหน้าที่เปิดขึ้น"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "claude.ai पर सेटिंग्स → कनेक्टर → कस्टम कनेक्टर जोड़ें खोलें, सर्वर URL डालें और कनेक्ट करें। खुलने वाले पेज पर नीचे दिया कोड और अपना PIN डालें।"
          }
        }
      }
    },
