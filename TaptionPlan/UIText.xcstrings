    "총무라서 친구에게 미리 받은 돈이면 그 사람을 고르세요. 정산에서 그 사람이 낸 돈으로 쳐요.|If you collected it from a friend as the organizer, pick them. It counts as what they paid when settling." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幹事として友達から先に受け取ったお金なら、その人を選んでください。精算でその人が払った分になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果是作为负责人先从朋友那里收的钱，请选这个人。结算时算作他付的钱。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果是以負責人身分先向朋友收的錢，請選這個人。結算時算作他付的錢。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du es als Organisator vorab von jemandem eingesammelt, wähle die Person. Beim Abrechnen zählt es als ihre Zahlung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous l’avez collecté auprès d’un ami en tant qu’organisateur, choisissez-le. Au règlement, cela compte comme son paiement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l’hai raccolto da un amico come organizzatore, sceglilo. Al saldo conta come suo pagamento."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo recogiste de un amigo como organizador, elígelo. Al liquidar cuenta como su pago."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você recolheu de um amigo como organizador, escolha-o. No acerto conta como pagamento dele."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu là tiền bạn thu trước từ bạn bè khi làm thủ quỹ, hãy chọn người đó. Khi quyết toán sẽ tính là họ đã trả."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda mengumpulkannya dari teman sebagai bendahara, pilih orangnya. Saat penyelesaian dihitung sebagai bayarannya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าเป็นเงินที่เก็บจากเพื่อนล่วงหน้าในฐานะเหรัญญิก ให้เลือกคนนั้น ตอนเคลียร์จะนับเป็นเงินที่เขาจ่าย"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आयोजक होने के नाते दोस्त से पहले लिया है, तो उसे चुनें। हिसाब में यह उसका भरा माना जाएगा।"
          }
        }
      }
    },
    "최근 15분 내 센서·건강 데이터 수신 시 연결됨으로 표시합니다.|Shown as connected when sensor or Health data arrives within the last 15 minutes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去15分以内にセンサーまたはヘルスケアのデータが届くと、接続済みと表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近15分钟内收到传感器或健康数据时，显示为已连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近 15 分鐘內收到感測器或健康資料時，會顯示為已連接。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird als verbunden angezeigt, wenn in den letzten 15 Minuten Sensor- oder Health-Daten eingetroffen sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché comme connecté lorsque des données de capteurs ou de Santé arrivent dans les 15 dernières minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appare come connesso quando i dati dei sensori o di Salute arrivano negli ultimi 15 minuti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra como conectado cuando llegan datos de sensores o de Salud en los últimos 15 minutos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece como conectado quando chegam dados de sensor ou do Saúde nos últimos 15 minutos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị là đã kết nối khi có dữ liệu cảm biến hoặc Sức khỏe trong 15 phút gần nhất."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditampilkan sebagai terhubung bila data sensor atau Kesehatan masuk dalam 15 menit terakhir."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงว่าเชื่อมต่อแล้วเมื่อมีข้อมูลเซนเซอร์หรือข้อมูลสุขภาพเข้ามาใน 15 นาทีที่ผ่านมา"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछले 15 मिनट में सेंसर या स्वास्थ्य डेटा आने पर जुड़ा हुआ दिखता है।"
          }
        }
      }
    },
