    "최근 {0}개 달을 뺀 지난 달 중 백업을 다시 읽어 확인된 달만 이 기기에서 지웁니다. 지운 달은 백업 목록에서 다시 불러올 수 있습니다.|Past months older than the latest {0} are removed from this device only after their backup is read back and verified. You can restore them from the backup list." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直近{0}か月より前の過去の月は、バックアップを読み戻して検証できた後にのみ、このデバイスから削除されます。バックアップの一覧から復元できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早于最近{0}个月的过往月份，只有在其备份被读回并验证后，才会从此设备移除。你可以从备份列表中恢复它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過最近 {0} 個月的過去月份，只有在備份讀回並驗證後，才會從這部裝置移除。你可以從備份列表還原。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergangene Monate, die älter sind als die letzten {0}, werden erst von diesem Gerät entfernt, nachdem ihr Backup zurückgelesen und geprüft wurde. Du kannst sie aus der Backup-Liste wiederherstellen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mois passés au-delà des {0} derniers ne sont supprimés de cet appareil qu'après relecture et vérification de leur sauvegarde. Vous pouvez les restaurer depuis la liste des sauvegardes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I mesi passati più vecchi degli ultimi {0} vengono rimossi da questo dispositivo solo dopo che il loro backup è stato riletto e verificato. Puoi ripristinarli dall'elenco dei backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los meses pasados anteriores a los últimos {0} se quitan de este dispositivo solo después de leer y verificar su copia. Puedes restaurarlos desde la lista de copias."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meses passados mais antigos que os últimos {0} são removidos só deste dispositivo depois que o backup for relido e verificado. Você pode restaurá-los pela lista de backups."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tháng đã qua cũ hơn {0} tháng gần nhất chỉ bị xóa khỏi thiết bị này sau khi bản sao lưu của chúng được đọc lại và xác minh. Bạn có thể khôi phục từ danh sách sao lưu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulan lalu yang lebih lama dari {0} terbaru dihapus dari perangkat ini hanya setelah cadangannya dibaca ulang dan diverifikasi. Anda dapat memulihkannya dari daftar cadangan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เดือนที่ผ่านมาซึ่งเก่ากว่า {0} เดือนล่าสุดจะถูกลบออกจากเครื่องนี้ก็ต่อเมื่ออ่านข้อมูลสำรองกลับและตรวจสอบแล้วเท่านั้น คุณกู้คืนได้จากรายการข้อมูลสำรอง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछले {0} से पुराने महीने बैकअप वापस पढ़कर सत्यापित होने के बाद ही इस डिवाइस से हटाए जाते हैं। आप उन्हें बैकअप सूची से रिस्टोर कर सकते हैं।"
          }
        }
      }
    },
