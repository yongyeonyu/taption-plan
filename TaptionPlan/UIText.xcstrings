    "업무 시간에만 번 돈이 쌓여요. 금액은 이 기기에만 저장돼요.|Earnings grow only during work time. Stored only on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稼ぎは勤務時間中のみ増えます。このデバイスにのみ保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收入仅在工作时间内增长。仅存储在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收入只會在工作時間內增加。僅儲存在這部裝置上。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Verdienst wächst nur während der Arbeitszeit. Nur auf diesem Gerät gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gains n'augmentent que pendant le temps de travail. Stockés uniquement sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I guadagni crescono solo durante l'orario di lavoro. Salvati solo su questo dispositivo."
          }
        },
        "es" : {
          "stringUnit" : {
