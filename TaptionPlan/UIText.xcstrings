    "|Face ID or Touch ID is unavailable. Check your device passcode and biometric settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face IDまたはTouch IDを利用できません。デバイスのパスコードと生体認証の設定を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面容 ID 或触控 ID 不可用。请检查设备密码和生物识别设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法使用 Face ID 或 Touch ID。請檢查裝置密碼與生物辨識設定。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID oder Touch ID ist nicht verfügbar. Prüfe den Code deines Geräts und die Einstellungen für biometrische Daten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID ou Touch ID n'est pas disponible. Vérifiez le code et les réglages biométriques de l'appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID o Touch ID non è disponibile. Controlla il codice del dispositivo e le impostazioni biometriche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID o Touch ID no está disponible. Revisa el código y los ajustes biométricos del dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID ou Touch ID indisponível. Verifique o código e os ajustes de biometria do dispositivo."
