    "|Na Hye-seok Street in Suwon, Gyeonggi. It honors the painter and writer Na Hye-seok, a Suwon native, and lies near Haenggung-dong." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "京畿道水原にあるナ・ヘソク通り。水原出身の画家で作家のナ・ヘソクをたたえる通りで、幸宮洞の近くにあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "京畿道水原的罗蕙锡街。纪念水原出身的画家兼作家罗蕙锡，靠近行宫洞。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "京畿道水原的羅蕙錫街。紀念出生於水原的畫家兼作家羅蕙錫,位於幸宮洞附近。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Na-Hye-seok-Straße in Suwon, Gyeonggi. Sie ehrt die aus Suwon stammende Malerin und Schriftstellerin Na Hye-seok und liegt nahe Haenggung-dong."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rue Na Hye-seok à Suwon, dans le Gyeonggi. Elle rend hommage à la peintre et écrivaine Na Hye-seok, native de Suwon, et se trouve près de Haenggung-dong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La strada Na Hye-seok a Suwon, nel Gyeonggi. Rende omaggio alla pittrice e scrittrice Na Hye-seok, originaria di Suwon, e si trova vicino a Haenggung-dong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La calle Na Hye-seok en Suwon, Gyeonggi. Rinde homenaje a la pintora y escritora Na Hye-seok, nativa de Suwon, y se encuentra cerca de Haenggung-dong."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rua Na Hye-seok em Suwon, Gyeonggi. Homenageia a pintora e escritora Na Hye-seok, natural de Suwon, e fica perto de Haenggung-dong."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phố Na Hye-seok ở Suwon, Gyeonggi. Tôn vinh họa sĩ kiêm nhà văn Na Hye-seok, người gốc Suwon, và nằm gần Haenggung-dong."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan Na Hye-seok di Suwon, Gyeonggi. Menghormati pelukis dan penulis Na Hye-seok, putra asli Suwon, dan terletak dekat Haenggung-dong."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถนน Na Hye-seok ในซูวอน จังหวัดคยองกี เพื่อเชิดชูจิตรกรและนักเขียน Na Hye-seok ชาวซูวอนโดยกำเนิด ตั้งอยู่ใกล้ Haenggung-dong"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्योंगगी के सूवोन में ना ह्ये-सोक स्ट्रीट। यह सूवोन में जन्मे चित्रकार और लेखक ना ह्ये-सोक को सम्मान देती है और हेंगगुंग-दोंग के पास है।"
          }
        }
      }
    },
