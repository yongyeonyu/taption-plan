          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Năm 2026 có 365 ngày nên mức tối đa là 365. Lv.366 là bản xem trước tác phẩm và sẽ trở về mức tối đa ở lần ghi tiếp theo."
