    "|Munich is the main city of Bavaria in Germany. It is known for Marienplatz, the English Garden and the Oktoberfest beer festival." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミュンヘンはドイツ・バイエルン州の中心都市です。マリエン広場、イングリッシャー・ガルテン、ビールの祭典オクトーバーフェストで知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慕尼黑是德国巴伐利亚州的主要城市。以玛利亚广场、英国花园和慕尼黑啤酒节闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慕尼黑是德國巴伐利亞的主要城市。以瑪利亞廣場、英國花園與慕尼黑啤酒節聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "München ist die Hauptstadt Bayerns in Deutschland. Sie ist für den Marienplatz, den Englischen Garten und das Oktoberfest bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Munich est la principale ville de Bavière, en Allemagne. Elle est connue pour la Marienplatz, le Jardin anglais et la fête de la bière de l'Oktoberfest."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monaco di Baviera è la città principale della Baviera, in Germania. È nota per la Marienplatz, il Giardino Inglese e il festival della birra Oktoberfest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Múnich es la ciudad principal de Baviera, en Alemania. Es conocida por Marienplatz, el Jardín Inglés y el festival de cerveza Oktoberfest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Munique é a principal cidade da Baviera, na Alemanha. É conhecida pela Marienplatz, pelo Jardim Inglês e pela festa da cerveja Oktoberfest."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Munich là thành phố chính của bang Bavaria ở Đức. Nổi tiếng với Marienplatz, English Garden và lễ hội bia Oktoberfest."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Munich adalah kota utama Bavaria di Jerman. Dikenal dengan Marienplatz, English Garden, dan festival bir Oktoberfest."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มิวนิกเป็นเมืองหลักของแคว้นบาวาเรียในเยอรมนี มีชื่อเสียงเรื่อง Marienplatz สวน English Garden และเทศกาลเบียร์ Oktoberfest"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "म्यूनिख जर्मनी के बवेरिया का मुख्य शहर है। यह मारिएनप्लात्ज़, इंग्लिश गार्डन और ऑक्टोबरफ़ेस्ट बीयर उत्सव के लिए जाना जाता है।"
          }
        }
      }
    },
