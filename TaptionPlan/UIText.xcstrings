    "|Melbourne is a city in Victoria, southeastern Australia. It is known for laneway cafes, street art, trams and major sports venues." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メルボルンはオーストラリア南東部ビクトリア州の都市です。路地のカフェ、ストリートアート、路面電車、大規模なスポーツ施設で知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "墨尔本是澳大利亚东南部维多利亚州的城市。以小巷咖啡馆、街头艺术、有轨电车和大型体育场馆闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "墨爾本是澳洲東南部維多利亞州的城市。以小巷咖啡館、街頭藝術、電車與大型體育場館聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melbourne ist eine Stadt in Victoria im Südosten Australiens. Sie ist für Café-Gassen, Street Art, Straßenbahnen und große Sportstätten bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melbourne est une ville de l'État de Victoria, dans le sud-est de l'Australie. Elle est connue pour ses cafés de ruelles, son street art, ses tramways et ses grands sites sportifs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melbourne è una città del Victoria, nel sud-est dell'Australia. È nota per i caffè nei vicoli, la street art, i tram e i grandi impianti sportivi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melbourne es una ciudad del estado de Victoria, en el sureste de Australia. Es conocida por sus cafeterías en callejones, el arte callejero, los tranvías y grandes recintos deportivos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melbourne é uma cidade em Victoria, no sudeste da Austrália. É conhecida por cafés em vielas, arte de rua, bondes e grandes estádios esportivos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melbourne là thành phố thuộc bang Victoria, đông nam nước Úc. Nổi tiếng với các quán cà phê trong ngõ nhỏ, nghệ thuật đường phố, xe điện và các sân vận động thể thao lớn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melbourne adalah kota di Victoria, Australia tenggara. Dikenal dengan kafe gang, seni jalanan, trem, dan arena olahraga besar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมลเบิร์นเป็นเมืองในรัฐวิกตอเรียทางตะวันออกเฉียงใต้ของออสเตรเลีย มีชื่อเสียงเรื่องคาเฟ่ในตรอก สตรีทอาร์ต รถราง และสนามกีฬาใหญ่"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेलबर्न दक्षिण-पूर्वी ऑस्ट्रेलिया के विक्टोरिया का शहर है। यह गलियों के कैफ़े, स्ट्रीट आर्ट, ट्रामों और बड़े खेल स्थलों के लिए जाना जाता है।"
          }
        }
      }
    },
