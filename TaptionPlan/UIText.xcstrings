    "|Yichang is a city on the Yangtze River in Hubei Province. It is known as the gateway to the Three Gorges Dam and Yangtze gorge cruises." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宜昌は湖北省の長江沿いの都市です。三峡ダムと長江峡谷クルーズへの玄関口として知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宜昌是湖北省长江畔的城市。以三峡大坝门户和长江三峡游轮闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宜昌是湖北省長江畔的城市。被譽為三峽大壩與長江三峽遊輪的門戶。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yichang ist eine Stadt am Jangtse in der Provinz Hubei. Sie gilt als Tor zum Drei-Schluchten-Damm und zu Kreuzfahrten durch die Jangtse-Schluchten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yichang est une ville sur le Yangtsé, dans la province du Hubei. Elle est connue comme la porte d'accès au barrage des Trois-Gorges et aux croisières dans les gorges du Yangtsé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yichang è una città sul fiume Yangtze, nella provincia dello Hubei. È nota come porta d'accesso alla Diga delle Tre Gole e alle crociere nelle gole dello Yangtze."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yichang es una ciudad a orillas del río Yangtsé, en la provincia de Hubei. Es conocida como la puerta de entrada a la presa de las Tres Gargantas y a los cruceros por las gargantas del Yangtsé."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yichang é uma cidade no rio Yangtzé, na província de Hubei. É conhecida como a porta de entrada para a Barragem das Três Gargantas e para os cruzeiros pelas gargantas do Yangtzé."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghi Xương là thành phố bên sông Trường Giang thuộc tỉnh Hồ Bắc. Được biết đến là cửa ngõ đến đập Tam Hiệp và các chuyến du thuyền qua hẻm núi Trường Giang."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yichang adalah kota di Sungai Yangtze di Provinsi Hubei. Dikenal sebagai gerbang menuju Bendungan Tiga Ngarai dan pelayaran ngarai Yangtze."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อี๋ชางเป็นเมืองริมแม่น้ำแยงซีในมณฑลหูเป่ย เป็นที่รู้จักในฐานะประตูสู่เขื่อนสามผาและการล่องเรือชมผาแยงซี"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यिछांग हुबेई प्रांत में यांगत्ज़ी नदी पर शहर है। यह थ्री गॉर्जेस बाँध और यांगत्ज़ी घाटी क्रूज़ के प्रवेश द्वार के रूप में जाना जाता है।"
          }
        }
      }
    },
