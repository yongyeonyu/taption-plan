    "|Seattle is a city on Puget Sound in Washington State. It is known for the Space Needle, Pike Place Market and its coffee culture." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シアトルはワシントン州のピュージェット湾沿いの都市です。スペース・ニードル、パイク・プレイス・マーケット、コーヒー文化で知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "西雅图是华盛顿州普吉特海湾畔的城市。以太空针塔、派克市场和咖啡文化闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "西雅圖是華盛頓州普吉特灣畔的城市。以太空針塔、派克市場與咖啡文化聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seattle ist eine Stadt am Puget Sound im Bundesstaat Washington. Sie ist für die Space Needle, den Pike Place Market und ihre Kaffeekultur bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seattle est une ville sur le Puget Sound, dans l'État de Washington. Elle est connue pour la Space Needle, le Pike Place Market et sa culture du café."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seattle è una città sul Puget Sound, nello Stato di Washington. È nota per lo Space Needle, il Pike Place Market e la cultura del caffè."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seattle es una ciudad en Puget Sound, en el estado de Washington. Es conocida por la Space Needle, el Pike Place Market y su cultura del café."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seattle é uma cidade em Puget Sound, no estado de Washington. É conhecida pela Space Needle, pelo Pike Place Market e pela cultura do café."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seattle là thành phố bên Puget Sound ở bang Washington. Nổi tiếng với Space Needle, chợ Pike Place và văn hóa cà phê."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seattle adalah kota di Puget Sound di Negara Bagian Washington. Dikenal dengan Space Needle, Pike Place Market, dan budaya kopinya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซีแอตเทิลเป็นเมืองริมอ่าว Puget Sound ในรัฐวอชิงตัน มีชื่อเสียงเรื่อง Space Needle ตลาด Pike Place และวัฒนธรรมกาแฟ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिएटल वॉशिंगटन राज्य में प्यूजेट साउंड पर शहर है। यह स्पेस नीडल, पाइक प्लेस मार्केट और कॉफ़ी संस्कृति के लिए जाना जाता है।"
          }
        }
      }
    },
