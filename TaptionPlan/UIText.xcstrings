    "|Singapore is a city-state at the southern tip of the Malay Peninsula. It is known for Marina Bay Sands, Gardens by the Bay, clean streets and varied food." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シンガポールはマレー半島南端の都市国家です。マリーナベイ・サンズ、ガーデンズ・バイ・ザ・ベイ、清潔な街並み、多彩な食で知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新加坡是位于马来半岛南端的城市国家。以滨海湾金沙、滨海湾花园、整洁的街道和多样的美食闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新加坡是位於馬來半島南端的城市國家。以濱海灣金沙、新加坡濱海灣花園、整潔的街道與多樣美食聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Singapur ist ein Stadtstaat an der Südspitze der Malaiischen Halbinsel. Es ist für Marina Bay Sands, Gardens by the Bay, saubere Straßen und vielfältiges Essen bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Singapour est une cité-État à la pointe sud de la péninsule malaise. Elle est connue pour Marina Bay Sands, Gardens by the Bay, ses rues propres et sa cuisine variée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Singapore è una città-stato all'estremità meridionale della penisola malese. È nota per il Marina Bay Sands, i Gardens by the Bay, le strade pulite e la cucina varia."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Singapur es una ciudad-estado en el extremo sur de la península malaya. Es conocida por Marina Bay Sands, Gardens by the Bay, sus calles limpias y su variada gastronomía."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Singapura é uma cidade-estado na ponta sul da Península Malaia. É conhecida pelo Marina Bay Sands, pelos Gardens by the Bay, pelas ruas limpas e pela gastronomia variada."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Singapore là quốc đảo thành phố ở mũi nam bán đảo Mã Lai. Nổi tiếng với Marina Bay Sands, Gardens by the Bay, đường phố sạch sẽ và ẩm thực đa dạng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Singapura adalah negara kota di ujung selatan Semenanjung Malaya. Dikenal dengan Marina Bay Sands, Gardens by the Bay, jalanan bersih, dan beragam makanan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิงคโปร์เป็นนครรัฐที่ปลายใต้ของคาบสมุทรมลายู มีชื่อเสียงเรื่อง Marina Bay Sands Gardens by the Bay ถนนสะอาด และอาหารหลากหลาย"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंगापुर मलय प्रायद्वीप के दक्षिणी छोर पर नगर-राज्य है। यह मरीना बे सैंड्स, गार्डन्स बाय द बे, साफ़ सड़कों और विविध खान-पान के लिए जाना जाता है।"
          }
        }
      }
    },
