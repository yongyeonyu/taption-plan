            "value" : "请先选择大类。设定一次后，同名日程不会再问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先選擇大類。設定一次後，同名行程不會再問。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
