    "|Adjust the length so it stays within the period of the parent and child plans." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "親プランと子プランの期間内に収まるよう、長さを調整してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请调整时长，使其保持在上级和下级计划的时间段内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請調整長度，使其保持在上層與下層計畫的期間內。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe die Länge so an, dass sie innerhalb des Zeitraums von übergeordnetem und untergeordnetem Plan bleibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez la durée pour qu'elle reste dans la période des plans parent et enfant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola la durata in modo che resti entro il periodo del piano principale e di quello secondario."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la duración para que quede dentro del periodo de los planes principal y secundario."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste a duração para ficar dentro do período dos planos principal e secundário."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chỉnh độ dài để nằm trong khoảng thời gian của kế hoạch cha và con."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuaikan durasi agar tetap dalam periode rencana induk dan anak."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับความยาวให้อยู่ในช่วงเวลาของแผนหลักและแผนย่อย"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लंबाई ऐसे बदलें कि वह पैरेंट और चाइल्ड प्लान की अवधि के भीतर रहे।"
          }
        }
      }
    },
