    "|Los Angeles is a large city in Southern California. Hollywood, Santa Monica beach and Griffith Observatory are among its best-known sights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロサンゼルスは南カリフォルニアの大都市です。ハリウッド、サンタモニカのビーチ、グリフィス天文台がよく知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "洛杉矶是南加州的大城市。好莱坞、圣莫尼卡海滩和格里菲斯天文台是其最知名的景点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "洛杉磯是南加州的大城市。好萊塢、聖塔莫尼卡海灘與格里菲斯天文台是其最知名的景點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Angeles ist eine große Stadt in Südkalifornien. Hollywood, der Strand von Santa Monica und das Griffith Observatory gehören zu ihren bekanntesten Sehenswürdigkeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Angeles est une grande ville du sud de la Californie. Hollywood, la plage de Santa Monica et l'observatoire Griffith comptent parmi ses sites les plus connus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Angeles è una grande città della California meridionale. Hollywood, la spiaggia di Santa Monica e il Griffith Observatory sono tra le sue attrazioni più note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Ángeles es una gran ciudad del sur de California. Hollywood, la playa de Santa Mónica y el Observatorio Griffith están entre sus lugares más conocidos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Angeles é uma grande cidade no sul da Califórnia. Hollywood, a praia de Santa Mônica e o Observatório Griffith estão entre suas atrações mais conhecidas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Angeles là thành phố lớn ở Nam California. Hollywood, bãi biển Santa Monica và Đài thiên văn Griffith là những điểm nổi tiếng nhất."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Angeles adalah kota besar di California Selatan. Hollywood, pantai Santa Monica, dan Observatorium Griffith termasuk tempat yang paling terkenal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลอสแอนเจลิสเป็นเมืองใหญ่ในแคลิฟอร์เนียตอนใต้ ฮอลลีวูด ชายหาดซานตามอนิกา และหอดูดาว Griffith เป็นสถานที่ที่รู้จักดีที่สุดบางแห่ง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉस एंजिल्स दक्षिणी कैलिफ़ोर्निया का बड़ा शहर है। हॉलीवुड, सांता मोनिका बीच और ग्रिफ़िथ ऑब्ज़र्वेटरी इसके सबसे प्रसिद्ध स्थलों में हैं।"
          }
        }
      }
    },
