    "+ 로 여행 중 쓴 돈을 넣어요. 다 같이 쓴 돈은 n분의 1로 나눠요.|Tap + to add trip spending. Money spent by everyone is split evenly." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+ で旅行中に使ったお金を入れます。みんなで使ったお金はn等分します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点 + 记入旅行中的花费。大家一起花的钱按人数平摊。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點 + 記入旅行中的花費。大家一起花的錢按人數平分。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit + trägst du Reiseausgaben ein. Was alle zusammen ausgeben, wird gleich geteilt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez + pour ajouter les dépenses du voyage. Ce qui est dépensé ensemble est partagé à parts égales."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca + per inserire le spese del viaggio. Ciò che si spende insieme si divide in parti uguali."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + para añadir gastos del viaje. Lo gastado entre todos se divide a partes iguales."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em + para lançar gastos da viagem. O que é gasto juntos é dividido igualmente."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm + để ghi chi tiêu chuyến đi. Tiền tiêu chung chia đều n phần."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk + untuk mencatat pengeluaran perjalanan. Uang yang dipakai bersama dibagi rata."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ + เพื่อลงรายจ่ายระหว่างทริป เงินที่ใช้ด้วยกันจะหารเท่ากัน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यात्रा का खर्च जोड़ने के लिए + दबाएँ। साथ में खर्च हुआ पैसा बराबर बँटता है।"
          }
        }
      }
    },
