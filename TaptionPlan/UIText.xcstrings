        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lieu de naissance du poète Jeong Ji-yong, à Okcheon. La maison au toit de chaume se dresse à côté d'un musée de la littérature consacré à son œuvre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il luogo di nascita del poeta Jeong Ji-yong a Okcheon. La casa con il tetto di paglia sorge accanto a un museo letterario dedicato alla sua opera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El lugar de nacimiento del poeta Jeong Ji-yong, en Okcheon. La casa de techo de paja se alza junto a un museo literario dedicado a su obra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O local de nascimento do poeta Jeong Ji-yong, em Okcheon. A casa de sapê fica ao lado de um museu de literatura dedicado à sua obra."
