    "|Athens is the capital of Greece and a cradle of Western civilization. The Acropolis, the Parthenon and the Ancient Agora are its key ruins." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アテネはギリシャの首都で、西洋文明の発祥地です。アクロポリス、パルテノン神殿、古代アゴラが主な遺跡です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雅典是希腊的首都，也是西方文明的摇篮。卫城、帕特农神庙和古代市集是其主要遗迹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雅典是希臘的首都,也是西方文明的搖籃。衛城、帕德嫩神殿與古代市集是主要遺跡。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Athen ist die Hauptstadt Griechenlands und eine Wiege der westlichen Zivilisation. Die Akropolis, der Parthenon und die Antike Agora sind die wichtigsten Ruinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Athènes est la capitale de la Grèce et un berceau de la civilisation occidentale. L'Acropole, le Parthénon et l'Agora antique en sont les principales ruines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atene è la capitale della Grecia e una culla della civiltà occidentale. L'Acropoli, il Partenone e l'Agorà antica sono le sue principali rovine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenas es la capital de Grecia y cuna de la civilización occidental. La Acrópolis, el Partenón y el Ágora Antigua son sus ruinas principales."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenas é a capital da Grécia e um berço da civilização ocidental. A Acrópole, o Partenon e a Ágora Antiga são suas principais ruínas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Athens là thủ đô của Hy Lạp và là cái nôi của nền văn minh phương Tây. Acropolis, đền Parthenon và Ancient Agora là những di tích chính."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Athena adalah ibu kota Yunani dan tempat lahirnya peradaban Barat. Acropolis, Parthenon, dan Agora Kuno adalah reruntuhan utamanya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอเธนส์เป็นเมืองหลวงของกรีซและเป็นแหล่งกำเนิดอารยธรรมตะวันตก อะโครโพลิส วิหารพาร์เธนอน และอาโกราโบราณเป็นซากโบราณสถานสำคัญ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एथेंस ग्रीस की राजधानी और पश्चिमी सभ्यता का पालना है। एक्रोपोलिस, पार्थेनन और प्राचीन अगोरा इसके मुख्य खंडहर हैं।"
          }
        }
      }
    },
