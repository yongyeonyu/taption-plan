          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini CLI : Connecter copie un bloc pour settings.json. Collez-le dans ~/.gemini/settings.json et redémarrez gemini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
