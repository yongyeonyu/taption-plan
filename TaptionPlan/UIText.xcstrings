          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli prima una categoria. Una volta scelta, non verrà più chiesto per eventi con lo stesso titolo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
