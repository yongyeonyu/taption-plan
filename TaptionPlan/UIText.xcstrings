    "|Frankfurt is a financial center in Hesse, Germany, on the River Main. It combines a high-rise skyline, the old Römer square and one of Europe’s major airports." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フランクフルトはドイツ・ヘッセン州にある金融の中心地で、マイン川沿いにあります。高層ビルのスカイライン、古いレーマー広場、ヨーロッパの主要空港の一つを併せ持ちます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法兰克福是德国黑森州的金融中心，位于美因河畔。高楼天际线、古老的罗马人广场和欧洲主要机场之一汇聚于此。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法蘭克福是德國黑森邦的金融中心,位於美因河畔。結合了高樓天際線、舊羅馬人廣場與歐洲主要機場之一。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frankfurt ist ein Finanzzentrum in Hessen, Deutschland, am Main. Es verbindet eine Hochhaus-Skyline, den alten Römerplatz und einen der großen Flughäfen Europas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Francfort est un centre financier de Hesse, en Allemagne, sur le Main. Elle associe un horizon de gratte-ciel, l'ancienne place du Römer et l'un des grands aéroports d'Europe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Francoforte è un centro finanziario in Assia, in Germania, sul fiume Meno. Unisce uno skyline di grattacieli, l'antica piazza Römer e uno dei principali aeroporti d'Europa."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fráncfort es un centro financiero de Hesse, Alemania, a orillas del río Meno. Combina un horizonte de rascacielos, la antigua plaza Römer y uno de los principales aeropuertos de Europa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frankfurt é um centro financeiro em Hesse, na Alemanha, às margens do rio Meno. Combina um horizonte de arranha-céus, a antiga praça Römer e um dos principais aeroportos da Europa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frankfurt là trung tâm tài chính ở bang Hesse, Đức, bên sông Main. Kết hợp đường chân trời cao tầng, quảng trường Römer cổ và một trong những sân bay lớn của châu Âu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frankfurt adalah pusat keuangan di Hesse, Jerman, di Sungai Main. Memadukan cakrawala gedung tinggi, alun-alun Römer yang tua, dan salah satu bandara utama Eropa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แฟรงก์เฟิร์ตเป็นศูนย์กลางการเงินในแคว้นเฮสเซิน ประเทศเยอรมนี ริมแม่น้ำไมน์ ผสมผสานเส้นขอบฟ้าตึกสูง จัตุรัส Römer เก่า และหนึ่งในสนามบินหลักของยุโรป"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ्रैंकफ़र्ट जर्मनी के हेस्से में मेन नदी पर वित्तीय केंद्र है। यह ऊँची इमारतों की क्षितिज रेखा, पुराने रोमर चौक और यूरोप के प्रमुख हवाई अड्डों में से एक को जोड़ता है।"
          }
        }
      }
    },
