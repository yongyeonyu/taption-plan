    "|Bali is an Indonesian island with a living Hindu culture. Beaches, terraced rice fields and sea temples are its highlights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バリはインドネシアの島で、ヒンドゥー文化が生きています。ビーチ、棚田、海の寺院が見どころです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "巴厘岛是印度尼西亚的一座岛屿，印度教文化依然鲜活。海滩、梯田和海边寺庙是其亮点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "峇里島是印尼的島嶼,擁有活生生的印度教文化。海灘、梯田與海邊寺廟是其亮點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bali ist eine indonesische Insel mit lebendiger hinduistischer Kultur. Strände, Reisterrassen und Meerestempel sind ihre Höhepunkte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bali est une île indonésienne à la culture hindoue vivante. Plages, rizières en terrasses et temples marins en sont les points forts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bali è un'isola indonesiana con una cultura indù viva. Spiagge, risaie a terrazze e templi sul mare sono i suoi punti forti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bali es una isla indonesia con una cultura hindú viva. Playas, arrozales en terrazas y templos marinos son lo más destacado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bali é uma ilha da Indonésia com uma cultura hindu viva. Praias, arrozais em terraços e templos à beira-mar são seus destaques."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bali là một hòn đảo của Indonesia với nền văn hóa Hindu còn sống động. Bãi biển, ruộng bậc thang và các đền biển là những điểm nổi bật."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bali adalah pulau di Indonesia dengan budaya Hindu yang hidup. Pantai, sawah berteras, dan pura laut adalah daya tarik utamanya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บาหลีเป็นเกาะของอินโดนีเซียที่มีวัฒนธรรมฮินดูที่ยังมีชีวิต ชายหาด นาขั้นบันได และวัดริมทะเลเป็นไฮไลต์"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाली इंडोनेशिया का द्वीप है, जहाँ जीवंत हिंदू संस्कृति है। समुद्र तट, सीढ़ीदार धान के खेत और समुद्री मंदिर इसके मुख्य आकर्षण हैं।"
          }
        }
      }
    },
