    "|The Penghu archipelago lies in the Taiwan Strait west of the main island. It is known for basalt coastlines and sea views, and is a popular summer beach destination." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "澎湖諸島は台湾海峡にあり、本島の西に位置します。玄武岩の海岸線と海の眺めで知られ、夏のビーチ旅行先として人気です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "澎湖群岛位于台湾海峡中，在本岛以西。以玄武岩海岸线和海景闻名，是热门的夏季海滩目的地。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "澎湖群島位於台灣海峽、台灣本島以西。以玄武岩海岸線與海景聞名,是熱門的夏季海灘度假地。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Penghu-Inseln liegen in der Taiwanstraße westlich der Hauptinsel. Sie sind für Basaltküsten und Meerblicke bekannt und ein beliebtes Strandziel im Sommer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archipel de Penghu se trouve dans le détroit de Taïwan, à l'ouest de l'île principale. Il est connu pour ses côtes de basalte et ses vues sur la mer, et est une destination balnéaire d'été prisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'arcipelago di Penghu si trova nello Stretto di Taiwan, a ovest dell'isola principale. È noto per le coste di basalto e le vedute sul mare ed è una popolare meta balneare estiva."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archipiélago de Penghu se encuentra en el estrecho de Taiwán, al oeste de la isla principal. Es conocido por sus costas de basalto y sus vistas del mar, y es un popular destino de playa en verano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquipélago de Penghu fica no Estreito de Taiwan, a oeste da ilha principal. É conhecido por costas de basalto e vistas do mar, e é um destino de praia popular no verão."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quần đảo Bành Hồ nằm ở eo biển Đài Loan, phía tây đảo chính. Nổi tiếng với bờ biển đá bazan và cảnh biển, và là điểm đến bãi biển mùa hè được ưa chuộng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kepulauan Penghu terletak di Selat Taiwan di barat pulau utama. Dikenal dengan garis pantai basalt dan pemandangan laut, dan merupakan tujuan pantai musim panas yang populer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หมู่เกาะเผิงหูตั้งอยู่ในช่องแคบไต้หวันทางตะวันตกของเกาะหลัก มีชื่อเสียงเรื่องชายฝั่งบะซอลต์และทัศนียภาพทะเล และเป็นจุดหมายชายหาดยอดนิยมในฤดูร้อน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेंगहू द्वीपसमूह मुख्य द्वीप के पश्चिम में ताइवान जलडमरूमध्य में है। यह बेसाल्ट तटरेखा और समुद्री दृश्यों के लिए जाना जाता है, और गर्मियों में समुद्र तट की लोकप्रिय जगह है।"
          }
        }
      }
    },
