          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre e escolha dias passados com Calendário na barra inferior."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tìm và chọn các ngày đã qua bằng Lịch ở thanh dưới."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temukan dan pilih hari lalu dengan Kalender di bilah bawah."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค้นหาและเลือกวันที่ผ่านมาด้วย ปฏิทิน ในแถบด้านล่าง"
