    "현재 위치를 받는 중입니다. 검색으로도 저장할 수 있습니다.|Waiting for your location. You can also search." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報を待っています。検索することもできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待你的位置。你也可以搜索。"
          }
