    "|Zurich is Switzerland’s largest city, at the northern end of Lake Zurich. It is a financial hub with an old town of narrow lanes and pleasant lakeside walks." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チューリッヒはスイス最大の都市で、チューリッヒ湖の北端にあります。金融の中心地で、細い路地の旧市街と心地よい湖畔の散歩道があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "苏黎世是瑞士最大的城市，位于苏黎世湖北端。它是金融中心，有窄巷纵横的老城和宜人的湖畔漫步道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蘇黎世是瑞士最大的城市,位於蘇黎世湖北端。它是金融中心,擁有巷弄狹窄的舊城區與宜人的湖畔步道。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zürich ist die größte Stadt der Schweiz am nördlichen Ende des Zürichsees. Es ist ein Finanzzentrum mit einer Altstadt aus engen Gassen und angenehmen Spaziergängen am See."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurich est la plus grande ville de Suisse, à l'extrémité nord du lac de Zurich. C'est un centre financier avec une vieille ville aux ruelles étroites et d'agréables promenades au bord du lac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurigo è la città più grande della Svizzera, all'estremità settentrionale del lago di Zurigo. È un centro finanziario con una città vecchia di vicoli stretti e piacevoli passeggiate in riva al lago."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zúrich es la mayor ciudad de Suiza, en el extremo norte del lago de Zúrich. Es un centro financiero con un casco antiguo de callejuelas estrechas y agradables paseos junto al lago."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurique é a maior cidade da Suíça, na extremidade norte do lago de Zurique. É um centro financeiro com uma cidade antiga de vielas estreitas e agradáveis passeios à beira do lago."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurich là thành phố lớn nhất Thụy Sĩ, ở đầu phía bắc hồ Zurich. Là trung tâm tài chính với khu phố cổ có những con hẻm hẹp và những lối đi dạo dễ chịu bên hồ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurich adalah kota terbesar Swiss, di ujung utara Danau Zurich. Pusat keuangan dengan kota tua bergang sempit dan jalan santai tepi danau yang menyenangkan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซูริกเป็นเมืองใหญ่ที่สุดของสวิตเซอร์แลนด์ ตั้งอยู่ปลายด้านเหนือของทะเลสาบซูริก เป็นศูนย์กลางการเงินที่มีเมืองเก่าตรอกแคบและทางเดินเล่นริมทะเลสาบอันน่ารื่นรมย์"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यूरिख स्विट्ज़रलैंड का सबसे बड़ा शहर है, जो ज़्यूरिख झील के उत्तरी छोर पर है। यह वित्तीय केंद्र है, जिसका पुराना शहर संकरी गलियों वाला है और झील किनारे की सुखद सैर है।"
          }
        }
      }
    },
