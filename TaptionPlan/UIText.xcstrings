          }
        }
      }
    },
    "지금 활동, 오늘 요약, 다음 일정을 보고 활동을 확인·수정합니다. 시계 페이스에도 놓을 수 있습니다.|See your current activity, today's summary, and next plan, confirm or fix activities, and add it to your watch face." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のアクティビティ、今日のまとめ、次の予定を確認し、アクティビティを確認・修正できます。文字盤にも追加できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看当前活动、今日摘要和下一个日程，并确认或修改活动。也可以添加到表盘上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看目前活動、今日摘要和下一個行程，並確認或修改活動。也可以加到錶面上。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die aktuelle Aktivität, die Tageszusammenfassung und den nächsten Plan, und du kannst Aktivitäten bestätigen oder korrigieren. Auch auf dem Zifferblatt möglich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez l’activité en cours, le résumé du jour et le prochain plan, puis confirmez ou corrigez les activités. Vous pouvez aussi l’ajouter au cadran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi l’attività attuale, il riepilogo di oggi e il prossimo piano, e conferma o correggi le attività. Puoi aggiungerla anche al quadrante."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta la actividad actual, el resumen de hoy y el próximo plan, y confirma o corrige actividades. También puedes añadirla a la esfera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja a atividade atual, o resumo de hoje e o próximo plano, e confirme ou corrija atividades. Também pode ser adicionado ao mostrador."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem hoạt động hiện tại, tóm tắt hôm nay và kế hoạch tiếp theo, đồng thời xác nhận hoặc sửa hoạt động. Cũng có thể thêm vào mặt đồng hồ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat aktivitas saat ini, ringkasan hari ini, dan rencana berikutnya, serta konfirmasi atau ubah aktivitas. Bisa juga ditambahkan ke tampilan jam."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูกิจกรรมปัจจุบัน สรุปวันนี้ และแผนถัดไป พร้อมยืนยันหรือแก้ไขกิจกรรม วางบนหน้าปัดนาฬิกาได้ด้วย"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा गतिविधि, आज का सारांश और अगला प्लान देखें, और गतिविधियों की पुष्टि या सुधार करें। इसे वॉच फ़ेस पर भी रख सकते हैं।"
          }
        }
      }
    },
    "지금 활동을 잠금화면과 다이나믹 아일랜드에 보여줍니다.|Shows your current activity on the Lock Screen and Dynamic Island." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のアクティビティをロック画面とDynamic Islandに表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
