          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật công tắc “BOKKI Thanh toán”. iOS thêm mục tự động hóa được chia sẻ ở trạng thái tắt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyalakan sakelar “BOKKI Pembayaran”. iOS menambahkan otomatisasi yang dibagikan dalam keadaan mati."
