          }
        }
      }
    },
    "|Salt Lake City is the capital of Utah, at the foot of the Rocky Mountains. It is known for Temple Square, the Great Salt Lake and nearby ski resorts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソルトレイクシティはユタ州の州都で、ロッキー山脈の麓にあります。テンプル・スクエア、グレートソルト湖、近くのスキーリゾートで知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "盐湖城是犹他州的首府，位于落基山脉脚下。以圣殿广场、大盐湖和附近的滑雪度假村闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鹽湖城是猶他州的首府,位於洛磯山脈山腳。以聖殿廣場、大鹽湖與附近的滑雪度假村聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt Lake City ist die Hauptstadt von Utah am Fuß der Rocky Mountains. Sie ist für den Temple Square, den Großen Salzsee und nahe Skigebiete bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt Lake City est la capitale de l'Utah, au pied des montagnes Rocheuses. Elle est connue pour Temple Square, le Grand Lac Salé et les stations de ski voisines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt Lake City è la capitale dello Utah, ai piedi delle Montagne Rocciose. È nota per Temple Square, il Great Salt Lake e le vicine stazioni sciistiche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt Lake City es la capital de Utah, al pie de las Montañas Rocosas. Es conocida por Temple Square, el Gran Lago Salado y las estaciones de esquí cercanas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt Lake City é a capital de Utah, ao pé das Montanhas Rochosas. É conhecida pela Temple Square, pelo Grande Lago Salgado e por estações de esqui próximas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt Lake City là thủ phủ của bang Utah, dưới chân dãy Rocky. Nổi tiếng với Temple Square, Hồ Muối Lớn và các khu trượt tuyết gần đó."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salt Lake City adalah ibu kota Utah, di kaki Pegunungan Rocky. Dikenal dengan Temple Square, Great Salt Lake, dan resor ski di dekatnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซอลต์เลกซิตี้เป็นเมืองหลวงของรัฐยูทาห์ ที่เชิงเทือกเขาร็อกกี มีชื่อเสียงเรื่อง Temple Square ทะเลสาบเกลือใหญ่ และรีสอร์ตสกีใกล้เคียง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सॉल्ट लेक सिटी रॉकी पर्वतों की तलहटी में यूटा की राजधानी है। यह टेम्पल स्क्वायर, ग्रेट सॉल्ट लेक और पास के स्की रिसॉर्ट के लिए जाना जाता है।"
          }
        }
      }
    },
