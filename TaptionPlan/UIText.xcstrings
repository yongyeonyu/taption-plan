        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองหลักของภูมิภาคคันไซของญี่ปุ่น มีชื่อเสียงเรื่องอาหาร ปราสาทโอซาก้าและโดตงโบริเป็นสถานที่ที่รู้จักดีที่สุด"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जापान के कंसाई क्षेत्र का मुख्य शहर, जो अपने खान-पान के लिए प्रसिद्ध है। ओसाका कैसल और डोतोनबोरी सबसे प्रसिद्ध दर्शनीय स्थल हैं।"
          }
        }
      }
    },
    "|The main city of Japan’s Tohoku region, called the city of trees. It is known for grilled beef tongue and nearby Matsushima Bay." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本の東北地方の中心都市で、杜の都と呼ばれます。牛タン焼きと近くの松島湾で知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本东北地区的主要城市，被称为森林之都。以烤牛舌和附近的松岛湾闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本東北地區的主要城市,被稱為杜之都。以烤牛舌與附近的松島灣聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die wichtigste Stadt der Region Tohoku in Japan, Stadt der Bäume genannt. Sie ist für gegrillte Rinderzunge und die nahe Matsushima-Bucht bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La principale ville de la région du Tohoku, au Japon, surnommée la ville des arbres. Elle est connue pour sa langue de bœuf grillée et la baie de Matsushima voisine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La città principale della regione del Tohoku, in Giappone, chiamata città degli alberi. È nota per la lingua di manzo alla griglia e per la vicina baia di Matsushima."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ciudad principal de la región de Tohoku, en Japón, llamada la ciudad de los árboles. Es conocida por la lengua de vaca a la parrilla y la cercana bahía de Matsushima."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A principal cidade da região de Tohoku, no Japão, chamada de cidade das árvores. É conhecida pela língua de boi grelhada e pela vizinha baía de Matsushima."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thành phố chính của vùng Tohoku, Nhật Bản, được gọi là thành phố của cây xanh. Nổi tiếng với món lưỡi bò nướng và vịnh Matsushima gần đó."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kota utama wilayah Tohoku Jepang, dijuluki kota pepohonan. Dikenal dengan lidah sapi panggang dan Teluk Matsushima di dekatnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมืองหลักของภูมิภาคโทโฮคุของญี่ปุ่น เรียกว่านครแห่งต้นไม้ มีชื่อเสียงเรื่องลิ้นวัวย่างและอ่าวมัตสึชิมะใกล้เคียง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जापान के तोहोकू क्षेत्र का मुख्य शहर, जिसे पेड़ों का शहर कहा जाता है। यह भुनी हुई बीफ़ जीभ और पास की मात्सुशिमा खाड़ी के लिए जाना जाता है।"
          }
        }
      }
    },
    "|The main city of Kagawa on Shikoku, Japan. It is known for Sanuki udon and Ritsurin Garden, and is a gateway to art islands such as Naoshima." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本の四国にある香川県の中心都市。讃岐うどんと栗林公園で知られ、直島などのアートの島への玄関口です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本四国香川县的主要城市。以赞岐乌冬面和栗林公园闻名，是前往直岛等艺术之岛的门户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本四國香川縣的主要城市。以讚岐烏龍麵與栗林公園聞名,也是前往直島等藝術島的門戶。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hauptstadt der Präfektur Kagawa auf Shikoku, Japan. Sie ist für Sanuki-Udon und den Ritsurin-Garten bekannt und Tor zu Kunstinseln wie Naoshima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La principale ville de Kagawa, sur Shikoku, au Japon. Elle est connue pour les udon Sanuki et le jardin Ritsurin, et est la porte d'accès à des îles d'art comme Naoshima."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La città principale di Kagawa a Shikoku, in Giappone. È nota per gli udon Sanuki e il Giardino Ritsurin ed è la porta d'accesso alle isole d'arte come Naoshima."
