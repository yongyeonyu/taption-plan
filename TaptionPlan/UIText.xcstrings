        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác định định dạng đầu vào âm thanh hiện tại."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format input audio saat ini tidak dapat ditentukan."
          }
