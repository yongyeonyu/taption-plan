          }
        }
      }
    },
    "|Tel Aviv is a Mediterranean coastal city in Israel. It is known for its beaches, the Bauhaus-style White City district and a lively cafe scene." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テルアビブはイスラエルの地中海沿岸の都市です。ビーチ、バウハウス様式のホワイト・シティ地区、にぎやかなカフェ文化で知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特拉维夫是以色列的地中海沿岸城市。以海滩、包豪斯风格的白城区和活跃的咖啡馆文化闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特拉維夫是以色列的地中海沿岸城市。以海灘、包浩斯風格的白城區與熱鬧的咖啡館文化聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel Aviv ist eine Mittelmeer-Küstenstadt in Israel. Sie ist für ihre Strände, das Viertel Weiße Stadt im Bauhaus-Stil und eine lebhafte Cafészene bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel Aviv est une ville côtière méditerranéenne d'Israël. Elle est connue pour ses plages, le quartier de la Ville blanche de style Bauhaus et une scène de cafés animée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel Aviv è una città costiera mediterranea in Israele. È nota per le sue spiagge, il quartiere della Città Bianca in stile Bauhaus e una vivace scena di caffè."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel Aviv es una ciudad costera mediterránea de Israel. Es conocida por sus playas, el distrito de la Ciudad Blanca de estilo Bauhaus y una animada escena de cafeterías."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel Aviv é uma cidade costeira mediterrânea em Israel. É conhecida pelas praias, pelo distrito da Cidade Branca em estilo Bauhaus e por uma animada cena de cafés."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel Aviv là thành phố ven Địa Trung Hải ở Israel. Nổi tiếng với bãi biển, khu White City theo phong cách Bauhaus và không khí quán cà phê sôi động."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel Aviv adalah kota pesisir Mediterania di Israel. Dikenal dengan pantainya, distrik White City bergaya Bauhaus, dan suasana kafe yang hidup."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เทลอาวีฟเป็นเมืองชายฝั่งเมดิเตอร์เรเนียนในอิสราเอล มีชื่อเสียงเรื่องชายหาด ย่านเมืองขาวสไตล์เบาเฮาส์ และวงการคาเฟ่ที่คึกคัก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तेल अवीव इज़राइल में भूमध्यसागरीय तटीय शहर है। यह अपने समुद्र तटों, बाउहाउस शैली के व्हाइट सिटी जिले और जीवंत कैफ़े माहौल के लिए जाना जाता है।"
          }
        }
      }
    },
    "|Telling “housework” apart. Time at home cannot be split into housework and rest." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「家事」の判別。自宅で過ごす時間を、家事と休憩に分けることはできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区分“家务”。在家的时间无法分为家务和休息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "區分「做家事」。在家的時間無法分成做家事和休息。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Hausarbeit“ unterscheiden. Zeit zu Hause lässt sich nicht in Hausarbeit und Ausruhen aufteilen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distinction des « tâches ménagères ». Le temps à la maison ne peut pas être séparé entre tâches ménagères et repos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconoscere le “faccende di casa”. Il tempo a casa non si può dividere tra faccende e riposo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distinguir las “tareas del hogar”. El tiempo en casa no se puede dividir entre tareas del hogar y descanso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distinguir “tarefas domésticas”. O tempo em casa não pode ser separado entre tarefas domésticas e descanso."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phân biệt “việc nhà”. Thời gian ở nhà không thể tách thành việc nhà và nghỉ ngơi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membedakan “pekerjaan rumah”. Waktu di rumah tidak dapat dibagi menjadi pekerjaan rumah dan istirahat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแยก “งานบ้าน” ออก เวลาที่อยู่บ้านแยกเป็นงานบ้านกับการพักผ่อนไม่ได้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“घर का काम” पहचानना। घर में बिताए समय को घर का काम और आराम में बाँटा नहीं जा सकता।"
          }
        }
      }
    },
    "|Temple of Artemis" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
