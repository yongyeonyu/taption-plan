    "|San Francisco is a hilly city on San Francisco Bay in Northern California. The Golden Gate Bridge, cable cars and Alcatraz Island are well known." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サンフランシスコは北カリフォルニアのサンフランシスコ湾岸にある坂の多い都市です。ゴールデンゲートブリッジ、ケーブルカー、アルカトラズ島がよく知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧金山是北加州旧金山湾畔的丘陵城市。金门大桥、缆车和恶魔岛广为人知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舊金山是北加州舊金山灣畔的丘陵城市。金門大橋、纜車與惡魔島廣為人知。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "San Francisco ist eine hügelige Stadt an der San Francisco Bay in Nordkalifornien. Die Golden Gate Bridge, Cable Cars und die Insel Alcatraz sind bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "San Francisco est une ville vallonnée sur la baie de San Francisco, dans le nord de la Californie. Le Golden Gate Bridge, les cable cars et l'île d'Alcatraz sont bien connus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "San Francisco è una città collinare sulla baia di San Francisco, nella California settentrionale. Il Golden Gate Bridge, i cable car e l'isola di Alcatraz sono ben noti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "San Francisco es una ciudad de colinas en la bahía de San Francisco, en el norte de California. El puente Golden Gate, los tranvías de cable y la isla de Alcatraz son muy conocidos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São Francisco é uma cidade de colinas na baía de São Francisco, no norte da Califórnia. A ponte Golden Gate, os bondes e a ilha de Alcatraz são bem conhecidos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "San Francisco là thành phố nhiều đồi bên vịnh San Francisco ở Bắc California. Cầu Cổng Vàng, xe cáp và đảo Alcatraz rất nổi tiếng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "San Francisco adalah kota berbukit di San Francisco Bay di California Utara. Jembatan Golden Gate, trem kabel, dan Pulau Alcatraz sangat terkenal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซานฟรานซิสโกเป็นเมืองบนเนินเขาริมอ่าวซานฟรานซิสโกในแคลิฟอร์เนียตอนเหนือ สะพานโกลเดนเกต รถราง cable car และเกาะอัลคาทราซเป็นที่รู้จักดี"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सैन फ्रांसिस्को उत्तरी कैलिफ़ोर्निया में सैन फ्रांसिस्को खाड़ी पर पहाड़ियों वाला शहर है। गोल्डन गेट ब्रिज, केबल कार और अल्काट्राज़ द्वीप प्रसिद्ध हैं।"
          }
        }
      }
    },
