        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{0} backups de uma versão anterior não podem ser abertos aqui e não aparecem na lista. Os arquivos não foram alterados."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{0} bản sao lưu từ phiên bản cũ hơn không thể mở ở đây và không được liệt kê. Các tệp không bị động tới."
          }
        },
        "id" : {
