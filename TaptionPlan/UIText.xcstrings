          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non lo supporta ancora. È necessario aggiornare l’app o il server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor aún no admite esto. Hay que actualizar la app o el servidor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor ainda não oferece suporte a isso. O app ou o servidor precisa ser atualizado."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ chưa hỗ trợ tính năng này. Cần cập nhật ứng dụng hoặc máy chủ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
