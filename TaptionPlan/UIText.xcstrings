    "|Zhangjiajie is a mountain tourism city in Hunan Province. Its national forest park is known for towering sandstone pillar peaks." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "張家界は湖南省の山岳観光都市です。国家森林公園は、そびえ立つ砂岩の柱状の峰で知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "张家界是湖南省的山岳旅游城市。其国家森林公园以高耸的砂岩石柱峰闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "張家界是湖南省的山岳觀光城市。國家森林公園以高聳的砂岩石柱峰聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhangjiajie ist eine Bergtourismusstadt in der Provinz Hunan. Ihr Nationaler Waldpark ist für hoch aufragende Sandsteinsäulen-Gipfel bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhangjiajie est une ville touristique de montagne de la province du Hunan. Son parc forestier national est connu pour ses piliers de grès qui se dressent en pics."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhangjiajie è una città turistica di montagna nella provincia dello Hunan. Il suo parco forestale nazionale è noto per gli imponenti pilastri di arenaria."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhangjiajie es una ciudad de turismo de montaña en la provincia de Hunan. Su parque forestal nacional es conocido por los imponentes picos de pilares de arenisca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhangjiajie é uma cidade turística de montanha na província de Hunan. Seu parque florestal nacional é conhecido por imponentes picos em pilares de arenito."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trương Gia Giới là thành phố du lịch miền núi thuộc tỉnh Hồ Nam. Công viên rừng quốc gia nổi tiếng với những cột đá sa thạch cao chót vót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhangjiajie adalah kota wisata pegunungan di Provinsi Hunan. Taman hutan nasionalnya terkenal dengan puncak pilar batu pasir yang menjulang."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จางเจียเจี้ยเป็นเมืองท่องเที่ยวภูเขาในมณฑลหูหนาน อุทยานป่าไม้แห่งชาติมีชื่อเสียงเรื่องยอดเสาหินทรายสูงตระหง่าน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "झांगजियाजी हुनान प्रांत में पहाड़ी पर्यटन शहर है। इसका राष्ट्रीय वन पार्क ऊँचे बलुआ पत्थर के स्तंभ जैसे शिखरों के लिए जाना जाता है।"
          }
        }
      }
    },
