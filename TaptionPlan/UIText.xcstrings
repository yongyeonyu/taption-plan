    "|Shenyang is the main city of Liaoning Province in northeastern China. Its best-known sight is the Shenyang Imperial Palace, built in the early Qing era." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀋陽は中国東北部の遼寧省の中心都市です。清の初期に建てられた瀋陽故宮が一番の名所です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沈阳是中国东北辽宁省的主要城市。最著名的景点是清代早期修建的沈阳故宫。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀋陽是中國東北遼寧省的主要城市。最著名的景點是建於清初的瀋陽故宮。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenyang ist die Hauptstadt der Provinz Liaoning im Nordosten Chinas. Ihre bekannteste Sehenswürdigkeit ist der Kaiserpalast von Shenyang, der in der frühen Qing-Zeit erbaut wurde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenyang est la principale ville de la province du Liaoning, dans le nord-est de la Chine. Son site le plus connu est le palais impérial de Shenyang, construit au début de l'ère Qing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenyang è la città principale della provincia del Liaoning, nella Cina nord-orientale. La sua attrazione più nota è il Palazzo Imperiale di Shenyang, costruito all'inizio dell'epoca Qing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenyang es la ciudad principal de la provincia de Liaoning, en el noreste de China. Su atractivo más conocido es el Palacio Imperial de Shenyang, construido a principios de la era Qing."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenyang é a principal cidade da província de Liaoning, no nordeste da China. Sua atração mais conhecida é o Palácio Imperial de Shenyang, construído no início da era Qing."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thẩm Dương là thành phố chính của tỉnh Liêu Ninh ở đông bắc Trung Quốc. Điểm tham quan nổi tiếng nhất là Cố cung Thẩm Dương, xây vào đầu thời Thanh."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shenyang adalah kota utama Provinsi Liaoning di timur laut Tiongkok. Tempat paling terkenal adalah Istana Kekaisaran Shenyang, dibangun pada awal era Qing."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสิ่นหยางเป็นเมืองหลักของมณฑลเหลียวหนิงทางตะวันออกเฉียงเหนือของจีน สถานที่ที่รู้จักดีที่สุดคือพระราชวังหลวงเสิ่นหยาง สร้างในช่วงต้นสมัยชิง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शेनयांग उत्तर-पूर्वी चीन के लियाओनिंग प्रांत का मुख्य शहर है। इसका सबसे प्रसिद्ध दर्शनीय स्थल शेनयांग इंपीरियल पैलेस है, जो शुरुआती किंग युग में बना।"
          }
        }
      }
    },
