    "|Yangon is Myanmar’s largest city and former capital. The golden Shwedagon Pagoda and colonial-era buildings remain in the city." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヤンゴンはミャンマー最大の都市で、かつての首都です。金色のシュエダゴン・パゴダと植民地時代の建物が街に残っています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仰光是缅甸最大的城市和前首都。金色的大金塔和殖民时代的建筑保留在城中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仰光是緬甸最大的城市與前首都。金色的大金寺與殖民時期建築仍留存於城中。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangon ist Myanmars größte Stadt und frühere Hauptstadt. Die goldene Shwedagon-Pagode und Gebäude aus der Kolonialzeit sind in der Stadt erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangon est la plus grande ville du Myanmar et son ancienne capitale. La pagode dorée Shwedagon et des bâtiments de l'époque coloniale subsistent dans la ville."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangon è la più grande città del Myanmar ed ex capitale. La dorata Pagoda Shwedagon e gli edifici dell'epoca coloniale restano in città."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangón es la mayor ciudad de Myanmar y su antigua capital. La dorada Pagoda Shwedagon y los edificios de la época colonial se conservan en la ciudad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangon é a maior cidade de Mianmar e antiga capital. O dourado Pagode Shwedagon e os edifícios da era colonial permanecem na cidade."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangon là thành phố lớn nhất và là cựu thủ đô của Myanmar. Chùa vàng Shwedagon và các tòa nhà thời thuộc địa vẫn còn trong thành phố."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yangon adalah kota terbesar dan bekas ibu kota Myanmar. Pagoda Shwedagon yang keemasan dan bangunan era kolonial masih ada di kota ini."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย่างกุ้งเป็นเมืองใหญ่ที่สุดและเป็นอดีตเมืองหลวงของเมียนมา เจดีย์ชเวดากองสีทองและอาคารสมัยอาณานิคมยังคงอยู่ในเมือง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यांगून म्यांमार का सबसे बड़ा शहर और पूर्व राजधानी है। सुनहरा श्वेडागोन पैगोडा और औपनिवेशिक काल की इमारतें शहर में बनी हुई हैं।"
          }
        }
      }
    },
