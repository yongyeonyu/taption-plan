        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Verlagsviertel in Paju aus Verlagen, Druckereien, Buchhandlungen und Galerien. Es ist ein Ort, um Bücher neben besonderer Architektur zu genießen."
          }
