    "지금은 반영하지 못했어요. 잠시 뒤 다시 해 주세요.|Couldn't add it right now. Try again in a moment." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今は反映できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时无法应用。请稍后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫時無法套用。請稍後再試。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konnte gerade nicht übernommen werden. Versuch es gleich noch einmal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de l'appliquer pour l'instant. Réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile applicarlo ora. Riprova tra poco."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo aplicar ahora. Reintente en un momento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível aplicar agora. Tente de novo em instantes."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện chưa áp dụng được. Vui lòng thử lại sau giây lát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum dapat diterapkan saat ini. Coba lagi sebentar lagi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้ยังนำไปใช้ไม่ได้ โปรดลองใหม่ในอีกสักครู่"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी लागू नहीं हो सका। थोड़ी देर बाद फिर कोशिश करें।"
          }
        }
      }
    },
    "지난 날짜로 만들면 그날의 기록이 이 여행의 실제 기록이 됩니다.|A past date turns that day's records into this trip's actual records." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去の日付で作成すると、その日の記録がこの旅行の実際の記録になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用过去的日期创建时，那一天的记录会成为这次旅行的实际记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以過去的日期建立時，那一天的紀錄會成為這次旅行的實際紀錄。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einem vergangenen Datum werden die Aufzeichnungen dieses Tages zu den tatsächlichen Aufzeichnungen dieser Reise."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec une date passée, les enregistrements de ce jour deviennent les enregistrements réels de ce voyage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una data passata, le registrazioni di quel giorno diventano le registrazioni reali di questo viaggio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una fecha pasada, los registros de ese día pasan a ser los registros reales de este viaje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com uma data passada, os registros daquele dia viram os registros reais desta viagem."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu tạo với ngày đã qua, bản ghi của ngày đó sẽ thành bản ghi thực tế của chuyến đi này."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika dibuat dengan tanggal yang sudah lewat, catatan hari itu menjadi catatan nyata perjalanan ini."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากสร้างด้วยวันที่ผ่านมาแล้ว บันทึกของวันนั้นจะเป็นบันทึกจริงของทริปนี้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बीती तारीख़ से बनाने पर उस दिन के रिकॉर्ड इस यात्रा के असली रिकॉर्ड बन जाते हैं।"
          }
        }
      }
    },
