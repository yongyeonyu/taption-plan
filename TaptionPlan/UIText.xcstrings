    "|Sign in under Settings → your name at the top → iCloud, turn on iCloud Drive, then tap this row." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → 画面上部の自分の名前 → iCloudでサインインし、iCloud Driveをオンにしてから、この行をタップしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”→ 顶部你的姓名 → iCloud 中登录，开启 iCloud 云盘，然后点按此行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前往「設定」→ 最上方你的名字 → iCloud，登入並開啟 iCloud 雲碟，然後點一下此列。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich unter Einstellungen → dein Name oben → iCloud an, schalte iCloud Drive ein und tippe dann auf diese Zeile."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous dans Réglages → votre nom en haut → iCloud, activez iCloud Drive, puis touchez cette ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi in Impostazioni → il tuo nome in alto → iCloud, attiva iCloud Drive, poi tocca questa riga."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en Ajustes → tu nombre arriba → iCloud, activa iCloud Drive y toca esta fila."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça login em Ajustes → seu nome no topo → iCloud, ative o iCloud Drive e toque nesta linha."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập trong Cài đặt → tên của bạn ở trên cùng → iCloud, bật iCloud Drive rồi nhấn vào hàng này."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk di Pengaturan → nama Anda di bagian atas → iCloud, aktifkan iCloud Drive, lalu ketuk baris ini."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลงชื่อเข้าใช้ที่ การตั้งค่า → ชื่อของคุณด้านบน → iCloud เปิด iCloud Drive แล้วแตะแถวนี้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्ज़ → सबसे ऊपर अपने नाम → iCloud में साइन इन करें, iCloud Drive चालू करें, फिर यह पंक्ति दबाएँ।"
          }
        }
      }
    },
