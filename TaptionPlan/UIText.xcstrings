            "value" : "1. แตะเริ่ม เดินในระยะทางที่ทราบ แล้วแตะหยุด"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. शुरू करें दबाएँ, एक जानी-पहचानी दूरी चलें, फिर रोकें दबाएँ।"
          }
