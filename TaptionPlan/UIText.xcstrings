    "|Wuxi is a city in Jiangsu Province on the shore of Lake Tai. Lake views, canals and traditional gardens are its main attractions." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無錫は江蘇省の太湖のほとりにある都市です。湖の景色、運河、伝統的な庭園が主な魅力です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无锡是江苏省太湖之滨的城市。湖光山色、运河和传统园林是其主要吸引力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無錫是江蘇省太湖畔的城市。湖光山色、運河與傳統園林是其主要吸引力。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuxi ist eine Stadt in der Provinz Jiangsu am Ufer des Taihu-Sees. Seeblicke, Kanäle und traditionelle Gärten sind die Hauptattraktionen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuxi est une ville de la province du Jiangsu, sur les rives du lac Tai. Vues sur le lac, canaux et jardins traditionnels en sont les principaux attraits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuxi è una città della provincia del Jiangsu sulla riva del lago Tai. Vedute del lago, canali e giardini tradizionali sono le sue attrazioni principali."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuxi es una ciudad de la provincia de Jiangsu, a orillas del lago Tai. Las vistas del lago, los canales y los jardines tradicionales son sus principales atractivos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuxi é uma cidade na província de Jiangsu, às margens do lago Tai. Vistas do lago, canais e jardins tradicionais são suas principais atrações."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vô Tích là thành phố ở tỉnh Giang Tô bên bờ hồ Thái. Cảnh hồ, kênh đào và các khu vườn truyền thống là những điểm thu hút chính."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wuxi adalah kota di Provinsi Jiangsu di tepi Danau Tai. Pemandangan danau, kanal, dan taman tradisional adalah daya tarik utamanya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อู๋ซีเป็นเมืองในมณฑลเจียงซูริมทะเลสาบไท่ ทิวทัศน์ทะเลสาบ คลอง และสวนดั้งเดิมเป็นจุดดึงดูดหลัก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वुशी ताई झील के किनारे जियांगसू प्रांत का शहर है। झील के दृश्य, नहरें और पारंपरिक बगीचे इसके मुख्य आकर्षण हैं।"
          }
        }
      }
    },
