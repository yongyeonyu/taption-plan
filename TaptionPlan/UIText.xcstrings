        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museo vicino al porto di Gunsan. Presenta la storia moderna e la vita quotidiana della città dopo l’apertura del porto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museo cerca del puerto de Gunsan. Presenta la historia moderna y la vida cotidiana de la ciudad tras la apertura del puerto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museu perto do porto de Gunsan. Apresenta a história moderna e a vida cotidiana da cidade após a abertura do porto."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một bảo tàng gần cảng Gunsan. Bảo tàng trình bày lịch sử cận đại và đời sống thường ngày của thành phố sau khi mở cảng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museum di dekat pelabuhan Gunsan. Menyajikan sejarah modern dan kehidupan sehari-hari kota setelah pelabuhan dibuka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พิพิธภัณฑ์ใกล้ท่าเรือกุนซาน นำเสนอประวัติศาสตร์สมัยใหม่และชีวิตประจำวันของเมืองหลังเปิดท่าเรือ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गुनसान बंदरगाह के पास संग्रहालय। यह बंदरगाह खुलने के बाद शहर का आधुनिक इतिहास और रोज़मर्रा का जीवन प्रस्तुत करता है।"
          }
        }
      }
    },
    "|A museum on printing culture in Cheongju. It exhibits materials about Jikji, which is known as the oldest extant book printed with movable metal type." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清州にある印刷文化の博物館です。現存する世界最古の金属活字印刷本として知られる直指に関する資料を展示しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于清州的印刷文化博物馆。展出有关直指的资料，直指被认为是现存最古老的金属活字印刷书籍。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於清州、以印刷文化為主題的博物館。展示關於直指的資料，直指被認為是現存最古老的金屬活字印刷書籍。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Museum zur Druckkultur in Cheongju. Es stellt Materialien über das Jikji aus, das als das älteste erhaltene mit beweglichen Metalllettern gedruckte Buch gilt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musée de la culture de l'imprimerie à Cheongju. Il expose des documents sur le Jikji, connu comme le plus ancien livre conservé imprimé avec des caractères métalliques mobiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museo sulla cultura della stampa a Cheongju. Espone materiali su Jikji, noto come il più antico libro esistente stampato con caratteri mobili di metallo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museo sobre la cultura de la imprenta en Cheongju. Exhibe materiales sobre el Jikji, conocido como el libro más antiguo que se conserva impreso con tipos móviles de metal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museu sobre a cultura da impressão em Cheongju. Exibe materiais sobre o Jikji, conhecido como o mais antigo livro existente impresso com tipos móveis de metal."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một bảo tàng về văn hóa in ấn ở Cheongju. Bảo tàng trưng bày tư liệu về Jikji, được biết đến là cuốn sách in bằng chữ kim loại rời lâu đời nhất còn tồn tại."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museum budaya percetakan di Cheongju. Memamerkan bahan tentang Jikji, yang dikenal sebagai buku tertua yang masih ada yang dicetak dengan huruf logam bergerak."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พิพิธภัณฑ์วัฒนธรรมการพิมพ์ในชองจู จัดแสดงเอกสารเกี่ยวกับจิกจิ ซึ่งเป็นที่รู้จักว่าเป็นหนังสือพิมพ์ด้วยตัวพิมพ์โลหะเคลื่อนที่ที่เก่าแก่ที่สุดที่หลงเหลืออยู่"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चेओंगजू में मुद्रण संस्कृति पर संग्रहालय। यह जिकजी से जुड़ी सामग्री प्रदर्शित करता है, जिसे चल धातु टाइप से छपी सबसे पुरानी उपलब्ध पुस्तक माना जाता है।"
          }
        }
      }
    },
    "|A national arboretum in Sejong City gathering plants from several climate zones. Visitors can tour its greenhouse and traditional Korean gardens." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世宗市にある国立樹木園で、複数の気候帯の植物を集めています。温室と伝統的な韓国庭園を巡れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于世宗市的国家树木园，汇集多个气候带的植物。游客可参观温室和韩国传统庭园。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於世宗市、匯集多種氣候帶植物的國立樹木園。遊客可參觀溫室與韓國傳統庭園。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Nationalarboretum in der Stadt Sejong, das Pflanzen aus mehreren Klimazonen versammelt. Besucher können das Gewächshaus und traditionelle koreanische Gärten besichtigen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arboretum national dans la ville de Sejong qui rassemble des plantes de plusieurs zones climatiques. Les visiteurs peuvent parcourir sa serre et ses jardins coréens traditionnels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arboreto nazionale nella città di Sejong che raccoglie piante di diverse zone climatiche. I visitatori possono visitare la serra e i giardini tradizionali coreani."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arboreto nacional en la ciudad de Sejong que reúne plantas de varias zonas climáticas. Los visitantes pueden recorrer su invernadero y jardines tradicionales coreanos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arboreto nacional na cidade de Sejong que reúne plantas de várias zonas climáticas. Os visitantes podem visitar sua estufa e os jardins tradicionais coreanos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một vườn thực vật quốc gia ở thành phố Sejong tập hợp thực vật từ nhiều vùng khí hậu. Du khách có thể tham quan nhà kính và các khu vườn truyền thống Hàn Quốc."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arboretum nasional di Kota Sejong yang mengumpulkan tanaman dari berbagai zona iklim. Pengunjung dapat menjelajahi rumah kaca dan taman tradisional Korea."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อาร์โบเรทัมแห่งชาติในเมืองเซจงที่รวบรวมพืชจากหลายเขตภูมิอากาศ ผู้มาเยือนชมเรือนกระจกและสวนเกาหลีแบบดั้งเดิมได้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेजोंग सिटी में राष्ट्रीय वृक्ष उद्यान, जो कई जलवायु क्षेत्रों के पौधे एकत्र करता है। पर्यटक इसके ग्रीनहाउस और पारंपरिक कोरियाई बाग़ों का भ्रमण कर सकते हैं।"
          }
        }
      }
    },
    "|A national cemetery in Buk-gu, Gwangju, for victims of the May 18 Democratic Uprising. It has a memorial tower, a place for paying respects and an exhibition hall." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光州・北区にある国立墓地で、5・18民主化運動の犠牲者を祀っています。追悼塔、参拝所、展示館があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于光州北区的国立墓地，安葬五一八民主化运动的受难者。有纪念塔、祭拜场所和展览馆。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於光州北區、為五一八民主化運動犧牲者而設的國立墓地。有紀念塔、祭拜處與展覽館。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Nationalfriedhof in Buk-gu, Gwangju, für die Opfer des Demokratieaufstands vom 18. Mai. Er hat einen Gedenkturm, einen Ort für Ehrerbietung und eine Ausstellungshalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cimetière national dans le Buk-gu de Gwangju, dédié aux victimes du soulèvement démocratique du 18 mai. Il compte une tour commémorative, un lieu de recueillement et une salle d'exposition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cimitero nazionale a Buk-gu, Gwangju, per le vittime della rivolta democratica del 18 maggio. Ha una torre commemorativa, un luogo per rendere omaggio e una sala espositiva."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cementerio nacional en Buk-gu, Gwangju, para las víctimas del Levantamiento Democrático del 18 de mayo. Tiene una torre conmemorativa, un lugar para rendir homenaje y una sala de exposiciones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cemitério nacional em Buk-gu, Gwangju, para as vítimas do Levante Democrático de 18 de Maio. Tem uma torre memorial, um local para prestar homenagens e um salão de exposições."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một nghĩa trang quốc gia ở quận Buk-gu, Gwangju, dành cho các nạn nhân của Cuộc khởi nghĩa Dân chủ 18 tháng 5. Nơi đây có tháp tưởng niệm, nơi dâng hương và phòng triển lãm."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemakaman nasional di Buk-gu, Gwangju, bagi korban Pemberontakan Demokratis 18 Mei. Memiliki menara peringatan, tempat memberi penghormatan, dan aula pameran."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สุสานแห่งชาติในเขตบุกกู ควังจู สำหรับผู้เสียชีวิตจากการลุกฮือเพื่อประชาธิปไตย 18 พฤษภาคม มีหอระลึก สถานที่คารวะ และหอนิทรรศการ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्वांगजू के बुक-गु में राष्ट्रीय क़ब्रिस्तान, जो 18 मई लोकतांत्रिक विद्रोह के पीड़ितों के लिए है। इसमें स्मारक मीनार, श्रद्धांजलि अर्पित करने का स्थान और प्रदर्शनी भवन है।"
          }
        }
      }
    },
    "|A national cemetery in Dongjak-gu, Seoul, where those who sacrificed for the country are laid to rest. The memorial tower and broad graves extend along the foot of Gwanaksan." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソウル・銅雀区にある国立墓地で、国のために犠牲となった人々が眠っています。顕忠塔と広い墓域が冠岳山のふもとに続きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于首尔铜雀区的国立墓地，为国家牺牲的人长眠于此。纪念塔和宽阔的墓地沿冠岳山脚延伸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於首爾銅雀區、安葬為國犧牲者的國立墓地。紀念塔與寬廣的墓區沿冠岳山山腳延伸。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Nationalfriedhof in Dongjak-gu, Seoul, auf dem diejenigen ruhen, die sich für das Land geopfert haben. Der Gedenkturm und die weiten Gräberfelder erstrecken sich am Fuß des Gwanaksan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cimetière national dans le Dongjak-gu de Séoul, où reposent ceux qui se sont sacrifiés pour le pays. La tour commémorative et les larges tombes s'étendent au pied du Gwanaksan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cimitero nazionale a Dongjak-gu, Seoul, dove riposano coloro che si sono sacrificati per il paese. La torre commemorativa e le ampie tombe si estendono ai piedi del Gwanaksan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cementerio nacional en Dongjak-gu, Seúl, donde descansan quienes se sacrificaron por el país. La torre conmemorativa y las amplias tumbas se extienden al pie de Gwanaksan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cemitério nacional em Dongjak-gu, Seul, onde repousam aqueles que se sacrificaram pelo país. A torre memorial e os amplos túmulos se estendem ao longo do sopé de Gwanaksan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một nghĩa trang quốc gia ở quận Dongjak, Seoul, nơi an nghỉ của những người đã hy sinh vì đất nước. Tháp tưởng niệm và những ngôi mộ rộng trải dài dưới chân núi Gwanaksan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemakaman nasional di Dongjak-gu, Seoul, tempat mereka yang berkorban untuk negara dimakamkan. Menara peringatan dan makam yang luas membentang di sepanjang kaki Gwanaksan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สุสานแห่งชาติในเขตทงจักกู กรุงโซล ที่ผู้เสียสละเพื่อประเทศชาติถูกฝังไว้ หอระลึกและหลุมศพกว้างทอดตามเชิงเขาควานักซาน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सियोल के डोंगजक-गु में राष्ट्रीय क़ब्रिस्तान, जहाँ देश के लिए बलिदान देने वाले चिरनिद्रा में हैं। स्मारक मीनार और विस्तृत समाधियाँ ग्वानकसान की तलहटी के साथ फैली हैं।"
          }
        }
      }
    },
    "|A national garden along the Taehwa River that runs through Ulsan. The broad bamboo grove and seasonal flower fields are the main sights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蔚山を流れる太和江沿いの国家庭園です。広い竹林と季節の花畑が主な見どころです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿流经蔚山的太和江而建的国家庭园。广阔的竹林和四季花田是主要景观。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿著流經蔚山的太和江而建的國家庭園。遼闊的竹林與隨季節變換的花田是主要看點。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Nationalgarten am Taehwa-Fluss, der durch Ulsan fließt. Der weite Bambushain und die saisonalen Blumenfelder sind die Hauptsehenswürdigkeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardin national le long de la rivière Taehwa qui traverse Ulsan. La vaste bambouseraie et les champs de fleurs saisonniers en sont les principaux attraits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giardino nazionale lungo il fiume Taehwa che attraversa Ulsan. Il vasto bosco di bambù e i campi di fiori stagionali sono le attrazioni principali."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardín nacional a lo largo del río Taehwa, que atraviesa Ulsan. El amplio bosque de bambú y los campos de flores de temporada son sus principales atractivos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardim nacional ao longo do rio Taehwa, que atravessa Ulsan. O amplo bambuzal e os campos de flores sazonais são as principais atrações."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một vườn quốc gia dọc sông Taehwa chảy qua Ulsan. Rừng tre rộng và những cánh đồng hoa theo mùa là các thắng cảnh chính."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taman nasional di sepanjang Sungai Taehwa yang mengalir melalui Ulsan. Hutan bambu yang luas dan ladang bunga musiman adalah pemandangan utamanya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวนแห่งชาติริมแม่น้ำแทฮวาที่ไหลผ่านอุลซาน ดงไผ่กว้างและทุ่งดอกไม้ตามฤดูกาลเป็นจุดชมหลัก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उल्सान से बहने वाली ताएह्वा नदी के किनारे राष्ट्रीय उद्यान। विशाल बाँस का वन और मौसमी फूलों के खेत मुख्य आकर्षण हैं।"
          }
        }
      }
    },
    "|A national library near the government buildings in Sejong City. The building resembles an open book and has a rooftop garden." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世宗市の政府庁舎の近くにある国立図書館です。建物は開いた本の形をしており、屋上庭園があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于世宗市政府大楼附近的国立图书馆。建筑形似一本打开的书，设有屋顶花园。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於世宗市政府大樓附近的國立圖書館。建築形似一本打開的書，並有屋頂花園。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Nationalbibliothek nahe den Regierungsgebäuden in der Stadt Sejong. Das Gebäude gleicht einem aufgeschlagenen Buch und hat einen Dachgarten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliothèque nationale près des bâtiments gouvernementaux de la ville de Sejong. Le bâtiment ressemble à un livre ouvert et possède un jardin sur le toit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteca nazionale vicino agli edifici governativi nella città di Sejong. L’edificio somiglia a un libro aperto e ha un giardino sul tetto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteca nacional cerca de los edificios gubernamentales en la ciudad de Sejong. El edificio se asemeja a un libro abierto y tiene un jardín en la azotea."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteca nacional perto dos edifícios do governo na cidade de Sejong. O prédio lembra um livro aberto e tem um jardim no terraço."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thư viện quốc gia gần các tòa nhà chính phủ ở thành phố Sejong. Tòa nhà giống một cuốn sách mở và có vườn trên mái."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpustakaan nasional di dekat gedung pemerintahan di Kota Sejong. Bangunannya menyerupai buku terbuka dan memiliki taman atap."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ห้องสมุดแห่งชาติใกล้อาคารรัฐบาลในเมืองเซจง อาคารคล้ายหนังสือเปิดและมีสวนบนดาดฟ้า"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेजोंग सिटी में सरकारी भवनों के पास राष्ट्रीय पुस्तकालय। इमारत खुली पुस्तक जैसी दिखती है और इसमें छत पर बाग़ है।"
          }
        }
      }
    },
    "|A national park mountain in Yeongam. It is known for rocky peaks along the ridge and a suspension bridge." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "霊岩にある国立公園の山です。稜線の岩峰と吊り橋で知られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于灵岩的国立公园山峰。以山脊上的岩峰和吊桥闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於靈巖的國立公園山岳。以稜線上的岩峰與吊橋聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Nationalparkberg in Yeongam. Er ist für felsige Gipfel entlang des Grats und eine Hängebrücke bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montagne de parc national à Yeongam. Elle est connue pour ses pics rocheux le long de la crête et un pont suspendu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montagna di parco nazionale a Yeongam. È nota per le cime rocciose lungo il crinale e per un ponte sospeso."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montaña de parque nacional en Yeongam. Es conocida por los picos rocosos a lo largo de la cresta y un puente colgante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montanha de parque nacional em Yeongam. É conhecida por picos rochosos ao longo da crista e por uma ponte suspensa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một ngọn núi vườn quốc gia ở Yeongam. Núi nổi tiếng với những đỉnh đá dọc sống núi và một cầu treo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunung taman nasional di Yeongam. Dikenal dengan puncak berbatu di sepanjang punggungan dan jembatan gantung."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภูเขาอุทยานแห่งชาติในยองอัม เป็นที่รู้จักด้านยอดหินตามสันเขาและสะพานแขวน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "योंगअम में राष्ट्रीय उद्यान का पर्वत। यह पर्वत-रेखा की चट्टानी चोटियों और एक झूला पुल के लिए जाना जाता है।"
          }
        }
      }
    },
    "|A national performing arts venue on the slope of Namsan. Several theaters, including Haeoreum Theater, present plays, opera and traditional performances." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "南山の斜面にある国立の舞台芸術会場です。ヘオルム劇場をはじめ複数の劇場で、演劇、オペラ、伝統公演が上演されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于南山山坡上的国家表演艺术场馆。包括海月剧场在内的多个剧场上演戏剧、歌剧和传统表演。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於南山山坡上的國立表演藝術場館。包括海月劇場在內的多座劇場上演戲劇、歌劇與傳統表演。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine nationale Spielstätte der darstellenden Künste am Hang des Namsan. Mehrere Theater, darunter das Haeoreum-Theater, zeigen Schauspiel, Oper und traditionelle Aufführungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lieu national des arts de la scène à flanc de Namsan. Plusieurs théâtres, dont le théâtre Haeoreum, présentent des pièces, de l'opéra et des spectacles traditionnels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sede nazionale di arti dello spettacolo sul pendio del Namsan. Diversi teatri, tra cui l’Haeoreum Theater, presentano prosa, opera e spettacoli tradizionali."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recinto nacional de artes escénicas en la ladera de Namsan. Varios teatros, incluido el Teatro Haeoreum, presentan obras de teatro, ópera y espectáculos tradicionales."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casa nacional de artes cênicas na encosta de Namsan. Vários teatros, incluindo o Teatro Haeoreum, apresentam peças, ópera e espetáculos tradicionais."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một địa điểm biểu diễn nghệ thuật quốc gia trên sườn Namsan. Nhiều nhà hát, trong đó có nhà hát Haeoreum, trình diễn kịch, opera và các buổi biểu diễn truyền thống."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempat seni pertunjukan nasional di lereng Namsan. Beberapa teater, termasuk Teater Haeoreum, menampilkan drama, opera, dan pertunjukan tradisional."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สถานที่แสดงศิลปะการแสดงแห่งชาติบนไหล่เขานัมซาน โรงละครหลายแห่งรวมถึงโรงละครแฮออรึมจัดแสดงละคร โอเปร่า และการแสดงดั้งเดิม"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नामसान की ढलान पर राष्ट्रीय प्रदर्शन कला स्थल। हेओरम थिएटर सहित कई थिएटर नाटक, ओपेरा और पारंपरिक प्रस्तुतियाँ दिखाते हैं।"
          }
        }
      }
    },
    "|A national university at the foot of Gwanaksan in Gwanak-gu, Seoul. Its large campus spreads along the mountain slope, and its gate is widely recognized." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソウル・冠岳区の冠岳山のふもとにある国立大学です。広いキャンパスが山の斜面に沿って広がり、正門は広く知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于首尔冠岳区冠岳山脚下的国立大学。宽阔的校园沿山坡铺展，校门广为人知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於首爾冠岳區冠岳山山腳下的國立大學。大型校園沿山坡展開，校門廣為人知。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Nationaluniversität am Fuß des Gwanaksan in Gwanak-gu, Seoul. Ihr großer Campus zieht sich am Berghang entlang, und ihr Tor ist weithin bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Université nationale au pied du Gwanaksan, dans le Gwanak-gu de Séoul. Son vaste campus s'étend sur le versant de la montagne, et sa porte est largement reconnue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Università nazionale ai piedi del Gwanaksan a Gwanak-gu, Seoul. Il vasto campus si estende lungo il pendio della montagna e il suo cancello è molto riconoscibile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universidad nacional al pie de Gwanaksan, en Gwanak-gu, Seúl. Su extenso campus se despliega por la ladera de la montaña, y su puerta es ampliamente reconocida."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universidade nacional ao pé de Gwanaksan, em Gwanak-gu, Seul. Seu grande campus se espalha pela encosta da montanha, e seu portão é amplamente reconhecido."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một trường đại học quốc gia dưới chân núi Gwanaksan ở quận Gwanak, Seoul. Khuôn viên rộng trải dọc sườn núi, và cổng trường được nhận ra rộng rãi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universitas negeri di kaki Gwanaksan di Gwanak-gu, Seoul. Kampusnya yang luas membentang di lereng gunung, dan gerbangnya dikenal luas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มหาวิทยาลัยแห่งชาติที่เชิงเขาควานักซานในเขตควานักกู กรุงโซล วิทยาเขตใหญ่ทอดตามไหล่เขา และประตูของมหาวิทยาลัยเป็นที่จดจำกันกว้างขวาง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सियोल के ग्वानक-गु में ग्वानकसान की तलहटी में राष्ट्रीय विश्वविद्यालय। इसका विशाल परिसर पर्वत की ढलान के साथ फैला है, और इसका द्वार व्यापक रूप से पहचाना जाता है।"
          }
        }
      }
    },
    "|A natural lagoon by the sea in Sokcho. A walking path circles the lake and Seoraksan can be seen in the distance." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "束草の海辺にある天然の潟湖です。湖を一周する遊歩道があり、遠くに雪岳山が望めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于束草海边的天然潟湖。步道环湖一周，远处可望见雪岳山。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於束草海邊的天然潟湖。步道環湖而行，遠處可見雪嶽山。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine natürliche Lagune am Meer in Sokcho. Ein Weg umrundet den See, und in der Ferne ist der Seoraksan zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagune naturelle au bord de la mer à Sokcho. Un sentier de promenade fait le tour du lac, et l'on aperçoit le Seoraksan au loin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laguna naturale sul mare a Sokcho. Un sentiero pedonale circonda il lago e in lontananza si vede il Seoraksan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laguna natural junto al mar en Sokcho. Un sendero rodea el lago y a lo lejos se ve Seoraksan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laguna natural junto ao mar em Sokcho. Um caminho de caminhada contorna o lago, e Seoraksan pode ser vista ao longe."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một đầm phá tự nhiên bên biển ở Sokcho. Một lối đi bộ vòng quanh hồ và có thể thấy Seoraksan ở phía xa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laguna alami di tepi laut di Sokcho. Jalur jalan kaki mengitari danau dan Seoraksan terlihat di kejauhan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทะเลสาบลากูนธรรมชาติริมทะเลในซ็อกโช ทางเดินวนรอบทะเลสาบ และมองเห็นซอรักซานอยู่ไกล ๆ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सोकचो में समुद्र के किनारे प्राकृतिक लैगून। एक पैदल पथ झील का चक्कर लगाता है और दूर सोराकसान दिखता है।"
          }
        }
      }
    },
    "|A natural rock gateway in Muju, North Jeolla. It is said to mark the old border between Silla and Baekje." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全羅北道・茂朱にある天然の岩の門です。かつての新羅と百済の国境の目印だったと言われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于全罗北道茂朱的天然岩石门。据说标志着新罗与百济的古代边界。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於全羅北道茂朱的天然石門。相傳是新羅與百濟舊時的邊界標記。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein natürliches Felstor in Muju, Nord-Jeolla. Es soll die alte Grenze zwischen Silla und Baekje markiert haben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porte naturelle de roche à Muju (Jeolla du Nord). On dit qu'elle marquait l'ancienne frontière entre Silla et Baekje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta naturale di roccia a Muju, nel Jeolla settentrionale. Si dice segni l’antico confine tra Silla e Baekje."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puerta natural de roca en Muju, Jeolla del Norte. Se dice que marca la antigua frontera entre Silla y Baekje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portal rochoso natural em Muju, Jeolla do Norte. Diz-se que marca a antiga fronteira entre Silla e Baekje."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một cổng đá tự nhiên ở Muju, Bắc Jeolla. Người ta nói nơi đây đánh dấu ranh giới xưa giữa Silla và Baekje."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerbang batu alami di Muju, Jeolla Utara. Konon menandai perbatasan lama antara Silla dan Baekje."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประตูหินธรรมชาติในมูจู จังหวัดช็อลลาเหนือ เล่ากันว่าเป็นเครื่องหมายเขตแดนเก่าระหว่างซิลลาและแพ็กเจ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उत्तर जेओला के मुजू में चट्टान का प्राकृतिक प्रवेशद्वार। कहा जाता है कि यह सिल्ला और बेकजे की प्राचीन सीमा को चिह्नित करता था।"
          }
        }
      }
    },
    "|A neighborhood in Nam-gu, Gwangju, with preserved early modern buildings. Western-style houses, missionary sites, cafes and small galleries share the streets." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光州・南区にある、近代初期の建物が保存された街区です。洋風の家屋、宣教師ゆかりの場所、カフェ、小さなギャラリーが通りに並びます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于光州南区的街区，保留着近代早期建筑。西式住宅、传教士遗址、咖啡馆和小画廊共处街巷。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於光州南區、保存近代早期建築的街區。西式住宅、傳教遺跡、咖啡館與小型畫廊並存於街巷。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Viertel in Nam-gu, Gwangju, mit erhaltenen Gebäuden der frühen Moderne. Häuser im westlichen Stil, Missionsstätten, Cafés und kleine Galerien teilen sich die Straßen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quartier du Nam-gu de Gwangju, avec des bâtiments du début de l'ère moderne préservés. Des maisons de style occidental, des sites de missionnaires, des cafés et de petites galeries se partagent les rues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quartiere a Nam-gu, Gwangju, con edifici della prima età moderna conservati. Case in stile occidentale, siti missionari, caffè e piccole gallerie si dividono le strade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barrio en Nam-gu, Gwangju, con edificios de principios de la era moderna conservados. Casas de estilo occidental, sitios misioneros, cafés y pequeñas galerías comparten sus calles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bairro em Nam-gu, Gwangju, com edifícios do início da era moderna preservados. Casas de estilo ocidental, locais de missionários, cafés e pequenas galerias dividem as ruas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một khu phố ở quận Nam-gu, Gwangju, còn lưu giữ các tòa nhà đầu thời cận đại. Nhà kiểu phương Tây, di tích truyền giáo, quán cà phê và phòng tranh nhỏ cùng nằm trên các con phố."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingkungan di Nam-gu, Gwangju, dengan bangunan awal era modern yang dilestarikan. Rumah bergaya Barat, situs misionaris, kafe, dan galeri kecil berbagi jalan-jalannya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย่านในเขตนัมกู ควังจู ที่อนุรักษ์อาคารสมัยต้นสมัยใหม่ไว้ บ้านสไตล์ตะวันตก สถานที่มิชชันนารี คาเฟ่ และแกลเลอรีเล็ก ๆ อยู่ร่วมกันตามถนน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्वांगजू के नाम-गु में मोहल्ला, जहाँ आरंभिक आधुनिक काल की इमारतें संरक्षित हैं। पश्चिमी शैली के घर, मिशनरी स्थल, कैफ़े और छोटी दीर्घाएँ सड़कों में साथ हैं।"
          }
        }
      }
    },
    "|A neighborhood of narrow alleys and hanok houses near Jongno 3-ga. Many of the old houses have become cafes and restaurants." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍾路3街の近くにある、細い路地と韓屋の街区です。古い家の多くがカフェや飲食店になっています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于钟路3街附近的街区，有狭窄的小巷和韩屋。许多老房子已变成咖啡馆和餐厅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於鍾路3街附近、由窄巷與韓屋構成的街區。許多老房子已改建為咖啡館與餐廳。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Viertel mit engen Gassen und Hanok-Häusern nahe Jongno 3-ga. Viele der alten Häuser sind zu Cafés und Restaurants geworden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quartier de ruelles étroites et de maisons hanok près de Jongno 3-ga. Beaucoup de ces vieilles maisons sont devenues des cafés et des restaurants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quartiere di vicoli stretti e case hanok vicino a Jongno 3-ga. Molte delle vecchie case sono diventate caffè e ristoranti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barrio de estrechos callejones y casas hanok cerca de Jongno 3-ga. Muchas de las casas antiguas se han convertido en cafés y restaurantes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bairro de becos estreitos e casas hanok perto de Jongno 3-ga. Muitas das casas antigas se tornaram cafés e restaurantes."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một khu phố có ngõ hẹp và nhà hanok gần Jongno 3-ga. Nhiều ngôi nhà cũ đã trở thành quán cà phê và nhà hàng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingkungan gang-gang sempit dan rumah hanok di dekat Jongno 3-ga. Banyak rumah tua telah menjadi kafe dan restoran."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย่านตรอกแคบและบ้านฮันอกใกล้จงโน 3-กา บ้านเก่าหลายหลังกลายเป็นคาเฟ่และร้านอาหาร"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जोंगनो 3-गा के पास सँकरी गलियों और हानोक घरों का मोहल्ला। कई पुराने घर कैफ़े और रेस्तरां बन गए हैं।"
          }
        }
      }
    },
    "|A neighborhood of traditional houses between Gyeongbokgung and Changdeokgung. Its alleys offer views of hanok roofs with the city beyond." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "景福宮と昌徳宮の間にある伝統家屋の街区です。路地から韓屋の屋根と、その向こうの街並みが見えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于景福宫与昌德宫之间的传统住宅区。从巷弄可望见韩屋屋顶和远处的城市。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於景福宮與昌德宮之間的傳統房屋街區。巷弄間可看到韓屋屋頂，遠處是都市景色。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Viertel mit traditionellen Häusern zwischen Gyeongbokgung und Changdeokgung. Seine Gassen bieten Blicke auf Hanok-Dächer mit der Stadt dahinter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quartier de maisons traditionnelles entre Gyeongbokgung et Changdeokgung. Ses ruelles offrent des vues sur les toits de hanok avec la ville en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quartiere di case tradizionali tra il Gyeongbokgung e il Changdeokgung. I suoi vicoli offrono viste sui tetti hanok con la città sullo sfondo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barrio de casas tradicionales entre Gyeongbokgung y Changdeokgung. Sus callejones ofrecen vistas de los tejados hanok con la ciudad al fondo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bairro de casas tradicionais entre Gyeongbokgung e Changdeokgung. Seus becos oferecem vistas de telhados hanok com a cidade ao fundo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một khu phố nhà truyền thống giữa Gyeongbokgung và Changdeokgung. Các ngõ nhỏ cho thấy những mái nhà hanok với thành phố phía xa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingkungan rumah tradisional di antara Gyeongbokgung dan Changdeokgung. Gang-gangnya menawarkan pemandangan atap hanok dengan kota di baliknya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย่านบ้านแบบดั้งเดิมระหว่างพระราชวังคยองบกกุงและชางด็อกกุง ตรอกให้ทิวทัศน์หลังคาฮันอกโดยมีเมืองอยู่ไกลออกไป"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्योंगबोकगुंग और चांगदेओकगुंग के बीच पारंपरिक घरों का मोहल्ला। इसकी गलियों से हानोक की छतों के और उनके पार शहर के दृश्य दिखते हैं।"
          }
        }
      }
    },
    "|A neighborhood traditional market in Mangwon-dong, Mapo-gu, Seoul. Food and household stores fill it, and the Han River and cozy alleys lie nearby." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソウル・麻浦区望遠洞にある近隣の伝統市場です。食料品や日用品の店が並び、漢江と居心地のよい路地が近くにあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于首尔麻浦区望远洞的社区传统市场。食品和日用品店铺林立，附近有汉江和温馨的小巷。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於首爾麻浦區望遠洞的社區傳統市場。食品與日用品商店林立，漢江與舒適的巷弄就在附近。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein traditioneller Nachbarschaftsmarkt in Mangwon-dong, Mapo-gu, Seoul. Läden für Essen und Haushaltswaren füllen ihn, und der Han-Fluss und gemütliche Gassen liegen in der Nähe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marché traditionnel de quartier à Mangwon-dong, dans le Mapo-gu de Séoul. Des magasins d'alimentation et d'articles ménagers le remplissent, et le fleuve Han et des ruelles chaleureuses sont proches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mercato tradizionale di quartiere a Mangwon-dong, Mapo-gu, Seoul. Negozi di alimentari e articoli per la casa lo riempiono e il fiume Han e accoglienti vicoli sono vicini."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mercado tradicional de barrio en Mangwon-dong, Mapo-gu, Seúl. Tiendas de comida y artículos del hogar lo llenan, y el río Han y acogedores callejones están cerca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mercado tradicional de bairro em Mangwon-dong, Mapo-gu, Seul. Lojas de comida e de artigos domésticos o preenchem, e o rio Han e becos aconchegantes ficam por perto."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một khu chợ truyền thống của khu phố ở Mangwon-dong, quận Mapo, Seoul. Cửa hàng thực phẩm và đồ gia dụng chật kín chợ, và sông Hàn cùng những ngõ ấm cúng ở gần đó."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasar tradisional lingkungan di Mangwon-dong, Mapo-gu, Seoul. Toko makanan dan kebutuhan rumah tangga memenuhinya, dan Sungai Han serta gang-gang yang nyaman berada di dekatnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตลาดดั้งเดิมประจำย่านในมังวอนดง เขตมาโปกู กรุงโซล เต็มไปด้วยร้านอาหารและของใช้ในบ้าน แม่น้ำฮันและตรอกน่ารักอยู่ใกล้ ๆ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सियोल के मापो-गु के मांगवोन-दोंग में मोहल्ले का पारंपरिक बाज़ार। खाने और घरेलू सामान की दुकानें इसे भरती हैं, और हान नदी तथा आरामदेह गलियाँ पास हैं।"
          }
        }
      }
    },
    "|A palace facing Seoul City Hall that served the Korean Empire as an imperial residence. Traditional halls stand beside a Western-style stone building." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソウル市庁に面した宮殿で、大韓帝国の皇室の住まいとなりました。伝統的な殿閣が西洋式の石造建築の隣に立っています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正对首尔市厅的宫殿，曾是大韩帝国的皇室居所。传统殿阁与西式石造建筑并立。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面向首爾市政廳、曾作為大韓帝國皇室居所的宮殿。傳統殿閣與一棟西式石造建築並立。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Palast gegenüber dem Seouler Rathaus, der dem Koreanischen Kaiserreich als kaiserliche Residenz diente. Traditionelle Hallen stehen neben einem Steingebäude im westlichen Stil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palais face à l'hôtel de ville de Séoul qui servit de résidence impériale à l'Empire coréen. Des pavillons traditionnels se dressent à côté d'un bâtiment de pierre de style occidental."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palazzo di fronte al municipio di Seoul che servì da residenza imperiale all’Impero coreano. Sale tradizionali sorgono accanto a un edificio di pietra in stile occidentale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palacio frente al Ayuntamiento de Seúl que sirvió de residencia imperial al Imperio Coreano. Salas tradicionales se alzan junto a un edificio de piedra de estilo occidental."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palácio de frente para a Prefeitura de Seul que serviu como residência imperial ao Império Coreano. Salões tradicionais ficam ao lado de um edifício de pedra de estilo ocidental."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một cung điện đối diện Tòa thị chính Seoul, từng là nơi ở của hoàng đế Đại Hàn Đế quốc. Các điện truyền thống đứng cạnh một tòa nhà đá kiểu phương Tây."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istana yang menghadap Balai Kota Seoul yang menjadi kediaman kaisar bagi Kekaisaran Korea. Aula tradisional berdiri di samping bangunan batu bergaya Barat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พระราชวังที่หันหน้าสู่ศาลาว่าการกรุงโซล เคยเป็นที่ประทับของจักรวรรดิเกาหลี หอแบบดั้งเดิมตั้งข้างอาคารหินสไตล์ตะวันตก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सियोल सिटी हॉल के सामने महल, जिसने कोरियाई साम्राज्य के लिए शाही निवास का काम किया। पारंपरिक भवन पश्चिमी शैली की पत्थर की इमारत के बगल में खड़े हैं।"
          }
        }
      }
    },
    "|A park built for the 1988 Seoul Olympics. Sports venues, sculptures and wide lawns make it good for walks and rest." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1988年ソウルオリンピックのために造られた公園です。競技施設、彫刻、広い芝生があり、散歩や休憩に向いています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为1988年首尔奥运会而建的公园。体育场馆、雕塑和宽阔的草坪适合散步和休息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為1988年首爾奧運而建的公園。運動場館、雕塑與寬廣的草坪適合散步與休息。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Park, der für die Olympischen Spiele 1988 in Seoul gebaut wurde. Sportstätten, Skulpturen und weite Rasenflächen machen ihn gut für Spaziergänge und Erholung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parc construit pour les Jeux olympiques de Séoul de 1988. Des installations sportives, des sculptures et de vastes pelouses en font un lieu agréable pour se promener et se reposer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parco costruito per le Olimpiadi di Seoul del 1988. Impianti sportivi, sculture e ampi prati lo rendono ideale per passeggiare e riposare."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque construido para los Juegos Olímpicos de Seúl de 1988. Recintos deportivos, esculturas y amplios céspedes lo hacen ideal para pasear y descansar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque construído para as Olimpíadas de Seul de 1988. Locais esportivos, esculturas e amplos gramados o tornam ótimo para caminhar e descansar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một công viên được xây cho Thế vận hội Seoul 1988. Các địa điểm thể thao, tác phẩm điêu khắc và bãi cỏ rộng khiến đây là nơi tốt để đi dạo và nghỉ ngơi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taman yang dibangun untuk Olimpiade Seoul 1988. Arena olahraga, patung, dan padang rumput luas menjadikannya tempat yang baik untuk berjalan dan beristirahat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวนสาธารณะที่สร้างสำหรับโอลิมปิกโซลปี 1988 สนามกีฬา ประติมากรรม และสนามหญ้ากว้างทำให้เหมาะกับการเดินเล่นและพักผ่อน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1988 सियोल ओलंपिक के लिए बना पार्क। खेल स्थल, मूर्तियाँ और विस्तृत लॉन इसे टहलने और आराम के लिए अच्छा बनाते हैं।"
          }
        }
      }
    },
    "|A park in Gwangjin-gu with children’s play areas and a small zoo. Wide lawns and a botanical garden make it suitable for family visits." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広津区にある公園で、子どもの遊び場と小さな動物園があります。広い芝生と植物園があり、家族での訪問に向いています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于广津区的公园，有儿童游乐区和小型动物园。宽阔的草坪和植物园适合家庭游览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於廣津區、有兒童遊樂區與小型動物園的公園。寬廣的草坪與植物園適合家庭造訪。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Park in Gwangjin-gu mit Kinderspielbereichen und einem kleinen Zoo. Weite Rasenflächen und ein botanischer Garten eignen sich für Familienbesuche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parc du Gwangjin-gu avec des aires de jeux pour enfants et un petit zoo. De vastes pelouses et un jardin botanique le rendent adapté aux visites en famille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parco a Gwangjin-gu con aree giochi per bambini e un piccolo zoo. Ampi prati e un giardino botanico lo rendono adatto alle visite in famiglia."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque en Gwangjin-gu con zonas de juegos infantiles y un pequeño zoológico. Amplios céspedes y un jardín botánico lo hacen adecuado para visitas en familia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque em Gwangjin-gu com áreas de recreação infantil e um pequeno zoológico. Amplos gramados e um jardim botânico o tornam adequado para visitas em família."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một công viên ở quận Gwangjin có khu vui chơi trẻ em và một sở thú nhỏ. Bãi cỏ rộng và vườn thực vật thích hợp cho gia đình ghé thăm."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taman di Gwangjin-gu dengan area bermain anak dan kebun binatang kecil. Padang rumput luas dan kebun raya membuatnya cocok untuk kunjungan keluarga."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวนสาธารณะในเขตควังจินกู มีที่เล่นเด็กและสวนสัตว์เล็ก ๆ สนามหญ้ากว้างและสวนพฤกษศาสตร์เหมาะกับการมาเที่ยวกับครอบครัว"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्वांगजिन-गु में पार्क, जहाँ बच्चों के खेलने की जगहें और एक छोटा चिड़ियाघर है। विस्तृत लॉन और वनस्पति उद्यान इसे परिवार के साथ घूमने के लिए उपयुक्त बनाते हैं।"
          }
        }
      }
    },
    "|A park in Jung District, Daejeon, themed around family names and genealogy. It has monuments about the origins of Korean clans and pleasant walking paths." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大田・中区にある、姓氏と家系をテーマにした公園です。韓国の氏族の起源についての碑と、心地よい遊歩道があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于大田中区、以姓氏和家谱为主题的公园。有关于韩国宗族起源的纪念碑和宜人的步道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於大田中區、以姓氏與族譜為主題的公園。有關於韓國氏族起源的紀念碑與宜人的步道。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Park im Bezirk Jung, Daejeon, mit dem Thema Familiennamen und Genealogie. Er hat Denkmäler zu den Ursprüngen koreanischer Clans und angenehme Spazierwege."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parc du district de Jung, à Daejeon, sur le thème des noms de famille et de la généalogie. Il compte des monuments sur l'origine des clans coréens et de plaisants sentiers de promenade."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parco nel distretto Jung di Daejeon, a tema cognomi e genealogia. Ha monumenti sulle origini dei clan coreani e piacevoli sentieri pedonali."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque en el distrito Jung, Daejeon, con el tema de los apellidos y la genealogía. Tiene monumentos sobre los orígenes de los clanes coreanos y agradables senderos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque no distrito de Jung, Daejeon, com tema de sobrenomes e genealogia. Tem monumentos sobre as origens dos clãs coreanos e agradáveis caminhos para passeio."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một công viên ở quận Jung, Daejeon, theo chủ đề họ tộc và phả hệ. Công viên có các tượng đài về nguồn gốc các dòng họ Hàn Quốc và những lối đi bộ dễ chịu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taman di Distrik Jung, Daejeon, bertema nama keluarga dan silsilah. Memiliki monumen tentang asal-usul klan Korea dan jalur jalan yang menyenangkan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวนสาธารณะในเขตจุงกู แทจอน ที่มีธีมเกี่ยวกับนามสกุลและลำดับวงศ์ตระกูล มีอนุสาวรีย์เกี่ยวกับต้นกำเนิดของตระกูลเกาหลีและทางเดินที่น่าเดิน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दाएजोन के जुंग ज़िले में पार्क, जिसकी थीम कुलनाम और वंशावली है। यहाँ कोरियाई कुलों की उत्पत्ति पर स्मारक और सुखद पैदल पथ हैं।"
          }
        }
      }
    },
    "|A park in Jung-gu, Daegu, built on the site of the old Dalseong earthen fortress. It has a zoo and walking paths and serves as a city retreat." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大邱・中区にある公園で、昔の達城土城の跡地に造られました。動物園と遊歩道があり、街なかの憩いの場になっています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于大邱中区的公园，建在旧达城土城遗址上。有动物园和步道，是市内的休憩之地。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於大邱中區、建在舊達城土城遺址上的公園。有動物園與步道，是市民的都市休憩地。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Park in Jung-gu, Daegu, auf dem Gelände der alten Erdfestung Dalseong. Er hat einen Zoo und Spazierwege und dient als Rückzugsort der Stadt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parc du Jung-gu de Daegu, construit sur le site de l'ancienne forteresse de terre de Dalseong. Il possède un zoo et des sentiers de promenade et sert de refuge urbain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parco a Jung-gu, Daegu, costruito sul sito dell’antica fortezza di terra di Dalseong. Ha uno zoo e sentieri pedonali e funge da rifugio cittadino."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque en Jung-gu, Daegu, construido en el sitio de la antigua fortaleza de tierra de Dalseong. Tiene un zoológico y senderos y sirve como refugio de la ciudad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque em Jung-gu, Daegu, construído no local da antiga fortaleza de terra de Dalseong. Tem um zoológico e caminhos para passeio e serve como refúgio na cidade."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một công viên ở quận Jung-gu, Daegu, xây trên địa điểm thành đất Dalseong cũ. Công viên có sở thú và lối đi bộ, và là nơi nghỉ ngơi của thành phố."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taman di Jung-gu, Daegu, dibangun di lokasi benteng tanah Dalseong yang lama. Memiliki kebun binatang dan jalur jalan, dan menjadi tempat peristirahatan kota."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวนสาธารณะในจุงกู แทกู สร้างบนที่ตั้งของป้อมดินทัลซองเดิม มีสวนสัตว์และทางเดิน และเป็นที่พักผ่อนของคนเมือง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दाएगू के जुंग-गु में पार्क, जो पुराने दालसोंग मिट्टी के किले के स्थल पर बना है। यहाँ चिड़ियाघर और पैदल पथ हैं और यह शहर में सुकून की जगह है।"
          }
        }
      }
    },
    "|A park in Seo-gu, Gwangju, commemorating the May 18 Democratic Uprising. It occupies a former military site from that period." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光州・西区にある、5・18民主化運動を記念する公園です。当時の軍事施設の跡地にあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于光州西区、纪念五一八民主化运动的公园。占用了当年的一处旧军事用地。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於光州西區、紀念五一八民主化運動的公園。佔用該時期的舊軍事用地。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Park in Seo-gu, Gwangju, zum Gedenken an den Demokratieaufstand vom 18. Mai. Er nimmt ein ehemaliges Militärgelände aus jener Zeit ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parc du Seo-gu de Gwangju qui commémore le soulèvement démocratique du 18 mai. Il occupe un ancien site militaire de cette période."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parco a Seo-gu, Gwangju, che commemora la rivolta democratica del 18 maggio. Occupa un ex sito militare di quel periodo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque en Seo-gu, Gwangju, que conmemora el Levantamiento Democrático del 18 de mayo. Ocupa un antiguo sitio militar de esa época."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parque em Seo-gu, Gwangju, em memória do Levante Democrático de 18 de Maio. Ocupa um antigo local militar daquela época."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một công viên ở quận Seo-gu, Gwangju, tưởng niệm Cuộc khởi nghĩa Dân chủ 18 tháng 5. Công viên nằm trên một khu quân sự cũ của thời kỳ đó."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taman di Seo-gu, Gwangju, yang memperingati Pemberontakan Demokratis 18 Mei. Menempati bekas lokasi militer dari masa itu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวนสาธารณะในเขตซอกู ควังจู เพื่อรำลึกการลุกฮือเพื่อประชาธิปไตย 18 พฤษภาคม ตั้งอยู่บนพื้นที่ทางทหารเดิมจากช่วงเวลานั้น"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्वांगजू के सेओ-गु में पार्क, जो 18 मई लोकतांत्रिक विद्रोह की स्मृति में है। यह उस दौर के पूर्व सैन्य स्थल पर बना है।"
          }
        }
      }
    },
    "|A park in Yuseong-gu, Daejeon, created for the 1993 Daejeon Expo. It features the Hanbit Tower and science facilities." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
