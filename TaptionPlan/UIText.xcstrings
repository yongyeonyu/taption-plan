      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坡州にある出版団地で、出版社、印刷所、書店、ギャラリーが集まっています。個性的な建築とともに本を楽しめる場所です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于坡州的出版区，由出版社、印刷厂、书店和画廊组成。可在独特的建筑旁享受书籍。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於坡州、由出版社、印刷廠、書店與畫廊組成的出版街區。可在獨特建築之間享受閱讀。"
