    "|Watch workout records that confirm the mode of transport. It is estimated from GPS, barometer and steps instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動手段を確認できるWatchのワークアウト記録。代わりにGPS、気圧計、歩数から推定します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可确认交通方式的 Watch 体能训练记录。现在改用 GPS、气压计和步数来估算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可確認交通方式的 Watch 體能訓練記錄。目前改用 GPS、氣壓計和步數估算。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch-Workout-Einträge, die das Verkehrsmittel bestätigen. Stattdessen wird es aus GPS, Barometer und Schritten geschätzt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séances d'entraînement de la Watch confirmant le mode de transport. Il est estimé à partir du GPS, du baromètre et des pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrazioni degli allenamenti del Watch che confermano il mezzo di trasporto. Viene invece stimato da GPS, barometro e passi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registros de entrenamiento del Watch que confirman el medio de transporte. En su lugar, se estima con GPS, barómetro y pasos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registros de treino do Watch que confirmam o meio de transporte. Em vez disso, ele é estimado por GPS, barômetro e passos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi bài tập trên Watch xác nhận phương tiện di chuyển. Thay vào đó, phương tiện được ước tính từ GPS, phong vũ biểu và số bước."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan olahraga Watch yang memastikan moda transportasi. Moda diperkirakan dari GPS, barometer, dan langkah."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกการออกกำลังกายบน Watch ที่ยืนยันรูปแบบการเดินทาง แต่จะประมาณจาก GPS เครื่องวัดความกดอากาศ และก้าวเดินแทน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परिवहन का तरीका पक्का करने वाले Watch वर्कआउट रिकॉर्ड। इसके बजाय GPS, बैरोमीटर और कदमों से अनुमान लगाया जाता है।"
          }
        }
      }
    },
