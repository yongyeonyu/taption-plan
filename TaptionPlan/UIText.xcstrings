          "stringUnit" : {
            "state" : "translated",
            "value" : "京畿道・高陽の一山新都市にある大きな人工湖の公園です。歩行者と自転車用の周回路と花の展示があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
