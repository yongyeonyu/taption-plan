          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva diagnósticos do iPhone e do Apple Watch, além da sessão anterior não concluída, em TaptionLogs no iCloud Drive."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu chẩn đoán của iPhone và Apple Watch cùng phiên chưa hoàn tất trước đó vào TaptionLogs trong iCloud Drive."
