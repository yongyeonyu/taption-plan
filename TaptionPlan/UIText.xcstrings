    "|Choose a time within the period of the parent and child plans." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "親プランと子プランの期間内の時間を選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择上级和下级计划时间段内的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請選擇在上層與下層計畫期間內的時間。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Zeit innerhalb des Zeitraums von übergeordnetem und untergeordnetem Plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une heure dans la période des plans parent et enfant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un orario entro il periodo del piano principale e di quello secondario."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una hora dentro del periodo de los planes principal y secundario."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um horário dentro do período dos planos principal e secundário."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chọn thời gian nằm trong khoảng thời gian của kế hoạch cha và con."
          }
        },
        "id" : {
          "stringUnit" : {
