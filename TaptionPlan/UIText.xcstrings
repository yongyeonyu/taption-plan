          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于忠州的温泉小镇。多年来以温泉区闻名，有酒店和公共浴场。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
