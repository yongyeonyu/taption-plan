    "연결하기를 누르면 연결 안내가 복사돼요. 웹 요청을 할 수 있는 AI에 붙여 넣어 주세요.|Connect copies the setup. Paste it into any AI that can make web requests." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「接続」を押すと接続ガイドがコピーされます。WebリクエストができるAIに貼り付けてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按“连接”会复制连接说明。请粘贴到能发起网络请求的 AI 中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下「連接」會拷貝連線說明。請貼到能發出網路請求的 AI 中。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Verbinden“ kopiert die Einrichtung. Füge sie in eine KI ein, die Web-Anfragen senden kann."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecter copie les instructions. Collez-les dans une IA capable de faire des requêtes web."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega copia le istruzioni. Incollale in un'IA che può fare richieste web."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectar copia las instrucciones. Péguelas en una IA que pueda hacer solicitudes web."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectar copia as instruções. Cole-as em uma IA que possa fazer requisições web."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn Kết nối để sao chép hướng dẫn kết nối. Hãy dán vào AI có thể gửi yêu cầu web."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan menyalin panduan koneksi. Tempel ke AI yang bisa membuat permintaan web."
          }
        },
        "th" : {
          "stringUnit" : {
