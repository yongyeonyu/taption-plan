          }
        }
      }
    },
    "서버에 닿지 않아 키를 바꾸지 못했어요. 잠시 뒤 다시 해 주세요.|Couldn't reach the server, so the key wasn't replaced. Try again in a moment." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーに接続できず、キーを変更できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接服务器，密钥未更换。请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連上伺服器，金鑰未更換。請稍後再試。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server nicht erreichbar, der Schlüssel wurde nicht ersetzt. Versuche es gleich noch einmal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveur injoignable, la clé n’a pas été remplacée. Réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server non raggiungibile, la chiave non è stata sostituita. Riprova tra poco."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con el servidor y la clave no se cambió. Inténtalo de nuevo en un momento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o servidor, e a chave não foi trocada. Tente de novo em instantes."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không kết nối được máy chủ nên chưa đổi khóa. Hãy thử lại sau giây lát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server tidak terjangkau, jadi kunci tidak diganti. Coba lagi sebentar lagi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ จึงยังไม่ได้เปลี่ยนคีย์ โปรดลองอีกครั้งในอีกสักครู่"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर तक नहीं पहुँच सके, इसलिए कुंजी नहीं बदली। थोड़ी देर बाद फिर कोशिश करें।"
          }
        }
      }
    },
    "서버에 올린 기록과 모든 AI 연결, PIN이 지워져요. 쓰던 AI는 다시 연결해야 해요.|The records on the server, every AI connection and the PIN are deleted. You'll need to reconnect the AIs you use." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバー上の記録、すべてのAI連携、PINが削除されます。使っていたAIは再連携が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器上的记录、所有 AI 连接和 PIN 都将删除。你需要重新连接所用的 AI。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器上的記錄、所有 AI 連線和 PIN 都將刪除。你需要重新連接所用的 AI。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Daten auf dem Server, alle KI-Verbindungen und die PIN werden gelöscht. Du musst deine KIs erneut verbinden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données sur le serveur, toutes les connexions IA et le PIN seront supprimés. Vous devrez reconnecter vos IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati sul server, tutte le connessioni IA e il PIN verranno eliminati. Dovrai ricollegare le IA che usi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán los registros del servidor, todas las conexiones con IA y el PIN. Habrá que volver a conectar las IA que usa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os registros no servidor, todas as conexões com IA e o PIN serão excluídos. Você precisará reconectar as IAs que usa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi trên máy chủ, mọi kết nối AI và PIN sẽ bị xóa. Bạn cần kết nối lại các AI đang dùng."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan di server, semua koneksi AI, dan PIN akan dihapus. AI yang Anda pakai perlu dihubungkan kembali."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกบนเซิร์ฟเวอร์ การเชื่อมต่อ AI ทั้งหมด และ PIN จะถูกลบ คุณต้องเชื่อมต่อ AI ที่ใช้อีกครั้ง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर पर मौजूद रिकॉर्ड, सभी AI कनेक्शन और PIN मिट जाएँगे। अपने AI फिर से कनेक्ट करने होंगे।"
          }
        }
      }
    },
    "선과 발자국은 지나온 길, 아이콘은 등록한 곳입니다.|Lines and footprints show where you went. Icons mark saved places." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線と足あとは通った道、アイコンは登録した場所です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "线条和脚印是走过的路，图标是已保存的地点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
