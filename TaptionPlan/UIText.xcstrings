        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दा नांग अन्तर्राष्ट्रीय विमानक्षेत्र"
          }
        }
      }
    },
    "|Da Nang is a port city on Vietnam’s central coast. It has a long beach, Ba Na Hills and the Marble Mountains, and is close to Hoi An." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダナンはベトナム中部海岸の港湾都市です。長いビーチ、バーナーヒルズ、五行山があり、ホイアンにも近い街です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "岘港是越南中部海岸的港口城市。有长长的海滩、巴拿山和五行山，离会安很近。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "峴港是越南中部海岸的港口城市。有長長的海灘、巴拿山與五行山,離會安很近。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da Nang ist eine Hafenstadt an der Küste Zentralvietnams. Sie hat einen langen Strand, die Ba Na Hills und die Marmorberge und liegt nahe Hoi An."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da Nang est une ville portuaire sur la côte centrale du Vietnam. Elle possède une longue plage, les Ba Na Hills et les montagnes de Marbre, et est proche de Hội An."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da Nang è una città portuale sulla costa centrale del Vietnam. Ha una lunga spiaggia, Ba Na Hills e le Montagne di Marmo, ed è vicina a Hoi An."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da Nang es una ciudad portuaria en la costa central de Vietnam. Tiene una larga playa, Ba Na Hills y las Montañas de Mármol, y está cerca de Hoi An."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da Nang é uma cidade portuária na costa central do Vietnã. Tem uma longa praia, Ba Na Hills e as Montanhas de Mármore, e fica perto de Hoi An."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đà Nẵng là thành phố cảng ở bờ biển miền Trung Việt Nam. Có bãi biển dài, Bà Nà Hills và Ngũ Hành Sơn, và gần Hội An."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da Nang adalah kota pelabuhan di pesisir tengah Vietnam. Memiliki pantai panjang, Ba Na Hills, dan Marble Mountains, serta dekat dengan Hoi An."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดานังเป็นเมืองท่าบนชายฝั่งภาคกลางของเวียดนาม มีชายหาดยาว Ba Na Hills และเขาหินอ่อน และอยู่ใกล้ฮอยอัน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दा नांग वियतनाम के मध्य तट पर बंदरगाह शहर है। यहाँ लंबा समुद्र तट, बा ना हिल्स और मार्बल पर्वत हैं, और यह होई आन के पास है।"
          }
        }
      }
    },
