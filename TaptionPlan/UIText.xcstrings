    "변경 내용을 저장소에서 다시 확인하지 못했습니다.|Changes could not be verified against storage again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更内容をストレージと再照合できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
