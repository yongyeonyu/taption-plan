    "‘미확인’ 없이 기록을 채운 날이 달성입니다.|A day counts when its records have no ‘unconfirmed’ time left." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「未確認」の時間が残っていない日が達成になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当天记录里没有“未确认”时间，才算达成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當天記錄裡沒有「未確認」時間，才算達成。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tag zählt, wenn in seinen Aufzeichnungen keine „unbestätigte“ Zeit übrig ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jour compte quand ses enregistrements n’ont plus de temps « non confirmé »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un giorno conta quando nelle sue registrazioni non resta tempo “non confermato”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un día cuenta cuando sus registros no tienen tiempo “sin confirmar”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dia conta quando seus registros não têm tempo “não identificado”."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một ngày được tính khi bản ghi không còn thời gian “chưa xác nhận”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
