    "|Terraced green tea fields in Boseong, South Jeolla. Green rows along the hillside and a cedar-lined path are the main sights." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全南宝城にある段々状の緑茶畑。丘の斜面に広がる緑の畝と杉並木の道が主な見どころです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全南宝城的梯田式绿茶园。山坡上的绿色茶垄和杉树成行的小径是主要景观。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於全南寶城的梯田式綠茶田。山坡上的綠色茶畦與杉木夾道的小徑是主要景觀。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terrassenförmige Grünteefelder in Boseong, Süd-Jeolla. Grüne Reihen am Hang und ein von Zedern gesäumter Weg sind die Hauptsehenswürdigkeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Champs de thé vert en terrasses à Boseong, dans le Jeolla du Sud. Les rangées vertes sur le coteau et une allée bordée de cèdres en sont les principaux sites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Campi terrazzati di tè verde a Boseong, nel Jeolla del Sud. Le file verdi lungo il pendio e un viale fiancheggiato da cedri sono le attrazioni principali."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Campos de té verde en terrazas en Boseong, Jeolla del Sur. Las hileras verdes a lo largo de la ladera y un camino bordeado de cedros son lo más destacado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Campos de chá verde em terraços em Boseong, Jeolla do Sul. Fileiras verdes ao longo da encosta e um caminho ladeado de cedros são as principais atrações."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những cánh đồng chè xanh bậc thang ở Boseong, Nam Jeolla. Những hàng chè xanh dọc sườn đồi và con đường rợp tuyết tùng là điểm chính."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladang teh hijau berteras di Boseong, Jeolla Selatan. Barisan hijau di lereng bukit dan jalan berbaris pohon cedar adalah pemandangan utama."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไร่ชาเขียวขั้นบันไดใน Boseong จอลลาใต้ แถวสีเขียวตามเนินเขาและทางเดินที่เรียงรายด้วยต้นซีดาร์เป็นจุดชมหลัก"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दक्षिणी जेओल्ला के बोसोंग में सीढ़ीदार हरी चाय के खेत। पहाड़ी ढलान पर हरी कतारें और देवदार-किनारे वाला रास्ता मुख्य दर्शनीय स्थल हैं।"
          }
        }
      }
    },
