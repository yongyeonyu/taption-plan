    "|Addis Ababa is the capital of Ethiopia, set on a high plateau. It hosts the African Union headquarters and is known for its National Museum, markets and coffee culture." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アディスアベバはエチオピアの首都で、高原に位置します。アフリカ連合の本部があり、国立博物館、市場、コーヒー文化で知られています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "亚的斯亚贝巴是埃塞俄比亚的首都，坐落在高原上。非洲联盟总部设于此，以国家博物馆、市集和咖啡文化闻名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "亞的斯亞貝巴是衣索比亞的首都,位於高原上。非洲聯盟總部設於此,並以國家博物館、市集與咖啡文化聞名。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addis Abeba ist die Hauptstadt Äthiopiens auf einem Hochplateau. Hier hat die Afrikanische Union ihren Sitz, und die Stadt ist für ihr Nationalmuseum, ihre Märkte und ihre Kaffeekultur bekannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addis-Abeba est la capitale de l'Éthiopie, située sur un haut plateau. Elle accueille le siège de l'Union africaine et est connue pour son Musée national, ses marchés et sa culture du café."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addis Abeba è la capitale dell'Etiopia, situata su un alto altopiano. Ospita la sede dell'Unione Africana ed è nota per il Museo Nazionale, i mercati e la cultura del caffè."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adís Abeba es la capital de Etiopía, situada en una meseta elevada. Alberga la sede de la Unión Africana y es conocida por su Museo Nacional, sus mercados y su cultura del café."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adis Abeba é a capital da Etiópia, situada num planalto elevado. Abriga a sede da União Africana e é conhecida pelo Museu Nacional, pelos mercados e pela cultura do café."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addis Ababa là thủ đô của Ethiopia, nằm trên một cao nguyên. Nơi đây đặt trụ sở Liên minh châu Phi và nổi tiếng với Bảo tàng Quốc gia, các khu chợ và văn hóa cà phê."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addis Ababa adalah ibu kota Ethiopia, terletak di dataran tinggi. Kota ini menjadi markas Uni Afrika dan terkenal dengan Museum Nasional, pasar, dan budaya kopinya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอดดิสอาบาบาเป็นเมืองหลวงของเอธิโอเปีย ตั้งอยู่บนที่ราบสูง เป็นที่ตั้งสำนักงานใหญ่สหภาพแอฟริกา และมีชื่อเสียงเรื่องพิพิธภัณฑ์แห่งชาติ ตลาด และวัฒนธรรมกาแฟ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अदीस अबाबा इथियोपिया की राजधानी है, जो एक ऊँचे पठार पर बसी है। यहाँ अफ़्रीकी संघ का मुख्यालय है, और यह अपने राष्ट्रीय संग्रहालय, बाज़ारों और कॉफ़ी संस्कृति के लिए जानी जाती है।"
          }
        }
      }
    },
    "|Adjust the length so it stays within the period of the parent and child plans." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "親プランと子プランの期間内に収まるよう、長さを調整してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请调整时长，使其保持在上级和下级计划的时间段内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請調整長度，使其保持在上層與下層計畫的期間內。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe die Länge so an, dass sie innerhalb des Zeitraums von übergeordnetem und untergeordnetem Plan bleibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez la durée pour qu'elle reste dans la période des plans parent et enfant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola la durata in modo che resti entro il periodo del piano principale e di quello secondario."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la duración para que quede dentro del periodo de los planes principal y secundario."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste a duração para ficar dentro do período dos planos principal e secundário."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chỉnh độ dài để nằm trong khoảng thời gian của kế hoạch cha và con."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuaikan durasi agar tetap dalam periode rencana induk dan anak."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับความยาวให้อยู่ในช่วงเวลาของแผนหลักและแผนย่อย"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लंबाई ऐसे बदलें कि वह पैरेंट और चाइल्ड प्लान की अवधि के भीतर रहे।"
          }
        }
      }
    },
