    "기록을 모두 불러온 뒤에 저장할 수 있습니다.|You can save after all records finish loading." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての記録を読み込んだ後に保存できます。"
          }
        },
        "zh-Hans" : {
