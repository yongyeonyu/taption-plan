          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công viên giải trí ở Gwacheon dưới chân núi Cheonggye. Có các trò chơi, diễu hành và sự kiện theo mùa."
          }
