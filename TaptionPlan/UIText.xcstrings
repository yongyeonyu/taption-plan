          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin nombre de comercio"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem nome da loja"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có tên cửa hàng"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa nama toko"
          }
        },
