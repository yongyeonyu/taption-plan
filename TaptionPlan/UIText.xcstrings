    "|The action item's time must fall within the routine's period." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクション項目の時間は、ルーティンの期間内である必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行动项的时间必须在流程的时间段内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行動項目的時間必須在例行事項的期間內。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeit der Aufgabe muss im Zeitraum der Routine liegen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'heure de l'action doit se situer dans la période de la routine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'orario dell'azione deve rientrare nel periodo della routine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hora de la tarea debe estar dentro del periodo de la rutina."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O horário do item de ação deve estar dentro do período da rotina."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian của mục hành động phải nằm trong khoảng thời gian của thói quen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu item aksi harus berada dalam periode rutinitas."
