    "|South Korea’s main international airport, on Yeongjongdo island in Incheon. Many international and transit flights serving Seoul and the capital region pass through it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仁川の永宗島にある韓国の主要国際空港。ソウルと首都圏を発着する多くの国際線や乗り継ぎ便が利用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "韩国主要的国际机场，位于仁川永宗岛上。许多服务首尔和首都圈的国际航班与中转航班经此往来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "韓國主要的國際機場,位於仁川永宗島。許多服務首爾與首都圈的國際與轉機航班都經由此處。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Südkoreas wichtigster internationaler Flughafen auf der Insel Yeongjongdo in Incheon. Viele internationale und Transitflüge für Seoul und die Hauptstadtregion laufen darüber."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal aéroport international de Corée du Sud, sur l'île de Yeongjongdo, à Incheon. De nombreux vols internationaux et de transit desservant Séoul et la région capitale y passent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il principale aeroporto internazionale della Corea del Sud, sull'isola di Yeongjongdo a Incheon. Vi passano molti voli internazionali e di transito che servono Seul e la regione della capitale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El principal aeropuerto internacional de Corea del Sur, en la isla de Yeongjongdo, en Incheon. Por él pasan muchos vuelos internacionales y de tránsito que sirven a Seúl y a la región capitalina."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O principal aeroporto internacional da Coreia do Sul, na ilha de Yeongjongdo, em Incheon. Muitos voos internacionais e de conexão que servem Seul e a região da capital passam por ele."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sân bay quốc tế chính của Hàn Quốc, trên đảo Yeongjongdo ở Incheon. Nhiều chuyến bay quốc tế và nối chuyến phục vụ Seoul và vùng thủ đô đi qua đây."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandara internasional utama Korea Selatan, di pulau Yeongjongdo di Incheon. Banyak penerbangan internasional dan transit yang melayani Seoul dan wilayah ibu kota melewatinya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สนามบินนานาชาติหลักของเกาหลีใต้ บนเกาะ Yeongjongdo ในอินชอน เที่ยวบินระหว่างประเทศและเที่ยวบินเปลี่ยนเครื่องจำนวนมากที่ให้บริการโซลและเขตเมืองหลวงผ่านที่นี่"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दक्षिण कोरिया का मुख्य अंतर्राष्ट्रीय हवाई अड्डा, जो इंचियोन के योंगजोंगदो द्वीप पर है। सियोल और राजधानी क्षेत्र को सेवा देने वाली कई अंतर्राष्ट्रीय और ट्रांज़िट उड़ानें यहाँ से गुज़रती हैं।"
          }
        }
      }
    },
