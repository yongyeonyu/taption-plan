    "|The wall that enclosed Hanyang, the Joseon capital. Hikers can follow its route across Inwangsan, Bugaksan, Naksan and Namsan." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝鮮の都・漢陽を囲んでいた城郭。仁王山、北岳山、駱山、南山を越える道筋をたどって歩けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曾环绕朝鲜都城汉阳的城墙。登山者可沿其路线穿越仁王山、北岳山、骆山和南山。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圍繞朝鮮首都漢陽的城牆。登山客可沿著它的路線,橫越仁王山、北岳山、駱山與南山。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mauer, die Hanyang, die Hauptstadt von Joseon, umschloss. Wanderer können ihrem Verlauf über Inwangsan, Bugaksan, Naksan und Namsan folgen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La muraille qui entourait Hanyang, la capitale de Joseon. Les randonneurs peuvent suivre son tracé à travers l'Inwangsan, le Bugaksan, le Naksan et le Namsan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mura che racchiudevano Hanyang, la capitale Joseon. Gli escursionisti possono seguirne il percorso attraverso Inwangsan, Bugaksan, Naksan e Namsan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La muralla que rodeaba Hanyang, la capital de Joseon. Los senderistas pueden seguir su recorrido por Inwangsan, Bugaksan, Naksan y Namsan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A muralha que cercava Hanyang, a capital de Joseon. Os caminhantes podem seguir seu trajeto por Inwangsan, Bugaksan, Naksan e Namsan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bức tường bao quanh Hanyang, kinh đô Joseon. Người đi bộ đường dài có thể theo lộ trình của nó qua Inwangsan, Bugaksan, Naksan và Namsan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tembok yang mengelilingi Hanyang, ibu kota Joseon. Pendaki dapat mengikuti rutenya melintasi Inwangsan, Bugaksan, Naksan, dan Namsan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำแพงที่เคยล้อม Hanyang เมืองหลวงของโชซอน นักเดินป่าเดินตามเส้นทางข้าม Inwangsan, Bugaksan, Naksan และ Namsan ได้"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह दीवार जिसने जोसियन राजधानी हान्यांग को घेरा था। पदयात्री इंवांगसान, बुकाकसान, नाकसान और नामसान के पार इसके मार्ग का अनुसरण कर सकते हैं।"
          }
        }
      }
    },
    "|The weather service is temporarily unavailable. Please try again shortly." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天気サービスが一時的に利用できません。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天气服务暂时不可用。请稍后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天氣服務暫時無法使用。請稍後再試。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wetterdienst ist vorübergehend nicht verfügbar. Bitte versuch es gleich noch einmal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service météo est temporairement indisponible. Réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio meteo è temporaneamente non disponibile. Riprova tra poco."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio del tiempo no está disponible temporalmente. Inténtalo de nuevo en un momento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O serviço de clima está temporariamente indisponível. Tente novamente em instantes."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch vụ thời tiết tạm thời không khả dụng. Vui lòng thử lại sau giây lát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layanan cuaca sementara tidak tersedia. Silakan coba lagi sebentar lagi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บริการสภาพอากาศไม่พร้อมใช้งานชั่วคราว โปรดลองอีกครั้งในอีกสักครู่"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौसम सेवा अस्थायी रूप से उपलब्ध नहीं है। कृपया थोड़ी देर बाद फिर कोशिश करें।"
          }
        }
      }
    },
