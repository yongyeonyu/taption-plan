        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho Chi Minh City"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trường Đại học Bách khoa, Đại học Quốc gia Thành phố Hồ Chí Minh"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
