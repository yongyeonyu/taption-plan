    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar access is required to show fixed events on your timeline."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고정된 일정을 시간표에 표시하기 위해 캘린더 접근이 필요합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定のイベントをタイムラインに表示するには、カレンダーへのアクセスが必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要日历权限，以便在你的时间线上显示固定事件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要行事曆存取權限，才能在你的時間軸上顯示固定事件。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kalenderzugriff ist nötig, um feste Termine in deiner Zeitleiste anzuzeigen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à Calendrier est nécessaire pour afficher les événements fixes sur votre chronologie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve l'accesso al calendario per mostrare gli eventi fissi nella tua timeline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso a Calendario para mostrar los eventos fijos en tu línea de tiempo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao Calendário é necessário para mostrar eventos fixos na sua linha do tempo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần quyền truy cập lịch để hiển thị các sự kiện cố định trên dòng thời gian của bạn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses kalender diperlukan untuk menampilkan acara tetap di garis waktu Anda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องเข้าถึงปฏิทินเพื่อแสดงกิจกรรมที่กำหนดไว้บนไทม์ไลน์ของคุณ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी टाइमलाइन पर तय इवेंट दिखाने के लिए कैलेंडर की अनुमति ज़रूरी है।"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID unlocks the encryption key for protected BOKKI Plan records."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보호된 BOKKI Plan 기록의 암호키를 열기 위해 Face ID를 사용합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face IDで、保護されたBOKKI Planの記録の暗号鍵のロックを解除します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面容 ID 用于解锁受保护的 BOKKI Plan 记录的加密密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID 用來解鎖受保護的 BOKKI Plan 記錄所使用的加密金鑰。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID entsperrt den Verschlüsselungsschlüssel für geschützte BOKKI-Plan-Einträge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID déverrouille la clé de chiffrement des enregistrements protégés de BOKKI Plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID sblocca la chiave di cifratura dei dati protetti di BOKKI Plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID desbloquea la clave de cifrado de los registros protegidos de BOKKI Plan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Face ID desbloqueia a chave de criptografia dos registros protegidos do BOKKI Plan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID mở khóa khóa mã hóa cho các bản ghi BOKKI Plan được bảo vệ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID membuka kunci enkripsi untuk catatan BOKKI Plan yang dilindungi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID ปลดล็อคกุญแจเข้ารหัสสำหรับบันทึก BOKKI Plan ที่ได้รับการป้องกัน"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID सुरक्षित BOKKI Plan रिकॉर्ड की एन्क्रिप्शन कुंजी अनलॉक करता है।"
          }
        }
      }
    },
    "NSHealthClinicalHealthRecordsShareUsageDescription" : {
      "comment" : "Privacy - Clinical Health Records Share Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access is required to connect the timing and source of clinical records you allow with on-device health-management activities."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자가 허용한 임상 기록의 시각과 출처를 기기 안에서 건강관리 일과와 연결하기 위해 접근이 필요합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可した診療記録のタイミングと提供元を、デバイス上の健康管理アクティビティと結び付けるために、アクセスが必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要此访问权限，以便将你允许的临床记录的时间和来源，与设备上的健康管理活动关联起来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要存取權限，才能將你允許的臨床記錄之時間與來源，連結到裝置上的健康管理活動。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff ist nötig, um Zeitpunkt und Quelle der von dir freigegebenen klinischen Einträge mit Gesundheitsaktivitäten auf dem Gerät zu verknüpfen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès est nécessaire pour relier le moment et la source des dossiers médicaux que vous autorisez aux activités de gestion de la santé sur l'appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve l'accesso per collegare orari e fonte delle cartelle cliniche che consenti alle attività di gestione della salute sul dispositivo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso para conectar el momento y el origen de los registros clínicos que permitas con las actividades de gestión de la salud en el dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso é necessário para relacionar o horário e a origem dos registros clínicos que você permitir com as atividades de gerenciamento de saúde no dispositivo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần quyền truy cập để kết nối thời điểm và nguồn của hồ sơ lâm sàng mà bạn cho phép với các hoạt động quản lý sức khỏe trên thiết bị."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses diperlukan untuk menghubungkan waktu dan sumber catatan klinis yang Anda izinkan dengan aktivitas manajemen kesehatan di perangkat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องเข้าถึงเพื่อเชื่อมโยงเวลาและแหล่งที่มาของบันทึกทางการแพทย์ที่คุณอนุญาตกับกิจกรรมการจัดการสุขภาพในเครื่อง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी अनुमति वाले क्लिनिकल रिकॉर्ड के समय और स्रोत को डिवाइस पर होने वाली स्वास्थ्य-प्रबंधन गतिविधियों से जोड़ने के लिए पहुँच ज़रूरी है।"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access is required to compare the workouts, sleep, activity, vitals, nutrition, medications, and clinical records you allow with your timeline and create on-device automatic records."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자가 허용한 운동·수면·활동·생체·영양·투약·임상 기록을 기기 안에서 일과와 비교하고 자동 기록하기 위해 건강 데이터 접근이 필요합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可したワークアウト、睡眠、アクティビティ、バイタル、栄養、服薬、診療記録をタイムラインと照らし合わせ、デバイス上で自動記録を作成するために、アクセスが必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要此访问权限，以便将你允许的体能训练、睡眠、活动、生命体征、营养、用药和临床记录与你的时间线对照，并在设备上生成自动记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要存取權限，才能將你允許的體能訓練、睡眠、活動、生命徵象、營養、用藥和臨床記錄與你的時間軸比對，並在裝置上建立自動記錄。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff ist nötig, um die von dir freigegebenen Workouts, Schlafdaten, Aktivitäten, Vitalwerte, Ernährungsdaten, Medikamente und klinischen Einträge mit deiner Zeitleiste abzugleichen und automatische Einträge auf dem Gerät zu erstellen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès est nécessaire pour comparer les entraînements, le sommeil, l'activité, les constantes vitales, la nutrition, les médicaments et les dossiers médicaux que vous autorisez avec votre chronologie et créer des enregistrements automatiques sur l'appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve l'accesso per confrontare allenamenti, sonno, attività, parametri vitali, alimentazione, farmaci e cartelle cliniche che consenti con la tua timeline e creare registrazioni automatiche sul dispositivo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso para comparar con tu línea de tiempo los entrenamientos, el sueño, la actividad, las constantes vitales, la nutrición, la medicación y los registros clínicos que permitas, y crear registros automáticos en el dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso é necessário para comparar com a sua linha do tempo os treinos, o sono, a atividade, os sinais vitais, a nutrição, os medicamentos e os registros clínicos que você permitir, e criar registros automáticos no dispositivo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần quyền truy cập để đối chiếu bài tập, giấc ngủ, hoạt động, chỉ số sinh tồn, dinh dưỡng, thuốc và hồ sơ lâm sàng mà bạn cho phép với dòng thời gian của bạn và tạo bản ghi tự động trên thiết bị."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses diperlukan untuk membandingkan olahraga, tidur, aktivitas, tanda vital, nutrisi, obat, dan catatan klinis yang Anda izinkan dengan garis waktu Anda dan membuat catatan otomatis di perangkat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องเข้าถึงเพื่อเปรียบเทียบการออกกำลังกาย การนอนหลับ กิจกรรม สัญญาณชีพ โภชนาการ การใช้ยา และบันทึกทางการแพทย์ที่คุณอนุญาตกับไทม์ไลน์ของคุณ และสร้างบันทึกอัตโนมัติในเครื่อง"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी अनुमति वाले वर्कआउट, नींद, गतिविधि, वाइटल्स, पोषण, दवाओं और क्लिनिकल रिकॉर्ड की आपकी टाइमलाइन से तुलना करने और डिवाइस पर स्वचालित रिकॉर्ड बनाने के लिए पहुँच ज़रूरी है।"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workouts measured on Apple Watch are saved to the Health app."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch에서 측정한 운동을 건강 앱에 저장합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchで測定したワークアウトをヘルスケアに保存します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 Apple Watch 测量的体能训练保存到“健康”App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 Apple Watch 測量的體能訓練儲存到「健康」App。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf der Apple Watch gemessene Trainings werden in der Health-App gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entraînements mesurés sur l’Apple Watch sont enregistrés dans l’app Santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli allenamenti misurati su Apple Watch vengono salvati nell’app Salute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los entrenamientos medidos en el Apple Watch se guardan en la app Salud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os treinos medidos no Apple Watch são salvos no app Saúde."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bài tập đo trên Apple Watch được lưu vào ứng dụng Sức khỏe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olahraga yang diukur di Apple Watch disimpan ke app Kesehatan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกการออกกำลังกายที่วัดจาก Apple Watch ลงในแอปสุขภาพ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch पर मापे गए वर्कआउट Health ऐप में सहेजे जाते हैं।"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background location access records visited places and travel segments while movement logging is enabled. You can stop it in Settings > GPS & Sensor Data; continuous logging can increase battery use."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동 기록이 켜진 동안 방문 장소와 이동 구간을 백그라운드에서 기록합니다. 설정 > GPS 및 센서 데이터에서 중지할 수 있으며, 연속 기록은 배터리 사용량을 늘릴 수 있습니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドの位置情報へのアクセスは、移動ログがオンのとき、訪れた場所と移動区間を記録します。設定 > GPSとセンサーのデータで停止できます。継続的なログ記録はバッテリーの消費を増やす場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用移动记录期间，后台定位用于记录你到访的地点和出行路段。你可以在“设置”>“GPS 与传感器数据”中停止；持续记录可能增加耗电。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟移動記錄後，背景定位服務會記錄你造訪的地點和移動區段。你可以在「設定 > GPS 與感測器資料」中停止；持續記錄可能增加耗電量。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff im Hintergrund zeichnet besuchte Orte und Reiseabschnitte auf, solange die Bewegungsaufzeichnung aktiviert ist. Du kannst sie unter Einstellungen > GPS- & Sensordaten stoppen; dauerhafte Aufzeichnung kann den Akkuverbrauch erhöhen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la localisation en arrière-plan enregistre les lieux visités et les segments de trajet lorsque le suivi des déplacements est activé. Vous pouvez l'arrêter dans Réglages > Données GPS et capteurs ; un suivi continu peut augmenter la consommation de batterie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso alla posizione in background registra i luoghi visitati e i tragitti mentre la registrazione degli spostamenti è attiva. Puoi interromperla in Impostazioni > Dati GPS e sensori; la registrazione continua può aumentare il consumo della batteria."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación en segundo plano registra los lugares visitados y los tramos de viaje mientras el registro de movimiento está activado. Puedes detenerlo en Ajustes > Datos de GPS y sensores; el registro continuo puede aumentar el uso de batería."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização em segundo plano registra os lugares visitados e os trechos de viagem enquanto o registro de movimento está ativado. Você pode interromper em Ajustes > Dados de GPS e sensores; o registro contínuo pode aumentar o uso da bateria."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền vị trí nền ghi lại những nơi bạn đã ghé và các đoạn di chuyển khi tính năng ghi di chuyển được bật. Bạn có thể dừng trong Cài đặt > Dữ liệu GPS và cảm biến; ghi liên tục có thể làm tăng mức dùng pin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses lokasi latar belakang merekam tempat yang dikunjungi dan segmen perjalanan saat pencatatan pergerakan aktif. Anda dapat menghentikannya di Pengaturan > Data GPS & Sensor; pencatatan terus-menerus dapat meningkatkan pemakaian baterai."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเข้าถึงตำแหน่งเบื้องหลังจะบันทึกสถานที่ที่ไปและช่วงการเดินทางขณะเปิดการบันทึกการเคลื่อนที่ คุณหยุดได้ที่ การตั้งค่า > ข้อมูล GPS และเซนเซอร์ การบันทึกต่อเนื่องอาจใช้แบตเตอรี่มากขึ้น"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकग्राउंड स्थान पहुँच, मूवमेंट लॉगिंग चालू होने पर घूमी गई जगहें और यात्रा के खंड रिकॉर्ड करती है। आप इसे सेटिंग्ज़ > GPS और सेंसर डेटा में रोक सकते हैं; लगातार लॉगिंग से बैटरी ज़्यादा खर्च हो सकती है।"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access records where you stayed and how long you traveled within the permissions you allow."
