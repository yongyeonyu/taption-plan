            "value" : "TaptionPlan"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar access is required to show fixed events on your timeline."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고정된 일정을 시간표에 표시하기 위해 캘린더 접근이 필요합니다."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID unlocks the encryption key for protected Taption Plan records."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보호된 Taption Plan 기록의 암호키를 열기 위해 Face ID를 사용합니다."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health access is required to compare workouts and sleep stages with your timeline."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동과 수면 단계의 실제 기록을 시간표와 비교하기 위해 건강 데이터 접근이 필요합니다."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health write access is required to synchronize workouts and sleep records with your timeline."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동과 수면 기록을 앱의 시간표와 동기화하기 위해 건강 데이터 저장 권한이 필요합니다."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background location access records visited places and travel segments while movement logging is enabled. You can stop it in Settings > GPS & Sensor Data; continuous logging can increase battery use."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동 기록이 켜진 동안 방문 장소와 이동 구간을 백그라운드에서 기록합니다. 설정 > GPS 및 센서 데이터에서 중지할 수 있으며, 연속 기록은 배터리 사용량을 늘릴 수 있습니다."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access records where you stayed and how long you traveled within the permissions you allow."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "머문 장소와 이동 시간을 사용자가 허용한 범위에서 기록하기 위해 위치 접근이 필요합니다."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone access is required to attach voice memos to action items."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "액션 아이템에 음성 메모를 첨부하기 위해 마이크 접근이 필요합니다."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion & Fitness access estimates walking, running, travel, steps, and floor changes while sensor collection is enabled."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "센서 수집이 켜진 동안 걷기·달리기·이동 상태와 걸음 및 층수 변화를 추정하기 위해 동작 및 피트니스 접근이 필요합니다."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo access is required to show photos on the timeline at the time they were captured."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "촬영 시각에 맞춰 사진을 시간표에 표시하기 위해 사진 접근이 필요합니다."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
