          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff zeichnet im Rahmen der von dir erlaubten Berechtigungen auf, wo du dich aufgehalten hast und wie lange du unterwegs warst."
