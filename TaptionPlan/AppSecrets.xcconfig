// 대기질 중계 주소. 새 worktree에도 그대로 쓰인다.
AIR_QUALITY_PROXY_HOST = air.bokkiyaw.com
// 카카오 REST 키는 앱에 넣지 않는다. 여행 계획 중계 서버의 비밀값(KAKAO_REST_API_KEY)으로만 둔다(REV1110A03).
// 여행 계획 중계 서버 호스트(server/trip-relay). 계정 이름이 든 workers.dev 주소 대신 회사 도메인을 쓴다(REV1110A05).
TRIP_RELAY_HOST = trip.bokkiyaw.com
// 「BOKKI 결제」 단축어의 iCloud ID는 로컬 파일에만 둔다(SCB1112A01). 없으면 앱은 파일 공유로 넣는다.
PAYMENT_SHORTCUT_ICLOUD_ID =
// 「BOKKI 결제 알림」(은행·카드 앱 알림 자동화)의 iCloud ID도 로컬 파일에만 둔다(NTF1112A01).
PAYMENT_ALERT_SHORTCUT_ICLOUD_ID =
// 위키백과 장소 사진(TVV1113A01)을 받을 때 밝히는 연락처(앱 지원 주소나 공용 메일). 위키미디어 규칙이며, 비어 있으면 사진을 받지 않는다.
// 로컬 파일에만 둔다. xcconfig에서는 「//」가 주석이라 주소는 https:// 없이 적는다(예: example.org/support).
WIKIMEDIA_CONTACT =
// 카카오 지도 네이티브 앱 키(KMP1113A01). 로컬 파일에만 둔다. 비어 있으면 「카카오 지도」를 고를 수 없다.
KAKAO_NATIVE_APP_KEY =
#include? "AppSecrets.local.xcconfig"
